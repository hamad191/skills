	rifle = {
		piece("RightArm", Vector3.new(0.32, 3.2, 0.42), Vector3.new(0, -1.9, -0.2), GUNMETAL, nil, Enum.Material.Metal),
		piece("RightArm", Vector3.new(0.38, 0.9, 0.65), Vector3.new(0, -0.45, 0.15), WOOD, nil, Enum.Material.Wood),
	},
	longrifle = {
		piece("RightArm", Vector3.new(0.3, 4.4, 0.4), Vector3.new(0, -2.5, -0.2), Color3.fromRGB(55, 65, 50), nil, Enum.Material.Metal),
		piece("RightArm", Vector3.new(0.38, 0.9, 0.65), Vector3.new(0, -0.45, 0.15), WOOD, nil, Enum.Material.Wood),
		piece("RightArm", Vector3.new(0.9, 0.3, 0.3), CFrame.new(0, -1.6, -0.55) * UP, DARK, CYL),
	},
	net = {
		piece("RightArm", Vector3.new(1.3, 1.3, 1.3), Vector3.new(0, -1.4, -0.2), Color3.fromRGB(170, 160, 135), BALL, Enum.Material.Fabric),
		piece("Torso", Vector3.new(2.3, 0.3, 0.3), CFrame.new(0, 0.1, 0.55) * CFrame.Angles(0, 0, 0.7), Color3.fromRGB(150, 130, 100), CYL, Enum.Material.Fabric),
	},
	bomb = {
		piece("RightArm", Vector3.new(1.2, 1.2, 1.2), Vector3.new(0, -1.45, -0.25), DARK, BALL),
		piece("RightArm", Vector3.new(0.12, 0.5, 0.12), Vector3.new(0, -0.75, -0.25), Color3.fromRGB(200, 180, 140)),
		piece("RightArm", Vector3.new(0.3, 0.3, 0.3), Vector3.new(0, -0.45, -0.25), Color3.fromRGB(255, 160, 40), BALL, Enum.Material.Neon),
	},
	cannon = {
		piece("Torso", Vector3.new(3.2, 1.1, 1.1), CFrame.new(1.2, 1.2, -0.4) * CFrame.Angles(0, math.pi / 2, 0), GUNMETAL, CYL, Enum.Material.Metal),
		piece("Torso", Vector3.new(0.4, 1.3, 1.3), CFrame.new(1.2, 1.2, 1.1) * CFrame.Angles(0, math.pi / 2, 0), DARK, CYL),
	},
	coat = {
		piece("Torso", Vector3.new(2.4, 2.9, 0.2), Vector3.new(0, -0.55, 0.62), WHITE, nil, Enum.Material.Fabric),
		piece("Torso", Vector3.new(0.9, 0.25, 1.1), Vector3.new(-1.3, 0.95, 0), GOLD),
		piece("Torso", Vector3.new(0.9, 0.25, 1.1), Vector3.new(1.3, 0.95, 0), GOLD),
	},
}

-- How each enemy holds itself (read by client/Rigs.lua): shooters aim, bombers carry.
local function styleOf(def)
	if def.gear == "rifle" or def.gear == "longrifle" or def.gear == "net" then
		return "aim"
	end
	return def.gear == "bomb" and "carry" or "march"
end

local function buildBody(def, colors, name, x, y, z)
	local s = def.scale
	local model = Instance.new("Model")
	model.Name = name
	local torso = makePart({ Name = "Torso", Size = Vector3.new(2, 2, 1) * s, Color = colors.color }, model)
	torso.CFrame = CFrame.new(x, y + LEG_DEPTH * s, z)
	local parts = { Torso = torso }

	local function newPart(partName, size, color, shape, material)
		local p = makePart({
			Name = partName, Size = size * s, Color = color, Shape = shape or Enum.PartType.Block,
			Material = material or Enum.Material.SmoothPlastic, CastShadow = false,
		}, nil)
		p.Anchored, p.Massless = false, true
		return p
	end
	for _, limb in LIMBS do
		local p = newPart(limb[1], limb[2], colors[limb[5]], limb[7])
		local joint = Instance.new("Motor6D")
		joint.Name = limb[6]
		joint.Part0, joint.Part1 = torso, p
		joint.C0, joint.C1 = CFrame.new(limb[3] * s), CFrame.new(limb[4] * s)
		joint.Parent = torso
		p.CFrame = torso.CFrame * joint.C0 * joint.C1:Inverse()
		p.Parent = model
		parts[limb[1]] = p
	end
	local function attach(list)
		for _, pc in list do
			local on = parts[pc[1]]
			local color = typeof(pc[4]) == "Color3" and pc[4] or colors[pc[4]] or DARK
			local p = newPart(pc[1] .. "Detail", pc[2], color, pc[5], pc[6])
			local offset = typeof(pc[3]) == "CFrame" and pc[3] or CFrame.new(pc[3])
			p.CFrame = on.CFrame * (offset - offset.Position + offset.Position * s)
			if pc[4] == "eyes" and def.eyes then
				p.Material = Enum.Material.Neon
			end
			local weld = Instance.new("WeldConstraint")
			weld.Part0, weld.Part1 = on, p
			weld.Parent = p
			p.Parent = model
		end
	end
	attach(BASE)
	if SAILOR_HATS[def.hat] then
		attach(SAILOR)
	end
	attach(HATS[def.hat] or {})
	attach(GEAR[def.gear] or {})
	if def.gear == "coat" then
		-- "Justice" on the back of every officer's coat
		local back
		for _, p in model:GetChildren() do
			if p.Name == "TorsoDetail" and p.Size.Z < 0.25 * s and p.Size.Y > 2.5 * s then
				back = p
			end
		end
		if back then
			local gui = Instance.new("SurfaceGui")
			gui.Face = Enum.NormalId.Back
			gui.CanvasSize = Vector2.new(120, 140)
			gui.Parent = back
			local text = Instance.new("TextLabel")
			text.Size = UDim2.fromScale(1, 0.6)
			text.Position = UDim2.fromScale(0, 0.1)
			text.BackgroundTransparency = 1
			text.Text = "正義"
			text.TextScaled = true
			text.TextColor3 = DARK
			text.Font = Enum.Font.GothamBlack
			text.Parent = gui
		end
	end
	model.PrimaryPart = torso
	model:SetAttribute("Style", styleOf(def))
	model:SetAttribute("Scale", s)
	return model, parts
end

function Enemies.spawn(kind, x, z, hpScale, dmgScale, runKey, look)
	local def = Config.Enemies[kind]
	local y = groundY(x, z)
	if not y then
		return nil
	end
	look = look or {}
	local colors = { color = look.color or def.color, accent = look.accent or def.accent, skin = def.skin, eyes = def.eyes or DARK }
	local name = look.name or def.name
	local model, parts = buildBody(def, colors, name, x, y, z)
	if def.healthBar then
		model:SetAttribute("Boss", name)
		model:SetAttribute("BossTier", kind == "Boss" and 2 or 1)
		model:SetAttribute("Hp", 1)
	end
	model.Parent = folder

	local hp = def.hp * hpScale
	local now = os.clock()
	local e = {
		model = model, root = parts.Torso, head = parts.Head, def = def, kind = kind, run = runKey,
		color = colors.color, skin = colors.skin, name = name,
		hp = hp, maxHp = hp, damage = def.damage * dmgScale, hpScale = hpScale, dmgScale = dmgScale,
		radius = 1.2 * def.scale, lastHit = 0, phase = math.random() * 10, busyUntil = 0,
		nextAttack = now + math.random() * (def.fireRate or 1) + 1,
		nextSlam = now + (def.slamEvery or 0), nextRing = now + (def.ringEvery or 0),
		cool = {},
	}
	-- skills start partly charged so a squad doesn't fire all at once
	for skill, cooldown in def.skills or {} do
		e.cool[skill] = now + cooldown * (0.4 + math.random() * 0.6)
	end
	if def.healthBar then
		e.bar = makeBar(parts.Torso, def.scale, name)
	end
	table.insert(list, e)
	return e
end

-- Removes an enemy without a reward (a Bomb Clown that blew itself up).
local function vanish(e)
	e.dead = true
	e.model:Destroy()
end

-- Attacks -----------------------------------------------------------------------------------

-- Tells clients to play an attack pose: "swing" (melee), "cast" (both arms up), "shoot".
local function pose(e, kind)
	e.model:SetAttribute("Pose", kind)
	e.model:SetAttribute("PoseAt", os.clock())
end

local function faceTo(e, dir)
	local pos = e.root.Position
	e.root.CFrame = CFrame.lookAt(pos, pos + dir)
end

local function groundPos(e)
	return e.root.Position - Vector3.new(0, LEG_DEPTH * e.def.scale - 0.2, 0)
end

-- A telegraphed blast: players see a red circle, then everyone still inside gets hit.
local function blast(e, pos, radius, damage, delay, onLand)
	Fx.emit("warn", { pos = pos, r = radius, t = delay })
	local runKey = e.run
	task.delay(delay, function()
		if onLand and not onLand() then
			return
		end
		for _, t in lastTargets[runKey] or NO_TARGETS do
			if t.hum.Health > 0 and flat(t.root.Position - pos).Magnitude <= radius then
				hurt(t, damage)
			end
		end
		Fx.emit("slam", { pos = pos, r = radius, c = BLAST_COLOR })
	end)
end

-- A telegraphed straight line (Pacifista lasers, sniper shots, sword lunges): a red strip shows
-- on the ground, then everyone still on it gets hit. The enemy holds still while aiming.
local function lineAttack(e, dir, length, width, damage, delay, beam)
	local from = groundPos(e)
	e.busyUntil = os.clock() + delay + 0.2
	faceTo(e, dir)
	pose(e, beam.pose)
	Fx.emit("line", { o = from, d = dir, len = length, w = width, t = delay, c = beam.color })
	local runKey = e.run
	task.delay(delay, function()
		if e.dead then
			return
		end
		for _, t in lastTargets[runKey] or NO_TARGETS do
			local rel = flat(t.root.Position - from)
			local along = rel:Dot(dir)
			if t.hum.Health > 0 and along >= 0 and along <= length and (rel - dir * along).Magnitude <= width / 2 + PLAYER_RADIUS then
				hurt(t, damage)
			end
		end
		local eye = e.head.Position
		Fx.emit("beam", { o = eye, d = dir, len = length, w = beam.width, c = beam.color })
		if beam.lunge then
			-- the swordsman dashes along his line
			local pos = e.root.Position + dir * length * 0.85
			local y = groundY(pos.X, pos.Z)
			if y then
				e.root.CFrame = CFrame.lookAt(Vector3.new(pos.X, y + LEG_DEPTH * e.def.scale, pos.Z), Vector3.new(pos.X, y + LEG_DEPTH * e.def.scale, pos.Z) + dir)
			end
		end
	end)
end

-- A projectile flying flat toward the target (rifle bullets, air blades, seastone nets).
local function shoot(e, target, opts)
	opts = opts or {}
	nextBulletId += 1
	local from = e.root.Position
	local dir = flat(target.root.Position - from)
	dir = dir.Magnitude > 0.1 and dir.Unit or Vector3.new(0, 0, -1)
	local range = (e.def.range or 30) * 1.6
	local speed = opts.speed or BULLET_SPEED
	table.insert(bullets, {
		id = nextBulletId, pos = from, dir = dir, left = range, damage = opts.damage or e.damage, run = e.run,
		speed = speed, radius = opts.radius or 2.2, slow = opts.slow, slowTime = opts.slowTime,
	})
	Fx.emit("eshot", { id = nextBulletId, o = from, d = dir, speed = speed, len = range, c = opts.color, s = opts.size })
	pose(e, "shoot")
end

local SKILLS = {}

-- Swordsman: a quick lunge along a short red line.
function SKILLS.dash(e, target, dist)
	if dist > 22 or dist < 4 then
		return false
	end
	local dir = flat(target.root.Position - e.root.Position).Unit
	lineAttack(e, dir, 20, 3, e.damage * 1.5, 0.55, { color = Color3.fromRGB(220, 230, 255), width = 0.6, pose = "swing", lunge = true })
	return true
end

-- Pacifista (and the final boss): a wide laser from the mouth after a long aim.
function SKILLS.laser(e, target, dist)
	if dist > e.def.range then
		return false
	end
	local dir = flat(target.root.Position - e.root.Position).Unit
	lineAttack(e, dir, e.def.range + 8, 4 * math.max(1, e.def.scale / 2), e.damage * 1.6, 1.1, { color = LASER_COLOR, width = 1.4, pose = "cast" })
	return true
end

-- Sniper: a long, thin, very painful shot.
function SKILLS.snipe(e, target, dist)
	if dist > e.def.range + 10 then
		return false
	end
	local dir = flat(target.root.Position - e.root.Position).Unit
	lineAttack(e, dir, e.def.range + 20, 2.2, e.damage, 1.3, { color = SNIPE_COLOR, width = 0.35, pose = "shoot" })
	return true
end

-- Medic: heals every nearby Marine that is hurt.
function SKILLS.heal(e)
	local healed = false
	for _, other in list do
		if not other.dead and other.run == e.run and other.hp < other.maxHp
			and flat(other.root.Position - e.root.Position).Magnitude <= e.def.healRadius then
			other.hp = math.min(other.maxHp, other.hp + other.maxHp * e.def.heal)
			if other.bar then
				other.bar.Size = UDim2.fromScale(other.hp / other.maxHp, 1)
				other.model:SetAttribute("Hp", other.hp / other.maxHp)
			end
			healed = true
		end
	end
	if healed then
		pose(e, "cast")
		Fx.emit("heal", { pos = groundPos(e), r = e.def.healRadius })
	end
	return true -- checks again after the cooldown either way
end

-- Bomb Clown: runs up, lights the fuse, and blows up (taking itself out).
function SKILLS.bomb(e, _target, dist)
	if dist > 5 or e.fusing then
		return false
	end
	e.fusing = true
	e.busyUntil = os.clock() + 10
	pose(e, "cast")
	blast(e, groundPos(e), e.def.blast, e.damage, 1, function()
		if e.dead then
			return false -- defused: killed before it went off
		end
		vanish(e)
		return true
	end)
	return true
end

-- Seastone Netter: a slow net that halves your speed for a moment.
function SKILLS.net(e, target, dist)
	if dist > e.def.range then
		return false
	end
	shoot(e, target, {
		speed = 32, radius = 2.8, damage = e.damage, slow = e.def.slow, slowTime = e.def.slowTime,
		color = Color3.fromRGB(200, 190, 160), size = 2,
	})
	return true
end

-- CP9 Agent: Soru - vanishes and reappears right beside you.
function SKILLS.blink(e, target, dist)
	if dist < 10 or dist > 80 then
		return false
	end
	local a = math.random() * math.pi * 2
	local spot = target.root.Position + Vector3.new(math.cos(a) * 5, 0, math.sin(a) * 5)
	local y = groundY(spot.X, spot.Z)
	if not y then
		return false
	end
	Fx.emit("puff", { pos = e.root.Position })
	local pos = Vector3.new(spot.X, y + LEG_DEPTH * e.def.scale, spot.Z)
	e.root.CFrame = CFrame.lookAt(pos, Vector3.new(target.root.Position.X, pos.Y, target.root.Position.Z))
	Fx.emit("puff", { pos = pos })
	e.lastHit = os.clock() - 0.4 -- a moment to react before the first hit
	return true
end

-- CP9 Agent: Rankyaku - a kicked blade of air.
function SKILLS.rankyaku(e, target, dist)
	if dist > e.def.range or dist < 8 then
		return false
	end
	shoot(e, target, { speed = 60, radius = 2.6, damage = e.damage * 0.8, color = Color3.fromRGB(190, 240, 255), size = 1.6 })
	return true
end

-- Captains and Vice Admirals: call in a few recruits.
function SKILLS.call(e)
	if Enemies.count(e.run) >= Config.MAX_ENEMIES then
		return false
	end
	pose(e, "cast")
	Fx.emit("shout", { pos = e.head.Position, text = "REINFORCEMENTS!" })
	local pos = e.root.Position
	for k = 1, 3 do
		local a = k * math.pi * 2 / 3 + math.random()
		Enemies.spawn("Grunt", pos.X + math.cos(a) * 7, pos.Z + math.sin(a) * 7, e.hpScale, e.dmgScale, e.run)
	end
	return true
end

-- Ranged attacks, boss attacks and skills. Melee hits happen in Enemies.step.
local function specialAttacks(e, target, dist, targets, now)
	local def = e.def
	if now < e.busyUntil then
		return
	end
	for skill, cooldown in def.skills or {} do
		if now >= e.cool[skill] and SKILLS[skill](e, target, dist) then
			e.cool[skill] = now + cooldown
			return -- one skill at a time
		end
	end
	if def.ai == "ranged" and dist <= def.range and now >= e.nextAttack then
		e.nextAttack = now + def.fireRate
		shoot(e, target)
	elseif def.ai == "artillery" and dist <= def.range and now >= e.nextAttack then
		e.nextAttack = now + def.fireRate
		pose(e, "cast")
		blast(e, target.root.Position, def.blast, e.damage, 1.4)
	elseif def.ai == "boss" then
		if now >= e.nextSlam then
			e.nextSlam = now + def.slamEvery
			local victim = targets[math.random(#targets)]
			pose(e, "swing")
			blast(e, victim.root.Position, def.blast, e.damage * 1.5, 1.2)
		end
		if def.ringEvery and now >= e.nextRing then
			e.nextRing = now + def.ringEvery
			pose(e, "cast")
			for k = 1, 6 do
				local a = k * math.pi / 3
				blast(e, e.root.Position + Vector3.new(math.cos(a) * 14, 0, math.sin(a) * 14), 7, e.damage, 1.5)
			end
		end
	end
end

function Enemies.damage(e, amount, player)
	if e.dead then
		return
	end
	e.hp -= amount
	if e.bar then
		local ratio = math.max(e.hp, 0) / e.maxHp
		e.bar.Size = UDim2.fromScale(ratio, 1)
		e.model:SetAttribute("Hp", ratio)
	end
	if e.hp > 0 then
		flash(e)
		return
	end
	e.dead = true
	if e.def.xp > 0 then
		dropOrb(e.root.Position - Vector3.new(0, LEG_DEPTH * e.def.scale - 0.8, 0), e.def.xp, e.run)
	end
	Fx.emit("death", { pos = e.root.Position, c = e.color, s = e.def.scale })
	local chestChance = Config.CHESTS[e.kind]
	if chestChance and math.random() < chestChance then
		dropChest(e.root.Position - Vector3.new(0, LEG_DEPTH * e.def.scale, 0), e.run, e.kind)
	end
	Enemies.onKilled(e, player)
	e.model:Destroy()
end

-- targetsByRun: [runKey] = array of { player, root, hum, magnet }
function Enemies.step(dt, targetsByRun)
	local now = os.clock()
	lastTargets = targetsByRun
	for i = #list, 1, -1 do
		local e = list[i]
		if e.dead then
			table.remove(list, i)
			continue
		end
		local best, bestDist
		for _, t in targetsByRun[e.run] or NO_TARGETS do
			local d = flat(t.root.Position - e.root.Position).Magnitude
			if not bestDist or d < bestDist then
				best, bestDist = t, d
			end
		end
		if best then
			local busy = now < e.busyUntil
			local pos = e.root.Position
			local to = flat(best.root.Position - pos)
			local reach = e.radius + 2
			-- shooters and support stop at a distance; everyone else walks right up
			local stopAt = e.def.keepAway and e.def.range * 0.8 or reach
			if not busy and bestDist > stopAt then
				local newPos = pos + to.Unit * math.min(e.def.speed * dt, bestDist - stopAt)
				local sway = math.sin(now * 9 + e.phase) * 0.04
				e.root.CFrame = CFrame.lookAt(newPos, newPos + to) * CFrame.Angles(0, 0, sway)
			elseif not busy and to.Magnitude > 0.1 then
				faceTo(e, to) -- keep facing the target while standing
			end
			if not busy and bestDist <= reach and now - e.lastHit >= 1 then
				e.lastHit = now
				pose(e, "swing")
				hurt(best, e.damage)
			end
			specialAttacks(e, best, bestDist, targetsByRun[e.run], now)
		end
	end

	for i = #chests, 1, -1 do
		local chest = chests[i]
		-- bob gently so it catches the eye
		chest.model:PivotTo(CFrame.new(chest.pos + Vector3.new(0, math.sin((now - chest.born) * 3) * 0.3, 0)) * CFrame.Angles(0, now - chest.born, 0))
		for _, t in targetsByRun[chest.run] or NO_TARGETS do
			if flat(t.root.Position - chest.pos).Magnitude <= 5 then
				Fx.emit("chest", { pos = chest.pos })
				Enemies.onChest(chest.run, chest.kind, t.player)
				chest.model:Destroy()
				table.remove(chests, i)
				break
			end
		end
	end

	for i = #bullets, 1, -1 do
		local b = bullets[i]
		local move = b.speed * dt
		b.pos += b.dir * move
		b.left -= move
		local hit
		for _, t in targetsByRun[b.run] or NO_TARGETS do
			if flat(t.root.Position - b.pos).Magnitude <= b.radius then
				hit = t
				break
			end
		end
		if hit then
			hurt(hit, b.damage)
			if b.slow and hit.player then
				Enemies.onSlow(hit.player, b.slow, b.slowTime)
			end
		end
		if hit or b.left <= 0 then
			Fx.emit("eshotEnd", { id = b.id })
			table.remove(bullets, i)
		end
	end

	for i = #orbs, 1, -1 do
		local o = orbs[i]
		local t = o.target
		if t and (t.hum.Health <= 0 or not t.root.Parent) then
			t, o.target = nil, nil
		end
		if not t then
			for _, candidate in targetsByRun[o.run] or NO_TARGETS do
				if (candidate.root.Position - o.part.Position).Magnitude <= candidate.magnet then
					t, o.target = candidate, candidate
					break
				end
			end
		end
		if t then
			local to = t.root.Position - o.part.Position
			if to.Magnitude < 2 then
				Enemies.onPickup(t.player, o.xp)
				o.part:Destroy()
				table.remove(orbs, i)
			else
				o.part.Position += to.Unit * math.min(to.Magnitude, 60 * dt)
			end
		end
	end
end

function Enemies.nearest(pos, maxDist, exclude)
	local best, bestDist = nil, maxDist
	for _, e in list do
		if not e.dead and not (exclude and exclude[e]) then
			local d = flat(e.root.Position - pos).Magnitude - e.radius
			if d <= bestDist then
				best, bestDist = e, d
			end
		end
	end
	return best
end

-- up to n enemies within maxDist, closest first
function Enemies.closest(pos, maxDist, n)
	local found = {}
	for _, e in list do
		if not e.dead then
			local d = flat(e.root.Position - pos).Magnitude - e.radius
			if d <= maxDist then
				table.insert(found, { e = e, d = d })
			end
		end
	end
	table.sort(found, function(a, b)
		return a.d < b.d
	end)
	local out = {}
	for i = 1, math.min(n, #found) do
		out[i] = found[i].e
	end
	return out
end

function Enemies.inRadius(pos, r)
	local out = {}
	for _, e in list do
		if not e.dead and flat(e.root.Position - pos).Magnitude <= r + e.radius then
			table.insert(out, e)
		end
	end
	return out
end

function Enemies.count(runKey)
	local n = 0
	for _, e in list do
		if e.run == runKey and not e.dead then
			n += 1
		end
	end
	return n
end

-- Removes one adventure's enemies, bullets, chests and XP orbs.
function Enemies.clear(runKey)
	for i = #chests, 1, -1 do
		if chests[i].run == runKey then
			chests[i].model:Destroy()
			table.remove(chests, i)
		end
	end
	for i = #bullets, 1, -1 do
		if bullets[i].run == runKey then
			Fx.emit("eshotEnd", { id = bullets[i].id })
			table.remove(bullets, i)
		end
	end
	for i = #list, 1, -1 do
		local e = list[i]
		if e.run == runKey then
			e.dead = true
			e.model:Destroy()
			table.remove(list, i)
		end
	end
	for i = #orbs, 1, -1 do
		if orbs[i].run == runKey then
			orbs[i].part:Destroy()
			table.remove(orbs, i)
		end
	end
end

return Enemies
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX13478"><Properties><string name="Name">Fx</string><ProtectedString name="Source"><![CDATA[-- Queues visual effects and sends them to every client once per frame.
-- The server only decides what happened; clients draw it (see client/Effects.lua).
local Fx = {}
local queue = {}
local remote

function Fx.init(r)
	remote = r
end

function Fx.emit(kind, data)
	data.k = kind
	table.insert(queue, data)
end

function Fx.flush()
	if #queue > 0 then
		remote:FireAllClients(queue)
		queue = {}
	end
end

return Fx
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX13479"><Properties><string name="Name">Gear</string><ProtectedString name="Source"><![CDATA[-- Signature gear each pirate wears or carries (hats, swords, staffs...), welded onto the
-- character on the server so every player sees it. Built from plain parts: no assets needed.
local Gear = {}

local CYL, BALL = Enum.PartType.Cylinder, Enum.PartType.Ball
local UP = CFrame.Angles(0, 0, math.pi / 2) -- cylinder standing upright
local FORWARD = CFrame.Angles(0, math.pi / 2, 0) -- cylinder pointing forward (-Z)
local METAL, NEON, FABRIC = Enum.Material.Metal, Enum.Material.Neon, Enum.Material.Fabric
local SKIN = Color3.fromRGB(255, 205, 160)
local STEEL = Color3.fromRGB(215, 220, 230)
local BLACK = Color3.fromRGB(20, 20, 25)

-- R6 rigs have fewer parts; attach to the closest one.
local R6 = {
	UpperTorso = "Torso", LowerTorso = "Torso", RightHand = "Right Arm", LeftHand = "Left Arm",
	RightLowerArm = "Right Arm", LeftLowerArm = "Left Arm", LeftUpperArm = "Left Arm",
	RightFoot = "Right Leg", LeftFoot = "Left Leg",
}

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

-- A piece is { body part, size, offset from that part, color, shape?, material? }.
local function hat(brim, crown, band, height, y)
	y = y or 0.5
	height = height or 0.7
	local pieces = {
		{ "Head", Vector3.new(0.15, 2.7, 2.7), CFrame.new(0, y, 0) * UP, brim, CYL, FABRIC },
		{ "Head", Vector3.new(height, 1.4, 1.4), CFrame.new(0, y + height / 2, 0) * UP, crown, CYL, FABRIC },
	}
	if band then
		table.insert(pieces, { "Head", Vector3.new(0.22, 1.45, 1.45), CFrame.new(0, y + 0.15, 0) * UP, band, CYL, FABRIC })
	end
	return pieces
end

local function sword(hand, handle, length)
	return {
		{ hand, Vector3.new(0.9, 0.28, 0.28), CFrame.new(0, -0.15, -0.1) * FORWARD, handle, CYL },
		{ hand, Vector3.new(0.08, 0.7, 0.7), CFrame.new(0, -0.15, -0.6) * FORWARD, rgb(200, 170, 60), CYL, METAL },
		{ hand, Vector3.new(0.08, 0.25, length), CFrame.new(0, -0.15, -0.65 - length / 2), STEEL, nil, METAL },
	}
end

local function sheath(x, color, tilt)
	return { "LowerTorso", Vector3.new(0.26, 0.26, 3.2), CFrame.new(x, -0.1, 0.3) * CFrame.Angles(math.rad(tilt), 0, 0), color }
end

local function staff(hand, colors, length)
	local pieces = {}
	local segment = length / #colors
	for i, color in colors do
		local y = -length / 2 + (i - 0.5) * segment
		table.insert(pieces, { hand, Vector3.new(segment, 0.22, 0.22), CFrame.new(0, y, 0) * UP, color, CYL })
	end
	return pieces
end

local function join(...)
	local all = {}
	for _, list in { ... } do
		for _, piece in list do
			table.insert(all, piece)
		end
	end
	return all
end

local GEAR = {
	Marine = join(hat(rgb(245, 245, 250), rgb(245, 245, 250), rgb(30, 60, 140), 0.6), {
		{ "UpperTorso", Vector3.new(2.3, 3, 0.15), CFrame.new(0, -0.4, 0.6), rgb(250, 250, 252), nil, FABRIC },
		{ "UpperTorso", Vector3.new(0.9, 0.9, 0.06), CFrame.new(0, -0.3, 0.69), rgb(40, 70, 150) },
	}),
	Luffy = hat(rgb(240, 210, 110), rgb(240, 210, 110), rgb(200, 30, 30)),
	Zoro = join(sword("RightHand", BLACK, 3.4), {
		sheath(-1.05, rgb(240, 240, 240), 55),
		sheath(-0.85, rgb(170, 30, 30), 65),
		{ "LeftUpperArm", Vector3.new(1.1, 0.35, 1.1), CFrame.new(0, 0.2, 0), rgb(30, 30, 30), nil, FABRIC },
	}),
	Nami = staff("RightHand", { rgb(40, 90, 200), rgb(130, 200, 255), rgb(40, 90, 200) }, 5),
	Sanji = {
		{ "UpperTorso", Vector3.new(2.08, 1.62, 1.08), CFrame.new(), BLACK, nil, FABRIC },
		{ "UpperTorso", Vector3.new(0.28, 1.1, 0.06), CFrame.new(0, 0.05, -0.57), rgb(30, 50, 120) },
		{ "RightFoot", Vector3.new(1.05, 0.45, 1.25), CFrame.new(0, -0.05, -0.1), BLACK },
		{ "LeftFoot", Vector3.new(1.05, 0.45, 1.25), CFrame.new(0, -0.05, -0.1), BLACK },
	},
	Ace = join(hat(rgb(240, 120, 30), rgb(240, 120, 30), rgb(180, 30, 30)), {
		{ "Head", Vector3.new(0.3, 0.3, 0.3), CFrame.new(-0.25, 0.75, -0.72), rgb(220, 40, 40), BALL },
		{ "Head", Vector3.new(0.3, 0.3, 0.3), CFrame.new(0.25, 0.75, -0.72), rgb(40, 100, 220), BALL },
	}),
	Robin = hat(rgb(120, 70, 170), rgb(120, 70, 170), rgb(210, 180, 240)),
	Chopper = join(hat(rgb(240, 120, 170), rgb(240, 120, 170), nil, 1.3), {
		{ "Head", Vector3.new(0.9, 0.12, 0.06), CFrame.new(0, 1.15, -0.72) * CFrame.Angles(0, 0, math.rad(45)), rgb(250, 250, 250) },
		{ "Head", Vector3.new(0.9, 0.12, 0.06), CFrame.new(0, 1.15, -0.72) * CFrame.Angles(0, 0, math.rad(-45)), rgb(250, 250, 250) },
		{ "Head", Vector3.new(1.2, 0.2, 0.2), CFrame.new(-0.9, 0.6, 0) * CFrame.Angles(0, 0, math.rad(-50)), rgb(130, 85, 45), CYL },
		{ "Head", Vector3.new(1.2, 0.2, 0.2), CFrame.new(0.9, 0.6, 0) * CFrame.Angles(0, 0, math.rad(50)), rgb(130, 85, 45), CYL },
	}),
	Usopp = {
		{ "Head", Vector3.new(1.3, 0.3, 0.3), CFrame.new(0, -0.05, -1.15) * FORWARD, SKIN, CYL },
		{ "Head", Vector3.new(0.42, 0.42, 0.42), CFrame.new(-0.27, 0.42, -0.58), rgb(255, 210, 80), BALL, NEON },
		{ "Head", Vector3.new(0.42, 0.42, 0.42), CFrame.new(0.27, 0.42, -0.58), rgb(255, 210, 80), BALL, NEON },
		{ "LeftHand", Vector3.new(0.9, 0.2, 0.2), CFrame.new(0, -0.1, 0) * UP, rgb(110, 70, 40), CYL },
		{ "LeftHand", Vector3.new(0.7, 0.16, 0.16), CFrame.new(-0.2, 0.55, 0) * CFrame.Angles(0, 0, math.rad(115)), rgb(110, 70, 40), CYL },
		{ "LeftHand", Vector3.new(0.7, 0.16, 0.16), CFrame.new(0.2, 0.55, 0) * CFrame.Angles(0, 0, math.rad(65)), rgb(110, 70, 40), CYL },
	},
	Franky = {
		{ "Head", Vector3.new(1.0, 0.55, 1.5), CFrame.new(0, 0.75, -0.25), rgb(60, 150, 240) },
		{ "Head", Vector3.new(1.15, 0.25, 0.08), CFrame.new(0, 0.15, -0.62), BLACK },
		{ "RightLowerArm", Vector3.new(1.3, 1.4, 1.3), CFrame.new(0, -0.1, 0), rgb(60, 120, 210), nil, METAL },
		{ "LeftLowerArm", Vector3.new(1.3, 1.4, 1.3), CFrame.new(0, -0.1, 0), rgb(60, 120, 210), nil, METAL },
		{ "UpperTorso", Vector3.new(0.5, 0.5, 0.06), CFrame.new(-0.5, 0.3, -0.56), rgb(255, 220, 60), nil, NEON },
	},
	Brook = join({
		{ "Head", Vector3.new(2, 2, 2), CFrame.new(0, 1.05, 0.45), BLACK, BALL, FABRIC },
	}, hat(BLACK, BLACK, rgb(150, 60, 60), 1.2, 1.9), staff("RightHand", { BLACK, BLACK }, 4.2), {
		{ "RightHand", Vector3.new(0.4, 0.4, 0.4), CFrame.new(0, 2.15, 0), rgb(220, 190, 80), BALL, METAL },
	}),
	Jinbe = {
		{ "UpperTorso", Vector3.new(2.12, 1.64, 1.12), CFrame.new(), rgb(40, 70, 110), nil, FABRIC },
		{ "LowerTorso", Vector3.new(2.15, 0.35, 1.15), CFrame.new(0, 0.05, 0), rgb(240, 140, 40), nil, FABRIC },
		{ "UpperTorso", Vector3.new(0.4, 0.4, 0.4), CFrame.new(0, 0.85, -0.45), rgb(230, 80, 80), BALL },
	},
	Law = join(hat(rgb(245, 245, 240), rgb(245, 245, 240), rgb(60, 60, 60), 0.9, 0.45), {
		{ "Head", Vector3.new(0.3, 0.3, 0.3), CFrame.new(-0.4, 1.0, -0.55), BLACK, BALL },
		{ "Head", Vector3.new(0.3, 0.3, 0.3), CFrame.new(0.35, 1.05, -0.55), BLACK, BALL },
		{ "Head", Vector3.new(0.3, 0.3, 0.3), CFrame.new(0.6, 0.9, 0.2), BLACK, BALL },
		{ "UpperTorso", Vector3.new(0.32, 5.4, 0.32), CFrame.new(0.2, 0.2, 0.68) * CFrame.Angles(0, 0, math.rad(35)), BLACK },
		{ "UpperTorso", Vector3.new(0.3, 1.1, 0.3), CFrame.new(-1.67, 2.86, 0.68) * CFrame.Angles(0, 0, math.rad(35)), rgb(240, 240, 240) },
	}),
	Hancock = {
		{ "UpperTorso", Vector3.new(2.4, 3.4, 0.12), CFrame.new(0, -0.5, 0.62), rgb(200, 30, 60), nil, FABRIC },
		{ "Head", Vector3.new(0.3, 1.45, 1.45), CFrame.new(0, 0.62, 0) * UP, rgb(240, 200, 60), CYL, METAL },
		{ "Head", Vector3.new(0.3, 0.3, 0.3), CFrame.new(0, 0.9, -0.62), rgb(255, 90, 160), BALL, NEON },
	},
}

-- Replaces any gear on the character with this class's gear.
function Gear.apply(character, className)
	if not character then
		return
	end
	local old = character:FindFirstChild("PirateGear")
	if old then
		old:Destroy()
	end
	local pieces = GEAR[className]
	if not pieces then
		return
	end
	local folder = Instance.new("Folder")
	folder.Name = "PirateGear"
	for _, piece in pieces do
		local attachName, size, offset, color, shape, material = piece[1], piece[2], piece[3], piece[4], piece[5], piece[6]
		local attach = character:FindFirstChild(attachName) or (R6[attachName] and character:FindFirstChild(R6[attachName]))
		if attach and attach:IsA("BasePart") then
			local p = Instance.new("Part")
			p.Name = attachName .. "Gear"
			p.Shape = shape or Enum.PartType.Block
			p.Size = size
			p.Color = color
			p.Material = material or Enum.Material.SmoothPlastic
			p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
			p.CanCollide, p.CanQuery, p.CanTouch, p.Massless, p.CastShadow = false, false, false, true, false
			p.CFrame = attach.CFrame * offset
			local weld = Instance.new("WeldConstraint")
			weld.Part0, weld.Part1 = attach, p
			weld.Parent = p
			p.Parent = folder
		end
	end
	folder.Parent = character
end

return Gear
]]></ProtectedString></Properties></Item><Item class="Script" referent="RBX13480"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[-- Game flow:
--   Spawn island: pick a character, train and gear up with the NPCs, step onto a voyage gate.
--   The first player on a pad is the captain and picks a map + difficulty they have unlocked.
--   When the gate's countdown ends, everyone on the pad sails to that map's arena.
--   Each adventure runs until its boss falls, its time runs out, or its whole crew is down.
--   Players can leave early (keeping the gold they earned) or be revived.
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(RS.Shared.Config)
local PlayerData = require(script.Parent.PlayerData)
local Enemies = require(script.Parent.Enemies)
local Progression = require(script.Parent.Progression)
local Weapons = require(script.Parent.Weapons)
local Fx = require(script.Parent.Fx)
local Portals = require(script.Parent.Portals)
local Gear = require(script.Parent.Gear)
local Npcs = require(script.Parent.Npcs)
local Monetization = require(script.Parent.Monetization)

Players.CharacterAutoLoads = false

local remotes = {}
local remoteFolder = Instance.new("Folder")
remoteFolder.Name = "Remotes"
for _, name in {
	"State", "Stats", "LevelUp", "Choose", "Reroll", "SelectClass", "BuyMeta", "Meta", "Results", "Fx", "Portal",
	"Announce", "Voyage", "Dash", "Leave", "Revive", "Train", "Gear", "UnlockClass", "Wave",
} do
	local r = Instance.new("RemoteEvent")
	r.Name = name
	r.Parent = remoteFolder
	remotes[name] = r
end
remoteFolder.Parent = RS
Progression.init(remotes)
Fx.init(remotes.Fx)
Portals.build()
task.spawn(Npcs.build) -- building R15 characters can take a moment

local LOBBY_TEXT = "Step onto a voyage gate to choose an adventure!"
local selectedClass = {}
local runOf = {} -- [player] = the run they are in (nil = on the spawn island)
local runs = {} -- [mapKey] = run in progress (one crew per map at a time)
local lastDash = {} -- [player] = os.clock() of their last dash
local gates = {} -- [gateIndex] = { captain, map, difficulty, launchAt }
for i in Config.GATES do
	gates[i] = {}
end

-- The class a player plays: their pick, if they have unlocked it, else the Marine.
local function classOf(player)
	local pick = selectedClass[player]
	return pick and PlayerData.hasClass(player, pick) and pick or Config.DEFAULT_CLASS
end

local function sendMeta(player)
	local data = PlayerData.get(player)
	if not data then
		return
	end
	local costs = {}
	for name, m in Config.Meta do
		costs[name] = data.meta[name] < m.max and PlayerData.metaCost(name, data.meta[name]) or false
	end
	local boosts = {}
	for boost, untilTime in data.boosts do
		boosts[boost] = math.max(0, untilTime - os.time())
	end
	remotes.Meta:FireClient(player, {
		gold = data.gold, levels = data.meta, costs = costs, progress = data.progress, class = classOf(player),
		mastery = data.mastery, training = data.training, items = data.items, equipped = data.equipped,
		gearLevels = data.gearLevels, gearCopies = data.gearCopies, classes = data.classes,
		revives = data.revives, boosts = boosts, passes = Monetization.ownedList(player),
		dashCooldown = Monetization.dashCooldown(player), loadFailed = data.loadFailed == true,
	})
end

local function sendLobby(player)
	remotes.State:FireClient(player, { phase = "Lobby", text = LOBBY_TEXT })
end

local function announce(run, text, color)
	for player in run.players do
		remotes.Announce:FireClient(player, text, color)
	end
end

local function sendToArena(player, center)
	local character = player.Character
	local root = character and character:WaitForChild("HumanoidRootPart", 5)
	if not root then
		return
	end
	local a = math.random() * 2 * math.pi
	local r = math.random() * Config.ARENA_DROP_RADIUS
	character:PivotTo(CFrame.new(center.X + math.cos(a) * r, center.Y + 5, center.Z + math.sin(a) * r))
end

-- A gold "VIP" tag over the heads of VIP pass owners.
local function addVipTag(character)
	local head = character:WaitForChild("Head", 5)
	if not head or head:FindFirstChild("VipTag") then
		return
	end
	local tag = Instance.new("BillboardGui")
	tag.Name = "VipTag"
	tag.Size = UDim2.fromOffset(90, 26)
	tag.StudsOffset = Vector3.new(0, 3.2, 0)
	tag.MaxDistance = 80
	tag.Parent = head
	local text = Instance.new("TextLabel")
	text.Size = UDim2.fromScale(1, 1)
	text.BackgroundTransparency = 1
	text.Text = "👑 VIP"
	text.TextScaled = true
	text.Font = Enum.Font.GothamBlack
	text.TextColor3 = Color3.fromRGB(255, 205, 60)
	text.TextStrokeTransparency = 0.3
	text.Parent = tag
end

local function onCharacter(player, character)
	local hum = character:WaitForChild("Humanoid")
	hum.Died:Connect(function()
		local s = Progression.get(player)
		if runOf[player] and s then
			-- out until revived or the crew's adventure ends; they can watch or leave
			s.dead = true
			Weapons.cleanup(player)
			remotes.LevelUp:FireClient(player, nil)
			return
		end
		task.wait(3)
		if player.Parent and not runOf[player] then
			player:LoadCharacter()
		end
	end)
	Progression.applyStats(player)
	task.spawn(function()
		character:WaitForChild("HumanoidRootPart", 5)
		task.wait(0.3) -- let the body parts finish loading
		if character.Parent then
			Gear.apply(character, classOf(player))
			if Monetization.owns(player, "VIP") then
				addVipTag(character)
			end
		end
	end)
end

local function onPlayerAdded(player)
	PlayerData.load(player)
	if not player.Parent then
		return
	end
	Monetization.load(player)
	player.CharacterAdded:Connect(function(character)
		onCharacter(player, character)
	end)
	player:LoadCharacter()
	sendMeta(player)
	sendLobby(player)
	local data = PlayerData.get(player)
	if data and data.loadFailed then
		remotes.Announce:FireClient(player, "Your save couldn't load - progress won't save this visit. Try rejoining.", Config.RARITIES.Mythic)
	end
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end

Players.PlayerRemoving:Connect(function(player)
	local run = runOf[player]
	if run then
		run.players[player] = nil
	end
	runOf[player] = nil
	lastDash[player] = nil
	Weapons.cleanup(player)
	Progression.stop(player)
	selectedClass[player] = nil
	Monetization.release(player)
	PlayerData.release(player)
end)

Enemies.onKilled = function(enemy, killer)
	local s = killer and Progression.get(killer)
	if s then
		s.kills += 1
		s.bonusGold += enemy.def.gold or 0
	end
end
Enemies.onPickup = Progression.addXP
Enemies.onSlow = Progression.slow

local function runTargets(run)
	local targets = {}
	for player in run.players do
		local s = Progression.get(player)
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local hum = character and character:FindFirstChildOfClass("Humanoid")
		if s and not s.dead and root and hum and hum.Health > 0 then
			table.insert(targets, {
				player = player, s = s, root = root, hum = hum, magnet = Progression.magnet(s),
				armor = math.min(Config.MAX_DEFENSE, Progression.bonus(s, "defense")),
			})
		end
	end
	return targets
end

RunService.Heartbeat:Connect(function(dt)
	local targetsByRun = {}
	for key, run in runs do
		targetsByRun[key] = runTargets(run)
	end
	Enemies.step(dt, targetsByRun)
	Weapons.step(dt)
	Fx.flush()
end)

-- Rewards ---------------------------------------------------------------------------------

-- A random gear item, its rarity rolled with a difficulty's drop weights.
local function rollItem(difficulty)
	local weights = Config.DROPS[difficulty].weights
	local total = 0
	for _, weight in weights do
		total += weight
	end
	local roll, rarity = math.random() * total, "Common"
	for name, weight in weights do
		roll -= weight
		if roll <= 0 then
			rarity = name
			break
		end
	end
	local pool = {}
	for _, item in Config.GEAR_ITEMS do
		if item.rarity == rarity then
			table.insert(pool, item)
		end
	end
	return pool[math.random(#pool)]
end

-- Gives a player a dropped item. New items are kept; owned ones become a spare copy for
-- upgrading (or gold once they have enough copies). Returns what to show them.
local function giveItem(player, item)
	local outcome = PlayerData.grantItem(player, item.id)
	local data = PlayerData.get(player)
	local drop = { name = item.name, icon = item.icon, rarity = item.rarity, outcome = outcome }
	if outcome == "gold" and data then
		drop.gold = Config.DUPLICATE_GOLD[item.rarity]
		data.gold += drop.gold
	end
	return drop
end

local function dropText(drop)
	if drop.outcome == "new" then
		return string.format("🎁 New gear: %s %s (%s)", drop.icon, drop.name, drop.rarity)
	elseif drop.outcome == "copy" then
		return string.format("🎁 Spare %s %s - use it to upgrade at Tom's", drop.icon, drop.name)
	end
	return string.format("🎁 %s %s (maxed) - +%s gold", drop.icon, drop.name, drop.gold or 0)
end

-- A treasure chest gives every crew member a gear roll: a Vice Admiral's follows the
-- difficulty, an elite Marine's is one step lower.
Enemies.onChest = function(runKey, kind, opener)
	local run = runs[runKey]
	if not run then
		return
	end
	local tier = kind == "MiniBoss" and run.difficulty or math.max(1, run.difficulty - 1)
	for player in run.players do
		local drop = giveItem(player, rollItem(tier))
		local who = player == opener and "" or opener.DisplayName .. " opened a chest!  "
		remotes.Announce:FireClient(player, who .. dropText(drop), Config.RARITIES[drop.rarity])
	end
end

-- What a first clear of this map + difficulty opens up.
local function unlockMessage(map, difficulty)
	local unlocked = {}
	if Config.Difficulties[difficulty + 1] then
		table.insert(unlocked, map.name .. " " .. Config.Difficulties[difficulty + 1].name)
	end
	if difficulty == 1 and Config.Maps[map.index + 1] then
		table.insert(unlocked, Config.Maps[map.index + 1].name)
	end
	return #unlocked > 0 and "Unlocked: " .. table.concat(unlocked, " and ") or nil
end

-- Gold, unlocks and drops for one player at the end of their adventure (or when they leave).
local function reward(player, run, result)
	local s, data = Progression.get(player), PlayerData.get(player)
	if not s or not data then
		return
	end
	local map, diff = run.map, run.diff
	local elapsed = os.clock() - run.start
	local gold = s.kills + math.floor(elapsed / 10) + s.bonusGold + (result == "Victory" and 500 or 0)
	gold = math.floor(gold * map.gold * diff.gold * (1 + Progression.bonus(s, "gold")) * Monetization.goldMultiplier(player))
	local unlocked, drop
	if result == "Victory" then
		if PlayerData.recordClear(player, map.key, run.difficulty) then
			unlocked = unlockMessage(map, run.difficulty)
		end
		if math.random() < Config.DROPS[run.difficulty].chance then
			drop = dropText(giveItem(player, rollItem(run.difficulty)))
		end
	end
	data.gold += gold
	task.spawn(PlayerData.save, player)
	remotes.Results:FireClient(player, {
		result = result, adventure = map.name .. "  -  " .. diff.name, color = diff.color,
		gold = gold, kills = s.kills, level = s.level, time = math.floor(elapsed), unlocked = unlocked, drop = drop,
	})
end

-- Takes a player out of their run and back to the island.
local function sendHome(player)
	runOf[player] = nil
	Weapons.cleanup(player)
	Progression.stop(player)
	if player.Parent then
		player:LoadCharacter() -- back to the spawn island with default stats
		sendMeta(player)
		sendLobby(player)
	end
end

-- Running an adventure --------------------------------------------------------------------

-- Crew members who have landed in the arena (enemies only spawn around them).
local function landedTargets(run, targets)
	local landed = {}
	for _, t in targets do
		local offset = t.root.Position - run.map.center
		if math.abs(offset.X) <= Config.ARENA_HALF_SIZE and math.abs(offset.Z) <= Config.ARENA_HALF_SIZE then
			table.insert(landed, t)
		end
	end
	return landed
end

local function spawnAround(kind, run, targets, hpScale, dmgScale, look)
	local landed = landedTargets(run, targets)
	if #landed == 0 then
		return nil
	end
	local p = landed[math.random(#landed)].root.Position
	for _ = 1, 6 do
		local a = math.random() * 2 * math.pi
		local d = Config.SPAWN_MIN + math.random() * (Config.SPAWN_MAX - Config.SPAWN_MIN)
		local e = Enemies.spawn(kind, p.X + math.cos(a) * d, p.Z + math.sin(a) * d, hpScale, dmgScale, run.key, look)
		if e then
			return e
		end
	end
	-- the player is near the edge of the map: spawn close instead
	return Enemies.spawn(kind, p.X, p.Z + 15, hpScale, dmgScale, run.key, look)
end

-- Weighted pick from Config.SPAWN_TABLE: later maps and later minutes bring tougher Marines.
local function pickKind(minutes, mapIndex)
	local options, total = {}, 0
	for _, row in Config.SPAWN_TABLE do
		if mapIndex >= row[2] and minutes >= row[3] then
			table.insert(options, row)
			total += row[4]
		end
	end
	local roll = math.random() * total
	for _, row in options do
		roll -= row[4]
		if roll <= 0 then
			return row[1]
		end
	end
	return "Grunt"
end

-- Waves ----------------------------------------------------------------------------------------

-- This wave's event: one the map and wave number allow, picked by weight.
local function pickEvent(wave, mapIndex)
	local options, total = {}, 0
	for _, ev in Config.WAVE_EVENTS do
		if wave >= ev.fromWave and mapIndex >= ev.fromMap then
			table.insert(options, ev)
			total += ev.weight
		end
	end
	local roll = math.random() * total
	for _, ev in options do
		roll -= ev.weight
		if roll <= 0 then
			return ev
		end
	end
	return options[1]
end

-- A wave event's squad arrives around one crew member: a pack charging from one side, a ring
-- closing in from all around, or a firing line.
local function spawnSquad(ev, run, wave, crew, hpScale, dmgScale, minutes)
	local landed = landedTargets(run, runTargets(run))
	if #landed == 0 then
		return
	end
	local center = landed[math.random(#landed)].root.Position
	local count = math.floor(ev.count * (1 + (wave - 1) * 0.08) * crew + 0.5)
	count = math.min(count, Config.MAX_ENEMIES + 30 - Enemies.count(run.key))
	local a = math.random() * math.pi * 2
	local edge = Config.ARENA_HALF_SIZE - 10
	for i = 1, count do
		local x, z
		if ev.shape == "ring" then
			local angle = a + i / count * math.pi * 2
			x, z = center.X + math.cos(angle) * 42, center.Z + math.sin(angle) * 42
		elseif ev.shape == "line" then
			local side = (i - (count + 1) / 2) * 7
			local dx, dz = math.cos(a), math.sin(a)
			x, z = center.X + dx * 50 - dz * side, center.Z + dz * 50 + dx * side
		else
			local d = 58 + math.random() * 10
			x = center.X + math.cos(a) * d + math.random(-8, 8)
			z = center.Z + math.sin(a) * d + math.random(-8, 8)
		end
		x = math.clamp(x, run.map.center.X - edge, run.map.center.X + edge)
		z = math.clamp(z, run.map.center.Z - edge, run.map.center.Z + edge)
		Enemies.spawn(ev.kind or pickKind(minutes, run.map.index), x, z, hpScale, dmgScale, run.key)
	end
end

local function sendWave(run, info)
	for player in run.players do
		remotes.Wave:FireClient(player, info)
	end
end

-- Starts wave `wave` of `total`: shows the banner, then the event squad (and every few waves a
-- Vice Admiral) lands a moment later.
local function startWave(run, wave, total, crew, hpScale, dmgScale, minutes)
	local event = wave > 1 and pickEvent(wave, run.map.index) or nil
	local mini = wave % Config.MINIBOSS_WAVE == 0
	local info = { n = wave, total = total, title = "THE MARINES ARE COMING", sub = "Survive and grow stronger", color = Color3.fromRGB(120, 200, 255) }
	if event then
		info.title, info.sub, info.color = event.title, event.sub, event.color
	end
	if mini then
		info.title = "VICE ADMIRAL" .. (event and "  +  " .. event.title or "")
		info.sub = "A Vice Admiral leads this wave!"
		info.color = Color3.fromRGB(190, 90, 255)
	end
	sendWave(run, info)
	task.delay(1.5, function()
		if run.ending or runs[run.key] ~= run then
			return
		end
		if event then
			spawnSquad(event, run, wave, crew, hpScale, dmgScale, minutes)
		end
		if mini then
			spawnAround("MiniBoss", run, runTargets(run), hpScale, dmgScale)
		end
	end)
end

-- Once a second: Regeneration heals its owner, and healers (Chopper) heal everyone nearby.
local function healers(targets)
	for _, t in targets do
		local regen = Progression.bonus(t.s, "regen")
		if regen > 0 then
			t.hum.Health = math.min(t.hum.MaxHealth, t.hum.Health + regen)
		end
	end
	for _, healer in targets do
		local amount = Progression.bonus(healer.s, "heal")
		if amount > 0 then
			for _, t in targets do
				if (t.root.Position - healer.root.Position).Magnitude <= 30 then
					t.hum.Health = math.min(t.hum.MaxHealth, t.hum.Health + amount)
				end
			end
		end
	end
end

local function clock(seconds)
	seconds = math.max(0, math.ceil(seconds))
	return string.format("%d:%02d", seconds // 60, seconds % 60)
end

local function playRun(run)
	local map, diff = run.map, run.diff
	local waves = math.max(1, math.floor(diff.runLength / Config.WAVE_LENGTH))
	local wave = 0
	local lastTick = 0
	local boss, bossAt, enraged
	task.wait(1) -- let the crew land
	while true do
		local elapsed = os.clock() - run.start
		local minutes = elapsed / 60
		local targets = runTargets(run)
		if #targets == 0 then
			return "Defeat"
		end

		local crew = 1 + 0.3 * (#targets - 1)
		local hpScale = (1 + minutes * 0.4) * crew * map.hp * diff.hp
		local dmgScale = (1 + minutes * 0.15) * map.damage * diff.damage
		local desired = math.min(Config.MAX_ENEMIES, math.floor((15 + minutes * 12) * crew))
		for _ = 1, math.min(4, desired - Enemies.count(run.key)) do
			spawnAround(pickKind(minutes, map.index), run, targets, hpScale, dmgScale)
		end
		local due = math.min(waves, math.floor(elapsed / Config.WAVE_LENGTH) + 1)
		if due > wave and elapsed < diff.runLength then
			wave = due
			startWave(run, wave, waves, crew, hpScale, dmgScale, minutes)
		end
		if elapsed >= diff.runLength then
			if not boss then
				local look = { name = map.boss, color = map.bossColor, accent = map.bossAccent }
				boss = spawnAround("Boss", run, targets, crew * map.hp * diff.hp, map.damage * diff.damage, look)
				if boss then
					bossAt = elapsed
					sendWave(run, {
						n = "FINAL", total = waves, title = map.boss:upper(), boss = true,
						sub = string.format("Defeat them within %d:%02d!", Config.BOSS_TIME_LIMIT // 60, Config.BOSS_TIME_LIMIT % 60),
						color = Color3.fromRGB(255, 60, 60),
					})
				end
			elseif boss.dead then
				return "Victory"
			elseif elapsed - bossAt >= Config.BOSS_TIME_LIMIT then
				announce(run, "Time's up! The Marines hold the line.", Color3.fromRGB(255, 60, 60))
				return "Defeat"
			elseif not enraged and elapsed - bossAt >= Config.BOSS_ENRAGE_AT then
				enraged = true
				boss.damage *= 1.75
				announce(run, map.boss .. " is ENRAGED!", Color3.fromRGB(255, 40, 40))
			end
		end

		if os.clock() - lastTick >= 1 then
			lastTick = os.clock()
			healers(targets)
			local text = not boss and clock(diff.runLength - elapsed)
				or "BOSS  " .. clock(Config.BOSS_TIME_LIMIT - (elapsed - bossAt))
			local crewIds = {}
			for player in run.players do
				table.insert(crewIds, player.UserId)
			end
			for player in run.players do
				local s = Progression.get(player)
				remotes.State:FireClient(player, {
					phase = "Run", text = text, adventure = map.name .. "  -  " .. diff.name, color = diff.color,
					down = s ~= nil and s.dead, boss = boss ~= nil, crew = crewIds,
					wave = wave, waves = waves, waveLeft = not boss and math.max(0, wave * Config.WAVE_LENGTH - elapsed) or nil,
				})
				Progression.sync(player)
			end
		end
		task.wait(0.25)
	end
end

local function finishRun(run, result)
	run.ending = true
	for player in run.players do
		reward(player, run, result)
		remotes.State:FireClient(player, { phase = "Results", text = result == "Victory" and "VICTORY!" or "DEFEATED" })
		Weapons.cleanup(player)
		Progression.stop(player)
	end
	Enemies.clear(run.key)
	task.wait(Config.RESULTS_TIME)
	for player in run.players do
		sendHome(player)
	end
	runs[run.key] = nil
end

local function startRun(map, difficulty, crew)
	local diff = Config.Difficulties[difficulty]
	local run = { key = map.key, map = map, diff = diff, difficulty = difficulty, players = {}, start = os.clock() }
	runs[map.key] = run
	for _, player in crew do
		local data = PlayerData.get(player)
		if player.Parent and data and not runOf[player] then
			run.players[player] = true
			runOf[player] = run
			local extra = PlayerData.gearBonus(player)
			for stat, value in Monetization.bonus(player) do
				extra[stat] = (extra[stat] or 0) + value
			end
			Progression.start(player, classOf(player), data, extra)
			Progression.applyStats(player)
			Progression.sync(player)
			remotes.State:FireClient(player, {
				phase = "Run", text = "Set sail!", adventure = map.name .. "  -  " .. diff.name, color = diff.color,
			})
			task.spawn(sendToArena, player, map.center)
		end
	end
	finishRun(run, playRun(run))
end

-- Revives a knocked-out player in their run using one revive (from the store).
local function revive(player)
	local run, s, data = runOf[player], Progression.get(player), PlayerData.get(player)
	if not (run and not run.ending and s and s.dead and data and data.revives > 0) then
		return false
	end
	data.revives -= 1
	s.dead = false
	s.invulnerableUntil = os.clock() + 3
	player:LoadCharacter()
	task.spawn(sendToArena, player, run.map.center)
	announce(run, player.DisplayName .. " is back in the fight!", Config.RARITIES.Legendary)
	task.spawn(PlayerData.save, player)
	sendMeta(player)
	return true
end

-- Player requests -------------------------------------------------------------------------

remotes.Choose.OnServerEvent:Connect(function(player, index)
	if typeof(index) == "number" then
		Progression.choose(player, index)
	end
end)
remotes.Reroll.OnServerEvent:Connect(Progression.reroll)
remotes.Meta.OnServerEvent:Connect(sendMeta)
local function selectClass(player, name)
	selectedClass[player] = name
	Gear.apply(player.Character, name)
	sendMeta(player)
end
remotes.SelectClass.OnServerEvent:Connect(function(player, name)
	if not runOf[player] and typeof(name) == "string" and PlayerData.hasClass(player, name) then
		selectClass(player, name)
	end
end)
-- Pirates are bought with gold; buying one also picks it.
remotes.UnlockClass.OnServerEvent:Connect(function(player, name)
	if not runOf[player] and typeof(name) == "string" and PlayerData.unlockClass(player, name) then
		task.spawn(PlayerData.save, player)
		selectClass(player, name)
	end
end)
remotes.BuyMeta.OnServerEvent:Connect(function(player, name)
	if not runOf[player] and typeof(name) == "string" and PlayerData.buy(player, name) then
		sendMeta(player)
	end
end)
remotes.Train.OnServerEvent:Connect(function(player, kind, name)
	if not runOf[player] and typeof(kind) == "string" and typeof(name) == "string" and PlayerData.train(player, kind, name) then
		sendMeta(player)
	end
end)
remotes.Gear.OnServerEvent:Connect(function(player, action, id)
	if runOf[player] or typeof(action) ~= "string" or typeof(id) ~= "string" then
		return
	end
	local changed = action == "buy" and PlayerData.buyGear(player, id)
		or action == "equip" and PlayerData.equipGear(player, id)
		or action == "upgrade" and PlayerData.upgradeGear(player, id)
	if changed then
		sendMeta(player)
	end
end)
-- The captain of a gate picks where the crew sails.
remotes.Voyage.OnServerEvent:Connect(function(player, mapKey, difficulty)
	if typeof(mapKey) ~= "string" or typeof(difficulty) ~= "number" then
		return
	end
	for _, gate in gates do
		if gate.captain == player then
			if PlayerData.unlocked(player, mapKey, difficulty) and not runs[mapKey] then
				gate.map, gate.difficulty, gate.launchAt = mapKey, difficulty, nil
			end
			return
		end
	end
end)
-- The client moves the character; the server grants the dash's moment of safety and shows it.
remotes.Dash.OnServerEvent:Connect(function(player)
	local now = os.clock()
	if now - (lastDash[player] or 0) < Monetization.dashCooldown(player) * 0.9 then
		return
	end
	lastDash[player] = now
	local s = Progression.get(player)
	if s and not s.dead then
		s.invulnerableUntil = math.max(s.invulnerableUntil, now + Config.DASH.invulnerable)
	end
	Fx.emit("dash", { p = player })
end)
-- Leaving keeps the gold earned so far (no victory bonus).
remotes.Leave.OnServerEvent:Connect(function(player)
	local run = runOf[player]
	if run and not run.ending then
		reward(player, run, "Defeat")
		run.players[player] = nil
		sendHome(player)
	end
end)
remotes.Revive.OnServerEvent:Connect(revive)

Monetization.onChanged = function(player)
	sendMeta(player)
	if Monetization.owns(player, "VIP") and player.Character then
		task.spawn(addVipTag, player.Character)
	end
end
Monetization.onRevive = revive

-- Voyage gates ----------------------------------------------------------------------------

-- The first player on a pad is captain; when the countdown ends, the crew sails.
local function updateGate(index, gate)
	local aboard = {}
	for _, player in Portals.playersInside(index) do
		if not runOf[player] then
			table.insert(aboard, player)
		end
	end
	if not table.find(aboard, gate.captain) then
		-- the captain stepped off: the next player in line takes over and picks again
		gate.captain, gate.map, gate.difficulty, gate.launchAt = aboard[1], nil, nil, nil
	end
	if gate.map and runs[gate.map] then
		gate.map, gate.difficulty, gate.launchAt = nil, nil, nil -- another crew got there first
	end
	local map = gate.map and Config.MapByKey[gate.map]
	local diff = gate.difficulty and Config.Difficulties[gate.difficulty]

	local status
	if not gate.captain then
		status = "Step in to choose an adventure"
	elseif not map then
		status = gate.captain.DisplayName .. " is choosing an adventure..."
	else
		gate.launchAt = gate.launchAt or os.clock() + Config.PORTAL_COUNTDOWN
		local left = math.ceil(gate.launchAt - os.clock())
		if left <= 0 then
			status = "Setting sail!"
			local difficulty = gate.difficulty
			gate.captain, gate.map, gate.difficulty, gate.launchAt = nil, nil, nil, nil
			task.spawn(startRun, map, difficulty, aboard)
		else
			status = string.format("%s - %s  |  %d aboard  |  sailing in %d", map.name, diff.name, #aboard, left)
		end
	end
	Portals.setStatus(index, status)
	local busy = {}
	for key in runs do
		busy[key] = true
	end
	for _, player in aboard do
		remotes.Portal:FireClient(player, {
			gate = index, color = Config.GATE_COLORS[index], text = status,
			captain = player == gate.captain, captainName = gate.captain and gate.captain.DisplayName,
			map = gate.map, difficulty = gate.difficulty, busy = busy,
		})
	end
end

while true do
	for index, gate in gates do
		updateGate(index, gate)
	end
	task.wait(0.25)
end
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX13481"><Properties><string name="Name">Monetization</string><ProtectedString name="Source"><![CDATA[-- Robux purchases: game passes (permanent perks) and developer products (gold, timed boosts,
-- revives). Paste your IDs into Config.GAME_PASSES / Config.PRODUCTS after creating them on the
-- Creator Dashboard; anything left at id = 0 shows as "not set up" and can't be bought.
-- Products are only granted once their purchase is saved, and each purchase is granted once.
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")

local Config = require(RS.Shared.Config)
local PlayerData = require(script.Parent.PlayerData)

local Monetization = {}
Monetization.onChanged = function(_player) end -- refresh the player's menus and perks
Monetization.onRevive = function(_player) end -- a revive was bought: use it now if knocked out

local owned = {} -- [player] = { [passKey] = true }
local productById = {}
for _, product in Config.PRODUCTS do
	if product.id > 0 then
		productById[product.id] = product
	end
end

function Monetization.owns(player, passKey)
	return owned[player] ~= nil and owned[player][passKey] == true
end

function Monetization.ownedList(player)
	local list = {}
	for passKey in owned[player] or {} do
		table.insert(list, passKey)
	end
	return list
end

function Monetization.load(player)
	owned[player] = {}
	for passKey, pass in Config.GAME_PASSES do
		if pass.id > 0 then
			local ok, has = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, player.UserId, pass.id)
			if ok and has then
				owned[player][passKey] = true
			end
		end
	end
end

function Monetization.release(player)
	owned[player] = nil
end

-- Stat bonuses from passes and active boosts (see Progression.bonus).
function Monetization.bonus(player)
	local bonus = {}
	for passKey in owned[player] or {} do
		for stat, value in Config.GAME_PASSES[passKey].bonus or {} do
			bonus[stat] = (bonus[stat] or 0) + value
		end
	end
	if PlayerData.boostActive(player, "xp") then
		bonus.xp = (bonus.xp or 0) + 1
	end
	return bonus
end

-- Gold multiplier: 2x Gold pass and 2x Gold boost each add another 100%.
function Monetization.goldMultiplier(player)
	return 1 + (Monetization.owns(player, "DoubleGold") and 1 or 0) + (PlayerData.boostActive(player, "gold") and 1 or 0)
end

function Monetization.dashCooldown(player)
	return Config.DASH.cooldown * (Monetization.owns(player, "SwiftDash") and Config.SWIFT_DASH or 1)
end

MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
	if not purchased then
		return
	end
	for passKey, pass in Config.GAME_PASSES do
		if pass.id == passId then
			owned[player] = owned[player] or {}
			owned[player][passKey] = true
		end
	end
	Monetization.onChanged(player)
end)

MarketplaceService.ProcessReceipt = function(receipt)
	local product = productById[receipt.ProductId]
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	local data = player and PlayerData.get(player)
	if not product or not data or data.loadFailed then
		return Enum.ProductPurchaseDecision.NotProcessedYet -- Roblox retries later
	end
	if data.receipts[receipt.PurchaseId] then
		return Enum.ProductPurchaseDecision.PurchaseGranted -- already delivered
	end

	local before = { gold = data.gold, revives = data.revives, xp = data.boosts.xp, goldBoost = data.boosts.gold }
	if product.gold then
		data.gold += product.gold
	end
	if product.boost then
		data.boosts[product.boost] = math.max(data.boosts[product.boost] or 0, os.time()) + product.minutes * 60
	end
	if product.revive then
		data.revives += 1
	end
	data.receipts[receipt.PurchaseId] = os.time()

	if not PlayerData.save(player) then
		-- couldn't save it: undo and let Roblox deliver it again later
		data.gold, data.revives, data.boosts.xp, data.boosts.gold = before.gold, before.revives, before.xp, before.goldBoost
		data.receipts[receipt.PurchaseId] = nil
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if product.revive then
		Monetization.onRevive(player)
	end
	Monetization.onChanged(player)
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

return Monetization
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX13482"><Properties><string name="Name">Npcs</string><ProtectedString name="Source"><![CDATA[-- Island NPCs: trainers, the gear smith, the upgrades bar and the store. Each one is a real R15
-- character in their own outfit, standing at their own stall (training dummies, a clinic, a
-- shipyard forge, a bar, a circus tent). Clients animate them (client/Rigs.lua). Each has a
-- prompt ("E" on keyboard, tap on phones) that opens its menu on the client.
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")

local Config = require(RS.Shared.Config)

local Npcs = {}

local SKIN = Color3.fromRGB(255, 205, 160)
local UPRIGHT = CFrame.Angles(0, 0, math.pi / 2) -- a cylinder standing upright
local FORWARD = CFrame.Angles(0, math.pi / 2, 0) -- a cylinder pointing forward
local CYL, BALL, WEDGE = Enum.PartType.Cylinder, Enum.PartType.Ball, Enum.PartType.Wedge
local WOOD, PLANKS, METAL, NEON, FABRIC, SLATE, GLASS =
	Enum.Material.Wood, Enum.Material.WoodPlanks, Enum.Material.Metal, Enum.Material.Neon, Enum.Material.Fabric, Enum.Material.Slate, Enum.Material.Glass

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local function makePart(props, parent)
	local p = Instance.new("Part")
	p.Anchored, p.CanTouch, p.CastShadow = true, false, true
	p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
	for k, v in props do
		p[k] = v
	end
	p.Parent = parent
	return p
end

local function groundY(pos)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local exclude = {}
	for _, p in Players:GetPlayers() do
		if p.Character then
			table.insert(exclude, p.Character)
		end
	end
	params.FilterDescendantsInstances = exclude
	local hit = workspace:Raycast(pos + Vector3.new(0, 100, 0), Vector3.new(0, -200, 0), params)
	return hit and hit.Position.Y or pos.Y
end

local function label(parent, props)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.TextScaled = true
	l.Font = Enum.Font.LuckiestGuy
	l.TextColor3 = Color3.new(1, 1, 1)
	l.TextStrokeTransparency = 0.2
	for k, v in props do
		l[k] = v
	end
	l.Parent = parent
	return l
end

-- Outfits ---------------------------------------------------------------------------------
-- colors: body part colors. pieces: { body part, size, offset, color, shape?, material? },
-- measured on a default R15 body (head 1.2 tall, upper torso 1.6 tall); they follow the
-- actual part sizes. The head faces -Z; its top is at +0.6.

local NOMINAL_HEIGHT = {
	Head = 1.2, UpperTorso = 1.6, LowerTorso = 0.4, RightHand = 0.3, LeftHand = 0.3,
	RightUpperArm = 1.17, LeftUpperArm = 1.17, RightLowerArm = 1.05, LeftLowerArm = 1.05,
}

local function bodyColors(skin, shirt, sleeves, forearms, belt, pants, shoes, hands)
	return {
		Head = skin, UpperTorso = shirt, LowerTorso = belt,
		LeftUpperArm = sleeves, RightUpperArm = sleeves, LeftLowerArm = forearms, RightLowerArm = forearms,
		LeftHand = hands or skin, RightHand = hands or skin,
		LeftUpperLeg = pants, RightUpperLeg = pants, LeftLowerLeg = pants, RightLowerLeg = pants,
		LeftFoot = shoes, RightFoot = shoes,
	}
end

local function lens(x, color)
	return { "Head", Vector3.new(0.06, 0.34, 0.34), CFrame.new(x, 0.08, -0.63) * FORWARD, color, CYL, GLASS }
end


	},
	Franky = {
		{ "Head", Vector3.new(1.0, 0.55, 1.5), CFrame.new(0, 0.75, -0.25), rgb(60, 150, 240) },
		{ "Head", Vector3.new(1.15, 0.25, 0.08), CFrame.new(0, 0.15, -0.62), BLACK },

	{ id = "JinbeKimono", slot = "outfit", name = "Jinbe's Kimono", icon = "👘", rarity = "Epic", cost = 25000, bonus = { health = 60, defense = 0.08 } },
	{ id = "SeastoneArmor", slot = "outfit", name = "Seastone Armor", icon = "🛡️", rarity = "Legendary", cost = 90000, bonus = { health = 100, defense = 0.12 } },
	{ id = "EmperorCloak", slot = "outfit", name = "Emperor's Cloak", icon = "👑", rarity = "Mythic", cost = 0, bonus = { health = 150, defense = 0.15, regen = 2 } },
	{ id = "LuckyCoin", slot = "charm", name = "Lucky Coin", icon = "🪙", rarity = "Common", cost = 1500, bonus = { gold = 0.10 } },
	{ id = "LogPose", slot = "charm", name = "Log Pose", icon = "🧭", rarity = "Rare", cost = 7500, bonus = { magnet = 0.30, xp = 0.10 } },
	{ id = "DenDenMushi", slot = "charm", name = "Den Den Mushi", icon = "🐌", rarity = "Epic", cost = 25000, bonus = { cooldown = 0.08, area = 0.08 } },
	{ id = "EternalPose", slot = "charm", name = "Eternal Pose", icon = "📍", rarity = "Epic", cost = 25000, bonus = { xp = 0.20, cooldown = 0.05 } },
	{ id = "TreasureMap", slot = "charm", name = "Treasure Map", icon = "🗺️", rarity = "Legendary", cost = 90000, bonus = { gold = 0.30, magnet = 0.40 } },
	{ id = "DevilFruit", slot = "charm", name = "Devil Fruit", icon = "🍇", rarity = "Mythic", cost = 0, bonus = { damage = 0.15, cooldown = 0.10, xp = 0.25 } },
}
Config.GearById = {}
for _, item in Config.GEAR_ITEMS do
	Config.GearById[item.id] = item
end

-- Free gear drops on victory: chance per difficulty and how rare the drop tends to be.
-- Owning the item already turns the drop into gold.
Config.DROPS = {
	{ chance = 0.3, weights = { Common = 70, Rare = 25, Epic = 5 } },
	{ chance = 0.35, weights = { Common = 45, Rare = 40, Epic = 14, Legendary = 1 } },
	{ chance = 0.4, weights = { Common = 25, Rare = 45, Epic = 25, Legendary = 5 } },
	{ chance = 0.5, weights = { Rare = 40, Epic = 40, Legendary = 17, Mythic = 3 } },
	{ chance = 0.6, weights = { Epic = 50, Legendary = 38, Mythic = 12 } },
}
-- Getting gear you already own gives a spare copy, used to upgrade it (gold once you have
-- enough copies to reach +10).
Config.DUPLICATE_GOLD = { Common = 500, Rare = 2000, Epic = 6000, Legendary = 15000, Mythic = 30000 }

-- Gear upgrades at Tom's: each level costs one duplicate copy of the item plus gold, and adds
-- 10% of the item's base stats (+10 doubles them).
Config.GEAR_UPGRADE = {
	max = 10, per = 0.10, growth = 1.55,
	cost = { Common = 400, Rare = 1200, Epic = 3500, Legendary = 9000, Mythic = 20000 },
}
function Config.gearUpgradeCost(item, level)
	return math.floor(Config.GEAR_UPGRADE.cost[item.rarity] * Config.GEAR_UPGRADE.growth ^ level)
end
-- An item's stats at an upgrade level.
function Config.gearStats(item, level)
	local scale = 1 + Config.GEAR_UPGRADE.per * (level or 0)
	local stats = {}
	for stat, value in item.bonus do
		stats[stat] = stat == "health" and math.floor(value * scale) or value * scale
	end
	return stats
end

-- Treasure chests dropped during adventures: chance per enemy kind. Opening one gives every
-- crew member a gear roll (rarity follows the difficulty, see Config.DROPS).
Config.CHESTS = { MiniBoss = 1, Captain = 0.04, Agent = 0.04, Brute = 0.03 }

-- How each stat reads in menus, e.g. "+10% damage".
local STAT_TEXT = {
	damage = "+%d%% damage", cooldown = "-%d%% cooldowns", area = "+%d%% area", speed = "+%d%% speed",
	magnet = "+%d%% pickup range", gold = "+%d%% gold", crit = "+%d%% crit chance", critDamage = "+%d%% crit damage",
	defense = "-%d%% damage taken", xp = "+%d%% XP",
}
function Config.describeBonus(bonus)
	local parts = {}
	for _, stat in { "damage", "crit", "critDamage", "cooldown", "area", "health", "defense", "regen", "speed", "magnet", "xp", "gold" } do
		local value = bonus[stat]
		if value then
			if stat == "health" then
				table.insert(parts, "+" .. value .. " max HP")
			elseif stat == "regen" then
				table.insert(parts, "+" .. value .. " HP/s")
			else
				table.insert(parts, string.format(STAT_TEXT[stat], math.floor(value * 100 + 0.5)))
			end
		end
	end
	return table.concat(parts, ", ")
end

-- Robux purchases. Create these on the Roblox Creator Dashboard (your experience > Monetization)
-- and paste their IDs here. Anything left at id = 0 shows as "not set up" and can't be bought.
-- Prices are set on the dashboard. Suggested: 2x Gold 299, VIP 399, Lucky Pirate 149,
-- Swift Dash 99; gold packs 49 / 199 / 649; boosts 79 each; Revive 25.
Config.GAME_PASSES = {
	DoubleGold = { id = 0, icon = "💰", name = "2x Gold", desc = "Double gold from every adventure, forever." },
	VIP = { id = 0, icon = "👑", name = "VIP", desc = "+25% XP, +10% damage and a VIP tag.", bonus = { xp = 0.25, damage = 0.10 } },
	LuckyPirate = { id = 0, icon = "🎲", name = "Lucky Pirate", desc = "+2 rerolls in every run.", bonus = { reroll = 2 } },
	SwiftDash = { id = 0, icon = "💨", name = "Swift Dash", desc = "Dash 40% more often." },
}
Config.PASS_ORDER = { "DoubleGold", "VIP", "LuckyPirate", "SwiftDash" }
Config.SWIFT_DASH = 0.6 -- dash cooldown multiplier with Swift Dash
Config.PRODUCTS = {
	Gold5k = { id = 0, icon = "💰", name = "5,000 Gold", desc = "A pouch of gold.", gold = 5000 },
	Gold25k = { id = 0, icon = "💰", name = "25,000 Gold", desc = "A chest of gold.", gold = 25000 },
	Gold100k = { id = 0, icon = "💎", name = "100,000 Gold", desc = "A pirate king's treasure.", gold = 100000 },
	XPBoost = { id = 0, icon = "⚡", name = "2x XP Boost", desc = "Double XP for 30 minutes.", boost = "xp", minutes = 30 },
	GoldBoost = { id = 0, icon = "🪙", name = "2x Gold Boost", desc = "Double gold for 30 minutes.", boost = "gold", minutes = 30 },
	Revive = { id = 0, icon = "💖", name = "Revive", desc = "Get back up with full HP when knocked out.", revive = true },
}
Config.PRODUCT_ORDER = { "Gold5k", "Gold25k", "Gold100k", "XPBoost", "GoldBoost", "Revive" }

return Config
]]></ProtectedString></Properties></Item></Item></Item><Item class="ServerScriptService" referent="RBX13488"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Folder" referent="RBX13487"><Properties><string name="Name">Server</string></Properties><Item class="ModuleScript" referent="RBX13477"><Properties><string name="Name">Enemies</string><ProtectedString name="Source"><![CDATA[-- Enemy spawning, bodies, movement, attacks and skills (rifle shots, telegraphed blasts, lasers,
-- snipes, heals, bombs, nets, Soru blinks, air blades, reinforcements), damage, XP orbs and chests.
-- Each enemy is an anchored torso moved by the server, with jointed limbs (Motor6Ds) that every
-- client animates on its own (client/Rigs.lua): cheap enough for big swarms.
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")

local Config = require(RS.Shared.Config)
local Fx = require(script.Parent.Fx)

local Enemies = {}
Enemies.onKilled = function(_enemy, _killer) end
Enemies.onPickup = function(_player, _xp) end
Enemies.onChest = function(_runKey, _kind, _opener) end -- a crew member opened a treasure chest
Enemies.onSlow = function(_player, _factor, _seconds) end -- a seastone net hit a player

local list, orbs, bullets, chests = {}, {}, {}, {}
local nextBulletId = 0
local lastTargets = {} -- targets from the latest step, used when delayed blasts land
local NO_TARGETS = {}
local BULLET_SPEED = 45
local BLAST_COLOR = Color3.fromRGB(255, 80, 40)
local LASER_COLOR = Color3.fromRGB(255, 230, 90)
local SNIPE_COLOR = Color3.fromRGB(255, 60, 60)
local PLAYER_RADIUS = 1.5

-- Hurts a player target, after their Iron Body defense. Dashing and picking level-up cards
-- make players briefly untouchable.
local function hurt(t, amount)
	if t.s and (t.s.invulnerableUntil or 0) > os.clock() then
		return
	end
	t.hum:TakeDamage(amount * (1 - (t.armor or 0)))
end

local folder = Instance.new("Folder")
folder.Name = "Enemies"
folder.Parent = workspace
local orbFolder = Instance.new("Folder")
orbFolder.Name = "XPOrbs"
orbFolder.Parent = workspace

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function flat(v)
	return Vector3.new(v.X, 0, v.Z)
end

local function groundY(x, z)
	local exclude = { folder, orbFolder }
	local fx = workspace:FindFirstChild("FX")
	if fx then
		table.insert(exclude, fx)
	end
	for _, p in Players:GetPlayers() do
		if p.Character then
			table.insert(exclude, p.Character)
		end
	end
	rayParams.FilterDescendantsInstances = exclude
	local hit = workspace:Raycast(Vector3.new(x, 200, z), Vector3.new(0, -400, 0), rayParams)
	return hit and hit.Position.Y
end

local function makePart(props, parent)
	local p = Instance.new("Part")
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, false, false, false
	p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
	for k, v in props do
		p[k] = v
	end
	p.Parent = parent
	return p
end

local function makeBar(part, scale, name)
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(220, 36)
	gui.StudsOffset = Vector3.new(0, 3.5 * scale, 0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 300
	gui.Adornee = part
	gui.Parent = part
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 0, 20)
	label.BackgroundTransparency = 1
	label.Text = name
	label.TextScaled = true
	label.Font = Enum.Font.LuckiestGuy
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0
	label.Parent = gui
	local back = Instance.new("Frame")
	back.Size = UDim2.new(1, 0, 0, 12)
	back.Position = UDim2.fromOffset(0, 22)
	back.BackgroundColor3 = Color3.fromRGB(30, 0, 0)
	back.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 6)
	corner.Parent = back
	local fill = Instance.new("Frame")
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = Color3.fromRGB(230, 40, 40)
	fill.BorderSizePixel = 0
	fill.Parent = back
	corner:Clone().Parent = fill
	return fill
end

local function dropOrb(pos, xp, runKey)
	-- merge into an existing orb of the same run when there are too many on the map
	if #orbs >= 250 then
		local o = orbs[math.random(#orbs)]
		if o.run == runKey then
			o.xp += xp
			return
		end
	end
	local big = xp >= 10
	local part = makePart({
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * (big and 1.6 or 0.9),
		Material = Enum.Material.Neon,
		Color = big and Color3.fromRGB(180, 80, 255) or Color3.fromRGB(70, 160, 255),
		Position = pos,
	}, orbFolder)
	table.insert(orbs, { part = part, xp = xp, run = runKey })
end

-- A glowing treasure chest; the first crew member to walk up opens it for the whole crew.
local function dropChest(pos, runKey, kind)
	local model = Instance.new("Model")
	model.Name = "TreasureChest"
	local gold = Color3.fromRGB(255, 200, 50)
	local base = makePart({ Name = "Base", Size = Vector3.new(3, 2, 2.2), Color = Color3.fromRGB(110, 70, 35), Material = Enum.Material.Wood, CFrame = CFrame.new(pos + Vector3.new(0, 1, 0)) }, model)
	makePart({ Name = "Lid", Size = Vector3.new(3.1, 0.8, 2.3), Color = Color3.fromRGB(130, 85, 40), Material = Enum.Material.Wood, CFrame = base.CFrame * CFrame.new(0, 1.4, 0) }, model)
	makePart({ Name = "Band", Size = Vector3.new(0.3, 2.9, 2.35), Color = gold, Material = Enum.Material.Metal, CFrame = base.CFrame * CFrame.new(0, 0.4, 0) }, model)
	local glow = makePart({ Name = "Glow", Shape = Enum.PartType.Ball, Size = Vector3.one * 5, Color = gold, Material = Enum.Material.ForceField, CFrame = base.CFrame * CFrame.new(0, 0.6, 0) }, model)
	local light = Instance.new("PointLight")
	light.Color, light.Range, light.Brightness = gold, 14, 2
	light.Parent = glow
	local tag = Instance.new("BillboardGui")
	tag.Size = UDim2.fromOffset(60, 60)
	tag.StudsOffset = Vector3.new(0, 4, 0)
	tag.AlwaysOnTop = true
	tag.MaxDistance = 250
	tag.Parent = base
	local icon = Instance.new("TextLabel")
	icon.Size = UDim2.fromScale(1, 1)
	icon.BackgroundTransparency = 1
	icon.TextScaled = true
	icon.Text = "🎁"
	icon.Parent = tag
	model.Parent = folder
	table.insert(chests, { model = model, pos = base.Position, run = runKey, kind = kind, born = os.clock() })
end

local function flash(e)
	if e.flashing then
		return
	end
	e.flashing = true
	e.root.Color = Color3.new(1, 1, 1)
	e.head.Color = Color3.new(1, 1, 1)
	task.delay(0.07, function()
		e.flashing = false
		if not e.dead then
			e.root.Color = e.color
			e.head.Color = e.skin
		end
	end)
end

-- Bodies ----------------------------------------------------------------------------------

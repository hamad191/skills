-- Enemies are anchored parts moved by the server: cheap enough for big swarms.
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")

local Config = require(RS.Shared.Config)
local Fx = require(script.Parent.Fx)

local Enemies = {}
Enemies.onKilled = function(_enemy, _killer) end
Enemies.onPickup = function(_player, _xp) end

local list, orbs, bullets = {}, {}, {}
local nextBulletId = 0
local lastTargets = {} -- targets from the latest step, used when delayed blasts land
local NO_TARGETS = {}
local BULLET_SPEED = 45
local BLAST_COLOR = Color3.fromRGB(255, 80, 40)

local folder = Instance.new("Folder")
folder.Name = "Enemies"
folder.Parent = workspace
local orbFolder = Instance.new("Folder")
orbFolder.Name = "XPOrbs"
orbFolder.Parent = workspace

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function flat(v)
	return Vector3.new(v.X, 0, v.Z)
end

local function groundY(x, z)
	local exclude = { folder, orbFolder }
	local fx = workspace:FindFirstChild("FX")
	if fx then
		table.insert(exclude, fx)
	end
	for _, p in Players:GetPlayers() do
		if p.Character then
			table.insert(exclude, p.Character)
		end
	end
	rayParams.FilterDescendantsInstances = exclude
	local hit = workspace:Raycast(Vector3.new(x, 200, z), Vector3.new(0, -400, 0), rayParams)
	return hit and hit.Position.Y
end

local function makePart(props, parent)
	local p = Instance.new("Part")
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, false, false, false
	for k, v in props do
		p[k] = v
	end
	p.Parent = parent
	return p
end

local function makeBar(part, scale, name)
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(220, 36)
	gui.StudsOffset = Vector3.new(0, 3.5 * scale, 0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 300
	gui.Adornee = part
	gui.Parent = part
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 0, 20)
	label.BackgroundTransparency = 1
	label.Text = name
	label.TextScaled = true
	label.Font = Enum.Font.GothamBlack
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0
	label.Parent = gui
	local back = Instance.new("Frame")
	back.Size = UDim2.new(1, 0, 0, 12)
	back.Position = UDim2.fromOffset(0, 22)
	back.BackgroundColor3 = Color3.fromRGB(30, 0, 0)
	back.Parent = gui
	local fill = Instance.new("Frame")
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = Color3.fromRGB(230, 40, 40)
	fill.BorderSizePixel = 0
	fill.Parent = back
	return fill
end

local function dropOrb(pos, xp, runKey)
	-- merge into an existing orb of the same run when there are too many on the map
	if #orbs >= 250 then
		local o = orbs[math.random(#orbs)]
		if o.run == runKey then
			o.xp += xp
			return
		end
	end
	local big = xp >= 10
	local part = makePart({
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * (big and 1.6 or 0.9),
		Material = Enum.Material.Neon,
		Color = big and Color3.fromRGB(180, 80, 255) or Color3.fromRGB(70, 160, 255),
		Position = pos,
	}, orbFolder)
	table.insert(orbs, { part = part, xp = xp, run = runKey })
end

local function flash(e)
	if e.flashing then
		return
	end
	e.flashing = true
	e.root.Color = Color3.new(1, 1, 1)
	e.head.Color = Color3.new(1, 1, 1)
	task.delay(0.07, function()
		e.flashing = false
		if not e.dead then
			e.root.Color = e.color
			e.head.Color = e.skin
		end
	end)
end

-- Body parts: name, size, offset from the torso, color key, shape (all scaled by def.scale)
local BODY = {
	{ "LeftLeg", Vector3.new(0.9, 1.6, 1), Vector3.new(-0.5, -1.8, 0), "accent" },
	{ "RightLeg", Vector3.new(0.9, 1.6, 1), Vector3.new(0.5, -1.8, 0), "accent" },
	{ "LeftArm", Vector3.new(0.8, 1.8, 0.8), Vector3.new(-1.45, -0.1, 0), "color" },
	{ "RightArm", Vector3.new(0.8, 1.8, 0.8), Vector3.new(1.45, -0.1, 0), "color" },
	{ "LeftHand", Vector3.new(0.7, 0.7, 0.7), Vector3.new(-1.45, -1.2, 0), "skin", Enum.PartType.Ball },
	{ "RightHand", Vector3.new(0.7, 0.7, 0.7), Vector3.new(1.45, -1.2, 0), "skin", Enum.PartType.Ball },
	{ "Head", Vector3.new(1.7, 1.7, 1.7), Vector3.new(0, 1.85, 0), "skin", Enum.PartType.Ball },
	{ "Cap", Vector3.new(1.8, 0.45, 1.8), Vector3.new(0, 2.65, 0), "accent" },
	{ "Brim", Vector3.new(1.2, 0.15, 0.6), Vector3.new(0, 2.45, -1), "accent" },
	{ "LeftEye", Vector3.new(0.32, 0.32, 0.32), Vector3.new(-0.35, 2, -0.75), "eyes", Enum.PartType.Ball },
	{ "RightEye", Vector3.new(0.32, 0.32, 0.32), Vector3.new(0.35, 2, -0.75), "eyes", Enum.PartType.Ball },
}
local LEG_DEPTH = 2.6 -- torso center to the soles of the feet

-- What enemies carry: same format as BODY, plus an optional rotation. Colors here are fixed.
local STEEL = Color3.fromRGB(210, 215, 225)
local GUNMETAL = Color3.fromRGB(45, 45, 50)
local GEAR = {
	sword = {
		{ "Blade", Vector3.new(0.12, 0.3, 3), Vector3.new(1.45, -1.25, -1.6), STEEL },
		{ "Guard", Vector3.new(0.6, 0.15, 0.15), Vector3.new(1.45, -1.25, -0.1), Color3.fromRGB(200, 170, 60) },
	},
	rifle = {
		{ "Rifle", Vector3.new(0.35, 0.45, 3.4), Vector3.new(0.9, -0.5, -1.4), GUNMETAL },
		{ "Stock", Vector3.new(0.4, 0.7, 0.9), Vector3.new(0.9, -0.6, 0.2), Color3.fromRGB(110, 70, 40) },
	},
	cannon = {
		{ "Cannon", Vector3.new(3.2, 1.1, 1.1), Vector3.new(1.2, 1.2, -0.4), GUNMETAL, Enum.PartType.Cylinder, CFrame.Angles(0, math.pi / 2, 0) },
	},
	coat = {
		{ "Coat", Vector3.new(2.4, 2.8, 0.2), Vector3.new(0, -0.5, 0.62), Color3.fromRGB(250, 250, 250) },
		{ "EpauletL", Vector3.new(0.9, 0.25, 1.1), Vector3.new(-1.3, 0.95, 0), Color3.fromRGB(230, 190, 60) },
		{ "EpauletR", Vector3.new(0.9, 0.25, 1.1), Vector3.new(1.3, 0.95, 0), Color3.fromRGB(230, 190, 60) },
	},
}

-- runKey: which adventure this enemy belongs to; it only chases that crew.
-- look (optional): { name, color, accent } to dress up a named boss.
function Enemies.spawn(kind, x, z, hpScale, dmgScale, runKey, look)
	local def = Config.Enemies[kind]
	local y = groundY(x, z)
	if not y then
		return nil
	end
	look = look or {}
	local colors = { color = look.color or def.color, accent = look.accent or def.accent, skin = def.skin, eyes = def.eyes }
	local name = look.name or def.name
	local s = def.scale
	local model = Instance.new("Model")
	model.Name = name
	local torso = makePart({ Name = "Torso", Size = Vector3.new(2, 2, 1) * s, Color = colors.color }, model)
	torso.CFrame = CFrame.new(x, y + LEG_DEPTH * s, z)
	local parts = { Torso = torso }
	local function attach(pieceName, size, offset, color, shape, rotation)
		local p = makePart({ Name = pieceName, Size = size * s, Color = color, Shape = shape or Enum.PartType.Block }, nil)
		p.Anchored, p.Massless = false, true
		p.CFrame = torso.CFrame * CFrame.new(offset * s) * (rotation or CFrame.identity)
		local weld = Instance.new("WeldConstraint")
		weld.Part0, weld.Part1 = torso, p
		weld.Parent = p
		p.Parent = model
		parts[pieceName] = p
		return p
	end
	for _, b in BODY do
		local p = attach(b[1], b[2], b[3], colors[b[4]] or Color3.fromRGB(20, 20, 20), b[5])
		if b[4] == "eyes" and def.eyes then
			p.Material = Enum.Material.Neon
		end
	end
	for _, g in GEAR[def.gear] or {} do
		attach(g[1], g[2], g[3], g[4], g[5], g[6])
	end
	model.PrimaryPart = torso
	model.Parent = folder

	local hp = def.hp * hpScale
	local now = os.clock()
	local e = {
		model = model, root = torso, head = parts.Head, def = def, kind = kind, run = runKey,
		color = colors.color, skin = colors.skin, name = name,
		hp = hp, maxHp = hp, damage = def.damage * dmgScale,
		radius = 1.2 * s, lastHit = 0, phase = math.random() * 10,
		nextAttack = now + math.random() * (def.fireRate or 1) + 1,
		nextSlam = now + (def.slamEvery or 0), nextRing = now + (def.ringEvery or 0),
	}
	if def.healthBar then
		e.bar = makeBar(torso, s, name)
	end
	table.insert(list, e)
	return e
end

-- A telegraphed blast: players see a red circle, then everyone still inside gets hit.
local function blast(e, pos, radius, damage, delay)
	Fx.emit("warn", { pos = pos, r = radius, t = delay })
	local runKey = e.run
	task.delay(delay, function()
		for _, t in lastTargets[runKey] or NO_TARGETS do
			if t.hum.Health > 0 and flat(t.root.Position - pos).Magnitude <= radius then
				t.hum:TakeDamage(damage)
			end
		end
		Fx.emit("slam", { pos = pos, r = radius, c = BLAST_COLOR })
	end)
end

-- A rifle bullet flying flat toward the target.
local function shoot(e, target)
	nextBulletId += 1
	local from = e.root.Position
	local dir = flat(target.root.Position - from)
	dir = dir.Magnitude > 0.1 and dir.Unit or Vector3.new(0, 0, -1)
	local range = e.def.range * 1.6
	table.insert(bullets, { id = nextBulletId, pos = from, dir = dir, left = range, damage = e.damage, run = e.run })
	Fx.emit("eshot", { id = nextBulletId, o = from, d = dir, speed = BULLET_SPEED, len = range })
end

-- Ranged and boss attacks. Melee hits happen in Enemies.step.
local function specialAttacks(e, target, dist, targets, now)
	local def = e.def
	if def.ai == "ranged" and dist <= def.range and now >= e.nextAttack then
		e.nextAttack = now + def.fireRate
		shoot(e, target)
	elseif def.ai == "artillery" and dist <= def.range and now >= e.nextAttack then
		e.nextAttack = now + def.fireRate
		blast(e, target.root.Position, def.blast, e.damage, 1.4)
	elseif def.ai == "boss" then
		if now >= e.nextSlam then
			e.nextSlam = now + def.slamEvery
			local victim = targets[math.random(#targets)]
			blast(e, victim.root.Position, def.blast, e.damage * 1.5, 1.2)
		end
		if def.ringEvery and now >= e.nextRing then
			e.nextRing = now + def.ringEvery
			for k = 1, 6 do
				local a = k * math.pi / 3
				blast(e, e.root.Position + Vector3.new(math.cos(a) * 14, 0, math.sin(a) * 14), 7, e.damage, 1.5)
			end
		end
	end
end

function Enemies.damage(e, amount, player)
	if e.dead then
		return
	end
	e.hp -= amount
	if e.bar then
		e.bar.Size = UDim2.fromScale(math.max(e.hp, 0) / e.maxHp, 1)
	end
	if e.hp > 0 then
		flash(e)
		return
	end
	e.dead = true
	if e.def.xp > 0 then
		dropOrb(e.root.Position - Vector3.new(0, LEG_DEPTH * e.def.scale - 0.8, 0), e.def.xp, e.run)
	end
	Fx.emit("death", { pos = e.root.Position, c = e.color, s = e.def.scale })
	Enemies.onKilled(e, player)
	e.model:Destroy()
end

-- targetsByRun: [runKey] = array of { player, root, hum, magnet }
function Enemies.step(dt, targetsByRun)
	local now = os.clock()
	lastTargets = targetsByRun
	for i = #list, 1, -1 do
		local e = list[i]
		if e.dead then
			table.remove(list, i)
			continue
		end
		local best, bestDist
		for _, t in targetsByRun[e.run] or NO_TARGETS do
			local d = flat(t.root.Position - e.root.Position).Magnitude
			if not bestDist or d < bestDist then
				best, bestDist = t, d
			end
		end
		if best then
			local pos = e.root.Position
			local to = flat(best.root.Position - pos)
			local reach = e.radius + 2
			-- shooters stop at a distance; everyone else walks right up
			local stopAt = (e.def.ai == "ranged" or e.def.ai == "artillery") and e.def.range * 0.8 or reach
			if bestDist > stopAt then
				local newPos = pos + to.Unit * math.min(e.def.speed * dt, bestDist - stopAt)
				-- waddle side to side while walking
				local sway = math.sin(now * 9 + e.phase) * 0.12
				e.root.CFrame = CFrame.lookAt(newPos, newPos + to) * CFrame.Angles(0, 0, sway)
			end
			if bestDist <= reach and now - e.lastHit >= 1 then
				e.lastHit = now
				best.hum:TakeDamage(e.damage)
			end
			specialAttacks(e, best, bestDist, targetsByRun[e.run], now)
		end
	end

	for i = #bullets, 1, -1 do
		local b = bullets[i]
		local move = BULLET_SPEED * dt
		b.pos += b.dir * move
		b.left -= move
		local hit
		for _, t in targetsByRun[b.run] or NO_TARGETS do
			if flat(t.root.Position - b.pos).Magnitude <= 2.2 then
				hit = t
				break
			end
		end
		if hit then
			hit.hum:TakeDamage(b.damage)
		end
		if hit or b.left <= 0 then
			Fx.emit("eshotEnd", { id = b.id })
			table.remove(bullets, i)
		end
	end

	for i = #orbs, 1, -1 do
		local o = orbs[i]
		local t = o.target
		if t and (t.hum.Health <= 0 or not t.root.Parent) then
			t, o.target = nil, nil
		end
		if not t then
			for _, candidate in targetsByRun[o.run] or NO_TARGETS do
				if (candidate.root.Position - o.part.Position).Magnitude <= candidate.magnet then
					t, o.target = candidate, candidate
					break
				end
			end
		end
		if t then
			local to = t.root.Position - o.part.Position
			if to.Magnitude < 2 then
				Enemies.onPickup(t.player, o.xp)
				o.part:Destroy()
				table.remove(orbs, i)
			else
				o.part.Position += to.Unit * math.min(to.Magnitude, 60 * dt)
			end
		end
	end
end

function Enemies.nearest(pos, maxDist, exclude)
	local best, bestDist = nil, maxDist
	for _, e in list do
		if not e.dead and not (exclude and exclude[e]) then
			local d = flat(e.root.Position - pos).Magnitude - e.radius
			if d <= bestDist then
				best, bestDist = e, d
			end
		end
	end
	return best
end

-- up to n enemies within maxDist, closest first
function Enemies.closest(pos, maxDist, n)
	local found = {}
	for _, e in list do
		if not e.dead then
			local d = flat(e.root.Position - pos).Magnitude - e.radius
			if d <= maxDist then
				table.insert(found, { e = e, d = d })
			end
		end
	end
	table.sort(found, function(a, b)
		return a.d < b.d
	end)
	local out = {}
	for i = 1, math.min(n, #found) do
		out[i] = found[i].e
	end
	return out
end

function Enemies.inRadius(pos, r)
	local out = {}
	for _, e in list do
		if not e.dead and flat(e.root.Position - pos).Magnitude <= r + e.radius then
			table.insert(out, e)
		end
	end
	return out
end

function Enemies.count(runKey)
	local n = 0
	for _, e in list do
		if e.run == runKey and not e.dead then
			n += 1
		end
	end
	return n
end

-- Removes one adventure's enemies, bullets and XP orbs.
function Enemies.clear(runKey)
	for i = #bullets, 1, -1 do
		if bullets[i].run == runKey then
			Fx.emit("eshotEnd", { id = bullets[i].id })
			table.remove(bullets, i)
		end
	end
	for i = #list, 1, -1 do
		local e = list[i]
		if e.run == runKey then
			e.dead = true
			e.model:Destroy()
			table.remove(list, i)
		end
	end
	for i = #orbs, 1, -1 do
		if orbs[i].run == runKey then
			orbs[i].part:Destroy()
			table.remove(orbs, i)
		end
	end
end

return Enemies
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX08046"><Properties><string name="Name">Fx</string><ProtectedString name="Source"><![CDATA[-- Queues visual effects and sends them to every client once per frame.
-- The server only decides what happened; clients draw it (see client/Effects.lua).
local Fx = {}
local queue = {}
local remote

function Fx.init(r)
	remote = r
end

function Fx.emit(kind, data)
	data.k = kind
	table.insert(queue, data)
end

function Fx.flush()
	if #queue > 0 then
		remote:FireAllClients(queue)
		queue = {}
	end
end

return Fx
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX08047"><Properties><string name="Name">Gear</string><ProtectedString name="Source"><![CDATA[-- Signature gear each pirate wears or carries (hats, swords, staffs...), welded onto the
-- character on the server so every player sees it. Built from plain parts: no assets needed.
local Gear = {}

local CYL, BALL = Enum.PartType.Cylinder, Enum.PartType.Ball
local UP = CFrame.Angles(0, 0, math.pi / 2) -- cylinder standing upright
local FORWARD = CFrame.Angles(0, math.pi / 2, 0) -- cylinder pointing forward (-Z)
local METAL, NEON, FABRIC = Enum.Material.Metal, Enum.Material.Neon, Enum.Material.Fabric
local SKIN = Color3.fromRGB(255, 205, 160)
local STEEL = Color3.fromRGB(215, 220, 230)
local BLACK = Color3.fromRGB(20, 20, 25)

-- R6 rigs have fewer parts; attach to the closest one.
local R6 = {
	UpperTorso = "Torso", LowerTorso = "Torso", RightHand = "Right Arm", LeftHand = "Left Arm",
	RightLowerArm = "Right Arm", LeftLowerArm = "Left Arm", LeftUpperArm = "Left Arm",
	RightFoot = "Right Leg", LeftFoot = "Left Leg",
}

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

-- A piece is { body part, size, offset from that part, color, shape?, material? }.
local function hat(brim, crown, band, height, y)
	y = y or 0.5
	height = height or 0.7
	local pieces = {
		{ "Head", Vector3.new(0.15, 2.7, 2.7), CFrame.new(0, y, 0) * UP, brim, CYL, FABRIC },
		{ "Head", Vector3.new(height, 1.4, 1.4), CFrame.new(0, y + height / 2, 0) * UP, crown, CYL, FABRIC },
	}
	if band then
		table.insert(pieces, { "Head", Vector3.new(0.22, 1.45, 1.45), CFrame.new(0, y + 0.15, 0) * UP, band, CYL, FABRIC })
	end
	return pieces
end

local function sword(hand, handle, length)
	return {
		{ hand, Vector3.new(0.9, 0.28, 0.28), CFrame.new(0, -0.15, -0.1) * FORWARD, handle, CYL },
		{ hand, Vector3.new(0.08, 0.7, 0.7), CFrame.new(0, -0.15, -0.6) * FORWARD, rgb(200, 170, 60), CYL, METAL },
		{ hand, Vector3.new(0.08, 0.25, length), CFrame.new(0, -0.15, -0.65 - length / 2), STEEL, nil, METAL },
	}
end

local function sheath(x, color, tilt)
	return { "LowerTorso", Vector3.new(0.26, 0.26, 3.2), CFrame.new(x, -0.1, 0.3) * CFrame.Angles(math.rad(tilt), 0, 0), color }
end

local function staff(hand, colors, length)
	local pieces = {}
	local segment = length / #colors
	for i, color in colors do
		local y = -length / 2 + (i - 0.5) * segment
		table.insert(pieces, { hand, Vector3.new(segment, 0.22, 0.22), CFrame.new(0, y, 0) * UP, color, CYL })
	end
	return pieces
end

local function join(...)
	local all = {}
	for _, list in { ... } do
		for _, piece in list do
			table.insert(all, piece)
		end
	end
	return all
end

local GEAR = {
	Luffy = hat(rgb(240, 210, 110), rgb(240, 210, 110), rgb(200, 30, 30)),
	Zoro = join(sword("RightHand", BLACK, 3.4), {
		sheath(-1.05, rgb(240, 240, 240), 55),
		sheath(-0.85, rgb(170, 30, 30), 65),
		{ "LeftUpperArm", Vector3.new(1.1, 0.35, 1.1), CFrame.new(0, 0.2, 0), rgb(30, 30, 30), nil, FABRIC },
	}),
	Nami = staff("RightHand", { rgb(40, 90, 200), rgb(130, 200, 255), rgb(40, 90, 200) }, 5),
	Sanji = {
		{ "UpperTorso", Vector3.new(2.08, 1.62, 1.08), CFrame.new(), BLACK, nil, FABRIC },
		{ "UpperTorso", Vector3.new(0.28, 1.1, 0.06), CFrame.new(0, 0.05, -0.57), rgb(30, 50, 120) },
		{ "RightFoot", Vector3.new(1.05, 0.45, 1.25), CFrame.new(0, -0.05, -0.1), BLACK },
		{ "LeftFoot", Vector3.new(1.05, 0.45, 1.25), CFrame.new(0, -0.05, -0.1), BLACK },
	},
	Ace = join(hat(rgb(240, 120, 30), rgb(240, 120, 30), rgb(180, 30, 30)), {
		{ "Head", Vector3.new(0.3, 0.3, 0.3), CFrame.new(-0.25, 0.75, -0.72), rgb(220, 40, 40), BALL },
		{ "Head", Vector3.new(0.3, 0.3, 0.3), CFrame.new(0.25, 0.75, -0.72), rgb(40, 100, 220), BALL },
	}),
	Robin = hat(rgb(120, 70, 170), rgb(120, 70, 170), rgb(210, 180, 240)),
	Chopper = join(hat(rgb(240, 120, 170), rgb(240, 120, 170), nil, 1.3), {
		{ "Head", Vector3.new(0.9, 0.12, 0.06), CFrame.new(0, 1.15, -0.72) * CFrame.Angles(0, 0, math.rad(45)), rgb(250, 250, 250) },
		{ "Head", Vector3.new(0.9, 0.12, 0.06), CFrame.new(0, 1.15, -0.72) * CFrame.Angles(0, 0, math.rad(-45)), rgb(250, 250, 250) },
		{ "Head", Vector3.new(1.2, 0.2, 0.2), CFrame.new(-0.9, 0.6, 0) * CFrame.Angles(0, 0, math.rad(-50)), rgb(130, 85, 45), CYL },
		{ "Head", Vector3.new(1.2, 0.2, 0.2), CFrame.new(0.9, 0.6, 0) * CFrame.Angles(0, 0, math.rad(50)), rgb(130, 85, 45), CYL },
	}),
	Usopp = {
		{ "Head", Vector3.new(1.3, 0.3, 0.3), CFrame.new(0, -0.05, -1.15) * FORWARD, SKIN, CYL },
		{ "Head", Vector3.new(0.42, 0.42, 0.42), CFrame.new(-0.27, 0.42, -0.58), rgb(255, 210, 80), BALL, NEON },
		{ "Head", Vector3.new(0.42, 0.42, 0.42), CFrame.new(0.27, 0.42, -0.58), rgb(255, 210, 80), BALL, NEON },
		{ "LeftHand", Vector3.new(0.9, 0.2, 0.2), CFrame.new(0, -0.1, 0) * UP, rgb(110, 70, 40), CYL },
		{ "LeftHand", Vector3.new(0.7, 0.16, 0.16), CFrame.new(-0.2, 0.55, 0) * CFrame.Angles(0, 0, math.rad(115)), rgb(110, 70, 40), CYL },
		{ "LeftHand", Vector3.new(0.7, 0.16, 0.16), CFrame.new(0.2, 0.55, 0) * CFrame.Angles(0, 0, math.rad(65)), rgb(110, 70, 40), CYL },
	},
	Franky = {
		{ "Head", Vector3.new(1.0, 0.55, 1.5), CFrame.new(0, 0.75, -0.25), rgb(60, 150, 240) },
		{ "Head", Vector3.new(1.15, 0.25, 0.08), CFrame.new(0, 0.15, -0.62), BLACK },
		{ "RightLowerArm", Vector3.new(1.3, 1.4, 1.3), CFrame.new(0, -0.1, 0), rgb(60, 120, 210), nil, METAL },
		{ "LeftLowerArm", Vector3.new(1.3, 1.4, 1.3), CFrame.new(0, -0.1, 0), rgb(60, 120, 210), nil, METAL },
		{ "UpperTorso", Vector3.new(0.5, 0.5, 0.06), CFrame.new(-0.5, 0.3, -0.56), rgb(255, 220, 60), nil, NEON },
	},
	Brook = join({
		{ "Head", Vector3.new(2, 2, 2), CFrame.new(0, 1.05, 0.45), BLACK, BALL, FABRIC },
	}, hat(BLACK, BLACK, rgb(150, 60, 60), 1.2, 1.9), staff("RightHand", { BLACK, BLACK }, 4.2), {
		{ "RightHand", Vector3.new(0.4, 0.4, 0.4), CFrame.new(0, 2.15, 0), rgb(220, 190, 80), BALL, METAL },
	}),
	Jinbe = {
		{ "UpperTorso", Vector3.new(2.12, 1.64, 1.12), CFrame.new(), rgb(40, 70, 110), nil, FABRIC },
		{ "LowerTorso", Vector3.new(2.15, 0.35, 1.15), CFrame.new(0, 0.05, 0), rgb(240, 140, 40), nil, FABRIC },
		{ "UpperTorso", Vector3.new(0.4, 0.4, 0.4), CFrame.new(0, 0.85, -0.45), rgb(230, 80, 80), BALL },
	},
	Law = join(hat(rgb(245, 245, 240), rgb(245, 245, 240), rgb(60, 60, 60), 0.9, 0.45), {
		{ "Head", Vector3.new(0.3, 0.3, 0.3), CFrame.new(-0.4, 1.0, -0.55), BLACK, BALL },
		{ "Head", Vector3.new(0.3, 0.3, 0.3), CFrame.new(0.35, 1.05, -0.55), BLACK, BALL },
		{ "Head", Vector3.new(0.3, 0.3, 0.3), CFrame.new(0.6, 0.9, 0.2), BLACK, BALL },
		{ "UpperTorso", Vector3.new(0.32, 5.4, 0.32), CFrame.new(0.2, 0.2, 0.68) * CFrame.Angles(0, 0, math.rad(35)), BLACK },
		{ "UpperTorso", Vector3.new(0.3, 1.1, 0.3), CFrame.new(-1.67, 2.86, 0.68) * CFrame.Angles(0, 0, math.rad(35)), rgb(240, 240, 240) },
	}),
	Hancock = {
		{ "UpperTorso", Vector3.new(2.4, 3.4, 0.12), CFrame.new(0, -0.5, 0.62), rgb(200, 30, 60), nil, FABRIC },
		{ "Head", Vector3.new(0.3, 1.45, 1.45), CFrame.new(0, 0.62, 0) * UP, rgb(240, 200, 60), CYL, METAL },
		{ "Head", Vector3.new(0.3, 0.3, 0.3), CFrame.new(0, 0.9, -0.62), rgb(255, 90, 160), BALL, NEON },
	},
}

-- Replaces any gear on the character with this class's gear.
function Gear.apply(character, className)
	if not character then
		return
	end
	local old = character:FindFirstChild("PirateGear")
	if old then
		old:Destroy()
	end
	local pieces = GEAR[className]
	if not pieces then
		return
	end
	local folder = Instance.new("Folder")
	folder.Name = "PirateGear"
	for _, piece in pieces do
		local attachName, size, offset, color, shape, material = piece[1], piece[2], piece[3], piece[4], piece[5], piece[6]
		local attach = character:FindFirstChild(attachName) or (R6[attachName] and character:FindFirstChild(R6[attachName]))
		if attach and attach:IsA("BasePart") then
			local p = Instance.new("Part")
			p.Name = attachName .. "Gear"
			p.Shape = shape or Enum.PartType.Block
			p.Size = size
			p.Color = color
			p.Material = material or Enum.Material.SmoothPlastic
			p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
			p.CanCollide, p.CanQuery, p.CanTouch, p.Massless, p.CastShadow = false, false, false, true, false
			p.CFrame = attach.CFrame * offset
			local weld = Instance.new("WeldConstraint")
			weld.Part0, weld.Part1 = attach, p
			weld.Parent = p
			p.Parent = folder
		end
	end
	folder.Parent = character
end

return Gear
]]></ProtectedString></Properties></Item><Item class="Script" referent="RBX08048"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[-- Game flow:
--   Spawn island: pick a character, buy upgrades, step onto a voyage gate's pad.
--   The first player on a pad is the captain and picks a map + difficulty they have unlocked.
--   When the gate's countdown ends, everyone on the pad sails to that map's arena.
--   Each adventure runs on its own until its boss falls or its whole crew is down.
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(RS.Shared.Config)
local PlayerData = require(script.Parent.PlayerData)
local Enemies = require(script.Parent.Enemies)
local Progression = require(script.Parent.Progression)
local Weapons = require(script.Parent.Weapons)
local Fx = require(script.Parent.Fx)
local Portals = require(script.Parent.Portals)
local Gear = require(script.Parent.Gear)

Players.CharacterAutoLoads = false

local remotes = {}
local remoteFolder = Instance.new("Folder")
remoteFolder.Name = "Remotes"
for _, name in {
	"State", "Stats", "LevelUp", "Choose", "Reroll", "SelectClass", "BuyMeta", "Meta", "Results", "Fx", "Portal",
	"Announce", "Voyage",
} do
	local r = Instance.new("RemoteEvent")
	r.Name = name
	r.Parent = remoteFolder
	remotes[name] = r
end
remoteFolder.Parent = RS
Progression.init(remotes)
Fx.init(remotes.Fx)
Portals.build()

local LOBBY_TEXT = "Step onto a voyage gate to choose an adventure!"
local selectedClass = {}
local runOf = {} -- [player] = the run they are in (nil = on the spawn island)
local runs = {} -- [mapKey] = run in progress (one crew per map at a time)
local gates = {} -- [gateIndex] = { captain, map, difficulty, launchAt }
for i in Config.GATES do
	gates[i] = {}
end

local function classOf(player)
	return selectedClass[player] or Config.DEFAULT_CLASS
end

local function sendMeta(player)
	local data = PlayerData.get(player)
	if not data then
		return
	end
	local costs = {}
	for name, m in Config.Meta do
		costs[name] = data.meta[name] < m.max and PlayerData.metaCost(name, data.meta[name]) or false
	end
	remotes.Meta:FireClient(player, {
		gold = data.gold, levels = data.meta, costs = costs, progress = data.progress, class = classOf(player),
	})
end

local function sendLobby(player)
	remotes.State:FireClient(player, { phase = "Lobby", text = LOBBY_TEXT })
end

local function sendToArena(player, center)
	local character = player.Character
	local root = character and character:WaitForChild("HumanoidRootPart", 5)
	if not root then
		return
	end
	local a = math.random() * 2 * math.pi
	local r = math.random() * Config.ARENA_DROP_RADIUS
	character:PivotTo(CFrame.new(center.X + math.cos(a) * r, center.Y + 5, center.Z + math.sin(a) * r))
end

local function onCharacter(player, character)
	local hum = character:WaitForChild("Humanoid")
	hum.Died:Connect(function()
		local s = Progression.get(player)
		if runOf[player] and s then
			-- out until the crew's adventure ends
			s.dead = true
			Weapons.cleanup(player)
			remotes.LevelUp:FireClient(player, nil)
			return
		end
		task.wait(3)
		if player.Parent and not runOf[player] then
			player:LoadCharacter()
		end
	end)
	Progression.applyStats(player)
	task.spawn(function()
		character:WaitForChild("HumanoidRootPart", 5)
		task.wait(0.3) -- let the body parts finish loading
		if character.Parent then
			Gear.apply(character, classOf(player))
		end
	end)
end

local function onPlayerAdded(player)
	PlayerData.load(player)
	player.CharacterAdded:Connect(function(character)
		onCharacter(player, character)
	end)
	player:LoadCharacter()
	sendMeta(player)
	sendLobby(player)
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end

Players.PlayerRemoving:Connect(function(player)
	local run = runOf[player]
	if run then
		run.players[player] = nil
	end
	runOf[player] = nil
	Weapons.cleanup(player)
	Progression.stop(player)
	selectedClass[player] = nil
	PlayerData.release(player)
end)

remotes.Choose.OnServerEvent:Connect(function(player, index)
	if typeof(index) == "number" then
		Progression.choose(player, index)
	end
end)
remotes.Reroll.OnServerEvent:Connect(Progression.reroll)
remotes.Meta.OnServerEvent:Connect(sendMeta)
remotes.SelectClass.OnServerEvent:Connect(function(player, name)
	if not runOf[player] and typeof(name) == "string" and Config.Classes[name] then
		selectedClass[player] = name
		Gear.apply(player.Character, name)
		sendMeta(player)
	end
end)
remotes.BuyMeta.OnServerEvent:Connect(function(player, name)
	if not runOf[player] and typeof(name) == "string" and PlayerData.buy(player, name) then
		sendMeta(player)
	end
end)
-- The captain of a gate picks where the crew sails.
remotes.Voyage.OnServerEvent:Connect(function(player, mapKey, difficulty)
	if typeof(mapKey) ~= "string" or typeof(difficulty) ~= "number" then
		return
	end
	for _, gate in gates do
		if gate.captain == player then
			if PlayerData.unlocked(player, mapKey, difficulty) and not runs[mapKey] then
				gate.map, gate.difficulty, gate.launchAt = mapKey, difficulty, nil
			end
			return
		end
	end
end)

Enemies.onKilled = function(enemy, killer)
	local s = killer and Progression.get(killer)
	if s then
		s.kills += 1
		s.bonusGold += enemy.def.gold or 0
	end
end
Enemies.onPickup = Progression.addXP

local function runTargets(run)
	local targets = {}
	for player in run.players do
		local s = Progression.get(player)
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local hum = character and character:FindFirstChildOfClass("Humanoid")
		if s and not s.dead and root and hum and hum.Health > 0 then
			table.insert(targets, { player = player, s = s, root = root, hum = hum, magnet = Progression.magnet(s) })
		end
	end
	return targets
end

RunService.Heartbeat:Connect(function(dt)
	local targetsByRun = {}
	for key, run in runs do
		targetsByRun[key] = runTargets(run)
	end
	Enemies.step(dt, targetsByRun)
	Weapons.step(dt)
	Fx.flush()
end)

local function spawnAround(kind, run, targets, hpScale, dmgScale, look)
	-- only around crew members who have landed in the arena
	local landed = {}
	for _, t in targets do
		local offset = t.root.Position - run.map.center
		if math.abs(offset.X) <= Config.ARENA_HALF_SIZE and math.abs(offset.Z) <= Config.ARENA_HALF_SIZE then
			table.insert(landed, t)
		end
	end
	if #landed == 0 then
		return nil
	end
	local p = landed[math.random(#landed)].root.Position
	for _ = 1, 6 do
		local a = math.random() * 2 * math.pi
		local d = Config.SPAWN_MIN + math.random() * (Config.SPAWN_MAX - Config.SPAWN_MIN)
		local e = Enemies.spawn(kind, p.X + math.cos(a) * d, p.Z + math.sin(a) * d, hpScale, dmgScale, run.key, look)
		if e then
			return e
		end
	end
	-- the player is near the edge of the map: spawn close instead
	return Enemies.spawn(kind, p.X, p.Z + 15, hpScale, dmgScale, run.key, look)
end

-- Weighted pick from Config.SPAWN_TABLE: later maps and later minutes bring tougher Marines.
local function pickKind(minutes, mapIndex)
	local options, total = {}, 0
	for _, row in Config.SPAWN_TABLE do
		if mapIndex >= row[2] and minutes >= row[3] then
			table.insert(options, row)
			total += row[4]
		end
	end
	local roll = math.random() * total
	for _, row in options do
		roll -= row[4]
		if roll <= 0 then
			return row[1]
		end
	end
	return "Grunt"
end

local function healers(targets)
	for _, healer in targets do
		local amount = Progression.bonus(healer.s, "heal")
		if amount > 0 then
			for _, t in targets do
				if (t.root.Position - healer.root.Position).Magnitude <= 30 then
					t.hum.Health = math.min(t.hum.MaxHealth, t.hum.Health + amount)
				end
			end
		end
	end
end

local function announce(run, text, color)
	for player in run.players do
		remotes.Announce:FireClient(player, text, color)
	end
end

local function playRun(run)
	local map, diff = run.map, run.diff
	local start = os.clock()
	local nextMini = Config.MINIBOSS_EVERY
	local lastTick = 0
	local boss
	task.wait(1) -- let the crew land
	while true do
		local elapsed = os.clock() - start
		local minutes = elapsed / 60
		local targets = runTargets(run)
		if #targets == 0 then
			return "Defeat", elapsed
		end

		local crew = 1 + 0.3 * (#targets - 1)
		local hpScale = (1 + minutes * 0.4) * crew * map.hp * diff.hp
		local dmgScale = (1 + minutes * 0.15) * map.damage * diff.damage
		local desired = math.min(Config.MAX_ENEMIES, math.floor((15 + minutes * 12) * crew))
		for _ = 1, math.min(4, desired - Enemies.count(run.key)) do
			spawnAround(pickKind(minutes, map.index), run, targets, hpScale, dmgScale)
		end
		if elapsed >= nextMini and elapsed < diff.runLength then
			nextMini += Config.MINIBOSS_EVERY
			if spawnAround("MiniBoss", run, targets, hpScale, dmgScale) then
				announce(run, "A Vice Admiral appeared!", Color3.fromRGB(190, 90, 255))
			end
		end
		if elapsed >= diff.runLength then
			if not boss then
				local look = { name = map.boss, color = map.bossColor, accent = map.bossAccent }
				boss = spawnAround("Boss", run, targets, crew * map.hp * diff.hp, map.damage * diff.damage, look)
				if boss then
					announce(run, map.boss .. " has arrived!", Color3.fromRGB(255, 60, 60))
				end
			elseif boss.dead then
				return "Victory", elapsed
			end
		end

		if os.clock() - lastTick >= 1 then
			lastTick = os.clock()
			healers(targets)
			local left = math.ceil(diff.runLength - elapsed)
			local clock = left > 0 and string.format("%d:%02d", left // 60, left % 60) or "FINAL BOSS!"
			for player in run.players do
				local s = Progression.get(player)
				remotes.State:FireClient(player, {
					phase = "Run", text = clock, adventure = map.name .. "  -  " .. diff.name, color = diff.color,
					down = s ~= nil and s.dead,
				})
				Progression.sync(player)
			end
		end
		task.wait(0.25)
	end
end

-- What a first clear of this map + difficulty opens up.
local function unlockMessage(map, difficulty)
	local unlocked = {}
	if Config.Difficulties[difficulty + 1] then
		table.insert(unlocked, map.name .. " " .. Config.Difficulties[difficulty + 1].name)
	end
	if difficulty == 1 and Config.Maps[map.index + 1] then
		table.insert(unlocked, Config.Maps[map.index + 1].name)
	end
	return #unlocked > 0 and "Unlocked: " .. table.concat(unlocked, " and ") or nil
end

local function finishRun(run, result, elapsed)
	local map, diff = run.map, run.diff
	for player in run.players do
		local s, data = Progression.get(player), PlayerData.get(player)
		if s and data then
			local gold = s.kills + math.floor(elapsed / 10) + s.bonusGold + (result == "Victory" and 500 or 0)
			gold = math.floor(gold * map.gold * diff.gold * (1 + Progression.bonus(s, "gold")))
			data.gold += gold
			local unlocked
			if result == "Victory" and PlayerData.recordClear(player, map.key, run.difficulty) then
				unlocked = unlockMessage(map, run.difficulty)
			end
			task.spawn(PlayerData.save, player)
			remotes.Results:FireClient(player, {
				result = result, adventure = map.name .. "  -  " .. diff.name, color = diff.color,
				gold = gold, kills = s.kills, level = s.level, time = math.floor(elapsed), unlocked = unlocked,
			})
			remotes.State:FireClient(player, { phase = "Results", text = result == "Victory" and "VICTORY!" or "DEFEATED" })
		end
		Weapons.cleanup(player)
		Progression.stop(player)
	end
	Enemies.clear(run.key)
	task.wait(Config.RESULTS_TIME)
	for player in run.players do
		runOf[player] = nil
		if player.Parent then
			player:LoadCharacter() -- back to the spawn island with default stats
			sendMeta(player)
			sendLobby(player)
		end
	end
	runs[run.key] = nil
end

local function startRun(map, difficulty, crew)
	local diff = Config.Difficulties[difficulty]
	local run = { key = map.key, map = map, diff = diff, difficulty = difficulty, players = {} }
	runs[map.key] = run
	for _, player in crew do
		local data = PlayerData.get(player)
		if player.Parent and data and not runOf[player] then
			run.players[player] = true
			runOf[player] = run
			Progression.start(player, classOf(player), data.meta)
			Progression.applyStats(player)
			Progression.sync(player)
			remotes.State:FireClient(player, {
				phase = "Run", text = "Set sail!", adventure = map.name .. "  -  " .. diff.name, color = diff.color,
			})
			task.spawn(sendToArena, player, map.center)
		end
	end
	finishRun(run, playRun(run))
end

-- Voyage gates: the first player on a pad is captain; when the countdown ends, the crew sails.
local function updateGate(index, gate)
	local aboard = {}
	for _, player in Portals.playersInside(index) do
		if not runOf[player] then
			table.insert(aboard, player)
		end
	end
	if not table.find(aboard, gate.captain) then
		-- the captain stepped off: the next player in line takes over and picks again
		gate.captain, gate.map, gate.difficulty, gate.launchAt = aboard[1], nil, nil, nil
	end
	if gate.map and runs[gate.map] then
		gate.map, gate.difficulty, gate.launchAt = nil, nil, nil -- another crew got there first
	end
	local map = gate.map and Config.MapByKey[gate.map]
	local diff = gate.difficulty and Config.Difficulties[gate.difficulty]

	local status
	if not gate.captain then
		status = "Step in to choose an adventure"
	elseif not map then
		status = gate.captain.DisplayName .. " is choosing an adventure..."
	else
		gate.launchAt = gate.launchAt or os.clock() + Config.PORTAL_COUNTDOWN
		local left = math.ceil(gate.launchAt - os.clock())
		if left <= 0 then
			status = "Setting sail!"
			local difficulty = gate.difficulty
			gate.captain, gate.map, gate.difficulty, gate.launchAt = nil, nil, nil, nil
			task.spawn(startRun, map, difficulty, aboard)
		else
			status = string.format("%s - %s  |  %d aboard  |  sailing in %d", map.name, diff.name, #aboard, left)
		end
	end
	Portals.setStatus(index, status)
	for _, player in aboard do
		remotes.Portal:FireClient(player, {
			gate = index, color = Config.GATE_COLORS[index], text = status,
			captain = player == gate.captain, captainName = gate.captain and gate.captain.DisplayName,
			map = gate.map, difficulty = gate.difficulty,
		})
	end
end

while true do
	for index, gate in gates do
		updateGate(index, gate)
	end
	task.wait(0.25)
end
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX08049"><Properties><string name="Name">PlayerData</string><ProtectedString name="Source"><![CDATA[-- Saves gold, permanent upgrades and map progress between sessions.
local DataStoreService = game:GetService("DataStoreService")
local RS = game:GetService("ReplicatedStorage")

local Config = require(RS.Shared.Config)

local store
pcall(function()
	store = DataStoreService:GetDataStore("AnimeSwarm_v1")
end)

local PlayerData = {}
local cache = {}

local function key(player)
	return "p_" .. player.UserId
end

function PlayerData.load(player)
	local data = { gold = 0, meta = {}, progress = {} }
	local saved
	if store then
		local ok, result = pcall(store.GetAsync, store, key(player))
		if ok and type(result) == "table" then
			saved = result
		end
	end
	data.gold = saved and tonumber(saved.gold) or 0
	for name in Config.Meta do
		data.meta[name] = saved and saved.meta and tonumber(saved.meta[name]) or 0
	end
	-- progress: [mapKey] = highest difficulty cleared
	for _, map in Config.Maps do
		local cleared = saved and saved.progress and tonumber(saved.progress[map.key])
		if cleared and cleared > 0 then
			data.progress[map.key] = math.clamp(math.floor(cleared), 0, #Config.Difficulties)
		end
	end
	cache[player] = data
	return data
end

function PlayerData.get(player)
	return cache[player]
end

function PlayerData.save(player)
	local data = cache[player]
	if store and data then
		pcall(store.SetAsync, store, key(player), data)
	end
end

function PlayerData.release(player)
	PlayerData.save(player)
	cache[player] = nil
end

function PlayerData.unlocked(player, mapKey, difficulty)
	local data, map = cache[player], Config.MapByKey[mapKey]
	return data ~= nil and map ~= nil and Config.Difficulties[difficulty] ~= nil
		and Config.unlocked(data.progress, map, difficulty)
end

-- Records a cleared difficulty. Returns true if it was a new best for that map.
function PlayerData.recordClear(player, mapKey, difficulty)
	local data = cache[player]
	if data and difficulty > (data.progress[mapKey] or 0) then
		data.progress[mapKey] = difficulty
		return true
	end
	return false
end

function PlayerData.metaCost(name, level)
	local meta = Config.Meta[name]
	return math.floor(meta.cost * (meta.growth or Config.META_GROWTH) ^ level)
end

function PlayerData.buy(player, name)
	local data, meta = cache[player], Config.Meta[name]
	if not data or not meta then
		return false
	end
	local level = data.meta[name]
	local cost = PlayerData.metaCost(name, level)
	if level >= meta.max or data.gold < cost then
		return false
	end
	data.gold -= cost
	data.meta[name] = level + 1
	return true
end

game:BindToClose(function()
	for player in cache do
		PlayerData.save(player)
	end
end)

return PlayerData
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX08050"><Properties><string name="Name">Portals</string><ProtectedString name="Source"><![CDATA[-- Builds the voyage gates on the spawn island and tracks who is standing on their pads.
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")

local Config = require(RS.Shared.Config)

local Portals = {}
local built = {} -- [gateIndex] = { pad = Vector3, status = TextLabel }

local STONE = Color3.fromRGB(70, 72, 88)
local RING_RADIUS = 7.5
local UPRIGHT = CFrame.Angles(0, 0, math.pi / 2) -- stands a cylinder's length (X axis) upright

local function makePart(props, parent)
	local p = Instance.new("Part")
	p.Anchored, p.CanTouch, p.CastShadow = true, false, false
	p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
	for k, v in props do
		p[k] = v
	end
	p.Parent = parent
	return p
end

local function label(parent, props)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.TextScaled = true
	l.Font = Enum.Font.LuckiestGuy
	l.TextColor3 = Color3.new(1, 1, 1)
	l.TextStrokeTransparency = 0
	for k, v in props do
		l[k] = v
	end
	l.Parent = parent
	return l
end

local function groundY(pos)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local exclude = {}
	for _, p in Players:GetPlayers() do
		if p.Character then
			table.insert(exclude, p.Character)
		end
	end
	params.FilterDescendantsInstances = exclude
	local hit = workspace:Raycast(pos + Vector3.new(0, 100, 0), Vector3.new(0, -200, 0), params)
	return hit and hit.Position.Y or pos.Y
end

local function buildPortal(index, position, color, folder)
	local model = Instance.new("Model")
	model.Name = "Voyage Gate " .. index
	local y = groundY(position)
	local base = Vector3.new(position.X, y, position.Z)
	-- the portal's front (-Z) faces the spawn point
	local cf = CFrame.lookAt(base, Vector3.new(Config.ISLAND_CENTER.X, y, Config.ISLAND_CENTER.Z))
	local ringCenter = cf * CFrame.new(0, 10, 0)

	makePart({
		Name = "Platform", Shape = Enum.PartType.Cylinder, Material = Enum.Material.Slate, Color = STONE,
		Size = Vector3.new(1, 24, 24), CFrame = cf * CFrame.new(0, 0.5, 0) * UPRIGHT,
	}, model)
	local padCF = cf * CFrame.new(0, 1.05, -4)
	local pad = makePart({
		Name = "Pad", Shape = Enum.PartType.Cylinder, Material = Enum.Material.Neon, Color = color,
		Transparency = 0.35, CanCollide = false,
		Size = Vector3.new(0.1, Config.PORTAL_RADIUS * 2, Config.PORTAL_RADIUS * 2), CFrame = padCF * UPRIGHT,
	}, model)
	local rising = Instance.new("ParticleEmitter")
	rising.Color = ColorSequence.new(color)
	rising.LightEmission = 1
	rising.Rate = 10
	rising.Lifetime = NumberRange.new(1.2, 2)
	rising.Speed = NumberRange.new(0.5, 1.5)
	rising.Acceleration = Vector3.new(0, 4, 0)
	rising.Size = NumberSequence.new(0.5, 0)
	rising.Parent = pad

	-- stone ring with a glowing inner trim
	makePart({ Name = "Foot", Material = Enum.Material.Slate, Color = STONE, Size = Vector3.new(6, 1.6, 2.4), CFrame = cf * CFrame.new(0, 1.6, 0) }, model)
	local segments = 28
	for i = 0, segments - 1 do
		local a = i / segments * 2 * math.pi
		local spin = CFrame.Angles(0, 0, a)
		makePart({
			Name = "Ring", Material = Enum.Material.Slate, Color = STONE,
			Size = Vector3.new(1.6, 2 * math.pi * RING_RADIUS / segments * 1.15, 1.8),
			CFrame = ringCenter * CFrame.new(math.cos(a) * RING_RADIUS, math.sin(a) * RING_RADIUS, 0) * spin,
		}, model)
		local r = RING_RADIUS - 1
		makePart({
			Name = "Trim", Material = Enum.Material.Neon, Color = color, CanCollide = false,
			Size = Vector3.new(0.35, 2 * math.pi * r / segments * 1.15, 2),
			CFrame = ringCenter * CFrame.new(math.cos(a) * r, math.sin(a) * r, 0) * spin,
		}, model)
	end

	-- the swirling gateway itself
	local discCF = ringCenter * CFrame.Angles(0, math.pi / 2, 0)
	local discSize = Vector3.new(0.3, 2 * RING_RADIUS - 1.6, 2 * RING_RADIUS - 1.6)
	local glow = makePart({
		Name = "Glow", Shape = Enum.PartType.Cylinder, Material = Enum.Material.Neon, Color = color,
		Transparency = 0.45, CanCollide = false, Size = discSize, CFrame = discCF,
	}, model)
	makePart({
		Name = "Vortex", Shape = Enum.PartType.Cylinder, Material = Enum.Material.ForceField, Color = color,
		CanCollide = false, Size = discSize + Vector3.new(0.3, 0, 0), CFrame = discCF,
	}, model)
	for i = 0, 2 do
		local blade = makePart({
			Name = "Swirl", Material = Enum.Material.Neon, Color = color:Lerp(Color3.new(1, 1, 1), 0.5),
			Transparency = 0.3, CanCollide = false, Size = Vector3.new(0.4, 2 * RING_RADIUS - 3, 0.15),
			CFrame = ringCenter * CFrame.Angles(0, 0, i * math.pi / 3),
		}, model)
		blade:SetAttribute("Center", ringCenter)
		blade:SetAttribute("Phase", i * math.pi / 3)
		CollectionService:AddTag(blade, "PortalSwirl") -- spun by client/Effects.lua
	end
	local sparkles = Instance.new("ParticleEmitter")
	sparkles.Color = ColorSequence.new(color)
	sparkles.LightEmission = 1
	sparkles.Rate = 15
	sparkles.Lifetime = NumberRange.new(1, 2)
	sparkles.Speed = NumberRange.new(1, 3)
	sparkles.Size = NumberSequence.new(0.7, 0)
	sparkles.Parent = glow
	local light = Instance.new("PointLight")
	light.Color, light.Range, light.Brightness = color, 26, 2
	light.Parent = glow

	-- pillars, arch and name plate
	for _, side in { -1, 1 } do
		local x = side * 11
		makePart({ Name = "Pillar", Material = Enum.Material.Slate, Color = STONE, Size = Vector3.new(2.6, 20, 2.6), CFrame = cf * CFrame.new(x, 11, 0) }, model)
		makePart({ Name = "PillarGlow", Material = Enum.Material.Neon, Color = color, CanCollide = false, Size = Vector3.new(0.5, 17, 2.8), CFrame = cf * CFrame.new(x, 11, 0) }, model)
		makePart({ Name = "Orb", Shape = Enum.PartType.Ball, Material = Enum.Material.Neon, Color = color, CanCollide = false, Size = Vector3.one * 2.6, CFrame = cf * CFrame.new(x, 23.3, 0) }, model)
	end
	local arch = makePart({ Name = "Arch", Material = Enum.Material.Slate, Color = STONE, Size = Vector3.new(25, 3, 3), CFrame = cf * CFrame.new(0, 20.5, 0) }, model)
	local plate = Instance.new("SurfaceGui")
	plate.Face = Enum.NormalId.Front
	plate.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	plate.PixelsPerStud = 40
	plate.Parent = arch
	label(plate, { Size = UDim2.fromScale(1, 1), Text = "VOYAGE GATE " .. index, TextColor3 = color })

	-- floating info: difficulty, description, live status
	local anchor = makePart({ Name = "Info", Transparency = 1, CanCollide = false, CanQuery = false, Size = Vector3.one, CFrame = cf * CFrame.new(0, 28, 0) }, model)
	local board = Instance.new("BillboardGui")
	board.Size = UDim2.fromOffset(320, 96)
	board.MaxDistance = 220
	board.Parent = anchor
	label(board, { Size = UDim2.new(1, 0, 0.38, 0), Text = "★ ADVENTURE ★", TextColor3 = Color3.fromRGB(255, 215, 80) })
	label(board, { Size = UDim2.new(1, 0, 0.27, 0), Position = UDim2.fromScale(0, 0.4), Font = Enum.Font.FredokaOne, Text = "Step in to pick a map and difficulty" })
	local status = label(board, {
		Size = UDim2.new(1, 0, 0.3, 0), Position = UDim2.fromScale(0, 0.7),
		Font = Enum.Font.FredokaOne, Text = "Step in to set sail!", TextColor3 = color,
	})

	model.Parent = folder
	built[index] = { pad = padCF.Position, status = status }
end

function Portals.build()
	local folder = Instance.new("Folder")
	folder.Name = "Portals"
	folder.Parent = workspace
	for index, position in Config.GATES do
		buildPortal(index, position, Config.GATE_COLORS[index], folder)
	end
end

-- Living players whose character stands on the portal's pad.
function Portals.playersInside(index)
	local portal = built[index]
	local inside = {}
	if not portal then
		return inside
	end
	for _, player in Players:GetPlayers() do
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local hum = character and character:FindFirstChildOfClass("Humanoid")
		if root and hum and hum.Health > 0 then
			local offset = root.Position - portal.pad
			if Vector3.new(offset.X, 0, offset.Z).Magnitude <= Config.PORTAL_RADIUS and offset.Y > -2 and offset.Y < 10 then
				table.insert(inside, player)
			end
		end
	end
	return inside
end

function Portals.setStatus(index, text)
	local portal = built[index]
	if portal and portal.status.Text ~= text then
		portal.status.Text = text
	end
end

return Portals
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX08051"><Properties><string name="Name">Progression</string><ProtectedString name="Source"><![CDATA[-- Per-run player state: XP, levels, level-up choices, weapons, passives, evolutions.
local RS = game:GetService("ReplicatedStorage")

local Config = require(RS.Shared.Config)

local Progression = {}
local states = {} -- [player] = state
local remotes

function Progression.init(r)
	remotes = r
end

local function count(t)
	local n = 0
	for _ in t do
		n += 1
	end
	return n
end

-- Sum of class bonus, passives and permanent upgrades for one stat.
function Progression.bonus(s, stat)
	local total = s.classBonus[stat] or 0
	for name, level in s.passives do
		local p = Config.Passives[name]
		if p.stat == stat then
			total += p.per * level
		end
	end
	for name, level in s.meta do
		local m = Config.Meta[name]
		if m and m.stat == stat then
			total += m.per * level
		end
	end
	return total
end

function Progression.damageMult(s)
	return 1 + Progression.bonus(s, "damage")
end

function Progression.cooldownMult(s)
	return math.max(0.4, 1 - Progression.bonus(s, "cooldown"))
end

function Progression.areaMult(s)
	return 1 + Progression.bonus(s, "area")
end

function Progression.magnet(s)
	return Config.BASE_MAGNET * (1 + Progression.bonus(s, "magnet"))
end

-- Skill slots: a few to start, more from the "Skill Slot" upgrade.
function Progression.slots(s)
	return math.min(Config.WEAPON_SLOTS_MAX, Config.WEAPON_SLOTS_START + math.floor(Progression.bonus(s, "slots")))
end

function Progression.xpNeeded(level)
	return 5 + level * 2
end

-- Fused skills are made on the fly from any two skills, so they live here instead of Config.
local fusionDefs = {} -- [fusionKey] = { name, desc, color, fused = true, parts = { a, b } }

local function fusionKey(a, b)
	if a > b then
		a, b = b, a
	end
	local key = "Fusion_" .. a .. "_" .. b
	if not fusionDefs[key] then
		local wa, wb = Config.Weapons[a], Config.Weapons[b]
		fusionDefs[key] = {
			name = wa.name .. " x " .. wb.name,
			desc = "Fires " .. wa.name .. " and " .. wb.name .. " together, much stronger.",
			color = wa.color:Lerp(wb.color, 0.5), icon = wa.icon .. wb.icon, fused = true, parts = { a, b },
		}
	end
	return key
end

-- Definition of any skill a player can own: a Config skill, an evolution or a fusion.
function Progression.def(name)
	return Config.Weapons[name] or fusionDefs[name]
end

function Progression.get(player)
	return states[player]
end

function Progression.all()
	return states
end

function Progression.start(player, className, meta)
	if not Config.Classes[className] then
		className = Config.DEFAULT_CLASS
	end
	local class = Config.Classes[className]
	local s = {
		class = className, level = 1, xp = 0, kills = 0, bonusGold = 0, dead = false,
		weapons = { [class.weapon] = 1 }, passives = {}, timers = {},
		classBonus = class.bonus, meta = meta, choices = nil, pending = 0,
	}
	s.rerolls = math.floor(Progression.bonus(s, "reroll"))
	states[player] = s
	return s
end

function Progression.stop(player)
	if states[player] then
		states[player] = nil
		if player.Parent then
			remotes.LevelUp:FireClient(player, nil)
		end
	end
end

function Progression.applyStats(player)
	local s = states[player]
	local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if not s or not hum or hum.Health <= 0 then
		return
	end
	local ratio = hum.Health / hum.MaxHealth
	hum.MaxHealth = Config.BASE_HEALTH + Progression.bonus(s, "health")
	hum.Health = hum.MaxHealth * ratio
	hum.WalkSpeed = Config.BASE_SPEED * (1 + Progression.bonus(s, "speed"))
end

function Progression.sync(player)
	local s = states[player]
	if not s then
		return
	end
	local weapons, passives = {}, {}
	for name, level in s.weapons do
		local w = Progression.def(name)
		table.insert(weapons, {
			name = w.name, level = level, evo = w.evolved == true, fused = w.fused == true, color = w.color, icon = w.icon,
		})
	end
	for name, level in s.passives do
		table.insert(passives, { name = Config.Passives[name].name, level = level, icon = Config.Passives[name].icon })
	end
	remotes.Stats:FireClient(player, {
		level = s.level, xp = s.xp, need = Progression.xpNeeded(s.level),
		kills = s.kills, weapons = weapons, passives = passives, slots = Progression.slots(s),
	})
end

-- True if the player already has this skill, its evolution, or a fusion containing either.
local function ownsSkill(s, key)
	for name in s.weapons do
		local def = Progression.def(name)
		for _, part in def.fused and def.parts or { name } do
			if part == key or Config.Weapons[part].from == key then
				return true
			end
		end
	end
	return false
end

-- A skill can be fused once it is max level or evolved. Fusions can't be fused again.
local function fusionReady(name, level)
	local w = Config.Weapons[name]
	return w ~= nil and (w.evolved or level >= Config.WEAPON_MAX)
end

-- How likely each kind of card is. Crewmates' skills are rare so your own character's 6 come first.
local WEIGHT = { upgrade = 4, ownSkill = 3, crewSkill = 0.15, passive = 2 }

-- Removes and returns one entry, picked by weight.
local function takeWeighted(pool)
	local total = 0
	for _, c in pool do
		total += c.weight
	end
	local roll = math.random() * total
	for i, c in pool do
		roll -= c.weight
		if roll <= 0 then
			return table.remove(pool, i)
		end
	end
	return table.remove(pool)
end

local function buildChoices(s)
	local picks, pool, ready = {}, {}, {}
	for name, level in s.weapons do
		local w = Progression.def(name)
		if w.evolvesInto and level >= Config.WEAPON_MAX and (s.passives[w.evolveWith] or 0) >= Config.PASSIVE_MAX then
			table.insert(picks, { type = "evolve", key = name })
		elseif not w.evolved and not w.fused and level < Config.WEAPON_MAX then
			table.insert(pool, { type = "weapon", key = name, weight = WEIGHT.upgrade })
		end
		if fusionReady(name, level) then
			table.insert(ready, name)
		end
	end
	if #ready >= 2 then
		-- offer one random pair of maxed skills to fuse (reroll for a different pair)
		local a = table.remove(ready, math.random(#ready))
		table.insert(picks, { type = "fuse", a = a, b = ready[math.random(#ready)] })
	end
	if count(s.weapons) < Progression.slots(s) then
		for name, w in Config.Weapons do
			if not w.evolved and not ownsSkill(s, name) then
				local own = Config.SkillOwner[name] == s.class
				table.insert(pool, { type = "weapon", key = name, weight = own and WEIGHT.ownSkill or WEIGHT.crewSkill })
			end
		end
	end
	for name, level in s.passives do
		if level < Config.PASSIVE_MAX then
			table.insert(pool, { type = "passive", key = name, weight = WEIGHT.passive })
		end
	end
	if count(s.passives) < Config.PASSIVE_SLOTS then
		for name in Config.Passives do
			if not s.passives[name] then
				table.insert(pool, { type = "passive", key = name, weight = WEIGHT.passive })
			end
		end
	end

	while #picks > Config.CHOICES do
		table.remove(picks)
	end
	while #picks < Config.CHOICES and #pool > 0 do
		table.insert(picks, takeWeighted(pool))
	end
	if #picks == 0 then
		picks = { { type = "heal" }, { type = "gold" } }
	end
	return picks
end

local function describe(s, c)
	if c.type == "weapon" then
		local w = Config.Weapons[c.key]
		local level = (s.weapons[c.key] or 0) + 1
		local owner = Config.SkillOwner[c.key]
		local crew = level == 1 and owner ~= s.class
		return {
			title = w.name, color = w.color, icon = w.icon, level = level, max = Config.WEAPON_MAX,
			tag = crew and "CREW SKILL" or level == 1 and "NEW SKILL" or "UPGRADE",
			text = crew and owner .. "'s skill: " .. w.desc or level == 1 and w.desc or "More damage, faster attacks, more hits.",
		}
	elseif c.type == "passive" then
		local p = Config.Passives[c.key]
		local level = (s.passives[c.key] or 0) + 1
		return {
			title = p.name, text = p.desc, color = Color3.fromRGB(200, 210, 230), icon = p.icon,
			tag = level == 1 and "NEW PASSIVE" or "PASSIVE", level = level, max = Config.PASSIVE_MAX,
		}
	elseif c.type == "evolve" then
		local evo = Config.Weapons[Config.Weapons[c.key].evolvesInto]
		return { title = evo.name, text = evo.desc, color = evo.color, icon = evo.icon, tag = "EVOLUTION" }
	elseif c.type == "fuse" then
		local fused = Progression.def(fusionKey(c.a, c.b))
		return {
			title = fused.name, color = fused.color, icon = fused.icon, tag = "FUSION",
			text = "Fuse two maxed skills into one: both fire together with double damage. Frees a slot!",
		}
	elseif c.type == "heal" then
		return { title = "Meat on the Bone", text = "Heal 50 HP.", color = Color3.fromRGB(255, 170, 120), icon = "🍖", tag = "BONUS" }
	end
	return { title = "Gold Pouch", text = "+25 gold at the end of the run.", color = Color3.fromRGB(255, 215, 0), icon = "💰", tag = "BONUS" }
end

function Progression.offer(player)
	local s = states[player]
	s.choices = buildChoices(s)
	local cards = {}
	for i, c in s.choices do
		cards[i] = describe(s, c)
	end
	remotes.LevelUp:FireClient(player, cards, s.rerolls)
end

function Progression.addXP(player, amount)
	local s = states[player]
	if not s or s.dead then
		return
	end
	s.xp += amount
	while s.xp >= Progression.xpNeeded(s.level) do
		s.xp -= Progression.xpNeeded(s.level)
		s.level += 1
		s.pending += 1
	end
	if s.pending > 0 and not s.choices then
		Progression.offer(player)
	end
	Progression.sync(player)
end

function Progression.choose(player, index)
	local s = states[player]
	local c = s and not s.dead and s.choices and s.choices[index]
	if not c then
		return
	end
	if c.type == "weapon" then
		s.weapons[c.key] = (s.weapons[c.key] or 0) + 1
	elseif c.type == "passive" then
		s.passives[c.key] = (s.passives[c.key] or 0) + 1
	elseif c.type == "evolve" then
		s.weapons[c.key] = nil
		s.timers[c.key] = nil
		s.weapons[Config.Weapons[c.key].evolvesInto] = 1
	elseif c.type == "fuse" then
		s.weapons[c.a], s.weapons[c.b] = nil, nil
		s.timers[c.a], s.timers[c.b] = nil, nil
		s.weapons[fusionKey(c.a, c.b)] = 1
	elseif c.type == "heal" then
		local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if hum then
			hum.Health = math.min(hum.MaxHealth, hum.Health + 50)
		end
	else
		s.bonusGold += 25
	end
	s.choices = nil
	s.pending -= 1
	Progression.applyStats(player)
	if s.pending > 0 then
		Progression.offer(player)
	else
		remotes.LevelUp:FireClient(player, nil)
	end
	Progression.sync(player)
end

function Progression.reroll(player)
	local s = states[player]
	if s and s.choices and s.rerolls > 0 then
		s.rerolls -= 1
		Progression.offer(player)
	end
end

return Progression
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX08052"><Properties><string name="Name">Weapons</string><ProtectedString name="Source"><![CDATA[-- Auto-firing anime weapons. Each weapon kind targets and damages enemies on its own,
-- then tells clients what to draw through Fx.
local RS = game:GetService("ReplicatedStorage")

local Config = require(RS.Shared.Config)
local Enemies = require(script.Parent.Enemies)
local Progression = require(script.Parent.Progression)
local Fx = require(script.Parent.Fx)

local Weapons = {}
local projectiles = {}
local orbitSent = {} -- [player] = { [weaponName] = signature last sent to clients }
local nextShotId = 0
local nextOrbitResync = 0

local PROJECTILE_SPEED = 60
local MAX_HITS_SHOWN = 15

local function flat(v)
	return Vector3.new(v.X, 0, v.Z)
end

local function stats(s, name, level)
	local w = Config.Weapons[name]
	local up = level - 1
	return {
		w = w,
		damage = w.damage * (1 + 0.2 * up) * Progression.damageMult(s),
		cooldown = w.cooldown * (1 - 0.04 * up) * Progression.cooldownMult(s),
		range = w.range * Progression.areaMult(s),
		radius = (w.radius or 0) * Progression.areaMult(s),
		count = (w.count or 1) + math.floor(up / 3),
	}
end

local function directionTo(root, target)
	local d = flat(target.root.Position - root.Position)
	if d.Magnitude < 0.1 then
		d = flat(root.CFrame.LookVector)
	end
	return d.Unit
end

local function rotate(dir, angle)
	return CFrame.fromAxisAngle(Vector3.yAxis, angle):VectorToWorldSpace(dir)
end

-- Uses server time so clients can draw orbiting fists in the same place.
local function orbitPositions(root, st)
	local now = workspace:GetServerTimeNow()
	local out = {}
	for i = 1, st.count do
		local a = now * 3 + i * 2 * math.pi / st.count
		out[i] = root.Position + Vector3.new(math.cos(a) * st.range, 0, math.sin(a) * st.range)
	end
	return out
end

-- Damages an enemy and records the hit so clients can show sparks and numbers.
local function strike(player, e, damage, hits)
	if e.dead then
		return
	end
	if #hits < MAX_HITS_SHOWN then
		table.insert(hits, { e.root.Position, math.floor(damage + 0.5) })
	end
	Enemies.damage(e, damage, player)
end

-- Each returns true if it fired, false if there was nothing to hit.
local fire = {}

function fire.cone(player, _s, root, st)
	local target = Enemies.nearest(root.Position, st.range * 2.5)
	if not target then
		return false
	end
	local base = directionTo(root, target)
	local cosHalf = math.cos(math.rad(st.w.angle / 2))
	local nearby = Enemies.inRadius(root.Position, st.range)
	for i = 0, st.count - 1 do
		local dir = rotate(base, i * 2 * math.pi / st.count)
		local hits = {}
		for _, e in nearby do
			local d = flat(e.root.Position - root.Position)
			if d.Magnitude < 0.1 or d.Unit:Dot(dir) >= cosHalf then
				strike(player, e, st.damage, hits)
			end
		end
		Fx.emit(st.w.fx, {
			p = player, anim = st.w.anim, c = st.w.color, o = root.Position, d = dir,
			r = st.range, a = st.w.angle, arcs = st.w.arcs or 1, hits = hits,
		})
	end
	return true
end

function fire.chain(player, _s, root, st)
	local current = Enemies.nearest(root.Position, st.range)
	if not current then
		return false
	end
	local visited, points, hits = {}, {}, {}
	for _ = 1, st.count do
		visited[current] = true
		table.insert(points, current.root.Position)
		strike(player, current, st.damage, hits)
		current = Enemies.nearest(points[#points], 15, visited)
		if not current then
			break
		end
	end
	Fx.emit(st.w.fx, { p = player, anim = st.w.anim, c = st.w.color, cloud = st.w.cloud, pts = points, hits = hits })
	return true
end

function fire.projectile(player, _s, root, st)
	local targets = Enemies.closest(root.Position, st.range, st.count)
	if #targets == 0 then
		return false
	end
	for i = 1, st.count do
		local target = targets[(i - 1) % #targets + 1]
		nextShotId += 1
		local shot = {
			id = nextShotId, player = player, pos = root.Position, dir = directionTo(root, target),
			left = st.range, damage = st.damage, radius = st.radius, color = st.w.color, fire = st.w.fire,
		}
		table.insert(projectiles, shot)
		Fx.emit("shot", {
			id = shot.id, p = player, anim = i == 1 and st.w.anim or nil, c = st.w.color, fire = st.w.fire,
			o = shot.pos, d = shot.dir, len = st.range, speed = PROJECTILE_SPEED, size = 1.5 + st.radius / 4,
		})
	end
	return true
end

function fire.clones(player, _s, root, st)
	if not Enemies.nearest(root.Position, 40) then
		return false
	end
	Fx.emit("anim", { p = player, anim = st.w.anim })
	for i = 1, st.count do
		task.delay((i - 1) * 0.12, function()
			if not root.Parent then
				return
			end
			local offset = Vector3.new(math.random(-12, 12), 0, math.random(-12, 12))
			local target = Enemies.nearest(root.Position + offset, 30)
			local pos = target and target.root.Position or root.Position + offset
			pos = Vector3.new(pos.X, root.Position.Y, pos.Z)
			local hits = {}
			for _, e in Enemies.inRadius(pos, st.range) do
				strike(player, e, st.damage, hits)
			end
			Fx.emit(st.w.fx, { c = st.w.color, pos = pos, r = st.range, hits = hits })
		end)
	end
	return true
end

function fire.orbit(player, _s, root, st)
	local hits = {}
	for _, pos in orbitPositions(root, st) do
		for _, e in Enemies.inRadius(pos, 2.5) do
			strike(player, e, st.damage, hits)
		end
	end
	if #hits > 0 then
		Fx.emit("hits", { c = st.w.color, hits = hits })
	end
	return true
end

function fire.line(player, _s, root, st)
	local target = Enemies.nearest(root.Position, st.range)
	if not target then
		return false
	end
	local first = directionTo(root, target)
	local origin = root.Position
	local nearby = Enemies.inRadius(origin, st.range)
	for i = 1, st.count do
		local dir = i == 1 and first or rotate(first, math.random() * 2 * math.pi)
		local hits = {}
		for _, e in nearby do
			local rel = flat(e.root.Position - origin)
			local along = rel:Dot(dir)
			if along > 0 and (rel - dir * along).Magnitude <= st.w.width + e.radius then
				strike(player, e, st.damage, hits)
			end
		end
		Fx.emit(st.w.fx, {
			p = player, anim = i == 1 and st.w.anim or nil, c = st.w.color, arm = st.w.arm,
			o = origin, d = dir, len = st.range, w = st.w.width, i = i, hits = hits,
		})
	end
	return true
end

function fire.aura(player, _s, root, st)
	local nearby = Enemies.inRadius(root.Position, st.range)
	if #nearby == 0 then
		return false
	end
	local hits = {}
	for _, e in nearby do
		strike(player, e, st.damage, hits)
	end
	Fx.emit(st.w.fx, {
		p = player, anim = st.w.anim, c = st.w.color, fire = st.w.fire,
		o = root.Position, pos = root.Position, r = st.range, hits = hits,
	})
	return true
end

local function stepProjectiles(dt)
	for i = #projectiles, 1, -1 do
		local p = projectiles[i]
		local move = PROJECTILE_SPEED * dt
		p.pos += p.dir * move
		p.left -= move
		if p.left <= 0 or Enemies.nearest(p.pos, 1.5) then
			local hits = {}
			for _, e in Enemies.inRadius(p.pos, p.radius) do
				strike(p.player, e, p.damage, hits)
			end
			Fx.emit("boom", { id = p.id, pos = p.pos, r = p.radius, c = p.color, fire = p.fire, hits = hits })
			table.remove(projectiles, i)
		end
	end
end

-- Tells clients which orbiting fists to draw around a player (st = nil removes them).
local function syncOrbit(player, name, st)
	local sent = orbitSent[player] or {}
	orbitSent[player] = sent
	local signature = st and st.count .. ":" .. math.floor(st.range * 10) or nil
	if sent[name] ~= signature then
		sent[name] = signature
		Fx.emit("orbit", {
			p = player, key = name, n = st and st.count or 0, r = st and st.range or 0, c = st and st.w.color,
		})
	end
end

-- Stops drawing a player's orbiting weapons and drops their projectiles in flight.
function Weapons.cleanup(player)
	if orbitSent[player] then
		Fx.emit("orbit", { p = player, all = true, n = 0 })
		orbitSent[player] = nil
	end
	for i = #projectiles, 1, -1 do
		if projectiles[i].player == player then
			table.remove(projectiles, i)
		end
	end
end

-- Draws orbiting weapons and fires the weapon when its cooldown is up. `key` names its timer.
local function useWeapon(player, s, root, key, st, now)
	if st.w.kind == "orbit" then
		syncOrbit(player, key, st)
	end
	if now >= (s.timers[key] or 0) then
		local fired = fire[st.w.kind](player, s, root, st)
		s.timers[key] = now + (fired and st.cooldown or 0.2)
	end
end

function Weapons.step(dt)
	local now = os.clock()
	if now >= nextOrbitResync then
		-- redraw orbits from scratch now and then so players who join mid-run see them too
		nextOrbitResync = now + 3
		for player in orbitSent do
			if orbitSent[player] then
				Fx.emit("orbit", { p = player, all = true, n = 0 })
				orbitSent[player] = nil
			end
		end
	end
	stepProjectiles(dt)
	for player, s in Progression.all() do
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if s.dead or not root then
			Weapons.cleanup(player)
			continue
		end
		for key in orbitSent[player] or {} do
			local owner = key:match("^(.-)#%d+$") or key -- fused parts are "<fusion>#1" and "<fusion>#2"
			if not s.weapons[owner] then
				syncOrbit(player, key, nil) -- evolved or fused away
			end
		end
		for name, level in s.weapons do
			local def = Progression.def(name)
			if def.fused then
				-- a fusion fires both of its skills at max level, boosted
				for i, part in def.parts do
					local st = stats(s, part, Config.Weapons[part].evolved and 1 or Config.WEAPON_MAX)
					st.damage *= Config.FUSION.damage
					st.cooldown *= Config.FUSION.cooldown
					st.range *= Config.FUSION.area
					st.radius *= Config.FUSION.area
					st.count += Config.FUSION.extraHits
					useWeapon(player, s, root, name .. "#" .. i, st, now)
				end
			else
				useWeapon(player, s, root, name, stats(s, name, level), now)
			end
		end
	end
end

return Weapons
]]></ProtectedString></Properties></Item></Item></Item><Item class="StarterPlayer" referent="RBX08065"><Properties><string name="Name">StarterPlayer</string><token name="GameSettingsAvatar">1</token></Properties><Item class="StarterPlayerScripts" referent="RBX08062"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="Folder" referent="RBX08061"><Properties><string name="Name">Client</string></Properties><Item class="ModuleScript" referent="RBX08055"><Properties><string name="Name">Animate</string><ProtectedString name="Source"><![CDATA[-- Procedural attack animations: bends R15 joints for a moment, no animation assets needed.
-- Runs on every client for every character, so everyone sees everyone's attacks.
local RunService = game:GetService("RunService")

local Animate = {}
local active = {} -- { motor, pose, start, duration, peak }
local lastPlayed = {} -- [character] = { [style] = os.clock() }

local rad = math.rad

-- Each joint: { part name, motor name, function(t, k) -> CFrame }.
-- t goes 0 -> 1 over the animation, k is an envelope that rises fast then falls back to 0.
local STYLES = {
	punch = {
		duration = 0.25, peak = 0.25,
		joints = {
			{ "RightUpperArm", "RightShoulder", function(_, k) return CFrame.Angles(rad(95) * k, 0, 0) end },
			{ "UpperTorso", "Waist", function(_, k) return CFrame.Angles(0, rad(-30) * k, 0) end },
		},
	},
	slash = {
		duration = 0.3, peak = 0.35,
		joints = {
			{ "RightUpperArm", "RightShoulder", function(_, k) return CFrame.Angles(rad(80) * k, 0, rad(40) * k) end },
			{ "LeftUpperArm", "LeftShoulder", function(_, k) return CFrame.Angles(rad(80) * k, 0, rad(-40) * k) end },
			{ "UpperTorso", "Waist", function(t, k) return CFrame.Angles(0, rad(60 - 120 * t) * k, 0) end },
		},
	},
	kick = {
		duration = 0.3, peak = 0.3,
		joints = {
			{ "RightUpperLeg", "RightHip", function(_, k) return CFrame.Angles(rad(100) * k, 0, 0) end },
			{ "UpperTorso", "Waist", function(_, k) return CFrame.Angles(rad(-15) * k, rad(-40) * k, 0) end },
			{ "LeftUpperArm", "LeftShoulder", function(_, k) return CFrame.Angles(0, 0, rad(-60) * k) end },
			{ "RightUpperArm", "RightShoulder", function(_, k) return CFrame.Angles(0, 0, rad(60) * k) end },
		},
	},
	throw = {
		duration = 0.3, peak = 0.4,
		joints = {
			{ "RightUpperArm", "RightShoulder", function(t, k) return CFrame.Angles(rad(-40 + 150 * t) * k, 0, 0) end },
			{ "UpperTorso", "Waist", function(_, k) return CFrame.Angles(0, rad(-35) * k, 0) end },
		},
	},
	cast = {
		duration = 0.4, peak = 0.3,
		joints = {
			{ "RightUpperArm", "RightShoulder", function(_, k) return CFrame.Angles(rad(165) * k, 0, 0) end },
			{ "LeftUpperArm", "LeftShoulder", function(_, k) return CFrame.Angles(rad(30) * k, 0, 0) end },
		},
	},
	cross = {
		duration = 0.45, peak = 0.3,
		joints = {
			{ "RightUpperArm", "RightShoulder", function(_, k) return CFrame.Angles(rad(90) * k, 0, rad(35) * k) end },
			{ "LeftUpperArm", "LeftShoulder", function(_, k) return CFrame.Angles(rad(90) * k, 0, rad(-35) * k) end },
		},
	},
}

local function envelope(t, peak)
	if t < peak then
		return t / peak
	end
	return 1 - (t - peak) / (1 - peak)
end

function Animate.play(player, styleName)
	local style = STYLES[styleName]
	local character = player and player.Character
	if not style or not character then
		return
	end
	local now = os.clock()
	local played = lastPlayed[character] or {}
	lastPlayed[character] = played
	if played[styleName] and now - played[styleName] < style.duration * 0.8 then
		return -- already mid-swing
	end
	played[styleName] = now
	for _, joint in style.joints do
		local part = character:FindFirstChild(joint[1])
		local motor = part and part:FindFirstChild(joint[2])
		if motor and motor:IsA("Motor6D") then -- R15 only; R6 rigs just skip the animation
			table.insert(active, { motor = motor, pose = joint[3], start = now, duration = style.duration, peak = style.peak })
		end
	end
end

-- Stepped runs after Roblox's Animator, so these poses win over walk/idle for their joints.
RunService.Stepped:Connect(function()
	local now = os.clock()
	for i = #active, 1, -1 do
		local a = active[i]
		local t = (now - a.start) / a.duration
		if t >= 1 or not a.motor.Parent then
			a.motor.Transform = CFrame.identity
			table.remove(active, i)
		else
			a.motor.Transform = a.pose(t, envelope(t, a.peak))
		end
	end
	for character in lastPlayed do
		if not character.Parent then
			lastPlayed[character] = nil
		end
	end
end)

return Animate
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX08056"><Properties><string name="Name">Effects</string><ProtectedString name="Source"><![CDATA[-- Draws every skill effect on this client: stretching arms, sword arcs, lightning, projectiles,
-- spin kicks, energy bursts, sky strikes, flying waves, sprouting arms, orbiting objects,
-- hit sparks and damage numbers.
-- The server sends batches of events (see server/Fx.lua); nothing here affects gameplay.
local Players = game:GetService("Players")
local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")

local Animate = require(script.Parent.Animate)

local Effects = {}
local handlers = {}

local folder = Instance.new("Folder")
folder.Name = "ClientFX"
folder.Parent = workspace

local SKIN = Color3.fromRGB(255, 205, 160)
local WHITE = Color3.new(1, 1, 1)
local TEX_SPARK = "rbxasset://textures/particles/sparkles_main.dds"
local TEX_FIRE = "rbxasset://textures/particles/fire_main.dds"
local TEX_SMOKE = "rbxasset://textures/particles/smoke_main.dds"
local SMOOTH = Enum.Material.SmoothPlastic
local UPRIGHT = CFrame.Angles(0, 0, math.pi / 2) -- stands a cylinder's length (X axis) upright

-- helpers -------------------------------------------------------------------

local function rootOf(player)
	local character = player and player.Character
	return character and character:FindFirstChild("HumanoidRootPart")
end

local function rotateY(dir, angle)
	return CFrame.fromAxisAngle(Vector3.yAxis, angle):VectorToWorldSpace(dir)
end

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function groundAt(pos)
	local exclude = { folder }
	for _, name in { "Enemies", "XPOrbs", "FX" } do
		local f = workspace:FindFirstChild(name)
		if f then
			table.insert(exclude, f)
		end
	end
	for _, p in Players:GetPlayers() do
		if p.Character then
			table.insert(exclude, p.Character)
		end
	end
	rayParams.FilterDescendantsInstances = exclude
	local hit = workspace:Raycast(pos + Vector3.new(0, 5, 0), Vector3.new(0, -60, 0), rayParams)
	return hit and hit.Position or pos - Vector3.new(0, 3, 0)
end

local function part(props)
	local p = Instance.new("Part")
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, false
	p.Material = Enum.Material.Neon
	for k, v in props do
		p[k] = v
	end
	p.Parent = folder
	return p
end

local function tween(obj, time, goal, style, direction)
	local info = TweenInfo.new(time, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out)
	local t = TweenService:Create(obj, info, goal)
	t:Play()
	return t
end

local function fadeOut(p, time, goal)
	goal = goal or {}
	goal.Transparency = 1
	tween(p, time, goal)
	Debris:AddItem(p, time + 0.05)
end

-- One-shot particle burst. opts: texture, size, speed, life, gravity
local function burst(pos, color, count, opts)
	opts = opts or {}
	local life = opts.life or 0.3
	local speed = opts.speed or 12
	local holder = part({ Transparency = 1, Size = Vector3.one * 0.2, Position = pos })
	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = opts.texture or TEX_SPARK
	emitter.Color = ColorSequence.new(color)
	emitter.LightEmission = 1
	emitter.Size = NumberSequence.new(opts.size or 1, 0)
	emitter.Transparency = NumberSequence.new(0, 1)
	emitter.Lifetime = NumberRange.new(life, life * 1.6)
	emitter.Speed = NumberRange.new(speed, speed * 1.8)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Drag = 4
	emitter.Acceleration = opts.gravity or Vector3.zero
	emitter.RotSpeed = NumberRange.new(-180, 180)
	emitter.Rotation = NumberRange.new(0, 360)
	emitter.Rate = 0
	emitter.Parent = holder
	emitter:Emit(count)
	Debris:AddItem(holder, life * 2 + 0.2)
end

local function flashLight(pos, color, range, time)
	local holder = part({ Transparency = 1, Size = Vector3.one * 0.2, Position = pos })
	local light = Instance.new("PointLight")
	light.Color, light.Range, light.Brightness = color, range, 5
	light.Parent = holder
	tween(light, time, { Brightness = 0 })
	Debris:AddItem(holder, time + 0.05)
end

-- Flat expanding shockwave disc on the ground.
local function shockwave(pos, radius, color, time)
	local p = part({
		Shape = Enum.PartType.Cylinder, Color = color, Transparency = 0.25,
		Size = Vector3.new(0.2, 1, 1), CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.pi / 2),
	})
	fadeOut(p, time, { Size = Vector3.new(0.2, radius * 2, radius * 2) })
end

-- Briefly sets a body part on fire (Sanji's foot, Ace's fist).
local function ignite(player, partName, color, time)
	local character = player and player.Character
	local limb = character and character:FindFirstChild(partName)
	if limb then
		local fire = Instance.new("Fire")
		fire.Color, fire.SecondaryColor = color, Color3.fromRGB(255, 230, 120)
		fire.Size, fire.Heat = 4, 8
		fire.Parent = limb
		Debris:AddItem(fire, time)
	end
end

-- Attaches a glowing trail to a moving part.
local function addTrail(p, color, width, life, axis)
	local offset = axis == "X" and Vector3.new(width / 2, 0, 0) or Vector3.new(0, width / 2, 0)
	local a0 = Instance.new("Attachment")
	a0.Position = offset
	a0.Parent = p
	local a1 = Instance.new("Attachment")
	a1.Position = -offset
	a1.Parent = p
	local trail = Instance.new("Trail")
	trail.Attachment0, trail.Attachment1 = a0, a1
	trail.Color = ColorSequence.new(color)
	trail.Transparency = NumberSequence.new(0.2, 1)
	trail.Lifetime = life
	trail.LightEmission = 1
	trail.FaceCamera = true
	trail.Parent = p
end

-- Damage numbers and hit sparks ---------------------------------------------

local numbersShown = 0

local function damageNumber(pos, amount)
	if numbersShown >= 40 then
		return
	end
	numbersShown += 1
	local holder = part({
		Transparency = 1, Size = Vector3.one * 0.2,
		Position = pos + Vector3.new(math.random() * 2 - 1, 2, math.random() * 2 - 1),
	})
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(70, 32)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 120
	gui.Parent = holder
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = tostring(amount)
	label.TextScaled = true
	label.Font = Enum.Font.GothamBlack
	label.TextColor3 = amount >= 100 and Color3.fromRGB(255, 200, 40) or WHITE
	label.TextStrokeTransparency = 0
	label.Parent = gui
	tween(gui, 0.7, { StudsOffset = Vector3.new(0, 3, 0) })
	tween(label, 0.7, { TextTransparency = 1, TextStrokeTransparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	task.delay(0.75, function()
		numbersShown -= 1
		holder:Destroy()
	end)
end

local function showHits(hits, color)
	for i, hit in hits or {} do
		if i <= 6 then
			burst(hit[1], color, 6, { size = 0.9, speed = 14, life = 0.25 })
		end
		damageNumber(hit[1], hit[2])
	end
end

-- Effect pieces ---------------------------------------------------------------

-- A crescent slash that sweeps across `angle` degrees around `origin`.
local function arc(origin, dir, radius, angle, color, height, sweepTime)
	local segments = math.max(6, math.floor(angle / 12))
	local step = math.rad(angle) / segments
	local half = math.rad(angle) / 2
	for i = 0, segments - 1 do
		local t = (i + 0.5) / segments
		task.delay(sweepTime * t, function()
			local a = -half + (i + 0.5) * step
			local center = origin + rotateY(dir, a) * radius + Vector3.new(0, height, 0)
			local tangent = rotateY(dir, a + math.pi / 2)
			local width = 0.3 + 1.5 * math.sin(math.pi * t)
			local length = radius * step * 1.2
			local cf = CFrame.lookAt(center, center + tangent)
			local glow = part({ Color = color, Transparency = 0.15, Size = Vector3.new(width, 0.2, length), CFrame = cf })
			local core = part({ Color = WHITE, Size = Vector3.new(width * 0.35, 0.25, length), CFrame = cf })
			fadeOut(glow, 0.25, { Size = Vector3.new(width * 1.6, 0.2, length) })
			fadeOut(core, 0.15)
		end)
	end
end

-- A jagged lightning bolt between two points.
local function bolt(from, to, color, width)
	local points = { from }
	local n = math.clamp(math.floor((to - from).Magnitude / 4), 3, 10)
	for i = 1, n - 1 do
		local jitter = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * 3
		table.insert(points, from:Lerp(to, i / n) + jitter)
	end
	table.insert(points, to)
	for i = 1, #points - 1 do
		local a, b = points[i], points[i + 1]
		local length = (b - a).Magnitude
		if length > 0.05 then
			local cf = CFrame.lookAt((a + b) / 2, b)
			local glow = part({ Color = color, Transparency = 0.2, Size = Vector3.new(width, width, length), CFrame = cf })
			local core = part({ Color = WHITE, Size = Vector3.new(width * 0.4, width * 0.4, length), CFrame = cf })
			fadeOut(glow, 0.22)
			fadeOut(core, 0.12)
		end
	end
end

-- CFrame for a cylinder lying along `dir`, centered `distance` studs from `start`.
local function along(start, dir, distance)
	local center = start + dir * distance
	return CFrame.lookAt(center, center + dir) * CFrame.Angles(0, math.pi / 2, 0)
end

-- Handlers: one per effect kind the server sends ---------------------------------

-- Stretching punch (Luffy, Chopper): the arm shoots out to full range and snaps back.
function handlers.punch(ev)
	task.delay(((ev.i or 1) - 1) * 0.035, function()
		local root = rootOf(ev.p)
		local start = (root and root.Position or ev.o) + Vector3.new(0, 0.5, 0)
		local dir, length = ev.d, ev.len
		local size = (ev.w or 3) / 3
		local thick = 1.1 * size
		local skin = ev.arm or SKIN
		local arm = part({
			Shape = Enum.PartType.Cylinder, Material = SMOOTH, Color = skin,
			Size = Vector3.new(0.2, thick, thick), CFrame = along(start, dir, 0.1),
		})
		local sleeve = part({
			Shape = Enum.PartType.Cylinder, Material = SMOOTH, Color = ev.c,
			Size = Vector3.new(1.5, thick * 1.3, thick * 1.3), CFrame = along(start, dir, 0.75),
		})
		local fist = part({ Shape = Enum.PartType.Ball, Material = SMOOTH, Color = skin, Size = Vector3.one * 2.4 * size, CFrame = CFrame.new(start) })
		local out = 0.09
		tween(arm, out, { Size = Vector3.new(length, thick, thick), CFrame = along(start, dir, length / 2) }, Enum.EasingStyle.Linear)
		tween(fist, out, { CFrame = CFrame.new(start + dir * length) }, Enum.EasingStyle.Linear)
		task.delay(out, function()
			local tip = start + dir * length
			shockwave(tip, 3 * size, WHITE, 0.2)
			burst(tip, ev.c, 8, { size = 1.2, speed = 16 })
			local back = 0.12
			tween(arm, back, { Size = Vector3.new(0.2, thick, thick), CFrame = along(start, dir, 0.1) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			tween(fist, back, { CFrame = CFrame.new(start) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			for _, p in { arm, sleeve, fist } do
				Debris:AddItem(p, back + 0.02)
			end
		end)
		showHits(ev.hits, ev.c)
	end)
end

-- Sword or kick arcs sweeping in front (several lines for Zoro's three swords).
function handlers.slash(ev)
	local radius = ev.r * 0.75
	for j = 1, ev.arcs do
		local offset = j - (ev.arcs + 1) / 2
		arc(ev.o, ev.d, radius * (1 + offset * 0.12), ev.a, ev.c, offset * 0.8 - 0.4, 0.1)
	end
	showHits(ev.hits, ev.c)
end

-- Lightning that jumps from enemy to enemy; Nami's starts from a storm cloud.
function handlers.lightning(ev)
	local points = ev.pts
	if #points == 0 then
		return
	end
	local first = points[1]
	if ev.cloud then
		local cloud = first + Vector3.new(0, 22, 0)
		for _ = 1, 5 do
			local puff = part({
				Shape = Enum.PartType.Ball, Material = SMOOTH, Color = Color3.fromRGB(70, 70, 90), Transparency = 0.15,
				Size = Vector3.one * (5 + math.random() * 3),
				Position = cloud + Vector3.new(math.random(-5, 5), math.random() * 1.5, math.random(-5, 5)),
			})
			fadeOut(puff, 0.7)
		end
		bolt(cloud, first, ev.c, 0.7)
	else
		local root = rootOf(ev.p)
		if root then
			bolt(root.Position, first, ev.c, 0.45)
		end
	end
	flashLight(first, ev.c, 18, 0.3)
	for i = 1, #points - 1 do
		task.delay(i * 0.04, function()
			bolt(points[i], points[i + 1], ev.c, 0.45)
			flashLight(points[i + 1], ev.c, 10, 0.2)
		end)
	end
	showHits(ev.hits, ev.c)
end

-- Arms that sprout from the ground (Robin). Returns nothing; parts clean themselves up.
local function sproutArms(ground, spread, count, scale, color)
	for i = 1, count do
		local a = i / count * 2 * math.pi + math.random()
		local d = math.random() * spread
		local base = CFrame.new(ground + Vector3.new(math.cos(a) * d, 0, math.sin(a) * d))
			* CFrame.Angles(math.rad(math.random(-20, 20)), 0, math.rad(math.random(-20, 20)))
		local height = (3.5 + math.random() * 2) * scale
		local width = 0.7 * scale
		local arm = part({ Material = SMOOTH, Color = SKIN, Size = Vector3.new(width, 0.1, width), CFrame = base })
		local cuff = part({ Color = color, Size = Vector3.new(width * 1.4, 0.5 * scale, width * 1.4), CFrame = base * CFrame.new(0, 0.25 * scale, 0) })
		local hand = part({ Shape = Enum.PartType.Ball, Material = SMOOTH, Color = SKIN, Size = Vector3.one * width * 1.7, CFrame = base })
		tween(arm, 0.14, { Size = Vector3.new(width, height, width), CFrame = base * CFrame.new(0, height / 2, 0) }, Enum.EasingStyle.Back)
		tween(hand, 0.14, { CFrame = base * CFrame.new(0, height, 0) }, Enum.EasingStyle.Back)
		task.delay(0.45, function()
			for _, p in { arm, cuff, hand } do
				fadeOut(p, 0.2)
			end
		end)
	end
end

local PETALS = Color3.fromRGB(255, 160, 220)

-- A patch of arms bursting up with petals.
function handlers.hands(ev)
	local ground = groundAt(ev.pos or ev.o)
	local scale = math.min(ev.r / 7, 1.6)
	shockwave(ground + Vector3.new(0, 0.15, 0), ev.r, ev.c, 0.5)
	sproutArms(ground, ev.r * 0.6, ev.r > 8 and 7 or 4, scale, ev.c)
	burst(ground + Vector3.new(0, 2, 0), PETALS, 16, { size = 1.2, speed = 8, life = 0.6, gravity = Vector3.new(0, -6, 0) })
	showHits(ev.hits, ev.c)
end

-- Arms grabbing one enemy after another.
function handlers.grab(ev)
	for i, point in ev.pts do
		task.delay((i - 1) * 0.06, function()
			local ground = groundAt(point)
			sproutArms(ground, 1, 2, 0.7, ev.c)
			burst(ground + Vector3.new(0, 2, 0), PETALS, 6, { size = 1, speed = 6, life = 0.5 })
		end)
	end
	showHits(ev.hits, ev.c)
end

-- Projectiles: fireballs or glowing orbs. The server says where each one bursts ("boom").
local shots = {}

function handlers.shot(ev)
	local size = ev.size or 2
	local ball = part({ Shape = Enum.PartType.Ball, Color = ev.c, Transparency = 0.1, Size = Vector3.one * size, Position = ev.o })
	if ev.fire then
		local flames = Instance.new("Fire")
		flames.Color, flames.SecondaryColor = ev.c, Color3.fromRGB(255, 220, 90)
		flames.Size, flames.Heat = size * 2, 0
		flames.Parent = ball
		ignite(ev.p, "RightHand", ev.c, 0.3)
	end
	addTrail(ball, ev.c, size, 0.25)
	shots[ev.id] = { part = ball, pos = ev.o, dir = ev.d, left = ev.len, speed = ev.speed }
	Debris:AddItem(ball, ev.len / ev.speed + 1)
end

function handlers.boom(ev)
	local shot = shots[ev.id]
	if shot then
		shot.part:Destroy()
		shots[ev.id] = nil
	end
	local sphere = part({ Shape = Enum.PartType.Ball, Color = ev.c, Transparency = 0.1, Size = Vector3.one * 2, Position = ev.pos })
	fadeOut(sphere, 0.35, { Size = Vector3.one * ev.r * 2 })
	if ev.fire then
		local explosion = Instance.new("Explosion")
		explosion.Position = ev.pos
		explosion.BlastRadius = ev.r
		explosion.BlastPressure = 0 -- visual only
		explosion.DestroyJointRadiusPercent = 0
		explosion.ExplosionType = Enum.ExplosionType.NoCraters
		explosion.Parent = workspace
		burst(ev.pos, ev.c, 25, { texture = TEX_FIRE, size = 3, speed = ev.r * 2.5, life = 0.5 })
		burst(ev.pos, Color3.fromRGB(90, 90, 90), 10, { texture = TEX_SMOKE, size = 4, speed = ev.r, life = 0.8, gravity = Vector3.new(0, 8, 0) })
	else
		shockwave(groundAt(ev.pos) + Vector3.new(0, 0.2, 0), ev.r, ev.c, 0.35)
		burst(ev.pos, ev.c, 20, { size = 1.5, speed = ev.r * 2, life = 0.45 })
	end
	flashLight(ev.pos, ev.c, ev.r * 2.5, 0.4)
	showHits(ev.hits, ev.c)
end

-- Spin kick around the player; Sanji's burning kicks add flames.
function handlers.kick(ev)
	local root = rootOf(ev.p)
	local center = root and root.Position or ev.o
	local ground = groundAt(center)
	local facing = root and Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z).Unit or Vector3.new(0, 0, -1)
	arc(center, facing, ev.r * 0.7, 360, ev.c, -1.5, 0.14)
	shockwave(ground + Vector3.new(0, 0.2, 0), ev.r, ev.c, 0.3)
	for i = 1, 8 do
		local a = i * math.pi / 4
		local pos = ground + Vector3.new(math.cos(a) * ev.r * 0.8, 1, math.sin(a) * ev.r * 0.8)
		if ev.fire then
			burst(pos, ev.c, 4, { texture = TEX_FIRE, size = 2.5, speed = 3, life = 0.45, gravity = Vector3.new(0, 15, 0) })
		else
			burst(pos, ev.c, 3, { size = 1, speed = 6, life = 0.3 })
		end
	end
	if ev.fire then
		ignite(ev.p, "RightFoot", ev.c, 0.35)
	end
	showHits(ev.hits, ev.c)
end

-- Energy bursting out around the player (balloon, cyclone, fire fence, rumble ball...).
function handlers.nova(ev)
	local root = rootOf(ev.p)
	local center = root and root.Position or ev.o
	local ground = groundAt(center)
	local sphere = part({ Shape = Enum.PartType.Ball, Material = Enum.Material.ForceField, Color = ev.c, Size = Vector3.one * 2, Position = center })
	fadeOut(sphere, 0.4, { Size = Vector3.one * ev.r * 2 })
	shockwave(ground + Vector3.new(0, 0.25, 0), ev.r, ev.c, 0.35)
	burst(center, ev.c, 16, { size = 1.4, speed = ev.r * 2, life = 0.35 })
	flashLight(center, ev.c, ev.r * 2, 0.25)
	showHits(ev.hits, ev.c)
end

-- A column crashing down from the sky (giant fist, heel drop, fire pillar, thunder lance...).
function handlers.strike(ev)
	local ground = groundAt(ev.pos)
	local width = ev.r * 1.1
	local column = part({
		Shape = Enum.PartType.Cylinder, Color = ev.c, Transparency = 0.15,
		Size = Vector3.new(60, width, width), CFrame = CFrame.new(ground + Vector3.new(0, 30, 0)) * UPRIGHT,
	})
	local core = part({
		Shape = Enum.PartType.Cylinder, Color = WHITE,
		Size = Vector3.new(60, width * 0.35, width * 0.35), CFrame = column.CFrame,
	})
	fadeOut(column, 0.35, { Size = Vector3.new(60, width * 0.2, width * 0.2) })
	fadeOut(core, 0.2)
	shockwave(ground + Vector3.new(0, 0.2, 0), ev.r * 1.3, ev.c, 0.4)
	burst(ground + Vector3.new(0, 1, 0), ev.c, 14, { size = 2, speed = ev.r * 2, life = 0.4 })
	flashLight(ground + Vector3.new(0, 3, 0), ev.c, ev.r * 3, 0.3)
	showHits(ev.hits, ev.c)
end

-- A crescent wave flying down a line (sword waves, wind, petals, fire bullets...).
function handlers.wave(ev)
	task.delay(((ev.i or 1) - 1) * 0.06, function()
		local root = rootOf(ev.p)
		local start = root and root.Position or ev.o
		local finish = start + ev.d * ev.len
		local width = (ev.w or 3) * 1.6
		local travel = ev.len / 90
		local pieces = {}
		for side = -1, 1 do
			-- a center blade and two swept-back wings make the crescent
			local offset = CFrame.new(side * width * 0.42, 0, math.abs(side) * width * 0.25) * CFrame.Angles(0, -side * math.rad(28), 0)
			local blade = part({
				Color = side == 0 and WHITE or ev.c, Transparency = side == 0 and 0 or 0.15,
				Size = Vector3.new(side == 0 and width * 0.5 or width * 0.45, 0.3, 0.8),
				CFrame = CFrame.lookAt(start, finish) * offset,
			})
			table.insert(pieces, { part = blade, offset = offset })
		end
		addTrail(pieces[2].part, ev.c, width, 0.2, "X")
		for _, piece in pieces do
			tween(piece.part, travel, { CFrame = CFrame.lookAt(finish, finish + ev.d) * piece.offset }, Enum.EasingStyle.Linear)
			Debris:AddItem(piece.part, travel + 0.05)
		end
		showHits(ev.hits, ev.c)
	end)
end

-- Things circling the player: fists, clouds, fireflies, petals (positions follow server time).
local orbits = {} -- [player] = { [weaponName] = { parts = {}, r = radius } }

local function clearOrbits(player)
	for _, o in orbits[player] or {} do
		for _, p in o.parts do
			p:Destroy()
		end
	end
	orbits[player] = nil
end

function handlers.orbit(ev)
	if ev.all then
		clearOrbits(ev.p)
		return
	end
	local mine = orbits[ev.p] or {}
	orbits[ev.p] = mine
	local o = mine[ev.key] or { parts = {} }
	mine[ev.key] = o
	o.r = ev.r
	while #o.parts < ev.n do
		local fist = part({ Shape = Enum.PartType.Ball, Material = SMOOTH, Color = ev.c, Size = Vector3.one * 1.8 })
		addTrail(fist, ev.c, 1.2, 0.2)
		table.insert(o.parts, fist)
	end
	while #o.parts > ev.n do
		table.remove(o.parts):Destroy()
	end
	if ev.n == 0 then
		mine[ev.key] = nil
	end
end

function handlers.hits(ev)
	showHits(ev.hits, ev.c)
end

-- An enemy goes down in a puff of smoke.
function handlers.death(ev)
	burst(ev.pos, Color3.fromRGB(200, 200, 200), math.floor(6 * ev.s) + 2, { texture = TEX_SMOKE, size = 2.5 * ev.s, speed = 6, life = 0.5, gravity = Vector3.new(0, 6, 0) })
	burst(ev.pos, ev.c, 6, { size = 1, speed = 15, life = 0.3 })
end

function handlers.anim(_ev) end -- the animation itself is played in Effects.play

-- Enemy attacks -------------------------------------------------------------------

-- A red warning circle on the ground: the blast lands when it fills up. Get out!
function handlers.warn(ev)
	local ground = groundAt(ev.pos) + Vector3.new(0, 0.15, 0)
	local size = ev.r * 2
	local ring = part({
		Shape = Enum.PartType.Cylinder, Color = Color3.fromRGB(255, 40, 40), Transparency = 0.55,
		Size = Vector3.new(0.15, size, size), CFrame = CFrame.new(ground) * UPRIGHT,
	})
	local fill = part({
		Shape = Enum.PartType.Cylinder, Color = Color3.fromRGB(255, 130, 60), Transparency = 0.3,
		Size = Vector3.new(0.2, 0.5, 0.5), CFrame = ring.CFrame,
	})
	tween(fill, ev.t, { Size = Vector3.new(0.2, size, size) }, Enum.EasingStyle.Linear)
	Debris:AddItem(ring, ev.t)
	Debris:AddItem(fill, ev.t)
end

function handlers.slam(ev)
	local ground = groundAt(ev.pos)
	local center = ground + Vector3.new(0, 1, 0)
	shockwave(ground + Vector3.new(0, 0.3, 0), ev.r * 1.2, ev.c, 0.35)
	local sphere = part({ Shape = Enum.PartType.Ball, Color = ev.c, Transparency = 0.2, Size = Vector3.one * 2, Position = center })
	fadeOut(sphere, 0.3, { Size = Vector3.one * ev.r * 2 })
	burst(center, ev.c, 16, { texture = TEX_FIRE, size = 2.5, speed = ev.r * 2, life = 0.4 })
	burst(center, Color3.fromRGB(90, 90, 90), 8, { texture = TEX_SMOKE, size = 3, speed = ev.r, life = 0.6, gravity = Vector3.new(0, 6, 0) })
end

-- Marine rifle bullets. The server says when each one hits or runs out ("eshotEnd").
local enemyShots = {}

function handlers.eshot(ev)
	local bullet = part({ Shape = Enum.PartType.Ball, Color = Color3.fromRGB(255, 230, 120), Size = Vector3.one * 0.7, Position = ev.o })
	addTrail(bullet, Color3.fromRGB(255, 190, 80), 0.4, 0.15)
	enemyShots[ev.id] = { part = bullet, pos = ev.o, dir = ev.d, left = ev.len, speed = ev.speed }
	Debris:AddItem(bullet, ev.len / ev.speed + 0.5)
end

function handlers.eshotEnd(ev)
	local shot = enemyShots[ev.id]
	if shot then
		shot.part:Destroy()
		enemyShots[ev.id] = nil
	end
end

-- Per-frame updates -------------------------------------------------------------

local function moveShots(list, dt)
	for id, shot in list do
		if not shot.part.Parent then
			list[id] = nil
		elseif shot.left > 0 then
			local move = math.min(shot.left, shot.speed * dt)
			shot.pos += shot.dir * move
			shot.left -= move
			shot.part.Position = shot.pos
		end
	end
end

RunService.RenderStepped:Connect(function(dt)
	moveShots(shots, dt)
	moveShots(enemyShots, dt)

	local now = workspace:GetServerTimeNow()
	for player, mine in orbits do
		local root = rootOf(player)
		if not root or not player.Parent then
			clearOrbits(player)
			continue
		end
		for _, o in mine do
			local n = #o.parts
			for i, p in o.parts do
				local a = now * 3 + i * 2 * math.pi / n
				p.CFrame = CFrame.new(root.Position + Vector3.new(math.cos(a) * o.r, 0, math.sin(a) * o.r))
			end
		end
	end

	-- spin the swirl blades inside the island's portals
	for _, blade in CollectionService:GetTagged("PortalSwirl") do
		local center = blade:GetAttribute("Center")
		if center then
			blade.CFrame = center * CFrame.Angles(0, 0, now * 1.5 + (blade:GetAttribute("Phase") or 0))
		end
	end
end)

-- Public ------------------------------------------------------------------------

function Effects.play(ev)
	if ev.p and ev.anim then
		Animate.play(ev.p, ev.anim)
	end
	local handler = handlers[ev.k]
	if handler then
		local ok, err = pcall(handler, ev)
		if not ok then
			warn("Effect " .. tostring(ev.k) .. " failed: " .. tostring(err))
		end
	end
end

function Effects.clear()
	for player in orbits do
		clearOrbits(player)
	end
	for _, list in { shots, enemyShots } do
		for _, shot in list do
			shot.part:Destroy()
		end
		table.clear(list)
	end
end

return Effects
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX08057"><Properties><string name="Name">Hud</string><ProtectedString name="Source"><![CDATA[-- In-run HUD: XP bar, adventure timer, kills, health, skill slots,
-- level-up cards, boss announcements and the results screen.
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")

local Config = require(RS:WaitForChild("Shared"):WaitForChild("Config"))
local Theme = require(script.Parent.Theme)

local Hud = {}
local ui = {}
local cards = {}
local callbacks
local player = Players.LocalPlayer

local CARD_W, CARD_H, CARD_GAP = 230, 300, 22

local function initials(name)
	local letters = ""
	for word in name:gmatch("[%a]+") do
		letters ..= word:sub(1, 1):upper()
		if #letters == 2 then
			break
		end
	end
	return letters
end

-- Top bar: XP, level, adventure + timer, kills ----------------------------------

local function buildTop(root)
	local _, xpFill, xpText = Theme.bar({
		Size = UDim2.new(1, -150, 0, 20), Position = UDim2.new(0, 80, 0, 12),
	}, root, Color3.fromRGB(110, 220, 255), Color3.fromRGB(40, 110, 255))
	ui.xpFill, ui.xpText = xpFill, xpText

	local badge = Theme.new("Frame", {
		Size = UDim2.fromOffset(56, 56), Position = UDim2.new(0, 16, 0, -6), BackgroundColor3 = Theme.GOLD,
	}, root)
	Theme.corner(badge, 28)
	Theme.stroke(badge, Color3.fromRGB(80, 50, 0), 3)
	Theme.gradient(badge, Color3.fromRGB(255, 240, 160), Color3.fromRGB(230, 150, 20))
	Theme.title({ Size = UDim2.new(1, 0, 0.35, 0), Position = UDim2.fromScale(0, 0.1), Text = "LV", TextColor3 = Theme.DARK_TEXT, TextStrokeTransparency = 1 }, badge)
	ui.level = Theme.title({ Size = UDim2.new(1, 0, 0.5, 0), Position = UDim2.fromScale(0, 0.42), Text = "1", TextColor3 = Color3.new(1, 1, 1) }, badge)

	local pill = Theme.panel({ Size = UDim2.fromOffset(260, 64), Position = UDim2.new(0.5, -130, 0, 42) }, root)
	ui.adventure = Theme.title({ Size = UDim2.new(1, -20, 0, 22), Position = UDim2.fromOffset(10, 6), Text = "" }, pill)
	ui.timer = Theme.text({ Size = UDim2.new(1, -20, 0, 30), Position = UDim2.fromOffset(10, 28), Text = "", MaxSize = 30 }, pill)

	local kills = Theme.panel({ Size = UDim2.fromOffset(140, 44), Position = UDim2.new(1, -156, 0, 46) }, root)
	ui.kills = Theme.title({ Size = UDim2.new(1, -16, 1, -10), Position = UDim2.fromOffset(8, 5), Text = "💀 0", TextColor3 = Theme.TEXT }, kills)
end

-- Health bar ------------------------------------------------------------------------

local function buildHealth(root)
	local frame
	frame, ui.hpFill, ui.hpText = Theme.bar({
		Size = UDim2.fromOffset(420, 28), Position = UDim2.new(0.5, -210, 1, -52),
	}, root, Color3.fromRGB(255, 110, 110), Color3.fromRGB(190, 20, 40))
	ui.health = frame
	ui.down = Theme.title({
		Size = UDim2.fromOffset(600, 44), Position = UDim2.new(0.5, -300, 1, -110), Visible = false,
		Text = "KNOCKED OUT! Your crew fights on...", TextColor3 = Theme.BAD,
	}, root)

	local function bind(character)
		local hum = character:WaitForChild("Humanoid")
		local function update()
			local ratio = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
			Theme.tween(ui.hpFill, 0.15, { Size = UDim2.fromScale(ratio, 1) })
			ui.hpText.Text = string.format("%d / %d", math.ceil(hum.Health), math.floor(hum.MaxHealth))
		end
		hum.HealthChanged:Connect(update)
		hum:GetPropertyChangedSignal("MaxHealth"):Connect(update)
		update()
	end
	player.CharacterAdded:Connect(bind)
	if player.Character then
		task.spawn(bind, player.Character)
	end
end

-- Skill and passive slots (left side) -----------------------------------------------

local function buildSlots(root)
	local column = Theme.new("Frame", {
		Size = UDim2.fromOffset(220, 470), Position = UDim2.new(0, 14, 0.5, -215), BackgroundTransparency = 1,
	}, root)
	Theme.new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }, column)
	ui.weaponSlots, ui.passiveSlots = {}, {}

	local order = 0
	local function header(text)
		order += 1
		Theme.title({ Size = UDim2.new(1, 0, 0, 24), Text = text, TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = order }, column)
	end
	local function slot()
		order += 1
		local frame = Theme.new("Frame", { Size = UDim2.new(1, 0, 0, 30), BackgroundColor3 = Theme.CARD, BackgroundTransparency = 0.15, LayoutOrder = order }, column)
		Theme.corner(frame, 8)
		Theme.stroke(frame, Color3.new(0, 0, 0), 1, 0.6)
		local stripe = Theme.new("Frame", { Size = UDim2.new(0, 6, 1, -8), Position = UDim2.fromOffset(4, 4), BackgroundColor3 = Theme.MUTED, BorderSizePixel = 0 }, frame)
		Theme.corner(stripe, 3)
		local name = Theme.text({ Size = UDim2.new(1, -70, 1, -10), Position = UDim2.fromOffset(16, 5), TextXAlignment = Enum.TextXAlignment.Left, MaxSize = 15 }, frame)
		local level = Theme.title({ Size = UDim2.new(0, 50, 1, -10), Position = UDim2.new(1, -56, 0, 5), TextXAlignment = Enum.TextXAlignment.Right, MaxSize = 16 }, frame)
		return { frame = frame, stripe = stripe, name = name, level = level }
	end

	header("SKILLS")
	for i = 1, Config.WEAPON_SLOTS_MAX do
		ui.weaponSlots[i] = slot()
	end
	header("PASSIVES")
	for i = 1, Config.PASSIVE_SLOTS do
		ui.passiveSlots[i] = slot()
	end
end

local function fillSlot(slot, info, isWeapon, locked)
	slot.frame.BackgroundTransparency = locked and 0.6 or 0.15
	if locked then
		slot.stripe.BackgroundColor3 = Color3.fromRGB(45, 48, 65)
		slot.name.Text = "Buy slot in Shop"
		slot.name.TextColor3 = Color3.fromRGB(110, 115, 140)
		slot.level.Text = "🔒"
		return
	end
	if not info then
		slot.stripe.BackgroundColor3 = Color3.fromRGB(70, 75, 100)
		slot.name.Text = "Empty"
		slot.name.TextColor3 = Theme.MUTED
		slot.level.Text = ""
		return
	end
	slot.stripe.BackgroundColor3 = info.color or Color3.fromRGB(200, 210, 230)
	slot.name.Text = (info.icon and info.icon .. " " or "") .. info.name
	slot.name.TextColor3 = Theme.TEXT
	if info.fused then
		slot.level.Text = "FUSED"
		slot.level.TextColor3 = Color3.fromRGB(120, 230, 255)
	elseif info.evo then
		slot.level.Text = "EVO"
		slot.level.TextColor3 = Color3.fromRGB(255, 120, 255)
	else
		local max = isWeapon and Config.WEAPON_MAX or Config.PASSIVE_MAX
		slot.level.Text = info.level >= max and "MAX" or "Lv" .. info.level
		slot.level.TextColor3 = info.level >= max and Theme.GOLD or Theme.TEXT
	end
end

-- Level-up cards ----------------------------------------------------------------------

local function buildLevelUp(gui)
	local overlay = Theme.new("Frame", {
		Name = "LevelUp", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.45, Visible = false, ZIndex = 20,
	}, gui)
	ui.levelOverlay = overlay
	ui.levelTitle = Theme.title({
		Size = UDim2.fromOffset(600, 70), Position = UDim2.new(0.5, -300, 0.5, -250), Text = "LEVEL UP!", ZIndex = 21,
	}, overlay)
	Theme.text({
		Size = UDim2.fromOffset(600, 26), Position = UDim2.new(0.5, -300, 0.5, -180), ZIndex = 21,
		Text = "Choose a power  -  press 1, 2 or 3", TextColor3 = Theme.MUTED, MaxSize = 22,
	}, overlay)

	local width = Config.CHOICES * CARD_W + (Config.CHOICES - 1) * CARD_GAP
	local row = Theme.new("Frame", {
		Size = UDim2.fromOffset(width, CARD_H), Position = UDim2.new(0.5, -width / 2, 0.5, -140),
		BackgroundTransparency = 1, ZIndex = 21,
	}, overlay)
	for i = 1, Config.CHOICES do
		local x = (i - 1) * (CARD_W + CARD_GAP)
		local button = Theme.new("TextButton", {
			Size = UDim2.fromOffset(CARD_W, CARD_H), Position = UDim2.fromOffset(x, 0), Text = "",
			AutoButtonColor = false, BackgroundColor3 = Theme.CARD, ZIndex = 22,
		}, row)
		Theme.corner(button, 16)
		local stroke = Theme.stroke(button, Theme.GOLD, 3)
		Theme.gradient(button, Color3.fromRGB(255, 255, 255), Color3.fromRGB(150, 155, 185))
		local scale = Theme.new("UIScale", {}, button)

		local header = Theme.new("Frame", { Size = UDim2.new(1, 0, 0, 40), BackgroundColor3 = Theme.GOLD, ZIndex = 23 }, button)
		Theme.corner(header, 16)
		Theme.new("Frame", { Size = UDim2.new(1, 0, 0, 16), Position = UDim2.new(0, 0, 1, -16), BackgroundColor3 = Theme.GOLD, BorderSizePixel = 0, ZIndex = 23, Name = "Square" }, header)
		local tag = Theme.title({ Size = UDim2.new(1, -50, 1, -12), Position = UDim2.fromOffset(12, 6), TextColor3 = Theme.DARK_TEXT, TextStrokeTransparency = 1, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 24 }, header)
		Theme.title({ Size = UDim2.new(0, 34, 1, -12), Position = UDim2.new(1, -42, 0, 6), Text = "[" .. i .. "]", TextColor3 = Theme.DARK_TEXT, TextStrokeTransparency = 1, ZIndex = 24 }, header)

		local icon = Theme.new("Frame", { Size = UDim2.fromOffset(86, 86), Position = UDim2.new(0.5, -43, 0, 54), BackgroundColor3 = Theme.GOLD, ZIndex = 23 }, button)
		Theme.corner(icon, 43)
		Theme.stroke(icon, Color3.new(1, 1, 1), 3, 0.2)
		Theme.gradient(icon, Color3.fromRGB(255, 255, 255), Color3.fromRGB(110, 110, 130))
		local iconText = Theme.title({ Size = UDim2.fromScale(0.7, 0.7), Position = UDim2.fromScale(0.15, 0.15), TextColor3 = Color3.new(1, 1, 1), ZIndex = 24 }, icon)

		local title = Theme.title({ Size = UDim2.new(1, -20, 0, 46), Position = UDim2.fromOffset(10, 148), TextWrapped = true, ZIndex = 23, MaxSize = 26 }, button)
		local desc = Theme.text({ Size = UDim2.new(1, -24, 0, 64), Position = UDim2.fromOffset(12, 196), TextWrapped = true, TextColor3 = Theme.TEXT, ZIndex = 23, MaxSize = 18 }, button)
		local pips = Theme.new("Frame", { Size = UDim2.new(1, -40, 0, 14), Position = UDim2.new(0, 20, 1, -30), BackgroundTransparency = 1, ZIndex = 23 }, button)
		Theme.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 6) }, pips)

		button.MouseEnter:Connect(function()
			Theme.tween(scale, 0.12, { Scale = 1.06 })
			Theme.tween(stroke, 0.12, { Thickness = 5 })
		end)
		button.MouseLeave:Connect(function()
			Theme.tween(scale, 0.12, { Scale = 1 })
			Theme.tween(stroke, 0.12, { Thickness = 3 })
		end)
		button.Activated:Connect(function()
			Hud.choose(i)
		end)
		cards[i] = {
			button = button, stroke = stroke, header = header, tag = tag, icon = icon, iconText = iconText,
			title = title, desc = desc, pips = pips, x = x,
		}
	end

	ui.reroll = Theme.button({
		Size = UDim2.fromOffset(220, 48), Position = UDim2.new(0.5, -110, 0.5, 180), Text = "REROLL (R)",
		BackgroundColor3 = Color3.fromRGB(70, 90, 170), ZIndex = 22,
	}, overlay, function()
		Hud.reroll()
	end)
end

local function setPips(container, level, max, color)
	for _, child in container:GetChildren() do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
	if not level or not max then
		return
	end
	local size = max > 6 and 12 or 14
	container:FindFirstChildOfClass("UIListLayout").Padding = UDim.new(0, max > 6 and 4 or 6)
	for i = 1, max do
		local pip = Theme.new("Frame", {
			Size = UDim2.fromOffset(size, size), ZIndex = 24,
			BackgroundColor3 = i <= level and color or Color3.fromRGB(60, 65, 90),
		}, container)
		Theme.corner(pip, size / 2)
		Theme.stroke(pip, Color3.new(0, 0, 0), 1, 0.4)
	end
end

-- Announcements and results -------------------------------------------------------------

local function buildBanners(gui)
	ui.announce = Theme.title({
		Size = UDim2.fromOffset(800, 70), Position = UDim2.new(0.5, -400, 0.25, 0), Text = "", Visible = false, ZIndex = 15,
	}, gui)
	ui.announceScale = Theme.new("UIScale", {}, ui.announce)

	local overlay = Theme.new("Frame", {
		Name = "Results", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.4, Visible = false, ZIndex = 30,
	}, gui)
	ui.results = overlay
	local card = Theme.panel({ Size = UDim2.fromOffset(460, 400), Position = UDim2.new(0.5, -230, 0.5, -200), ZIndex = 31 }, overlay)
	ui.resultScale = Theme.new("UIScale", {}, card)
	ui.resultTitle = Theme.title({ Size = UDim2.new(1, -40, 0, 70), Position = UDim2.fromOffset(20, 18), ZIndex = 32 }, card)
	ui.resultAdventure = Theme.text({ Size = UDim2.new(1, -40, 0, 26), Position = UDim2.fromOffset(20, 88), ZIndex = 32, MaxSize = 22 }, card)
	ui.resultRows = {}
	for i, name in { "Time survived", "Level reached", "Enemies defeated" } do
		local y = 128 + (i - 1) * 42
		local row = Theme.new("Frame", { Size = UDim2.new(1, -40, 0, 36), Position = UDim2.fromOffset(20, y), BackgroundColor3 = Theme.CARD, ZIndex = 32 }, card)
		Theme.corner(row, 10)
		Theme.text({ Size = UDim2.new(0.6, -12, 1, -12), Position = UDim2.fromOffset(12, 6), Text = name, TextColor3 = Theme.MUTED, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 33 }, row)
		ui.resultRows[i] = Theme.title({ Size = UDim2.new(0.4, -12, 1, -10), Position = UDim2.new(0.6, 0, 0, 5), TextColor3 = Theme.TEXT, TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 33 }, row)
	end
	ui.resultGold = Theme.title({ Size = UDim2.new(1, -40, 0, 52), Position = UDim2.fromOffset(20, 262), ZIndex = 32 }, card)
	ui.resultUnlocked = Theme.title({
		Size = UDim2.new(1, -40, 0, 26), Position = UDim2.fromOffset(20, 318), ZIndex = 32, TextColor3 = Theme.GOOD, MaxSize = 22,
	}, card)
	Theme.text({
		Size = UDim2.new(1, -40, 0, 22), Position = UDim2.fromOffset(20, 356), ZIndex = 32,
		Text = "Returning to the island...", TextColor3 = Theme.MUTED, MaxSize = 18,
	}, card)
end

-- Count a label up from 0 to `value`.
local function countUp(label, value, format)
	local number = Instance.new("NumberValue")
	number.Changed:Connect(function(v)
		label.Text = format(v)
	end)
	label.Text = format(0)
	Theme.tween(number, 1.2, { Value = value })
	task.delay(1.3, function()
		number:Destroy()
	end)
end

-- Public -----------------------------------------------------------------------------------

function Hud.init(gui, cb)
	callbacks = cb
	local root = Theme.new("Frame", { Name = "RunHud", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false }, gui)
	ui.root = root
	buildTop(root)
	buildHealth(root)
	buildSlots(root)
	buildLevelUp(gui)
	buildBanners(gui)
	Hud.setStats({ level = 1, xp = 0, need = 1, kills = 0, weapons = {}, passives = {}, slots = Config.WEAPON_SLOTS_START })
end

function Hud.setVisible(visible)
	ui.root.Visible = visible
	if not visible then
		ui.levelOverlay.Visible = false
	end
end

function Hud.setState(state)
	ui.adventure.Text = (state.adventure or ""):upper()
	ui.adventure.TextColor3 = state.color or Theme.GOLD
	ui.timer.Text = state.text or ""
	ui.timer.TextColor3 = state.text == "FINAL BOSS!" and Theme.BAD or Theme.TEXT
	ui.down.Visible = state.down == true
end

function Hud.setStats(st)
	Theme.tween(ui.xpFill, 0.2, { Size = UDim2.fromScale(math.clamp(st.xp / st.need, 0, 1), 1) })
	ui.xpText.Text = string.format("%d / %d XP", st.xp, st.need)
	ui.level.Text = tostring(st.level)
	ui.kills.Text = "💀 " .. Theme.comma(st.kills)
	local unlocked = st.slots or Config.WEAPON_SLOTS_START
	for i, slot in ui.weaponSlots do
		fillSlot(slot, st.weapons[i], true, i > unlocked)
	end
	for i, slot in ui.passiveSlots do
		fillSlot(slot, st.passives[i], false)
	end
end

function Hud.showLevelUp(list, rerolls)
	if not list then
		ui.levelOverlay.Visible = false
		return
	end
	for i, card in cards do
		local c = list[i]
		card.button.Visible = c ~= nil
		if c then
			local tint = c.tag == "EVOLUTION" and Color3.fromRGB(255, 120, 255)
				or c.tag == "FUSION" and Color3.fromRGB(120, 230, 255)
				or c.color
			card.tag.Text = c.tag or ""
			card.header.BackgroundColor3 = tint
			card.header.Square.BackgroundColor3 = tint
			card.stroke.Color = tint
			card.icon.BackgroundColor3 = c.color
			card.iconText.Text = c.icon or initials(c.title)
			card.title.Text = c.title
			card.title.TextColor3 = tint:Lerp(Color3.new(1, 1, 1), 0.35)
			card.desc.Text = c.text
			setPips(card.pips, c.level, c.max, c.color)
			-- slide each card up into place
			card.button.Position = UDim2.fromOffset(card.x, 80)
			Theme.tween(card.button, 0.35 + i * 0.06, { Position = UDim2.fromOffset(card.x, 0) }, Enum.EasingStyle.Back)
		end
	end
	ui.reroll.Text = string.format("REROLL (R)  x%d", rerolls or 0)
	ui.reroll.Visible = (rerolls or 0) > 0
	ui.levelOverlay.Visible = true
end

function Hud.choose(i)
	if ui.levelOverlay.Visible and cards[i] and cards[i].button.Visible then
		ui.levelOverlay.Visible = false -- the server sends the next offer, if any
		callbacks.choose(i)
	end
end

function Hud.reroll()
	if ui.levelOverlay.Visible and ui.reroll.Visible then
		callbacks.reroll()
	end
end

function Hud.announce(text, color)
	ui.announce.Text = text:upper()
	ui.announce.TextColor3 = color or Theme.GOLD
	ui.announce.TextTransparency = 0
	ui.announce.TextStrokeTransparency = 0
	ui.announce.Visible = true
	ui.announceScale.Scale = 0.5
	Theme.tween(ui.announceScale, 0.4, { Scale = 1 }, Enum.EasingStyle.Back)
	task.delay(2.5, function()
		Theme.tween(ui.announce, 0.5, { TextTransparency = 1, TextStrokeTransparency = 1 })
	end)
end

function Hud.showResults(r)
	local victory = r.result == "Victory"
	ui.resultTitle.Text = victory and "VICTORY!" or "DEFEATED"
	ui.resultTitle.TextColor3 = victory and Theme.GOLD or Theme.BAD
	ui.resultAdventure.Text = r.adventure or ""
	ui.resultAdventure.TextColor3 = r.color or Theme.TEXT
	countUp(ui.resultRows[1], r.time, function(v)
		v = math.floor(v)
		return string.format("%d:%02d", v // 60, v % 60)
	end)
	countUp(ui.resultRows[2], r.level, function(v)
		return tostring(math.floor(v))
	end)
	countUp(ui.resultRows[3], r.kills, function(v)
		return Theme.comma(v)
	end)
	ui.resultUnlocked.Text = r.unlocked or ""
	countUp(ui.resultGold, r.gold, function(v)
		return "+" .. Theme.comma(v) .. " GOLD"
	end)
	ui.results.Visible = true
	ui.resultScale.Scale = 0.6
	Theme.tween(ui.resultScale, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)
	task.delay(Config.RESULTS_TIME, function()
		ui.results.Visible = false
	end)
end

return Hud
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX08058"><Properties><string name="Name">Lobby</string><ProtectedString name="Source"><![CDATA[-- Spawn island UI: character select, upgrade shop, adventure map select, gold counter,
-- hints and the voyage gate boarding banner.
local RS = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(RS:WaitForChild("Shared"):WaitForChild("Config"))
local Theme = require(script.Parent.Theme)

local Lobby = {}
local ui = {}
local callbacks
local classCards = {}
local shopRows = {}
local mapCards = {}
local diffButtons = {}
local panels = {}
local lastPortalMessage = 0
local portal -- latest boarding info from the server while standing on a gate
local pickerOpened = false -- opened the map select once for this boarding
local selectedMap, selectedDifficulty = Config.Maps[1].key, 1
local meta = { gold = 0, levels = {}, costs = {}, progress = {}, class = Config.DEFAULT_CLASS }

local THEME_COLORS = {
	grass = Color3.fromRGB(80, 160, 70), marine = Color3.fromRGB(70, 110, 180), town = Color3.fromRGB(180, 140, 90),
	beach = Color3.fromRGB(220, 190, 120), ship = Color3.fromRGB(140, 95, 55), deepsea = Color3.fromRGB(40, 120, 190),
	snow = Color3.fromRGB(190, 215, 240), desert = Color3.fromRGB(220, 180, 100), jungle = Color3.fromRGB(40, 120, 60),
	sky = Color3.fromRGB(170, 200, 255), spooky = Color3.fromRGB(110, 60, 140), mangrove = Color3.fromRGB(120, 180, 90),
	prison = Color3.fromRGB(90, 85, 100), volcano = Color3.fromRGB(200, 70, 40), wano = Color3.fromRGB(230, 120, 170),
}
local LOCKED = Color3.fromRGB(55, 58, 75)

local function closeButton(panel, name)
	Theme.button({
		Size = UDim2.fromOffset(40, 40), Position = UDim2.new(1, -52, 0, 12), Text = "X",
		BackgroundColor3 = Theme.BAD, ZIndex = panel.ZIndex + 2,
	}, panel, function()
		Lobby.toggle(name, false)
	end)
end

local function panel(name, width, height, title)
	local frame = Theme.panel({
		Name = name, Size = UDim2.fromOffset(width, height), Position = UDim2.new(0.5, -width / 2, 0.5, -height / 2),
		Visible = false, ZIndex = 10,
	}, ui.root)
	panels[name:lower()] = { frame = frame, scale = Theme.new("UIScale", {}, frame), height = height, width = width }
	Theme.title({ Size = UDim2.new(1, -120, 0, 50), Position = UDim2.fromOffset(24, 14), Text = title, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 11 }, frame)
	closeButton(frame, name:lower())
	return frame
end

local function scroller(parent, props)
	props.BackgroundTransparency = 1
	props.BorderSizePixel = 0
	props.ScrollBarThickness = 8
	props.ScrollingDirection = Enum.ScrollingDirection.Y
	props.CanvasSize = UDim2.new()
	props.AutomaticCanvasSize = Enum.AutomaticSize.Y
	props.ZIndex = 11
	return Theme.new("ScrollingFrame", props, parent)
end

local function isCaptain()
	return portal ~= nil and portal.captain and os.clock() - lastPortalMessage < 0.6
end

-- Character select ------------------------------------------------------------------

local function buildCrew()
	local frame = panel("Crew", 740, 600, "CHOOSE YOUR PIRATE")
	local grid = scroller(frame, { Size = UDim2.new(1, -40, 0, 430), Position = UDim2.fromOffset(20, 76) })
	Theme.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(160, 196), CellPadding = UDim2.fromOffset(10, 10),
		HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder,
	}, grid)
	Theme.new("UIPadding", { PaddingTop = UDim.new(0, 10) }, grid)
	local details = Theme.new("Frame", { Size = UDim2.new(1, -40, 0, 74), Position = UDim2.new(0, 20, 1, -88), BackgroundColor3 = Theme.CARD, ZIndex = 11 }, frame)
	Theme.corner(details, 12)
	ui.detailsTitle = Theme.title({ Size = UDim2.new(1, -24, 0, 24), Position = UDim2.fromOffset(12, 6), TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 12 }, details)
	ui.detailsSkills = Theme.text({
		Size = UDim2.new(1, -24, 0, 36), Position = UDim2.fromOffset(12, 32), TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true, TextColor3 = Theme.TEXT, ZIndex = 12, MaxSize = 16,
	}, details)

	for i, name in Config.CLASS_ORDER do
		local class = Config.Classes[name]
		local skill = Config.Weapons[class.weapon]
		local card = Theme.new("TextButton", { Text = "", AutoButtonColor = false, BackgroundColor3 = Theme.CARD, LayoutOrder = i, ZIndex = 12 }, grid)
		Theme.corner(card, 14)
		local stroke = Theme.stroke(card, class.color, 2, 0.4)
		Theme.gradient(card, Color3.new(1, 1, 1), Color3.fromRGB(150, 155, 185))
		local scale = Theme.new("UIScale", {}, card)

		local portrait = Theme.new("Frame", { Size = UDim2.fromOffset(80, 80), Position = UDim2.new(0.5, -40, 0, 10), BackgroundColor3 = class.color, ZIndex = 13 }, card)
		Theme.corner(portrait, 40)
		Theme.stroke(portrait, Color3.new(1, 1, 1), 3, 0.1)
		Theme.gradient(portrait, Color3.new(1, 1, 1), Color3.fromRGB(110, 110, 120))
		Theme.title({ Size = UDim2.fromScale(0.7, 0.7), Position = UDim2.fromScale(0.15, 0.15), Text = name:sub(1, 1), TextColor3 = Color3.new(1, 1, 1), ZIndex = 14 }, portrait)

		Theme.title({ Size = UDim2.new(1, -16, 0, 26), Position = UDim2.fromOffset(8, 96), Text = name:upper(), TextColor3 = Theme.TEXT, ZIndex = 13 }, card)
		Theme.text({ Size = UDim2.new(1, -16, 0, 18), Position = UDim2.fromOffset(8, 122), Text = class.title, TextColor3 = Theme.MUTED, ZIndex = 13, MaxSize = 15 }, card)
		Theme.text({ Size = UDim2.new(1, -16, 0, 20), Position = UDim2.fromOffset(8, 142), Text = skill.icon .. " " .. skill.name, TextColor3 = skill.color:Lerp(Color3.new(1, 1, 1), 0.3), ZIndex = 13, MaxSize = 16 }, card)
		Theme.text({ Size = UDim2.new(1, -16, 0, 18), Position = UDim2.fromOffset(8, 166), Text = class.perk, TextColor3 = Theme.GOOD, ZIndex = 13, MaxSize = 14 }, card)
		local selected = Theme.title({
			Size = UDim2.fromOffset(110, 22), Position = UDim2.new(0.5, -55, 0, 2), Text = "SELECTED",
			BackgroundTransparency = 0, BackgroundColor3 = Theme.GOLD, TextColor3 = Theme.DARK_TEXT,
			TextStrokeTransparency = 1, Visible = false, ZIndex = 15,
		}, card)
		Theme.corner(selected, 8)

		card.MouseEnter:Connect(function()
			Theme.tween(scale, 0.12, { Scale = 1.05 })
			Lobby.showSkills(name)
		end)
		card.MouseLeave:Connect(function()
			Theme.tween(scale, 0.12, { Scale = 1 })
			Lobby.showSkills(meta.class)
		end)
		card.Activated:Connect(function()
			callbacks.selectClass(name)
		end)
		classCards[name] = { stroke = stroke, selected = selected, color = class.color }
	end
end

-- Upgrade shop --------------------------------------------------------------------------

local function buildShop()
	local frame = panel("Shop", 600, 560, "PERMANENT UPGRADES")
	Theme.text({ Size = UDim2.new(1, -48, 0, 20), Position = UDim2.fromOffset(24, 62), Text = "Spend gold from adventures. Upgrades last forever.", TextColor3 = Theme.MUTED, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 11, MaxSize = 17 }, frame)

	for i, name in Config.META_ORDER do
		local m = Config.Meta[name]
		local row = Theme.new("Frame", {
			Size = UDim2.new(1, -40, 0, 68), Position = UDim2.fromOffset(20, 92 + (i - 1) * 76),
			BackgroundColor3 = Theme.CARD, ZIndex = 11,
		}, frame)
		Theme.corner(row, 12)
		Theme.stroke(row, Color3.new(0, 0, 0), 1, 0.6)
		Theme.title({ Size = UDim2.new(0, 240, 0, 26), Position = UDim2.fromOffset(14, 8), Text = m.name:upper(), TextColor3 = Theme.TEXT, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 12 }, row)
		Theme.text({ Size = UDim2.new(0, 240, 0, 18), Position = UDim2.fromOffset(14, 36), Text = m.desc .. " per level", TextColor3 = Theme.MUTED, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 12, MaxSize = 16 }, row)
		local pips = Theme.new("Frame", { Size = UDim2.fromOffset(150, 12), Position = UDim2.new(1, -330, 0.5, -6), BackgroundTransparency = 1, ZIndex = 12 }, row)
		Theme.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 3), VerticalAlignment = Enum.VerticalAlignment.Center }, pips)
		local pipFrames = {}
		for p = 1, m.max do
			local pip = Theme.new("Frame", { Size = UDim2.fromOffset(math.floor(150 / m.max) - 3, 12), BackgroundColor3 = Color3.fromRGB(60, 65, 95), ZIndex = 13 }, pips)
			Theme.corner(pip, 4)
			pipFrames[p] = pip
		end
		local buy = Theme.button({
			Size = UDim2.fromOffset(150, 46), Position = UDim2.new(1, -164, 0.5, -23), Text = "",
			BackgroundColor3 = Color3.fromRGB(60, 170, 90), ZIndex = 12,
		}, row, function()
			callbacks.buy(name)
		end)
		shopRows[name] = { pips = pipFrames, buy = buy }
	end
end

-- Adventure map select -------------------------------------------------------------------

local function buildVoyage()
	local frame = panel("Voyage", 880, 600, "CHOOSE AN ADVENTURE")
	ui.voyageHint = Theme.text({ Size = UDim2.new(1, -150, 0, 20), Position = UDim2.fromOffset(24, 62), TextColor3 = Theme.MUTED, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 11, MaxSize = 17 }, frame)

	local grid = scroller(frame, { Size = UDim2.fromOffset(560, 490), Position = UDim2.fromOffset(16, 92) })
	Theme.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(128, 88), CellPadding = UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder,
	}, grid)
	Theme.new("UIPadding", { PaddingLeft = UDim.new(0, 4), PaddingTop = UDim.new(0, 4) }, grid)
	for i, map in Config.Maps do
		local card = Theme.new("TextButton", { Text = "", AutoButtonColor = false, BackgroundColor3 = THEME_COLORS[map.theme], LayoutOrder = i, ZIndex = 12 }, grid)
		Theme.corner(card, 10)
		local stroke = Theme.stroke(card, Color3.new(0, 0, 0), 2, 0.5)
		Theme.gradient(card, Color3.new(1, 1, 1), Color3.fromRGB(110, 110, 130))
		Theme.title({ Size = UDim2.fromOffset(28, 20), Position = UDim2.fromOffset(6, 4), Text = tostring(i), TextColor3 = Theme.GOLD, ZIndex = 13, TextXAlignment = Enum.TextXAlignment.Left }, card)
		Theme.title({ Size = UDim2.new(1, -12, 0, 40), Position = UDim2.fromOffset(6, 22), Text = map.name:upper(), TextWrapped = true, TextColor3 = Theme.TEXT, ZIndex = 13, MaxSize = 18 }, card)
		local pips = Theme.new("Frame", { Size = UDim2.new(1, -12, 0, 12), Position = UDim2.new(0, 6, 1, -18), BackgroundTransparency = 1, ZIndex = 13 }, card)
		Theme.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 4) }, pips)
		local pipFrames = {}
		for d = 1, #Config.Difficulties do
			local pip = Theme.new("Frame", { Size = UDim2.fromOffset(18, 10), BackgroundColor3 = Color3.fromRGB(40, 40, 55), ZIndex = 14 }, pips)
			Theme.corner(pip, 4)
			pipFrames[d] = pip
		end
		local lock = Theme.text({ Size = UDim2.fromScale(1, 1), Text = "🔒", BackgroundTransparency = 0.35, BackgroundColor3 = Color3.new(0, 0, 0), ZIndex = 16, Visible = false, MaxSize = 32 }, card)
		Theme.corner(lock, 10)
		card.Activated:Connect(function()
			selectedMap = map.key
			Lobby.refreshVoyage()
		end)
		mapCards[map.key] = { card = card, stroke = stroke, pips = pipFrames, lock = lock }
	end

	local side = Theme.new("Frame", { Size = UDim2.fromOffset(276, 490), Position = UDim2.fromOffset(588, 92), BackgroundColor3 = Theme.CARD, ZIndex = 11 }, frame)
	Theme.corner(side, 12)
	ui.mapName = Theme.title({ Size = UDim2.new(1, -20, 0, 34), Position = UDim2.fromOffset(10, 10), TextWrapped = true, ZIndex = 12 }, side)
	ui.mapBoss = Theme.text({ Size = UDim2.new(1, -20, 0, 20), Position = UDim2.fromOffset(10, 48), TextColor3 = Theme.BAD, ZIndex = 12, MaxSize = 16 }, side)
	ui.mapInfo = Theme.text({ Size = UDim2.new(1, -20, 0, 18), Position = UDim2.fromOffset(10, 70), TextColor3 = Theme.MUTED, ZIndex = 12, MaxSize = 15 }, side)
	for d, diff in Config.Difficulties do
		diffButtons[d] = Theme.button({
			Size = UDim2.new(1, -20, 0, 48), Position = UDim2.fromOffset(10, 98 + (d - 1) * 56), Text = "",
			BackgroundColor3 = diff.color, ZIndex = 12,
		}, side, function()
			selectedDifficulty = d
			Lobby.refreshVoyage()
		end)
	end
	ui.sail = Theme.button({
		Size = UDim2.new(1, -20, 0, 56), Position = UDim2.new(0, 10, 1, -66), Text = "SET SAIL!",
		BackgroundColor3 = Color3.fromRGB(60, 170, 90), ZIndex = 12,
	}, side, function()
		local map = Config.MapByKey[selectedMap]
		if isCaptain() and Config.unlocked(meta.progress, map, selectedDifficulty) then
			callbacks.voyage(selectedMap, selectedDifficulty)
			Lobby.toggle("voyage", false)
		end
	end)
end

-- Portal banner, hint, gold and menu buttons ---------------------------------------------

local function buildHud()
	local gold = Theme.panel({ Size = UDim2.fromOffset(190, 48), Position = UDim2.new(1, -206, 0, 14) }, ui.root)
	ui.gold = Theme.title({ Size = UDim2.new(1, -20, 1, -12), Position = UDim2.fromOffset(10, 6), Text = "💰 0" }, gold)

	local menu = Theme.new("Frame", { Size = UDim2.fromOffset(170, 260), Position = UDim2.new(0, 16, 0.5, -130), BackgroundTransparency = 1 }, ui.root)
	Theme.new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, menu)
	Theme.button({ Size = UDim2.fromOffset(170, 60), Text = "👒 CREW", BackgroundColor3 = Color3.fromRGB(200, 60, 60), LayoutOrder = 1 }, menu, function()
		Lobby.toggle("crew")
	end)
	ui.crewName = Theme.text({ Size = UDim2.new(1, 0, 0, 20), Text = "", TextColor3 = Theme.MUTED, MaxSize = 16, LayoutOrder = 2 }, menu)
	Theme.button({ Size = UDim2.fromOffset(170, 60), Text = "🗺️ MAPS", BackgroundColor3 = Color3.fromRGB(60, 120, 210), LayoutOrder = 3 }, menu, function()
		Lobby.toggle("voyage")
	end)
	Theme.button({ Size = UDim2.fromOffset(170, 60), Text = "💰 SHOP", BackgroundColor3 = Color3.fromRGB(220, 160, 30), LayoutOrder = 4 }, menu, function()
		Lobby.toggle("shop")
	end)

	ui.hint = Theme.panel({ Size = UDim2.fromOffset(600, 50), Position = UDim2.new(0.5, -300, 1, -74) }, ui.root)
	Theme.text({ Size = UDim2.new(1, -24, 1, -14), Position = UDim2.fromOffset(12, 7), Text = "Pick a pirate in CREW, then step onto a voyage gate to choose an adventure!", MaxSize = 19 }, ui.hint)

	local banner = Theme.panel({ Size = UDim2.fromOffset(480, 130), Position = UDim2.new(0.5, -240, 0, 20), Visible = false }, ui.root)
	ui.banner = banner
	ui.bannerStroke = banner:FindFirstChildOfClass("UIStroke")
	ui.bannerScale = Theme.new("UIScale", {}, banner)
	ui.bannerName = Theme.title({ Size = UDim2.new(1, -24, 0, 34), Position = UDim2.fromOffset(12, 8), Text = "" }, banner)
	ui.bannerCaptain = Theme.text({ Size = UDim2.new(1, -24, 0, 20), Position = UDim2.fromOffset(12, 44), Text = "", TextColor3 = Theme.GOLD, MaxSize = 17 }, banner)
	ui.bannerStatus = Theme.text({ Size = UDim2.new(1, -24, 0, 24), Position = UDim2.fromOffset(12, 66), Text = "", MaxSize = 20 }, banner)
	ui.bannerPick = Theme.button({
		Size = UDim2.fromOffset(180, 30), Position = UDim2.new(0.5, -90, 1, -36), Text = "CHOOSE MAP",
		BackgroundColor3 = Color3.fromRGB(60, 120, 210), Visible = false,
	}, banner, function()
		Lobby.toggle("voyage", true)
	end)
end

-- Public ----------------------------------------------------------------------------------

function Lobby.init(gui, cb)
	callbacks = cb
	ui.root = Theme.new("Frame", { Name = "Lobby", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1 }, gui)
	buildHud()
	buildCrew()
	buildShop()
	buildVoyage()
	Lobby.setMeta(meta)

	RunService.Heartbeat:Connect(function()
		local boarding = os.clock() - lastPortalMessage < 0.6
		if ui.banner.Visible ~= boarding then
			ui.banner.Visible = boarding
			if boarding then
				ui.bannerScale.Scale = 0.7
				Theme.tween(ui.bannerScale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
			else
				pickerOpened = false
				portal = nil
				Lobby.refreshVoyage()
			end
		end
		ui.hint.Visible = not boarding
	end)
end

function Lobby.setVisible(visible)
	ui.root.Visible = visible
	if not visible then
		for name in panels do
			Lobby.toggle(name, false)
		end
	end
end

-- Opens or closes a panel (only one at a time). Big panels shrink to fit small screens.
function Lobby.toggle(name, open)
	local p = panels[name]
	if open == nil then
		open = not p.frame.Visible
	end
	if open and not p.frame.Visible then
		for other, q in panels do
			if other ~= name then
				q.frame.Visible = false
			end
		end
		local viewport = workspace.CurrentCamera.ViewportSize
		local fit = math.min(1, (viewport.Y - 90) / p.height, (viewport.X - 40) / p.width)
		p.scale.Scale = fit * 0.85
		Theme.tween(p.scale, 0.25, { Scale = fit }, Enum.EasingStyle.Back)
		if name == "voyage" then
			Lobby.refreshVoyage()
		end
	end
	p.frame.Visible = open
end

-- Lists a character's 6 skills under the character cards.
function Lobby.showSkills(name)
	local class = Config.Classes[name]
	if not class then
		return
	end
	local names = {}
	for _, key in class.skills do
		local w = Config.Weapons[key]
		table.insert(names, w.icon .. " " .. w.name)
	end
	ui.detailsTitle.Text = name:upper() .. "'S 6 SKILLS"
	ui.detailsTitle.TextColor3 = class.color:Lerp(Color3.new(1, 1, 1), 0.3)
	ui.detailsSkills.Text = table.concat(names, "   ")
end

-- Redraws the map select: unlocks, cleared difficulties, the selected map and difficulty.
function Lobby.refreshVoyage()
	local progress = meta.progress or {}
	for _, map in Config.Maps do
		local card = mapCards[map.key]
		local open = Config.unlocked(progress, map, 1)
		card.lock.Visible = not open
		for d, pip in card.pips do
			pip.BackgroundColor3 = (progress[map.key] or 0) >= d and Config.Difficulties[d].color or Color3.fromRGB(40, 40, 55)
		end
		local chosen = map.key == selectedMap
		card.stroke.Color = chosen and Theme.GOLD or Color3.new(0, 0, 0)
		card.stroke.Thickness = chosen and 4 or 2
		card.stroke.Transparency = chosen and 0 or 0.5
	end

	local map = Config.MapByKey[selectedMap]
	ui.mapName.Text = map.index .. ". " .. map.name:upper()
	ui.mapBoss.Text = "Boss: " .. map.boss
	ui.mapInfo.Text = string.format("Enemy power x%.1f   |   Gold x%.1f", map.hp, map.gold)
	if not Config.unlocked(progress, map, selectedDifficulty) then
		selectedDifficulty = 1
	end
	for d, button in diffButtons do
		local diff = Config.Difficulties[d]
		local open = Config.unlocked(progress, map, d)
		local cleared = (progress[map.key] or 0) >= d
		button.BackgroundColor3 = open and diff.color or LOCKED
		button.Text = (open and "" or "🔒 ") .. diff.name:upper()
			.. string.format("  (+%d%% gold)", math.floor((diff.gold - 1) * 100 + 0.5)) .. (cleared and "  ✓" or "")
		button:FindFirstChildOfClass("UIStroke").Color = d == selectedDifficulty and Theme.GOLD or Color3.new(1, 1, 1)
		button:FindFirstChildOfClass("UIStroke").Transparency = d == selectedDifficulty and 0 or 0.75
	end

	local open = Config.unlocked(progress, map, selectedDifficulty)
	if not open then
		ui.sail.Text = map.index > 1 and (progress[Config.Maps[map.index - 1].key] or 0) < 1
			and "CLEAR " .. Config.Maps[map.index - 1].name:upper() .. " FIRST" or "LOCKED"
		ui.sail.BackgroundColor3 = LOCKED
	elseif isCaptain() then
		ui.sail.Text = "SET SAIL!"
		ui.sail.BackgroundColor3 = Color3.fromRGB(60, 170, 90)
	else
		ui.sail.Text = portal and "ONLY THE CAPTAIN CHOOSES" or "STAND ON A GATE TO SAIL"
		ui.sail.BackgroundColor3 = LOCKED
	end
	ui.voyageHint.Text = isCaptain() and "You are the captain! Pick a map and difficulty, then set sail."
		or "Clear a difficulty to unlock the next one. Clear a map on Easy to unlock the next map."
end

function Lobby.setMeta(data)
	meta = data
	meta.progress = meta.progress or {}
	Lobby.showSkills(data.class)
	ui.gold.Text = "💰 " .. Theme.comma(data.gold)
	ui.crewName.Text = data.class and "Playing as " .. data.class or ""
	for name, card in classCards do
		local chosen = name == data.class
		card.selected.Visible = chosen
		card.stroke.Color = chosen and Theme.GOLD or card.color
		card.stroke.Thickness = chosen and 4 or 2
		card.stroke.Transparency = chosen and 0 or 0.4
	end
	for name, row in shopRows do
		local level = data.levels[name] or 0
		for i, pip in row.pips do
			pip.BackgroundColor3 = i <= level and Theme.GOLD or Color3.fromRGB(60, 65, 95)
		end
		local cost = data.costs[name]
		if not cost then
			row.buy.Text = "MAXED"
			row.buy.BackgroundColor3 = Color3.fromRGB(90, 95, 120)
		else
			row.buy.Text = "💰 " .. Theme.comma(cost)
			row.buy.BackgroundColor3 = data.gold >= cost and Color3.fromRGB(60, 170, 90) or Color3.fromRGB(150, 60, 60)
		end
	end
	Lobby.refreshVoyage()
end

-- Called while standing on a voyage gate.
function Lobby.portal(info)
	local wasCaptain = isCaptain()
	portal = info
	lastPortalMessage = os.clock()
	ui.bannerName.Text = "⛵ VOYAGE GATE " .. info.gate
	ui.bannerName.TextColor3 = info.color
	ui.bannerStroke.Color = info.color
	ui.bannerStroke.Transparency = 0
	ui.bannerCaptain.Text = info.captain and "You are the captain!" or ("Captain: " .. (info.captainName or "?"))
	ui.bannerStatus.Text = info.text
	ui.bannerPick.Visible = info.captain
	panels.crew.frame.Visible = false
	panels.shop.frame.Visible = false
	-- the captain gets the map select once per boarding
	if info.captain and not info.map and not pickerOpened then
		pickerOpened = true
		Lobby.toggle("voyage", true)
	end
	if wasCaptain ~= isCaptain() then
		Lobby.refreshVoyage()
	end
end

return Lobby
]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX08059"><Properties><string name="Name">SwarmClient</string><ProtectedString name="Source"><![CDATA[-- Client entry point: builds the UI and connects it to the server's remotes.
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local UIS = game:GetService("UserInputService")
local StarterGui = game:GetService("StarterGui")

local remotes = RS:WaitForChild("Remotes")
local player = Players.LocalPlayer
local Effects = require(script.Parent:WaitForChild("Effects"))
local Hud = require(script.Parent:WaitForChild("Hud"))
local Lobby = require(script.Parent:WaitForChild("Lobby"))

-- our own health bar replaces the default one
pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
end)

local gui = Instance.new("ScreenGui")
gui.Name = "SwarmUI"
gui.ResetOnSpawn = false
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = player:WaitForChild("PlayerGui")

Hud.init(gui, {
	choose = function(i)
		remotes.Choose:FireServer(i)
	end,
	reroll = function()
		remotes.Reroll:FireServer()
	end,
})
Lobby.init(gui, {
	selectClass = function(name)
		remotes.SelectClass:FireServer(name)
	end,
	buy = function(name)
		remotes.BuyMeta:FireServer(name)
	end,
	voyage = function(mapKey, difficulty)
		remotes.Voyage:FireServer(mapKey, difficulty)
	end,
})

remotes.Fx.OnClientEvent:Connect(function(list)
	for _, ev in list do
		Effects.play(ev)
	end
end)
remotes.Stats.OnClientEvent:Connect(Hud.setStats)
remotes.LevelUp.OnClientEvent:Connect(Hud.showLevelUp)
remotes.Announce.OnClientEvent:Connect(Hud.announce)
remotes.Results.OnClientEvent:Connect(Hud.showResults)
remotes.Meta.OnClientEvent:Connect(Lobby.setMeta)
remotes.Portal.OnClientEvent:Connect(Lobby.portal)

remotes.State.OnClientEvent:Connect(function(state)
	local running = state.phase == "Run"
	if not running then
		Effects.clear()
	end
	Hud.setVisible(running)
	Hud.setState(state)
	Lobby.setVisible(state.phase == "Lobby")
end)

local KEYS = { [Enum.KeyCode.One] = 1, [Enum.KeyCode.Two] = 2, [Enum.KeyCode.Three] = 3 }
UIS.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	if KEYS[input.KeyCode] then
		Hud.choose(KEYS[input.KeyCode])
	elseif input.KeyCode == Enum.KeyCode.R then
		Hud.reroll()
	end
end)

remotes.Meta:FireServer()
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX08060"><Properties><string name="Name">Theme</string><ProtectedString name="Source"><![CDATA[-- Shared look for every menu: colors, fonts and small UI builders.
local TweenService = game:GetService("TweenService")

local Theme = {}

Theme.BG = Color3.fromRGB(14, 18, 36)
Theme.PANEL = Color3.fromRGB(26, 32, 60)
Theme.CARD = Color3.fromRGB(38, 46, 84)
Theme.STROKE = Color3.fromRGB(95, 115, 190)
Theme.GOLD = Color3.fromRGB(255, 205, 60)
Theme.TEXT = Color3.fromRGB(242, 245, 255)
Theme.MUTED = Color3.fromRGB(160, 172, 210)
Theme.GOOD = Color3.fromRGB(90, 220, 120)
Theme.BAD = Color3.fromRGB(240, 70, 70)
Theme.DARK_TEXT = Color3.fromRGB(20, 22, 35)
Theme.TITLE_FONT = Enum.Font.LuckiestGuy
Theme.FONT = Enum.Font.FredokaOne

function Theme.new(class, props, parent)
	local obj = Instance.new(class)
	for k, v in props do
		obj[k] = v
	end
	obj.Parent = parent
	return obj
end

function Theme.tween(obj, time, goal, style, direction)
	local info = TweenInfo.new(time, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out)
	local t = TweenService:Create(obj, info, goal)
	t:Play()
	return t
end

function Theme.corner(parent, radius)
	return Theme.new("UICorner", { CornerRadius = UDim.new(0, radius or 12) }, parent)
end

function Theme.stroke(parent, color, thickness, transparency)
	return Theme.new("UIStroke", {
		Color = color or Theme.STROKE, Thickness = thickness or 2, Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, parent)
end

-- Vertical gradient that tints whatever color the parent has.
function Theme.gradient(parent, top, bottom, rotation)
	return Theme.new("UIGradient", { Color = ColorSequence.new(top, bottom), Rotation = rotation or 90 }, parent)
end

function Theme.panel(props, parent)
	props.BackgroundColor3 = props.BackgroundColor3 or Theme.PANEL
	local frame = Theme.new("Frame", props, parent)
	Theme.corner(frame, 16)
	Theme.stroke(frame, Theme.STROKE, 2, 0.35)
	Theme.gradient(frame, Color3.new(1, 1, 1), Color3.fromRGB(150, 160, 190))
	return frame
end

-- Text label. Pass MaxSize to cap scaled text.
function Theme.text(props, parent)
	local maxSize = props.MaxSize
	props.MaxSize = nil
	props.BackgroundTransparency = props.BackgroundTransparency or 1
	props.TextColor3 = props.TextColor3 or Theme.TEXT
	props.Font = props.Font or Theme.FONT
	if props.TextScaled == nil then
		props.TextScaled = true
	end
	local label = Theme.new("TextLabel", props, parent)
	if maxSize then
		Theme.new("UITextSizeConstraint", { MaxTextSize = maxSize }, label)
	end
	return label
end

function Theme.title(props, parent)
	props.Font = Theme.TITLE_FONT
	props.TextColor3 = props.TextColor3 or Theme.GOLD
	props.TextStrokeTransparency = props.TextStrokeTransparency or 0
	props.TextStrokeColor3 = props.TextStrokeColor3 or Color3.fromRGB(30, 15, 0)
	return Theme.text(props, parent)
end

-- Rounded button that grows on hover and squishes when pressed.
function Theme.button(props, parent, onClick)
	props.AutoButtonColor = false
	props.BackgroundColor3 = props.BackgroundColor3 or Theme.CARD
	props.Font = props.Font or Theme.TITLE_FONT
	props.TextColor3 = props.TextColor3 or Theme.TEXT
	if props.TextScaled == nil then
		props.TextScaled = true
	end
	local button = Theme.new("TextButton", props, parent)
	Theme.corner(button, 12)
	local stroke = Theme.stroke(button, Color3.new(1, 1, 1), 2, 0.75)
	Theme.gradient(button, Color3.new(1, 1, 1), Color3.fromRGB(170, 175, 200))
	Theme.new("UITextSizeConstraint", { MaxTextSize = 26 }, button)
	local scale = Theme.new("UIScale", {}, button)
	button.MouseEnter:Connect(function()
		Theme.tween(scale, 0.12, { Scale = 1.05 })
		Theme.tween(stroke, 0.12, { Transparency = 0.2 })
	end)
	button.MouseLeave:Connect(function()
		Theme.tween(scale, 0.12, { Scale = 1 })
		Theme.tween(stroke, 0.12, { Transparency = 0.75 })
	end)
	button.MouseButton1Down:Connect(function()
		Theme.tween(scale, 0.06, { Scale = 0.95 })
	end)
	button.MouseButton1Up:Connect(function()
		Theme.tween(scale, 0.1, { Scale = 1.05 })
	end)
	if onClick then
		button.Activated:Connect(onClick)
	end
	return button
end

-- Rounded progress bar. Returns the frame, its fill and a centered label.
function Theme.bar(props, parent, top, bottom)
	props.BackgroundColor3 = props.BackgroundColor3 or Theme.BG
	props.BackgroundTransparency = props.BackgroundTransparency or 0.15
	local frame = Theme.new("Frame", props, parent)
	Theme.corner(frame, 10)
	Theme.stroke(frame, Color3.new(0, 0, 0), 2, 0.4)
	local fill = Theme.new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0 }, frame)
	Theme.corner(fill, 10)
	Theme.gradient(fill, top, bottom)
	local label = Theme.text({ Size = UDim2.fromScale(1, 1), ZIndex = (props.ZIndex or 1) + 1, TextStrokeTransparency = 0.3, MaxSize = 18 }, frame)
	return frame, fill, label
end

function Theme.comma(n)
	local s = tostring(math.floor(n))
	repeat
		local count
		s, count = s:gsub("^(-?%d+)(%d%d%d)", "%1,%2")
	until count == 0
	return s
end

return Theme
]]></ProtectedString></Properties></Item></Item></Item><Item class="StarterCharacterScripts" referent="RBX08064"><Properties><string name="Name">StarterCharacterScripts</string></Properties><Item class="Script" referent="RBX08063"><Properties><string name="Name">Health</string><ProtectedString name="Source"><![CDATA[-- Empty on purpose: replaces Roblox's default health regen, so healing only comes
-- from Chopper and level-up rewards.
]]></ProtectedString></Properties></Item></Item></Item></roblox>
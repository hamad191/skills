-- Replaces any gear on the character with this class's gear.
function Gear.apply(character, className)
	if not character then
		return
	end
	local old = character:FindFirstChild("PirateGear")
	if old then
		old:Destroy()
	end
	local pieces = GEAR[className]
	if not pieces then
		return
	end
	local folder = Instance.new("Folder")
	folder.Name = "PirateGear"
	for _, piece in pieces do
		local attachName, size, offset, color, shape, material = piece[1], piece[2], piece[3], piece[4], piece[5], piece[6]
		local attach = character:FindFirstChild(attachName) or (R6[attachName] and character:FindFirstChild(R6[attachName]))
		if attach and attach:IsA("BasePart") then
			local p = Instance.new("Part")
			p.Name = attachName .. "Gear"
			p.Shape = shape or Enum.PartType.Block
			p.Size = size
			p.Color = color
			p.Material = material or Enum.Material.SmoothPlastic
			p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
			p.CanCollide, p.CanQuery, p.CanTouch, p.Massless, p.CastShadow = false, false, false, true, false
			p.CFrame = attach.CFrame * offset
			local weld = Instance.new("WeldConstraint")
			weld.Part0, weld.Part1 = attach, p
			weld.Parent = p
			p.Parent = folder
		end
	end
	folder.Parent = character
end

return Gear
]]></ProtectedString></Properties></Item><Item class="Script" referent="RBX13480"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[-- Game flow:
--   Spawn island: pick a character, train and gear up with the NPCs, step onto a voyage gate.
--   The first player on a pad is the captain and picks a map + difficulty they have unlocked.
--   When the gate's countdown ends, everyone on the pad sails to that map's arena.
--   Each adventure runs until its boss falls, its time runs out, or its whole crew is down.
--   Players can leave early (keeping the gold they earned) or be revived.
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(RS.Shared.Config)
local PlayerData = require(script.Parent.PlayerData)
local Enemies = require(script.Parent.Enemies)
local Progression = require(script.Parent.Progression)
local Weapons = require(script.Parent.Weapons)
local Fx = require(script.Parent.Fx)
local Portals = require(script.Parent.Portals)
local Gear = require(script.Parent.Gear)
local Npcs = require(script.Parent.Npcs)
local Monetization = require(script.Parent.Monetization)

Players.CharacterAutoLoads = false

local remotes = {}
local remoteFolder = Instance.new("Folder")
remoteFolder.Name = "Remotes"
for _, name in {
	"State", "Stats", "LevelUp", "Choose", "Reroll", "SelectClass", "BuyMeta", "Meta", "Results", "Fx", "Portal",
	"Announce", "Voyage", "Dash", "Leave", "Revive", "Train", "Gear",
} do
	local r = Instance.new("RemoteEvent")
	r.Name = name
	r.Parent = remoteFolder
	remotes[name] = r
end
remoteFolder.Parent = RS
Progression.init(remotes)
Fx.init(remotes.Fx)
Portals.build()
Npcs.build()

local LOBBY_TEXT = "Step onto a voyage gate to choose an adventure!"
local selectedClass = {}
local runOf = {} -- [player] = the run they are in (nil = on the spawn island)
local runs = {} -- [mapKey] = run in progress (one crew per map at a time)
local lastDash = {} -- [player] = os.clock() of their last dash
local gates = {} -- [gateIndex] = { captain, map, difficulty, launchAt }
for i in Config.GATES do
	gates[i] = {}
end

local function classOf(player)
	return selectedClass[player] or Config.DEFAULT_CLASS
end

local function sendMeta(player)
	local data = PlayerData.get(player)
	if not data then
		return
	end
	local costs = {}
	for name, m in Config.Meta do
		costs[name] = data.meta[name] < m.max and PlayerData.metaCost(name, data.meta[name]) or false
	end
	local boosts = {}
	for boost, untilTime in data.boosts do
		boosts[boost] = math.max(0, untilTime - os.time())
	end
	remotes.Meta:FireClient(player, {
		gold = data.gold, levels = data.meta, costs = costs, progress = data.progress, class = classOf(player),
		mastery = data.mastery, training = data.training, items = data.items, equipped = data.equipped,
		revives = data.revives, boosts = boosts, passes = Monetization.ownedList(player),
		dashCooldown = Monetization.dashCooldown(player), loadFailed = data.loadFailed == true,
	})
end

local function sendLobby(player)
	remotes.State:FireClient(player, { phase = "Lobby", text = LOBBY_TEXT })
end

local function announce(run, text, color)
	for player in run.players do
		remotes.Announce:FireClient(player, text, color)
	end
end

local function sendToArena(player, center)
	local character = player.Character
	local root = character and character:WaitForChild("HumanoidRootPart", 5)
	if not root then
		return
	end
	local a = math.random() * 2 * math.pi
	local r = math.random() * Config.ARENA_DROP_RADIUS
	character:PivotTo(CFrame.new(center.X + math.cos(a) * r, center.Y + 5, center.Z + math.sin(a) * r))
end

-- A gold "VIP" tag over the heads of VIP pass owners.
local function addVipTag(character)
	local head = character:WaitForChild("Head", 5)
	if not head or head:FindFirstChild("VipTag") then
		return
	end
	local tag = Instance.new("BillboardGui")
	tag.Name = "VipTag"
	tag.Size = UDim2.fromOffset(90, 26)
	tag.StudsOffset = Vector3.new(0, 3.2, 0)
	tag.MaxDistance = 80
	tag.Parent = head
	local text = Instance.new("TextLabel")
	text.Size = UDim2.fromScale(1, 1)
	text.BackgroundTransparency = 1
	text.Text = "👑 VIP"
	text.TextScaled = true
	text.Font = Enum.Font.GothamBlack
	text.TextColor3 = Color3.fromRGB(255, 205, 60)
	text.TextStrokeTransparency = 0.3
	text.Parent = tag
end

local function onCharacter(player, character)
	local hum = character:WaitForChild("Humanoid")
	hum.Died:Connect(function()
		local s = Progression.get(player)
		if runOf[player] and s then
			-- out until revived or the crew's adventure ends; they can watch or leave
			s.dead = true
			Weapons.cleanup(player)
			remotes.LevelUp:FireClient(player, nil)
			return
		end
		task.wait(3)
		if player.Parent and not runOf[player] then
			player:LoadCharacter()
		end
	end)
	Progression.applyStats(player)
	task.spawn(function()
		character:WaitForChild("HumanoidRootPart", 5)
		task.wait(0.3) -- let the body parts finish loading
		if character.Parent then
			Gear.apply(character, classOf(player))
			if Monetization.owns(player, "VIP") then
				addVipTag(character)
			end
		end
	end)
end

local function onPlayerAdded(player)
	PlayerData.load(player)
	if not player.Parent then
		return
	end
	Monetization.load(player)
	player.CharacterAdded:Connect(function(character)
		onCharacter(player, character)
	end)
	player:LoadCharacter()
	sendMeta(player)
	sendLobby(player)
	local data = PlayerData.get(player)
	if data and data.loadFailed then
		remotes.Announce:FireClient(player, "Your save couldn't load - progress won't save this visit. Try rejoining.", Config.RARITIES.Mythic)
	end
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end

Players.PlayerRemoving:Connect(function(player)
	local run = runOf[player]
	if run then
		run.players[player] = nil
	end
	runOf[player] = nil
	lastDash[player] = nil
	Weapons.cleanup(player)
	Progression.stop(player)
	selectedClass[player] = nil
	Monetization.release(player)
	PlayerData.release(player)
end)

Enemies.onKilled = function(enemy, killer)
	local s = killer and Progression.get(killer)
	if s then
		s.kills += 1
		s.bonusGold += enemy.def.gold or 0
	end
end
Enemies.onPickup = Progression.addXP

local function runTargets(run)
	local targets = {}
	for player in run.players do
		local s = Progression.get(player)
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local hum = character and character:FindFirstChildOfClass("Humanoid")
		if s and not s.dead and root and hum and hum.Health > 0 then
			table.insert(targets, {
				player = player, s = s, root = root, hum = hum, magnet = Progression.magnet(s),
				armor = math.min(Config.MAX_DEFENSE, Progression.bonus(s, "defense")),
			})
		end
	end
	return targets
end

RunService.Heartbeat:Connect(function(dt)
	local targetsByRun = {}
	for key, run in runs do
		targetsByRun[key] = runTargets(run)
	end
	Enemies.step(dt, targetsByRun)
	Weapons.step(dt)
	Fx.flush()
end)

-- Rewards ---------------------------------------------------------------------------------

-- Picks a free gear drop for a victory, or nil. Owning it already turns it into gold.
local function rollDrop(difficulty)
	local drops = Config.DROPS[difficulty]
	if math.random() > drops.chance then
		return nil
	end
	local total = 0
	for _, weight in drops.weights do
		total += weight
	end
	local roll, rarity = math.random() * total, "Common"
	for name, weight in drops.weights do
		roll -= weight
		if roll <= 0 then
			rarity = name
			break
		end
	end
	local pool = {}
	for _, item in Config.GEAR_ITEMS do
		if item.rarity == rarity then
			table.insert(pool, item)
		end
	end
	return pool[math.random(#pool)]
end

-- What a first clear of this map + difficulty opens up.
local function unlockMessage(map, difficulty)
	local unlocked = {}
	if Config.Difficulties[difficulty + 1] then
		table.insert(unlocked, map.name .. " " .. Config.Difficulties[difficulty + 1].name)
	end
	if difficulty == 1 and Config.Maps[map.index + 1] then
		table.insert(unlocked, Config.Maps[map.index + 1].name)
	end
	return #unlocked > 0 and "Unlocked: " .. table.concat(unlocked, " and ") or nil
end

-- Gold, unlocks and drops for one player at the end of their adventure (or when they leave).
local function reward(player, run, result)
	local s, data = Progression.get(player), PlayerData.get(player)
	if not s or not data then
		return
	end
	local map, diff = run.map, run.diff
	local elapsed = os.clock() - run.start
	local gold = s.kills + math.floor(elapsed / 10) + s.bonusGold + (result == "Victory" and 500 or 0)
	gold = math.floor(gold * map.gold * diff.gold * (1 + Progression.bonus(s, "gold")) * Monetization.goldMultiplier(player))
	local unlocked, drop
	if result == "Victory" then
		if PlayerData.recordClear(player, map.key, run.difficulty) then
			unlocked = unlockMessage(map, run.difficulty)
		end
		local item = rollDrop(run.difficulty)
		if item then
			if PlayerData.grantItem(player, item.id) then
				drop = { name = item.name, icon = item.icon, rarity = item.rarity }
			else
				gold += Config.DUPLICATE_GOLD[item.rarity]
				drop = { name = item.name, icon = item.icon, rarity = item.rarity, duplicate = Config.DUPLICATE_GOLD[item.rarity] }
			end
		end
	end
	data.gold += gold
	task.spawn(PlayerData.save, player)
	remotes.Results:FireClient(player, {
		result = result, adventure = map.name .. "  -  " .. diff.name, color = diff.color,
		gold = gold, kills = s.kills, level = s.level, time = math.floor(elapsed), unlocked = unlocked, drop = drop,
	})
end

-- Takes a player out of their run and back to the island.
local function sendHome(player)
	runOf[player] = nil
	Weapons.cleanup(player)
	Progression.stop(player)
	if player.Parent then
		player:LoadCharacter() -- back to the spawn island with default stats
		sendMeta(player)
		sendLobby(player)
	end
end

-- Running an adventure --------------------------------------------------------------------

local function spawnAround(kind, run, targets, hpScale, dmgScale, look)
	-- only around crew members who have landed in the arena
	local landed = {}
	for _, t in targets do
		local offset = t.root.Position - run.map.center
		if math.abs(offset.X) <= Config.ARENA_HALF_SIZE and math.abs(offset.Z) <= Config.ARENA_HALF_SIZE then
			table.insert(landed, t)
		end
	end
	if #landed == 0 then
		return nil
	end
	local p = landed[math.random(#landed)].root.Position
	for _ = 1, 6 do
		local a = math.random() * 2 * math.pi
		local d = Config.SPAWN_MIN + math.random() * (Config.SPAWN_MAX - Config.SPAWN_MIN)
		local e = Enemies.spawn(kind, p.X + math.cos(a) * d, p.Z + math.sin(a) * d, hpScale, dmgScale, run.key, look)
		if e then
			return e
		end
	end
	-- the player is near the edge of the map: spawn close instead
	return Enemies.spawn(kind, p.X, p.Z + 15, hpScale, dmgScale, run.key, look)
end

-- Weighted pick from Config.SPAWN_TABLE: later maps and later minutes bring tougher Marines.
local function pickKind(minutes, mapIndex)
	local options, total = {}, 0
	for _, row in Config.SPAWN_TABLE do
		if mapIndex >= row[2] and minutes >= row[3] then
			table.insert(options, row)
			total += row[4]
		end
	end
	local roll = math.random() * total
	for _, row in options do
		roll -= row[4]
		if roll <= 0 then
			return row[1]
		end
	end
	return "Grunt"
end

-- Once a second: Regeneration heals its owner, and healers (Chopper) heal everyone nearby.
local function healers(targets)
	for _, t in targets do
		local regen = Progression.bonus(t.s, "regen")
		if regen > 0 then
			t.hum.Health = math.min(t.hum.MaxHealth, t.hum.Health + regen)
		end
	end
	for _, healer in targets do
		local amount = Progression.bonus(healer.s, "heal")
		if amount > 0 then
			for _, t in targets do
				if (t.root.Position - healer.root.Position).Magnitude <= 30 then
					t.hum.Health = math.min(t.hum.MaxHealth, t.hum.Health + amount)
				end
			end
		end
	end
end

local function clock(seconds)
	seconds = math.max(0, math.ceil(seconds))
	return string.format("%d:%02d", seconds // 60, seconds % 60)
end

local function playRun(run)
	local map, diff = run.map, run.diff
	local nextMini = Config.MINIBOSS_EVERY
	local lastTick = 0
	local boss, bossAt, enraged
	task.wait(1) -- let the crew land
	while true do
		local elapsed = os.clock() - run.start
		local minutes = elapsed / 60
		local targets = runTargets(run)
		if #targets == 0 then
			return "Defeat"
		end

		local crew = 1 + 0.3 * (#targets - 1)
		local hpScale = (1 + minutes * 0.4) * crew * map.hp * diff.hp
		local dmgScale = (1 + minutes * 0.15) * map.damage * diff.damage
		local desired = math.min(Config.MAX_ENEMIES, math.floor((15 + minutes * 12) * crew))
		for _ = 1, math.min(4, desired - Enemies.count(run.key)) do
			spawnAround(pickKind(minutes, map.index), run, targets, hpScale, dmgScale)
		end
		if elapsed >= nextMini and elapsed < diff.runLength then
			nextMini += Config.MINIBOSS_EVERY
			if spawnAround("MiniBoss", run, targets, hpScale, dmgScale) then
				announce(run, "A Vice Admiral appeared!", Color3.fromRGB(190, 90, 255))
			end
		end
		if elapsed >= diff.runLength then
			if not boss then
				local look = { name = map.boss, color = map.bossColor, accent = map.bossAccent }
				boss = spawnAround("Boss", run, targets, crew * map.hp * diff.hp, map.damage * diff.damage, look)
				if boss then
					bossAt = elapsed
					announce(run, map.boss .. " has arrived!", Color3.fromRGB(255, 60, 60))
				end
			elseif boss.dead then
				return "Victory"
			elseif elapsed - bossAt >= Config.BOSS_TIME_LIMIT then
				announce(run, "Time's up! The Marines hold the line.", Color3.fromRGB(255, 60, 60))
				return "Defeat"
			elseif not enraged and elapsed - bossAt >= Config.BOSS_ENRAGE_AT then
				enraged = true
				boss.damage *= 1.75
				announce(run, map.boss .. " is ENRAGED!", Color3.fromRGB(255, 40, 40))
			end
		end

		if os.clock() - lastTick >= 1 then
			lastTick = os.clock()
			healers(targets)
			local text = not boss and clock(diff.runLength - elapsed)
				or "BOSS  " .. clock(Config.BOSS_TIME_LIMIT - (elapsed - bossAt))
			local crewIds = {}
			for player in run.players do
				table.insert(crewIds, player.UserId)
			end
			for player in run.players do
				local s = Progression.get(player)
				remotes.State:FireClient(player, {
					phase = "Run", text = text, adventure = map.name .. "  -  " .. diff.name, color = diff.color,
					down = s ~= nil and s.dead, boss = boss ~= nil, crew = crewIds,
				})
				Progression.sync(player)
			end
		end
		task.wait(0.25)
	end
end

local function finishRun(run, result)
	run.ending = true
	for player in run.players do
		reward(player, run, result)
		remotes.State:FireClient(player, { phase = "Results", text = result == "Victory" and "VICTORY!" or "DEFEATED" })
		Weapons.cleanup(player)
		Progression.stop(player)
	end
	Enemies.clear(run.key)
	task.wait(Config.RESULTS_TIME)
	for player in run.players do
		sendHome(player)
	end
	runs[run.key] = nil
end

local function startRun(map, difficulty, crew)
	local diff = Config.Difficulties[difficulty]
	local run = { key = map.key, map = map, diff = diff, difficulty = difficulty, players = {}, start = os.clock() }
	runs[map.key] = run
	for _, player in crew do
		local data = PlayerData.get(player)
		if player.Parent and data and not runOf[player] then
			run.players[player] = true
			runOf[player] = run
			local extra = PlayerData.gearBonus(player)
			for stat, value in Monetization.bonus(player) do
				extra[stat] = (extra[stat] or 0) + value
			end
			Progression.start(player, classOf(player), data, extra)
			Progression.applyStats(player)
			Progression.sync(player)
			remotes.State:FireClient(player, {
				phase = "Run", text = "Set sail!", adventure = map.name .. "  -  " .. diff.name, color = diff.color,
			})
			task.spawn(sendToArena, player, map.center)
		end
	end
	finishRun(run, playRun(run))
end

-- Revives a knocked-out player in their run using one revive (from the store).
local function revive(player)
	local run, s, data = runOf[player], Progression.get(player), PlayerData.get(player)
	if not (run and not run.ending and s and s.dead and data and data.revives > 0) then
		return false
	end
	data.revives -= 1
	s.dead = false
	s.invulnerableUntil = os.clock() + 3
	player:LoadCharacter()
	task.spawn(sendToArena, player, run.map.center)
	announce(run, player.DisplayName .. " is back in the fight!", Config.RARITIES.Legendary)
	task.spawn(PlayerData.save, player)
	sendMeta(player)
	return true
end

-- Player requests -------------------------------------------------------------------------

remotes.Choose.OnServerEvent:Connect(function(player, index)
	if typeof(index) == "number" then
		Progression.choose(player, index)
	end
end)
remotes.Reroll.OnServerEvent:Connect(Progression.reroll)
remotes.Meta.OnServerEvent:Connect(sendMeta)
remotes.SelectClass.OnServerEvent:Connect(function(player, name)
	if not runOf[player] and typeof(name) == "string" and Config.Classes[name] then
		selectedClass[player] = name
		Gear.apply(player.Character, name)
		sendMeta(player)
	end
end)
remotes.BuyMeta.OnServerEvent:Connect(function(player, name)
	if not runOf[player] and typeof(name) == "string" and PlayerData.buy(player, name) then
		sendMeta(player)
	end
end)
remotes.Train.OnServerEvent:Connect(function(player, kind, name)
	if not runOf[player] and typeof(kind) == "string" and typeof(name) == "string" and PlayerData.train(player, kind, name) then
		sendMeta(player)
	end
end)
remotes.Gear.OnServerEvent:Connect(function(player, action, id)
	if runOf[player] or typeof(action) ~= "string" or typeof(id) ~= "string" then
		return
	end
	local changed = action == "buy" and PlayerData.buyGear(player, id) or action == "equip" and PlayerData.equipGear(player, id)
	if changed then
		sendMeta(player)
	end
end)
-- The captain of a gate picks where the crew sails.
remotes.Voyage.OnServerEvent:Connect(function(player, mapKey, difficulty)
	if typeof(mapKey) ~= "string" or typeof(difficulty) ~= "number" then
		return
	end
	for _, gate in gates do
		if gate.captain == player then
			if PlayerData.unlocked(player, mapKey, difficulty) and not runs[mapKey] then
				gate.map, gate.difficulty, gate.launchAt = mapKey, difficulty, nil
			end
			return
		end
	end
end)
-- The client moves the character; the server grants the dash's moment of safety and shows it.
remotes.Dash.OnServerEvent:Connect(function(player)
	local now = os.clock()
	if now - (lastDash[player] or 0) < Monetization.dashCooldown(player) * 0.9 then
		return
	end
	lastDash[player] = now
	local s = Progression.get(player)
	if s and not s.dead then
		s.invulnerableUntil = math.max(s.invulnerableUntil, now + Config.DASH.invulnerable)
	end
	Fx.emit("dash", { p = player })
end)
-- Leaving keeps the gold earned so far (no victory bonus).
remotes.Leave.OnServerEvent:Connect(function(player)
	local run = runOf[player]
	if run and not run.ending then
		reward(player, run, "Defeat")
		run.players[player] = nil
		sendHome(player)
	end
end)
remotes.Revive.OnServerEvent:Connect(revive)

Monetization.onChanged = function(player)
	sendMeta(player)
	if Monetization.owns(player, "VIP") and player.Character then
		task.spawn(addVipTag, player.Character)
	end
end
Monetization.onRevive = revive

-- Voyage gates ----------------------------------------------------------------------------

-- The first player on a pad is captain; when the countdown ends, the crew sails.
local function updateGate(index, gate)
	local aboard = {}
	for _, player in Portals.playersInside(index) do
		if not runOf[player] then
			table.insert(aboard, player)
		end
	end
	if not table.find(aboard, gate.captain) then
		-- the captain stepped off: the next player in line takes over and picks again
		gate.captain, gate.map, gate.difficulty, gate.launchAt = aboard[1], nil, nil, nil
	end
	if gate.map and runs[gate.map] then
		gate.map, gate.difficulty, gate.launchAt = nil, nil, nil -- another crew got there first
	end
	local map = gate.map and Config.MapByKey[gate.map]
	local diff = gate.difficulty and Config.Difficulties[gate.difficulty]

	local status
	if not gate.captain then
		status = "Step in to choose an adventure"
	elseif not map then
		status = gate.captain.DisplayName .. " is choosing an adventure..."
	else
		gate.launchAt = gate.launchAt or os.clock() + Config.PORTAL_COUNTDOWN
		local left = math.ceil(gate.launchAt - os.clock())
		if left <= 0 then
			status = "Setting sail!"
			local difficulty = gate.difficulty
			gate.captain, gate.map, gate.difficulty, gate.launchAt = nil, nil, nil, nil
			task.spawn(startRun, map, difficulty, aboard)
		else
			status = string.format("%s - %s  |  %d aboard  |  sailing in %d", map.name, diff.name, #aboard, left)
		end
	end
	Portals.setStatus(index, status)
	local busy = {}
	for key in runs do
		busy[key] = true
	end
	for _, player in aboard do
		remotes.Portal:FireClient(player, {
			gate = index, color = Config.GATE_COLORS[index], text = status,
			captain = player == gate.captain, captainName = gate.captain and gate.captain.DisplayName,
			map = gate.map, difficulty = gate.difficulty, busy = busy,
		})
	end
end

while true do
	for index, gate in gates do
		updateGate(index, gate)
	end
	task.wait(0.25)
end
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX13481"><Properties><string name="Name">Monetization</string><ProtectedString name="Source"><![CDATA[-- Robux purchases: game passes (permanent perks) and developer products (gold, timed boosts,
-- revives). Paste your IDs into Config.GAME_PASSES / Config.PRODUCTS after creating them on the
-- Creator Dashboard; anything left at id = 0 shows as "not set up" and can't be bought.
-- Products are only granted once their purchase is saved, and each purchase is granted once.
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")

local Config = require(RS.Shared.Config)
local PlayerData = require(script.Parent.PlayerData)

local Monetization = {}
Monetization.onChanged = function(_player) end -- refresh the player's menus and perks
Monetization.onRevive = function(_player) end -- a revive was bought: use it now if knocked out

local owned = {} -- [player] = { [passKey] = true }
local productById = {}
for _, product in Config.PRODUCTS do
	if product.id > 0 then
		productById[product.id] = product
	end
end

function Monetization.owns(player, passKey)
	return owned[player] ~= nil and owned[player][passKey] == true
end

function Monetization.ownedList(player)
	local list = {}
	for passKey in owned[player] or {} do
		table.insert(list, passKey)
	end
	return list
end

function Monetization.load(player)
	owned[player] = {}
	for passKey, pass in Config.GAME_PASSES do
		if pass.id > 0 then
			local ok, has = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, player.UserId, pass.id)
			if ok and has then
				owned[player][passKey] = true
			end
		end
	end
end

function Monetization.release(player)
	owned[player] = nil
end

-- Stat bonuses from passes and active boosts (see Progression.bonus).
function Monetization.bonus(player)
	local bonus = {}
	for passKey in owned[player] or {} do
		for stat, value in Config.GAME_PASSES[passKey].bonus or {} do
			bonus[stat] = (bonus[stat] or 0) + value
		end
	end
	if PlayerData.boostActive(player, "xp") then
		bonus.xp = (bonus.xp or 0) + 1
	end
	return bonus
end

-- Gold multiplier: 2x Gold pass and 2x Gold boost each add another 100%.
function Monetization.goldMultiplier(player)
	return 1 + (Monetization.owns(player, "DoubleGold") and 1 or 0) + (PlayerData.boostActive(player, "gold") and 1 or 0)
end

function Monetization.dashCooldown(player)
	return Config.DASH.cooldown * (Monetization.owns(player, "SwiftDash") and Config.SWIFT_DASH or 1)
end

MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
	if not purchased then
		return
	end
	for passKey, pass in Config.GAME_PASSES do
		if pass.id == passId then
			owned[player] = owned[player] or {}
			owned[player][passKey] = true
		end
	end
	Monetization.onChanged(player)
end)

MarketplaceService.ProcessReceipt = function(receipt)
	local product = productById[receipt.ProductId]
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	local data = player and PlayerData.get(player)
	if not product or not data or data.loadFailed then
		return Enum.ProductPurchaseDecision.NotProcessedYet -- Roblox retries later
	end
	if data.receipts[receipt.PurchaseId] then
		return Enum.ProductPurchaseDecision.PurchaseGranted -- already delivered
	end

	local before = { gold = data.gold, revives = data.revives, xp = data.boosts.xp, goldBoost = data.boosts.gold }
	if product.gold then
		data.gold += product.gold
	end
	if product.boost then
		data.boosts[product.boost] = math.max(data.boosts[product.boost] or 0, os.time()) + product.minutes * 60
	end
	if product.revive then
		data.revives += 1
	end
	data.receipts[receipt.PurchaseId] = os.time()

	if not PlayerData.save(player) then
		-- couldn't save it: undo and let Roblox deliver it again later
		data.gold, data.revives, data.boosts.xp, data.boosts.gold = before.gold, before.revives, before.xp, before.goldBoost
		data.receipts[receipt.PurchaseId] = nil
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if product.revive then
		Monetization.onRevive(player)
	end
	Monetization.onChanged(player)
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

return Monetization
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX13482"><Properties><string name="Name">Npcs</string><ProtectedString name="Source"><![CDATA[-- Island NPCs: trainers, the gear smith, the upgrades bar and the store. Each one has a
-- prompt ("E" on keyboard, tap on phones) that opens its menu on the client.
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")

local Config = require(RS.Shared.Config)

local Npcs = {}

local SKIN = Color3.fromRGB(255, 205, 160)
local UPRIGHT = CFrame.Angles(0, 0, math.pi / 2)

local function makePart(props, parent)
	local p = Instance.new("Part")
	p.Anchored, p.CanTouch, p.CastShadow = true, false, true
	p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
	for k, v in props do
		p[k] = v
	end
	p.Parent = parent
	return p
end

local function groundY(pos)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local exclude = {}
	for _, p in Players:GetPlayers() do
		if p.Character then
			table.insert(exclude, p.Character)
		end
	end
	params.FilterDescendantsInstances = exclude
	local hit = workspace:Raycast(pos + Vector3.new(0, 100, 0), Vector3.new(0, -200, 0), params)
	return hit and hit.Position.Y or pos.Y
end

local function label(parent, props)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.TextScaled = true
	l.Font = Enum.Font.GothamBlack
	l.TextColor3 = Color3.new(1, 1, 1)
	l.TextStrokeTransparency = 0.4
	for k, v in props do
		l[k] = v
	end
	l.Parent = parent
	return l
end

local function build(npc, folder)
	local model = Instance.new("Model")
	model.Name = npc.name
	local y = groundY(npc.position)
	local base = Vector3.new(npc.position.X, y, npc.position.Z)
	local cf = CFrame.lookAt(base, Vector3.new(Config.ISLAND_CENTER.X, y, Config.ISLAND_CENTER.Z))
	local function body(name, size, offset, color, shape)
		return makePart({ Name = name, Size = size, Color = color, Shape = shape or Enum.PartType.Block, CFrame = cf * offset }, model)
	end

	-- a round rug to stand on, then a simple blocky figure
	makePart({
		Name = "Rug", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.2, 9, 9), Color = npc.accent,
		Material = Enum.Material.Fabric, CanCollide = false, CFrame = cf * CFrame.new(0, 0.1, 0) * UPRIGHT,
	}, model)
	body("LeftLeg", Vector3.new(0.9, 2, 1), CFrame.new(-0.5, 1, 0), Color3.fromRGB(45, 45, 55))
	body("RightLeg", Vector3.new(0.9, 2, 1), CFrame.new(0.5, 1, 0), Color3.fromRGB(45, 45, 55))
	local torso = body("Torso", Vector3.new(2, 2, 1), CFrame.new(0, 3, 0), npc.color)
	body("LeftArm", Vector3.new(0.8, 2, 0.8), CFrame.new(-1.45, 3, 0), npc.color)
	body("RightArm", Vector3.new(0.8, 2, 0.8), CFrame.new(1.45, 3, 0) * CFrame.Angles(math.rad(-25), 0, 0), npc.color)
	body("Head", Vector3.new(1.6, 1.6, 1.6), CFrame.new(0, 4.85, 0), SKIN, Enum.PartType.Ball)
	body("Hat", Vector3.new(0.5, 1.9, 1.9), CFrame.new(0, 5.75, 0) * UPRIGHT, npc.accent, Enum.PartType.Cylinder)
	body("Brim", Vector3.new(0.12, 2.6, 2.6), CFrame.new(0, 5.5, 0) * UPRIGHT, npc.accent, Enum.PartType.Cylinder)
	for _, side in { -0.32, 0.32 } do
		body("Eye", Vector3.new(0.25, 0.25, 0.25), CFrame.new(side, 5, -0.72), Color3.fromRGB(25, 25, 30), Enum.PartType.Ball)
	end

	-- floating icon, name and role
	local board = Instance.new("BillboardGui")
	board.Size = UDim2.fromOffset(220, 86)
	board.StudsOffset = Vector3.new(0, 4.6, 0)
	board.MaxDistance = 90
	board.Parent = torso
	label(board, { Size = UDim2.new(1, 0, 0, 34), Text = npc.icon })
	label(board, { Size = UDim2.new(1, 0, 0, 26), Position = UDim2.fromOffset(0, 34), Text = npc.name })
	label(board, {
		Size = UDim2.new(1, 0, 0, 20), Position = UDim2.fromOffset(0, 62), Text = npc.role:upper(),
		Font = Enum.Font.GothamBold, TextColor3 = Color3.fromRGB(255, 205, 90),
	})

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "Talk"
	prompt.ActionText = "Talk"
	prompt.ObjectText = npc.name .. " - " .. npc.role
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt:SetAttribute("Panel", npc.panel) -- read by client/SwarmClient to open the menu
	prompt:SetAttribute("Tab", npc.tab)
	prompt.Parent = torso

	model.Parent = folder
end

function Npcs.build()
	local folder = Instance.new("Folder")
	folder.Name = "IslandNPCs"
	folder.Parent = workspace
	for _, npc in Config.NPCS do
		build(npc, folder)
	end
end

return Npcs
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX13483"><Properties><string name="Name">PlayerData</string><ProtectedString name="Source"><![CDATA[-- Saves gold, upgrades, training, gear, map progress and purchases between sessions.
-- Safety rules:
--   * every write uses UpdateAsync with a session lock, so two servers never overwrite each other
--   * failed loads are retried; if a save still can't be read, this session never saves for that
--     player (saving defaults would wipe their real data)
--   * everyone autosaves every couple of minutes and when the server shuts down
local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")
local RS = game:GetService("ReplicatedStorage")

local Config = require(RS.Shared.Config)

local store
pcall(function()
	store = DataStoreService:GetDataStore("AnimeSwarm_v1")
end)

local PlayerData = {}
local cache = {}
local LOCK_TIMEOUT = 600 -- seconds before a crashed server's lock is ignored
local AUTOSAVE_EVERY = 120
local MAX_RECEIPTS = 100

local function key(player)
	return "p_" .. player.UserId
end

local function num(v)
	if type(v) == "number" then
		return v
	end
	return type(v) == "string" and tonumber(v) or nil
end

local function fresh()
	return {
		gold = 0, meta = {}, progress = {}, mastery = {}, training = {}, items = {}, equipped = {},
		revives = 0, boosts = {}, receipts = {},
	}
end

-- Copies only known fields from a saved table, checking every type.
local function clean(saved)
	local data = fresh()
	if type(saved) ~= "table" then
		return data
	end
	local function section(name)
		return type(saved[name]) == "table" and saved[name] or {}
	end
	data.gold = math.max(0, math.floor(num(saved.gold) or 0))
	data.revives = math.max(0, math.floor(num(saved.revives) or 0))
	for name, m in Config.Meta do
		data.meta[name] = math.clamp(math.floor(num(section("meta")[name]) or 0), 0, m.max)
	end
	for _, map in Config.Maps do
		local cleared = num(section("progress")[map.key])
		if cleared and cleared > 0 then
			data.progress[map.key] = math.clamp(math.floor(cleared), 0, #Config.Difficulties)
		end
	end
	for skill, level in section("mastery") do
		if Config.Weapons[skill] and num(level) then
			data.mastery[skill] = math.clamp(math.floor(num(level)), 0, Config.MASTERY.max)
		end
	end
	for passive, level in section("training") do
		if Config.Passives[passive] and num(level) then
			data.training[passive] = math.clamp(math.floor(num(level)), 0, Config.TRAINING.max)
		end
	end
	for id in section("items") do
		if Config.GearById[id] then
			data.items[id] = true
		end
	end
	for slot, id in section("equipped") do
		local item = Config.GearById[id]
		if item and item.slot == slot and data.items[id] then
			data.equipped[slot] = id
		end
	end
	for boost, untilTime in section("boosts") do
		if (boost == "xp" or boost == "gold") and num(untilTime) then
			data.boosts[boost] = num(untilTime)
		end
	end
	-- keep the newest receipts so repeat deliveries of a purchase are ignored
	local receipts = {}
	for id, time in section("receipts") do
		table.insert(receipts, { id = id, time = num(time) or 0 })
	end
	table.sort(receipts, function(a, b)
		return a.time > b.time
	end)
	for i = 1, math.min(#receipts, MAX_RECEIPTS) do
		data.receipts[receipts[i].id] = receipts[i].time
	end
	return data
end

-- Loads a player's save and takes the session lock. Retries while another server still holds
-- the lock (they may be saving as the player teleports over) or the DataStore is busy.
function PlayerData.load(player)
	local data
	if store then
		local attempts = RunService:IsStudio() and 1 or 5
		for attempt = 1, attempts do
			local ok, result = pcall(store.UpdateAsync, store, key(player), function(old)
				if type(old) == "table" and old.lock and old.lock ~= game.JobId and os.time() - (num(old.lockTime) or 0) < LOCK_TIMEOUT then
					return nil -- another server still has this player
				end
				old = type(old) == "table" and old or {}
				old.lock, old.lockTime = game.JobId, os.time()
				return old
			end)
			if ok and type(result) == "table" and result.lock == game.JobId then
				data = clean(result)
				break
			end
			if not ok then
				warn("Couldn't load data for " .. player.Name .. ": " .. tostring(result))
			end
			if not player.Parent then
				return nil
			end
			if attempt < attempts then
				task.wait(attempt * 1.5)
			end
		end
	end
	if not data then
		data = fresh()
		data.loadFailed = store ~= nil -- never save over a save we couldn't read
	end
	cache[player] = data
	return data
end

function PlayerData.get(player)
	return cache[player]
end

-- Writes the player's data. release = true also frees the session lock (when they leave).
-- Returns true if the save went through.
function PlayerData.save(player, release)
	local data = cache[player]
	if not store or not data or data.loadFailed then
		return false
	end
	local wrote = false
	local ok = pcall(store.UpdateAsync, store, key(player), function(old)
		if type(old) == "table" and old.lock and old.lock ~= game.JobId then
			return nil -- another server took this player over: don't overwrite them
		end
		local out = {}
		for k, v in data do
			out[k] = v
		end
		out.loadFailed = nil
		out.lock = not release and game.JobId or nil
		out.lockTime = os.time()
		wrote = true
		return out
	end)
	return ok and wrote
end

function PlayerData.release(player)
	PlayerData.save(player, true)
	cache[player] = nil
end

-- Permanent upgrades ----------------------------------------------------------------------

function PlayerData.metaCost(name, level)
	local meta = Config.Meta[name]
	return math.floor(meta.cost * (meta.growth or Config.META_GROWTH) ^ level)
end

function PlayerData.buy(player, name)
	local data, meta = cache[player], Config.Meta[name]
	if not data or not meta then
		return false
	end
	local level = data.meta[name]
	local cost = PlayerData.metaCost(name, level)
	if level >= meta.max or data.gold < cost then
		return false
	end
	data.gold -= cost
	data.meta[name] = level + 1
	return true
end

-- Rayleigh's skill mastery ("skill") and Dr. Kureha's passive training ("passive").
function PlayerData.train(player, kind, name)
	local data = cache[player]
	local known = kind == "skill" and Config.Weapons[name] and not Config.Weapons[name].evolved
		or kind == "passive" and Config.Passives[name]
	if not data or not known then
		return false
	end
	local levels = kind == "skill" and data.mastery or data.training
	local max = kind == "skill" and Config.MASTERY.max or Config.TRAINING.max
	local level = levels[name] or 0
	local cost = Config.trainCost(kind, level)
	if level >= max or data.gold < cost then
		return false
	end
	data.gold -= cost
	levels[name] = level + 1
	return true
end

-- Gear ------------------------------------------------------------------------------------

function PlayerData.buyGear(player, id)
	local data, item = cache[player], Config.GearById[id]
	if not data or not item or item.cost <= 0 or data.items[id] or data.gold < item.cost then
		return false
	end
	data.gold -= item.cost
	data.items[id] = true
	data.equipped[item.slot] = data.equipped[item.slot] or id
	return true
end

function PlayerData.equipGear(player, id)
	local data, item = cache[player], Config.GearById[id]
	if not data or not item or not data.items[id] then
		return false
	end
	data.equipped[item.slot] = data.equipped[item.slot] ~= id and id or nil -- equipping again takes it off
	return true
end

-- Gives an item (a boss drop). Returns false if they already had it.
function PlayerData.grantItem(player, id)
	local data = cache[player]
	if not data or data.items[id] then
		return false
	end
	data.items[id] = true
	return true
end

-- All stat bonuses from the player's equipped gear.
function PlayerData.gearBonus(player)
	local bonus = {}
	local data = cache[player]
	for _, id in data and data.equipped or {} do
		for stat, value in Config.GearById[id].bonus do
			bonus[stat] = (bonus[stat] or 0) + value
		end
	end
	return bonus
end

-- Maps ------------------------------------------------------------------------------------

function PlayerData.unlocked(player, mapKey, difficulty)
	local data, map = cache[player], Config.MapByKey[mapKey]
	return data ~= nil and map ~= nil and Config.Difficulties[difficulty] ~= nil
		and Config.unlocked(data.progress, map, difficulty)
end

-- Records a cleared difficulty. Returns true if it was a new best for that map.
function PlayerData.recordClear(player, mapKey, difficulty)
	local data = cache[player]
	if data and difficulty > (data.progress[mapKey] or 0) then
		data.progress[mapKey] = difficulty
		return true
	end
	return false
end

function PlayerData.boostActive(player, boost)
	local data = cache[player]
	return data ~= nil and (data.boosts[boost] or 0) > os.time()
end

task.spawn(function()
	while true do
		task.wait(AUTOSAVE_EVERY)
		for player in cache do
			task.spawn(PlayerData.save, player)
		end
	end
end)

game:BindToClose(function()
	local pending = 0
	for player in cache do
		pending += 1
		task.spawn(function()
			PlayerData.save(player, true)
			pending -= 1
		end)
	end
	local start = os.clock()
	while pending > 0 and os.clock() - start < 25 do
		task.wait(0.1)
	end
end)

return PlayerData
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX13484"><Properties><string name="Name">Portals</string><ProtectedString name="Source"><![CDATA[-- Builds the voyage gates on the spawn island and tracks who is standing on their pads.
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")

local Config = require(RS.Shared.Config)

local Portals = {}
local built = {} -- [gateIndex] = { pad = Vector3, status = TextLabel }

local STONE = Color3.fromRGB(70, 72, 88)
local RING_RADIUS = 7.5
local UPRIGHT = CFrame.Angles(0, 0, math.pi / 2) -- stands a cylinder's length (X axis) upright

local function makePart(props, parent)
	local p = Instance.new("Part")
	p.Anchored, p.CanTouch, p.CastShadow = true, false, false
	p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
	for k, v in props do
		p[k] = v
	end
	p.Parent = parent
	return p
end

local function label(parent, props)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.TextScaled = true
	l.Font = Enum.Font.LuckiestGuy
	l.TextColor3 = Color3.new(1, 1, 1)
	l.TextStrokeTransparency = 0
	for k, v in props do
		l[k] = v
	end
	l.Parent = parent
	return l
end

local function groundY(pos)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local exclude = {}
	for _, p in Players:GetPlayers() do
		if p.Character then
			table.insert(exclude, p.Character)
		end
	end
	params.FilterDescendantsInstances = exclude
	local hit = workspace:Raycast(pos + Vector3.new(0, 100, 0), Vector3.new(0, -200, 0), params)
	return hit and hit.Position.Y or pos.Y
end

local function buildPortal(index, position, color, folder)
	local model = Instance.new("Model")
	model.Name = "Voyage Gate " .. index
	local y = groundY(position)
	local base = Vector3.new(position.X, y, position.Z)
	-- the portal's front (-Z) faces the spawn point
	local cf = CFrame.lookAt(base, Vector3.new(Config.ISLAND_CENTER.X, y, Config.ISLAND_CENTER.Z))
	local ringCenter = cf * CFrame.new(0, 10, 0)

	makePart({
		Name = "Platform", Shape = Enum.PartType.Cylinder, Material = Enum.Material.Slate, Color = STONE,
		Size = Vector3.new(1, 24, 24), CFrame = cf * CFrame.new(0, 0.5, 0) * UPRIGHT,
	}, model)
	local padCF = cf * CFrame.new(0, 1.05, -4)
	local pad = makePart({
		Name = "Pad", Shape = Enum.PartType.Cylinder, Material = Enum.Material.Neon, Color = color,
		Transparency = 0.35, CanCollide = false,
		Size = Vector3.new(0.1, Config.PORTAL_RADIUS * 2, Config.PORTAL_RADIUS * 2), CFrame = padCF * UPRIGHT,
	}, model)
	local rising = Instance.new("ParticleEmitter")
	rising.Color = ColorSequence.new(color)
	rising.LightEmission = 1
	rising.Rate = 10
	rising.Lifetime = NumberRange.new(1.2, 2)
	rising.Speed = NumberRange.new(0.5, 1.5)
	rising.Acceleration = Vector3.new(0, 4, 0)
	rising.Size = NumberSequence.new(0.5, 0)
	rising.Parent = pad

	-- stone ring with a glowing inner trim
	makePart({ Name = "Foot", Material = Enum.Material.Slate, Color = STONE, Size = Vector3.new(6, 1.6, 2.4), CFrame = cf * CFrame.new(0, 1.6, 0) }, model)
	local segments = 28
	for i = 0, segments - 1 do
		local a = i / segments * 2 * math.pi
		local spin = CFrame.Angles(0, 0, a)
		makePart({
			Name = "Ring", Material = Enum.Material.Slate, Color = STONE,
			Size = Vector3.new(1.6, 2 * math.pi * RING_RADIUS / segments * 1.15, 1.8),
			CFrame = ringCenter * CFrame.new(math.cos(a) * RING_RADIUS, math.sin(a) * RING_RADIUS, 0) * spin,
		}, model)
		local r = RING_RADIUS - 1
		makePart({
			Name = "Trim", Material = Enum.Material.Neon, Color = color, CanCollide = false,
			Size = Vector3.new(0.35, 2 * math.pi * r / segments * 1.15, 2),
			CFrame = ringCenter * CFrame.new(math.cos(a) * r, math.sin(a) * r, 0) * spin,
		}, model)
	end

	-- the swirling gateway itself
	local discCF = ringCenter * CFrame.Angles(0, math.pi / 2, 0)
	local discSize = Vector3.new(0.3, 2 * RING_RADIUS - 1.6, 2 * RING_RADIUS - 1.6)
	local glow = makePart({
		Name = "Glow", Shape = Enum.PartType.Cylinder, Material = Enum.Material.Neon, Color = color,
		Transparency = 0.45, CanCollide = false, Size = discSize, CFrame = discCF,
	}, model)
	makePart({
		Name = "Vortex", Shape = Enum.PartType.Cylinder, Material = Enum.Material.ForceField, Color = color,
		CanCollide = false, Size = discSize + Vector3.new(0.3, 0, 0), CFrame = discCF,
	}, model)
	for i = 0, 2 do
		local blade = makePart({
			Name = "Swirl", Material = Enum.Material.Neon, Color = color:Lerp(Color3.new(1, 1, 1), 0.5),
			Transparency = 0.3, CanCollide = false, Size = Vector3.new(0.4, 2 * RING_RADIUS - 3, 0.15),
			CFrame = ringCenter * CFrame.Angles(0, 0, i * math.pi / 3),
		}, model)
		blade:SetAttribute("Center", ringCenter)
		blade:SetAttribute("Phase", i * math.pi / 3)
		CollectionService:AddTag(blade, "PortalSwirl") -- spun by client/Effects.lua
	end
	local sparkles = Instance.new("ParticleEmitter")
	sparkles.Color = ColorSequence.new(color)
	sparkles.LightEmission = 1
	sparkles.Rate = 15
	sparkles.Lifetime = NumberRange.new(1, 2)
	sparkles.Speed = NumberRange.new(1, 3)
	sparkles.Size = NumberSequence.new(0.7, 0)
	sparkles.Parent = glow
	local light = Instance.new("PointLight")
	light.Color, light.Range, light.Brightness = color, 26, 2
	light.Parent = glow

	-- pillars, arch and name plate
	for _, side in { -1, 1 } do
		local x = side * 11
		makePart({ Name = "Pillar", Material = Enum.Material.Slate, Color = STONE, Size = Vector3.new(2.6, 20, 2.6), CFrame = cf * CFrame.new(x, 11, 0) }, model)
		makePart({ Name = "PillarGlow", Material = Enum.Material.Neon, Color = color, CanCollide = false, Size = Vector3.new(0.5, 17, 2.8), CFrame = cf * CFrame.new(x, 11, 0) }, model)
		makePart({ Name = "Orb", Shape = Enum.PartType.Ball, Material = Enum.Material.Neon, Color = color, CanCollide = false, Size = Vector3.one * 2.6, CFrame = cf * CFrame.new(x, 23.3, 0) }, model)
	end
	local arch = makePart({ Name = "Arch", Material = Enum.Material.Slate, Color = STONE, Size = Vector3.new(25, 3, 3), CFrame = cf * CFrame.new(0, 20.5, 0) }, model)
	local plate = Instance.new("SurfaceGui")
	plate.Face = Enum.NormalId.Front
	plate.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	plate.PixelsPerStud = 40
	plate.Parent = arch
	label(plate, { Size = UDim2.fromScale(1, 1), Text = "VOYAGE GATE " .. index, TextColor3 = color })

	-- floating info: difficulty, description, live status
	local anchor = makePart({ Name = "Info", Transparency = 1, CanCollide = false, CanQuery = false, Size = Vector3.one, CFrame = cf * CFrame.new(0, 28, 0) }, model)
	local board = Instance.new("BillboardGui")
	board.Size = UDim2.fromOffset(320, 96)
	board.MaxDistance = 220
	board.Parent = anchor
	label(board, { Size = UDim2.new(1, 0, 0.38, 0), Text = "★ ADVENTURE ★", TextColor3 = Color3.fromRGB(255, 215, 80) })
	label(board, { Size = UDim2.new(1, 0, 0.27, 0), Position = UDim2.fromScale(0, 0.4), Font = Enum.Font.FredokaOne, Text = "Step in to pick a map and difficulty" })
	local status = label(board, {
		Size = UDim2.new(1, 0, 0.3, 0), Position = UDim2.fromScale(0, 0.7),
		Font = Enum.Font.FredokaOne, Text = "Step in to set sail!", TextColor3 = color,
	})

	model.Parent = folder
	built[index] = { pad = padCF.Position, status = status }
end

function Portals.build()
	local folder = Instance.new("Folder")
	folder.Name = "Portals"
	folder.Parent = workspace
	for index, position in Config.GATES do
		buildPortal(index, position, Config.GATE_COLORS[index], folder)
	end
end

-- Living players whose character stands on the portal's pad.
function Portals.playersInside(index)
	local portal = built[index]
	local inside = {}
	if not portal then
		return inside
	end
	for _, player in Players:GetPlayers() do
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local hum = character and character:FindFirstChildOfClass("Humanoid")
		if root and hum and hum.Health > 0 then
			local offset = root.Position - portal.pad
			if Vector3.new(offset.X, 0, offset.Z).Magnitude <= Config.PORTAL_RADIUS and offset.Y > -2 and offset.Y < 10 then
				table.insert(inside, player)
			end
		end
	end
	return inside
end

function Portals.setStatus(index, text)
	local portal = built[index]
	if portal and portal.status.Text ~= text then
		portal.status.Text = text
	end
end

return Portals
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX13485"><Properties><string name="Name">Progression</string><ProtectedString name="Source"><![CDATA[-- Per-run player state: XP, levels, level-up choices, weapons, passives, evolutions.
local RS = game:GetService("ReplicatedStorage")

local Config = require(RS.Shared.Config)

local Progression = {}
local states = {} -- [player] = state
local remotes

function Progression.init(r)
	remotes = r
end

local function count(t)
	local n = 0
	for _ in t do
		n += 1
	end
	return n
end

-- Sum of class bonus, passives (boosted by Dr. Kureha's training), permanent upgrades,
-- gear, game passes and boosts for one stat.
function Progression.bonus(s, stat)
	local total = (s.classBonus[stat] or 0) + (s.extra[stat] or 0)
	for name, level in s.passives do
		local p = Config.Passives[name]
		if p.stat == stat then
			total += p.per * level * (1 + Config.TRAINING.boost * (s.training[name] or 0))
		end
	end
	for name, level in s.meta do
		local m = Config.Meta[name]
		if m and m.stat == stat then
			total += m.per * level
		end
	end
	return total
end

function Progression.damageMult(s)
	return 1 + Progression.bonus(s, "damage")
end

function Progression.cooldownMult(s)
	return math.max(0.4, 1 - Progression.bonus(s, "cooldown"))
end

function Progression.areaMult(s)
	return 1 + Progression.bonus(s, "area")
end

function Progression.magnet(s)
	return Config.BASE_MAGNET * (1 + Progression.bonus(s, "magnet"))
end

-- Skill slots: a few to start, more from the "Skill Slot" upgrade.
function Progression.slots(s)
	return math.min(Config.WEAPON_SLOTS_MAX, Config.WEAPON_SLOTS_START + math.floor(Progression.bonus(s, "slots")))
end

function Progression.xpNeeded(level)
	return 5 + level * 2
end

-- Fused skills are made on the fly from any two skills, so they live here instead of Config.
local fusionDefs = {} -- [fusionKey] = { name, desc, color, fused = true, parts = { a, b } }

local function fusionKey(a, b)
	if a > b then
		a, b = b, a
	end
	local key = "Fusion_" .. a .. "_" .. b
	if not fusionDefs[key] then
		local wa, wb = Config.Weapons[a], Config.Weapons[b]
		fusionDefs[key] = {
			name = wa.name .. " x " .. wb.name,
			desc = "Fires " .. wa.name .. " and " .. wb.name .. " together, much stronger.",
			color = wa.color:Lerp(wb.color, 0.5), icon = wa.icon .. wb.icon, fused = true, parts = { a, b },
		}
	end
	return key
end

-- Definition of any skill a player can own: a Config skill, an evolution or a fusion.
function Progression.def(name)
	return Config.Weapons[name] or fusionDefs[name]
end

function Progression.get(player)
	return states[player]
end

function Progression.all()
	return states
end

-- data: the player's save (upgrades, mastery, training). extra: stat bonuses from gear,
-- passes and boosts for this run.
function Progression.start(player, className, data, extra)
	if not Config.Classes[className] then
		className = Config.DEFAULT_CLASS
	end
	local class = Config.Classes[className]
	local s = {
		class = className, level = 1, xp = 0, kills = 0, bonusGold = 0, dead = false,
		weapons = { [class.weapon] = 1 }, passives = {}, timers = {},
		classBonus = class.bonus, meta = data.meta, mastery = data.mastery, training = data.training,
		extra = extra or {}, choices = nil, pending = 0, invulnerableUntil = 0,
	}
	s.rerolls = math.floor(Progression.bonus(s, "reroll"))
	states[player] = s
	return s
end

function Progression.stop(player)
	if states[player] then
		states[player] = nil
		if player.Parent then
			remotes.LevelUp:FireClient(player, nil)
		end
	end
end

function Progression.applyStats(player)
	local s = states[player]
	local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if not s or not hum or hum.Health <= 0 then
		return
	end
	local ratio = hum.Health / hum.MaxHealth
	hum.MaxHealth = Config.BASE_HEALTH + Progression.bonus(s, "health")
	hum.Health = hum.MaxHealth * ratio
	hum.WalkSpeed = Config.BASE_SPEED * (1 + Progression.bonus(s, "speed"))
end

function Progression.sync(player)
	local s = states[player]
	if not s then
		return
	end
	local weapons, passives = {}, {}
	for name, level in s.weapons do
		local w = Progression.def(name)
		table.insert(weapons, {
			name = w.name, level = level, evo = w.evolved == true, fused = w.fused == true, color = w.color, icon = w.icon,
		})
	end
	for name, level in s.passives do
		table.insert(passives, { name = Config.Passives[name].name, level = level, icon = Config.Passives[name].icon })
	end
	remotes.Stats:FireClient(player, {
		level = s.level, xp = s.xp, need = Progression.xpNeeded(s.level),
		kills = s.kills, weapons = weapons, passives = passives, slots = Progression.slots(s),
	})
end

-- True if the player already has this skill, its evolution, or a fusion containing either.
local function ownsSkill(s, key)
	for name in s.weapons do
		local def = Progression.def(name)
		for _, part in def.fused and def.parts or { name } do
			if part == key or Config.Weapons[part].from == key then
				return true
			end
		end
	end
	return false
end

-- A skill can be fused once it is max level or evolved. Fusions can't be fused again.
local function fusionReady(name, level)
	local w = Config.Weapons[name]
	return w ~= nil and (w.evolved or level >= Config.WEAPON_MAX)
end

-- How likely each kind of card is. Crewmates' skills are rare so your own character's 6 come first.
local WEIGHT = { upgrade = 4, ownSkill = 3, crewSkill = 0.15, passive = 2 }

-- Removes and returns one entry, picked by weight.
local function takeWeighted(pool)
	local total = 0
	for _, c in pool do
		total += c.weight
	end
	local roll = math.random() * total
	for i, c in pool do
		roll -= c.weight
		if roll <= 0 then
			return table.remove(pool, i)
		end
	end
	return table.remove(pool)
end

local function buildChoices(s)
	local picks, pool, ready = {}, {}, {}
	for name, level in s.weapons do
		local w = Progression.def(name)
		if w.evolvesInto and level >= Config.WEAPON_MAX and (s.passives[w.evolveWith] or 0) >= Config.PASSIVE_MAX then
			table.insert(picks, { type = "evolve", key = name })
		elseif not w.evolved and not w.fused and level < Config.WEAPON_MAX then
			table.insert(pool, { type = "weapon", key = name, weight = WEIGHT.upgrade })
		end
		if fusionReady(name, level) then
			table.insert(ready, name)
		end
	end
	if #ready >= 2 then
		-- offer one random pair of maxed skills to fuse (reroll for a different pair)
		local a = table.remove(ready, math.random(#ready))
		table.insert(picks, { type = "fuse", a = a, b = ready[math.random(#ready)] })
	end
	if count(s.weapons) < Progression.slots(s) then
		for name, w in Config.Weapons do
			if not w.evolved and not ownsSkill(s, name) then
				local own = Config.SkillOwner[name] == s.class
				table.insert(pool, { type = "weapon", key = name, weight = own and WEIGHT.ownSkill or WEIGHT.crewSkill })
			end
		end
	end
	for name, level in s.passives do
		if level < Config.PASSIVE_MAX then
			table.insert(pool, { type = "passive", key = name, weight = WEIGHT.passive })
		end
	end
	if count(s.passives) < Config.PASSIVE_SLOTS then
		for name in Config.Passives do
			if not s.passives[name] then
				table.insert(pool, { type = "passive", key = name, weight = WEIGHT.passive })
			end
		end
	end

	while #picks > Config.CHOICES do
		table.remove(picks)
	end
	while #picks < Config.CHOICES and #pool > 0 do
		table.insert(picks, takeWeighted(pool))
	end
	if #picks == 0 then
		picks = { { type = "heal" }, { type = "gold" } }
	end
	return picks
end

local function describe(s, c)
	if c.type == "weapon" then
		local w = Config.Weapons[c.key]
		local level = (s.weapons[c.key] or 0) + 1
		local owner = Config.SkillOwner[c.key]
		local crew = level == 1 and owner ~= s.class
		return {
			title = w.name, color = w.color, icon = w.icon, level = level, max = Config.WEAPON_MAX,
			tag = crew and "CREW SKILL" or level == 1 and "NEW SKILL" or "UPGRADE",
			text = crew and owner .. "'s skill: " .. w.desc or level == 1 and w.desc or "More damage, faster attacks, more hits.",
		}
	elseif c.type == "passive" then
		local p = Config.Passives[c.key]
		local level = (s.passives[c.key] or 0) + 1
		return {
			title = p.name, text = p.desc, color = Color3.fromRGB(200, 210, 230), icon = p.icon,
			tag = level == 1 and "NEW PASSIVE" or "PASSIVE", level = level, max = Config.PASSIVE_MAX,
		}
	elseif c.type == "evolve" then
		local evo = Config.Weapons[Config.Weapons[c.key].evolvesInto]
		return { title = evo.name, text = evo.desc, color = evo.color, icon = evo.icon, tag = "EVOLUTION" }
	elseif c.type == "fuse" then
		local fused = Progression.def(fusionKey(c.a, c.b))
		return {
			title = fused.name, color = fused.color, icon = fused.icon, tag = "FUSION",
			text = "Fuse two maxed skills into one: both fire together with double damage. Frees a slot!",
		}
	elseif c.type == "heal" then
		return { title = "Meat on the Bone", text = "Heal 50 HP.", color = Color3.fromRGB(255, 170, 120), icon = "🍖", tag = "BONUS" }
	end
	return { title = "Gold Pouch", text = "+25 gold at the end of the run.", color = Color3.fromRGB(255, 215, 0), icon = "💰", tag = "BONUS" }
end

function Progression.offer(player)
	local s = states[player]
	s.choices = buildChoices(s)
	-- a moment of safety while the cards are open (the run keeps going in co-op)
	s.invulnerableUntil = math.max(s.invulnerableUntil, os.clock() + Config.LEVELUP_SHIELD)
	local cards = {}
	for i, c in s.choices do
		cards[i] = describe(s, c)
	end
	remotes.LevelUp:FireClient(player, cards, s.rerolls)
end

function Progression.addXP(player, amount)
	local s = states[player]
	if not s or s.dead then
		return
	end
	s.xp += amount * (1 + Progression.bonus(s, "xp"))
	while s.xp >= Progression.xpNeeded(s.level) do
		s.xp -= Progression.xpNeeded(s.level)
		s.level += 1
		s.pending += 1
	end
	if s.pending > 0 and not s.choices then
		Progression.offer(player)
	end
	Progression.sync(player)
end

function Progression.choose(player, index)
	local s = states[player]
	local c = s and not s.dead and s.choices and s.choices[index]
	if not c then
		return
	end
	if c.type == "weapon" then
		s.weapons[c.key] = (s.weapons[c.key] or 0) + 1
	elseif c.type == "passive" then
		s.passives[c.key] = (s.passives[c.key] or 0) + 1
	elseif c.type == "evolve" then
		s.weapons[c.key] = nil
		s.timers[c.key] = nil
		s.weapons[Config.Weapons[c.key].evolvesInto] = 1
	elseif c.type == "fuse" then
		s.weapons[c.a], s.weapons[c.b] = nil, nil
		s.timers[c.a], s.timers[c.b] = nil, nil
		s.weapons[fusionKey(c.a, c.b)] = 1
	elseif c.type == "heal" then
		local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if hum then
			hum.Health = math.min(hum.MaxHealth, hum.Health + 50)
		end
	else
		s.bonusGold += 25
	end
	s.choices = nil
	s.pending -= 1
	Progression.applyStats(player)
	if s.pending > 0 then
		Progression.offer(player)
	else
		remotes.LevelUp:FireClient(player, nil)
	end
	Progression.sync(player)
end

function Progression.reroll(player)
	local s = states[player]
	if s and s.choices and s.rerolls > 0 then
		s.rerolls -= 1
		Progression.offer(player)
	end
end

return Progression
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX13486"><Properties><string name="Name">Weapons</string><ProtectedString name="Source"><![CDATA[-- Auto-firing anime weapons. Each weapon kind targets and damages enemies on its own,
-- then tells clients what to draw through Fx.
local RS = game:GetService("ReplicatedStorage")

local Config = require(RS.Shared.Config)
local Enemies = require(script.Parent.Enemies)
local Progression = require(script.Parent.Progression)
local Fx = require(script.Parent.Fx)

local Weapons = {}
local projectiles = {}
local orbitSent = {} -- [player] = { [weaponName] = signature last sent to clients }
local loadoutSent = {} -- [player] = signature of the skill emblems last sent to clients
local nextShotId = 0
local nextOrbitResync = 0

local PROJECTILE_SPEED = 60
local MAX_HITS_SHOWN = 15

local function flat(v)
	return Vector3.new(v.X, 0, v.Z)
end

local function stats(s, name, level)
	local w = Config.Weapons[name]
	local up = level - 1
	local mastery = s.mastery[w.from or name] or 0 -- Rayleigh's training (evolutions use their base skill)
	return {
		w = w,
		damage = w.damage * (1 + 0.2 * up) * (1 + Config.MASTERY.damage * mastery) * Progression.damageMult(s),
		cooldown = w.cooldown * (1 - 0.04 * up) * (1 - Config.MASTERY.cooldown * mastery) * Progression.cooldownMult(s),
		range = w.range * Progression.areaMult(s),
		radius = (w.radius or 0) * Progression.areaMult(s),
		count = (w.count or 1) + math.floor(up / 3) + math.floor(Progression.bonus(s, "count")),
	}
end

local function directionTo(root, target)
	local d = flat(target.root.Position - root.Position)
	if d.Magnitude < 0.1 then
		d = flat(root.CFrame.LookVector)
	end
	return d.Unit
end

local function rotate(dir, angle)
	return CFrame.fromAxisAngle(Vector3.yAxis, angle):VectorToWorldSpace(dir)
end

-- Uses server time so clients can draw orbiting fists in the same place.
local function orbitPositions(root, st)
	local now = workspace:GetServerTimeNow()
	local out = {}
	for i = 1, st.count do
		local a = now * 3 + i * 2 * math.pi / st.count
		out[i] = root.Position + Vector3.new(math.cos(a) * st.range, 0, math.sin(a) * st.range)
	end
	return out
end

-- Damages an enemy (rolling for a critical hit) and records the hit so clients can show
-- sparks and damage numbers.
local function strike(s, player, e, damage, hits)
	if e.dead then
		return
	end
	local crit = math.random() < Config.BASE_CRIT_CHANCE + Progression.bonus(s, "crit")
	if crit then
		damage *= Config.BASE_CRIT_DAMAGE + Progression.bonus(s, "critDamage")
	end
	if #hits < MAX_HITS_SHOWN then
		table.insert(hits, { e.root.Position, math.floor(damage + 0.5), crit })
	end
	Enemies.damage(e, damage, player)
end

-- Each returns true if it fired, false if there was nothing to hit.
local fire = {}

function fire.cone(player, s, root, st)
	local target = Enemies.nearest(root.Position, st.range * 2.5)
	if not target then
		return false
	end
	local base = directionTo(root, target)
	local cosHalf = math.cos(math.rad(st.w.angle / 2))
	local nearby = Enemies.inRadius(root.Position, st.range)
	for i = 0, st.count - 1 do
		local dir = rotate(base, i * 2 * math.pi / st.count)
		local hits = {}
		for _, e in nearby do
			local d = flat(e.root.Position - root.Position)
			if d.Magnitude < 0.1 or d.Unit:Dot(dir) >= cosHalf then
				strike(s, player, e, st.damage, hits)
			end
		end
		Fx.emit(st.w.fx, {
			p = player, anim = st.w.anim, c = st.w.color, o = root.Position, d = dir,
			r = st.range, a = st.w.angle, arcs = st.w.arcs or 1, hits = hits,
		})
	end
	return true
end

function fire.chain(player, s, root, st)
	local current = Enemies.nearest(root.Position, st.range)
	if not current then
		return false
	end
	local visited, points, hits = {}, {}, {}
	for _ = 1, st.count do
		visited[current] = true
		table.insert(points, current.root.Position)
		strike(s, player, current, st.damage, hits)
		current = Enemies.nearest(points[#points], 15, visited)
		if not current then
			break
		end
	end
	Fx.emit(st.w.fx, { p = player, anim = st.w.anim, c = st.w.color, cloud = st.w.cloud, pts = points, hits = hits })
	return true
end

function fire.projectile(player, s, root, st)
	local targets = Enemies.closest(root.Position, st.range, st.count)
	if #targets == 0 then
		return false
	end
	for i = 1, st.count do
		local target = targets[(i - 1) % #targets + 1]
		nextShotId += 1
		local shot = {
			id = nextShotId, player = player, s = s, pos = root.Position, dir = directionTo(root, target),
			left = st.range, damage = st.damage, radius = st.radius, color = st.w.color, fire = st.w.fire,
		}
		table.insert(projectiles, shot)
		Fx.emit("shot", {
			id = shot.id, p = player, anim = i == 1 and st.w.anim or nil, c = st.w.color, fire = st.w.fire,
			o = shot.pos, d = shot.dir, len = st.range, speed = PROJECTILE_SPEED, size = 1.5 + st.radius / 4,
		})
	end
	return true
end

function fire.clones(player, s, root, st)
	if not Enemies.nearest(root.Position, 40) then
		return false
	end
	Fx.emit("anim", { p = player, anim = st.w.anim })
	for i = 1, st.count do
		task.delay((i - 1) * 0.12, function()
			if not root.Parent then
				return
			end
			local offset = Vector3.new(math.random(-12, 12), 0, math.random(-12, 12))
			local target = Enemies.nearest(root.Position + offset, 30)
			local pos = target and target.root.Position or root.Position + offset
			pos = Vector3.new(pos.X, root.Position.Y, pos.Z)
			local hits = {}
			for _, e in Enemies.inRadius(pos, st.range) do
				strike(s, player, e, st.damage, hits)
			end
			Fx.emit(st.w.fx, { c = st.w.color, pos = pos, r = st.range, hits = hits })
		end)
	end
	return true
end

function fire.orbit(player, s, root, st)
	local hits = {}
	for _, pos in orbitPositions(root, st) do
		for _, e in Enemies.inRadius(pos, 2.5) do
			strike(s, player, e, st.damage, hits)
		end
	end
	if #hits > 0 then
		Fx.emit("hits", { c = st.w.color, hits = hits })
	end
	return true
end

function fire.line(player, s, root, st)
	local target = Enemies.nearest(root.Position, st.range)
	if not target then
		return false
	end
	local first = directionTo(root, target)
	local origin = root.Position
	local nearby = Enemies.inRadius(origin, st.range)
	for i = 1, st.count do
		local dir = i == 1 and first or rotate(first, math.random() * 2 * math.pi)
		local hits = {}
		for _, e in nearby do
			local rel = flat(e.root.Position - origin)
			local along = rel:Dot(dir)
			if along > 0 and (rel - dir * along).Magnitude <= st.w.width + e.radius then
				strike(s, player, e, st.damage, hits)
			end
		end
		Fx.emit(st.w.fx, {
			p = player, anim = i == 1 and st.w.anim or nil, c = st.w.color, arm = st.w.arm,
			o = origin, d = dir, len = st.range, w = st.w.width, i = i, hits = hits,
		})
	end
	return true
end

function fire.aura(player, s, root, st)
	local nearby = Enemies.inRadius(root.Position, st.range)
	if #nearby == 0 then
		return false
	end
	local hits = {}
	for _, e in nearby do
		strike(s, player, e, st.damage, hits)
	end
	Fx.emit(st.w.fx, {
		p = player, anim = st.w.anim, c = st.w.color, fire = st.w.fire,
		o = root.Position, pos = root.Position, r = st.range, hits = hits,
	})
	return true
end

local function stepProjectiles(dt)
	for i = #projectiles, 1, -1 do
		local p = projectiles[i]
		local move = PROJECTILE_SPEED * dt
		p.pos += p.dir * move
		p.left -= move
		if p.left <= 0 or Enemies.nearest(p.pos, 1.5) then
			local hits = {}
			for _, e in Enemies.inRadius(p.pos, p.radius) do
				strike(p.s, p.player, e, p.damage, hits)
			end
			Fx.emit("boom", { id = p.id, pos = p.pos, r = p.radius, c = p.color, fire = p.fire, hits = hits })
			table.remove(projectiles, i)
		end
	end
end

-- Tells clients which orbiting fists to draw around a player (st = nil removes them).
local function syncOrbit(player, name, st)
	local sent = orbitSent[player] or {}
	orbitSent[player] = sent
	local signature = st and st.count .. ":" .. math.floor(st.range * 10) or nil
	if sent[name] ~= signature then
		sent[name] = signature
		Fx.emit("orbit", {
			p = player, key = name, n = st and st.count or 0, r = st and st.range or 0, c = st and st.w.color,
		})
	end
end

-- Tells clients which skill emblems to float around a player (one per owned skill).
local function syncLoadout(player, s)
	local names = {}
	for name in s.weapons do
		table.insert(names, name)
	end
	table.sort(names)
	local signature = table.concat(names, ",")
	if loadoutSent[player] == signature then
		return
	end
	loadoutSent[player] = signature
	local items = {}
	for _, name in names do
		local def = Progression.def(name)
		local look = def.fused and Config.Weapons[def.parts[1]] or def
		if look.kind ~= "orbit" then -- orbiting skills already circle the player
			table.insert(items, { icon = def.icon, c = def.color, fx = look.fx, fire = look.fire })
		end
	end
	Fx.emit("loadout", { p = player, items = items })
end

-- Stops drawing a player's orbiting weapons and emblems and drops their projectiles in flight.
function Weapons.cleanup(player)
	if orbitSent[player] then
		Fx.emit("orbit", { p = player, all = true, n = 0 })
		orbitSent[player] = nil
	end
	if loadoutSent[player] then
		Fx.emit("loadout", { p = player, items = {} })
		loadoutSent[player] = nil
	end
	for i = #projectiles, 1, -1 do
		if projectiles[i].player == player then
			table.remove(projectiles, i)
		end
	end
end

-- Draws orbiting weapons and fires the weapon when its cooldown is up. `key` names its timer.
local function useWeapon(player, s, root, key, st, now)
	if st.w.kind == "orbit" then
		syncOrbit(player, key, st)
	end
	if now >= (s.timers[key] or 0) then
		local fired = fire[st.w.kind](player, s, root, st)
		s.timers[key] = now + (fired and st.cooldown or 0.2)
	end
end

function Weapons.step(dt)
	local now = os.clock()
	if now >= nextOrbitResync then
		-- redraw orbits from scratch now and then so players who join mid-run see them too
		nextOrbitResync = now + 3
		for player in orbitSent do
			if orbitSent[player] then
				Fx.emit("orbit", { p = player, all = true, n = 0 })
				orbitSent[player] = nil
			end
		end
		table.clear(loadoutSent)
	end
	stepProjectiles(dt)
	for player, s in Progression.all() do
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if s.dead or not root then
			Weapons.cleanup(player)
			continue
		end
		syncLoadout(player, s)
		for key in orbitSent[player] or {} do
			local owner = key:match("^(.-)#%d+$") or key -- fused parts are "<fusion>#1" and "<fusion>#2"
			if not s.weapons[owner] then
				syncOrbit(player, key, nil) -- evolved or fused away
			end
		end
		for name, level in s.weapons do
			local def = Progression.def(name)
			if def.fused then
				-- a fusion fires both of its skills at max level, boosted
				for i, part in def.parts do
					local st = stats(s, part, Config.Weapons[part].evolved and 1 or Config.WEAPON_MAX)
					st.damage *= Config.FUSION.damage
					st.cooldown *= Config.FUSION.cooldown
					st.range *= Config.FUSION.area
					st.radius *= Config.FUSION.area
					st.count += Config.FUSION.extraHits
					useWeapon(player, s, root, name .. "#" .. i, st, now)
				end
			else
				useWeapon(player, s, root, name, stats(s, name, level), now)
			end
		end
	end
end

return Weapons
]]></ProtectedString></Properties></Item></Item></Item><Item class="StarterPlayer" referent="RBX13499"><Properties><string name="Name">StarterPlayer</string><token name="GameSettingsAvatar">1</token><bool name="EnableMouseLockOption">false</bool></Properties><Item class="StarterPlayerScripts" referent="RBX13496"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="Folder" referent="RBX13495"><Properties><string name="Name">Client</string></Properties><Item class="ModuleScript" referent="RBX13489"><Properties><string name="Name">Animate</string><ProtectedString name="Source"><![CDATA[-- Procedural attack animations: bends R15 joints for a moment, no animation assets needed.
-- Runs on every client for every character, so everyone sees everyone's attacks.
local RunService = game:GetService("RunService")

local Animate = {}
local active = {} -- { motor, pose, start, duration, peak }
local lastPlayed = {} -- [character] = { [style] = os.clock() }

local rad = math.rad

-- Each joint: { part name, motor name, function(t, k) -> CFrame }.
-- t goes 0 -> 1 over the animation, k is an envelope that rises fast then falls back to 0.
local STYLES = {
	punch = {
		duration = 0.25, peak = 0.25,
		joints = {
			{ "RightUpperArm", "RightShoulder", function(_, k) return CFrame.Angles(rad(95) * k, 0, 0) end },
			{ "UpperTorso", "Waist", function(_, k) return CFrame.Angles(0, rad(-30) * k, 0) end },
		},
	},
	slash = {
		duration = 0.3, peak = 0.35,
		joints = {
			{ "RightUpperArm", "RightShoulder", function(_, k) return CFrame.Angles(rad(80) * k, 0, rad(40) * k) end },
			{ "LeftUpperArm", "LeftShoulder", function(_, k) return CFrame.Angles(rad(80) * k, 0, rad(-40) * k) end },
			{ "UpperTorso", "Waist", function(t, k) return CFrame.Angles(0, rad(60 - 120 * t) * k, 0) end },
		},
	},
	kick = {
		duration = 0.3, peak = 0.3,
		joints = {
			{ "RightUpperLeg", "RightHip", function(_, k) return CFrame.Angles(rad(100) * k, 0, 0) end },
			{ "UpperTorso", "Waist", function(_, k) return CFrame.Angles(rad(-15) * k, rad(-40) * k, 0) end },
			{ "LeftUpperArm", "LeftShoulder", function(_, k) return CFrame.Angles(0, 0, rad(-60) * k) end },
			{ "RightUpperArm", "RightShoulder", function(_, k) return CFrame.Angles(0, 0, rad(60) * k) end },
		},
	},
	throw = {
		duration = 0.3, peak = 0.4,
		joints = {
			{ "RightUpperArm", "RightShoulder", function(t, k) return CFrame.Angles(rad(-40 + 150 * t) * k, 0, 0) end },
			{ "UpperTorso", "Waist", function(_, k) return CFrame.Angles(0, rad(-35) * k, 0) end },
		},
	},
	cast = {
		duration = 0.4, peak = 0.3,
		joints = {
			{ "RightUpperArm", "RightShoulder", function(_, k) return CFrame.Angles(rad(165) * k, 0, 0) end },
			{ "LeftUpperArm", "LeftShoulder", function(_, k) return CFrame.Angles(rad(30) * k, 0, 0) end },
		},
	},
	cross = {
		duration = 0.45, peak = 0.3,
		joints = {
			{ "RightUpperArm", "RightShoulder", function(_, k) return CFrame.Angles(rad(90) * k, 0, rad(35) * k) end },
			{ "LeftUpperArm", "LeftShoulder", function(_, k) return CFrame.Angles(rad(90) * k, 0, rad(-35) * k) end },
		},
	},
}

local function envelope(t, peak)
	if t < peak then
		return t / peak
	end
	return 1 - (t - peak) / (1 - peak)
end

function Animate.play(player, styleName)
	local style = STYLES[styleName]
	local character = player and player.Character
	if not style or not character then
		return
	end
	local now = os.clock()
	local played = lastPlayed[character] or {}
	lastPlayed[character] = played
	if played[styleName] and now - played[styleName] < style.duration * 0.8 then
		return -- already mid-swing
	end
	played[styleName] = now
	for _, joint in style.joints do
		local part = character:FindFirstChild(joint[1])
		local motor = part and part:FindFirstChild(joint[2])
		if motor and motor:IsA("Motor6D") then -- R15 only; R6 rigs just skip the animation
			table.insert(active, { motor = motor, pose = joint[3], start = now, duration = style.duration, peak = style.peak })
		end
	end
end

-- Stepped runs after Roblox's Animator, so these poses win over walk/idle for their joints.
RunService.Stepped:Connect(function()
	local now = os.clock()
	for i = #active, 1, -1 do
		local a = active[i]
		local t = (now - a.start) / a.duration
		if t >= 1 or not a.motor.Parent then
			a.motor.Transform = CFrame.identity
			table.remove(active, i)
		else
			a.motor.Transform = a.pose(t, envelope(t, a.peak))
		end
	end
	for character in lastPlayed do
		if not character.Parent then
			lastPlayed[character] = nil
		end
	end
end)

return Animate
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX13490"><Properties><string name="Name">Effects</string><ProtectedString name="Source"><![CDATA[-- Draws every skill effect on this client: stretching arms, sword arcs, lightning, projectiles,
-- spin kicks, energy bursts, sky strikes, flying waves, sprouting arms, orbiting objects,
-- hit sparks and damage numbers.
-- The server sends batches of events (see server/Fx.lua); nothing here affects gameplay.
local Players = game:GetService("Players")
local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")

local Animate = require(script.Parent.Animate)

local Effects = {}
local handlers = {}

local folder = Instance.new("Folder")
folder.Name = "ClientFX"
folder.Parent = workspace

local SKIN = Color3.fromRGB(255, 205, 160)
local WHITE = Color3.new(1, 1, 1)
local TEX_SPARK = "rbxasset://textures/particles/sparkles_main.dds"
local TEX_FIRE = "rbxasset://textures/particles/fire_main.dds"
local TEX_SMOKE = "rbxasset://textures/particles/smoke_main.dds"
local SMOOTH = Enum.Material.SmoothPlastic
local UPRIGHT = CFrame.Angles(0, 0, math.pi / 2) -- stands a cylinder's length (X axis) upright

-- helpers -------------------------------------------------------------------

local function rootOf(player)
	local character = player and player.Character
	return character and character:FindFirstChild("HumanoidRootPart")
end

local function rotateY(dir, angle)
	return CFrame.fromAxisAngle(Vector3.yAxis, angle):VectorToWorldSpace(dir)
end

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function groundAt(pos)
	local exclude = { folder }
	for _, name in { "Enemies", "XPOrbs", "FX" } do
		local f = workspace:FindFirstChild(name)
		if f then
			table.insert(exclude, f)
		end
	end
	for _, p in Players:GetPlayers() do
		if p.Character then
			table.insert(exclude, p.Character)
		end
	end
	rayParams.FilterDescendantsInstances = exclude
	local hit = workspace:Raycast(pos + Vector3.new(0, 5, 0), Vector3.new(0, -60, 0), rayParams)
	return hit and hit.Position or pos - Vector3.new(0, 3, 0)
end

local function part(props)
	local p = Instance.new("Part")
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, false
	p.Material = Enum.Material.Neon
	for k, v in props do
		p[k] = v
	end
	p.Parent = folder
	return p
end

local function tween(obj, time, goal, style, direction)
	local info = TweenInfo.new(time, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out)
	local t = TweenService:Create(obj, info, goal)
	t:Play()
	return t
end

local function fadeOut(p, time, goal)
	goal = goal or {}
	goal.Transparency = 1
	tween(p, time, goal)
	Debris:AddItem(p, time + 0.05)
end

-- One-shot particle burst. opts: texture, size, speed, life, gravity
local function burst(pos, color, count, opts)
	opts = opts or {}
	local life = opts.life or 0.3
	local speed = opts.speed or 12
	local holder = part({ Transparency = 1, Size = Vector3.one * 0.2, Position = pos })
	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = opts.texture or TEX_SPARK
	emitter.Color = ColorSequence.new(color)
	emitter.LightEmission = 1
	emitter.Size = NumberSequence.new(opts.size or 1, 0)
	emitter.Transparency = NumberSequence.new(0, 1)
	emitter.Lifetime = NumberRange.new(life, life * 1.6)
	emitter.Speed = NumberRange.new(speed, speed * 1.8)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Drag = 4
	emitter.Acceleration = opts.gravity or Vector3.zero
	emitter.RotSpeed = NumberRange.new(-180, 180)
	emitter.Rotation = NumberRange.new(0, 360)
	emitter.Rate = 0
	emitter.Parent = holder
	emitter:Emit(count)
	Debris:AddItem(holder, life * 2 + 0.2)
end

local function flashLight(pos, color, range, time)
	local holder = part({ Transparency = 1, Size = Vector3.one * 0.2, Position = pos })
	local light = Instance.new("PointLight")
	light.Color, light.Range, light.Brightness = color, range, 5
	light.Parent = holder
	tween(light, time, { Brightness = 0 })
	Debris:AddItem(holder, time + 0.05)
end

-- Flat expanding shockwave disc on the ground.
local function shockwave(pos, radius, color, time)
	local p = part({
		Shape = Enum.PartType.Cylinder, Color = color, Transparency = 0.25,
		Size = Vector3.new(0.2, 1, 1), CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.pi / 2),
	})
	fadeOut(p, time, { Size = Vector3.new(0.2, radius * 2, radius * 2) })
end

-- Briefly sets a body part on fire (Sanji's foot, Ace's fist).
local function ignite(player, partName, color, time)
	local character = player and player.Character
	local limb = character and character:FindFirstChild(partName)
	if limb then
		local fire = Instance.new("Fire")
		fire.Color, fire.SecondaryColor = color, Color3.fromRGB(255, 230, 120)
		fire.Size, fire.Heat = 4, 8
		fire.Parent = limb
		Debris:AddItem(fire, time)
	end
end

-- Attaches a glowing trail to a moving part.
local function addTrail(p, color, width, life, axis)
	local offset = axis == "X" and Vector3.new(width / 2, 0, 0) or Vector3.new(0, width / 2, 0)
	local a0 = Instance.new("Attachment")
	a0.Position = offset
	a0.Parent = p
	local a1 = Instance.new("Attachment")
	a1.Position = -offset
	a1.Parent = p
	local trail = Instance.new("Trail")
	trail.Attachment0, trail.Attachment1 = a0, a1
	trail.Color = ColorSequence.new(color)
	trail.Transparency = NumberSequence.new(0.2, 1)
	trail.Lifetime = life
	trail.LightEmission = 1
	trail.FaceCamera = true
	trail.Parent = p
end

-- Damage numbers and hit sparks ---------------------------------------------

local numbersShown = 0

local function damageNumber(pos, amount, crit)
	if numbersShown >= 40 then
		return
	end
	numbersShown += 1
	local holder = part({
		Transparency = 1, Size = Vector3.one * 0.2,
		Position = pos + Vector3.new(math.random() * 2 - 1, 2, math.random() * 2 - 1),
	})
	local gui = Instance.new("BillboardGui")
	gui.Size = crit and UDim2.fromOffset(110, 46) or UDim2.fromOffset(70, 32)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 120
	gui.Parent = holder
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = crit and amount .. "!" or tostring(amount)
	label.TextScaled = true
	label.Font = Enum.Font.GothamBlack
	label.TextColor3 = crit and Color3.fromRGB(255, 80, 70) or amount >= 100 and Color3.fromRGB(255, 200, 40) or WHITE
	label.TextStrokeTransparency = 0
	label.Parent = gui
	if crit then
		-- critical hits pop in big
		local pop = Instance.new("UIScale")
		pop.Scale = 1.8
		pop.Parent = label
		tween(pop, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
	end
	tween(gui, 0.7, { StudsOffset = Vector3.new(0, 3, 0) })
	tween(label, 0.7, { TextTransparency = 1, TextStrokeTransparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	task.delay(0.75, function()
		numbersShown -= 1
		holder:Destroy()
	end)
end

local function showHits(hits, color)
	for i, hit in hits or {} do
		if i <= 6 then
			burst(hit[1], color, 6, { size = 0.9, speed = 14, life = 0.25 })
		end
		damageNumber(hit[1], hit[2], hit[3])
	end
end

-- Effect pieces ---------------------------------------------------------------

-- A crescent slash that sweeps across `angle` degrees around `origin`.
local function arc(origin, dir, radius, angle, color, height, sweepTime)
	local segments = math.max(6, math.floor(angle / 12))
	local step = math.rad(angle) / segments
	local half = math.rad(angle) / 2
	for i = 0, segments - 1 do
		local t = (i + 0.5) / segments
		task.delay(sweepTime * t, function()
			local a = -half + (i + 0.5) * step
			local center = origin + rotateY(dir, a) * radius + Vector3.new(0, height, 0)
			local tangent = rotateY(dir, a + math.pi / 2)
			local width = 0.3 + 1.5 * math.sin(math.pi * t)
			local length = radius * step * 1.2
			local cf = CFrame.lookAt(center, center + tangent)
			local glow = part({ Color = color, Transparency = 0.15, Size = Vector3.new(width, 0.2, length), CFrame = cf })
			local core = part({ Color = WHITE, Size = Vector3.new(width * 0.35, 0.25, length), CFrame = cf })
			fadeOut(glow, 0.25, { Size = Vector3.new(width * 1.6, 0.2, length) })
			fadeOut(core, 0.15)
		end)
	end
end

-- A jagged lightning bolt between two points.
local function bolt(from, to, color, width)
	local points = { from }
	local n = math.clamp(math.floor((to - from).Magnitude / 4), 3, 10)
	for i = 1, n - 1 do
		local jitter = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * 3
		table.insert(points, from:Lerp(to, i / n) + jitter)
	end
	table.insert(points, to)
	for i = 1, #points - 1 do
		local a, b = points[i], points[i + 1]
		local length = (b - a).Magnitude
		if length > 0.05 then
			local cf = CFrame.lookAt((a + b) / 2, b)
			local glow = part({ Color = color, Transparency = 0.2, Size = Vector3.new(width, width, length), CFrame = cf })
			local core = part({ Color = WHITE, Size = Vector3.new(width * 0.4, width * 0.4, length), CFrame = cf })
			fadeOut(glow, 0.22)
			fadeOut(core, 0.12)
		end
	end
end

-- CFrame for a cylinder lying along `dir`, centered `distance` studs from `start`.
local function along(start, dir, distance)
	local center = start + dir * distance
	return CFrame.lookAt(center, center + dir) * CFrame.Angles(0, math.pi / 2, 0)
end

-- Handlers: one per effect kind the server sends ---------------------------------

-- Stretching punch (Luffy, Chopper): the arm shoots out to full range and snaps back.
function handlers.punch(ev)
	task.delay(((ev.i or 1) - 1) * 0.035, function()
		local root = rootOf(ev.p)
		local start = (root and root.Position or ev.o) + Vector3.new(0, 0.5, 0)
		local dir, length = ev.d, ev.len
		local size = (ev.w or 3) / 3
		local thick = 1.1 * size
		local skin = ev.arm or SKIN
		local arm = part({
			Shape = Enum.PartType.Cylinder, Material = SMOOTH, Color = skin,
			Size = Vector3.new(0.2, thick, thick), CFrame = along(start, dir, 0.1),
		})
		local sleeve = part({
			Shape = Enum.PartType.Cylinder, Material = SMOOTH, Color = ev.c,
			Size = Vector3.new(1.5, thick * 1.3, thick * 1.3), CFrame = along(start, dir, 0.75),
		})
		local fist = part({ Shape = Enum.PartType.Ball, Material = SMOOTH, Color = skin, Size = Vector3.one * 2.4 * size, CFrame = CFrame.new(start) })
		local out = 0.09
		tween(arm, out, { Size = Vector3.new(length, thick, thick), CFrame = along(start, dir, length / 2) }, Enum.EasingStyle.Linear)
		tween(fist, out, { CFrame = CFrame.new(start + dir * length) }, Enum.EasingStyle.Linear)
		task.delay(out, function()
			local tip = start + dir * length
			shockwave(tip, 3 * size, WHITE, 0.2)
			burst(tip, ev.c, 8, { size = 1.2, speed = 16 })
			local back = 0.12
			tween(arm, back, { Size = Vector3.new(0.2, thick, thick), CFrame = along(start, dir, 0.1) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			tween(fist, back, { CFrame = CFrame.new(start) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			for _, p in { arm, sleeve, fist } do
				Debris:AddItem(p, back + 0.02)
			end
		end)
		showHits(ev.hits, ev.c)
	end)
end

-- Sword or kick arcs sweeping in front (several lines for Zoro's three swords).
function handlers.slash(ev)
	local radius = ev.r * 0.75
	for j = 1, ev.arcs do
		local offset = j - (ev.arcs + 1) / 2
		arc(ev.o, ev.d, radius * (1 + offset * 0.12), ev.a, ev.c, offset * 0.8 - 0.4, 0.1)
	end
	showHits(ev.hits, ev.c)
end

-- Lightning that jumps from enemy to enemy; Nami's starts from a storm cloud.
function handlers.lightning(ev)
	local points = ev.pts
	if #points == 0 then
		return
	end
	local first = points[1]
	if ev.cloud then
		local cloud = first + Vector3.new(0, 22, 0)
		for _ = 1, 5 do
			local puff = part({
				Shape = Enum.PartType.Ball, Material = SMOOTH, Color = Color3.fromRGB(70, 70, 90), Transparency = 0.15,
				Size = Vector3.one * (5 + math.random() * 3),
				Position = cloud + Vector3.new(math.random(-5, 5), math.random() * 1.5, math.random(-5, 5)),
			})
			fadeOut(puff, 0.7)
		end
		bolt(cloud, first, ev.c, 0.7)
	else
		local root = rootOf(ev.p)
		if root then
			bolt(root.Position, first, ev.c, 0.45)
		end
	end
	flashLight(first, ev.c, 18, 0.3)
	for i = 1, #points - 1 do
		task.delay(i * 0.04, function()
			bolt(points[i], points[i + 1], ev.c, 0.45)
			flashLight(points[i + 1], ev.c, 10, 0.2)
		end)
	end
	showHits(ev.hits, ev.c)
end

-- Arms that sprout from the ground (Robin). Returns nothing; parts clean themselves up.
local function sproutArms(ground, spread, count, scale, color)
	for i = 1, count do
		local a = i / count * 2 * math.pi + math.random()
		local d = math.random() * spread
		local base = CFrame.new(ground + Vector3.new(math.cos(a) * d, 0, math.sin(a) * d))
			* CFrame.Angles(math.rad(math.random(-20, 20)), 0, math.rad(math.random(-20, 20)))
		local height = (3.5 + math.random() * 2) * scale
		local width = 0.7 * scale
		local arm = part({ Material = SMOOTH, Color = SKIN, Size = Vector3.new(width, 0.1, width), CFrame = base })
		local cuff = part({ Color = color, Size = Vector3.new(width * 1.4, 0.5 * scale, width * 1.4), CFrame = base * CFrame.new(0, 0.25 * scale, 0) })
		local hand = part({ Shape = Enum.PartType.Ball, Material = SMOOTH, Color = SKIN, Size = Vector3.one * width * 1.7, CFrame = base })
		tween(arm, 0.14, { Size = Vector3.new(width, height, width), CFrame = base * CFrame.new(0, height / 2, 0) }, Enum.EasingStyle.Back)
		tween(hand, 0.14, { CFrame = base * CFrame.new(0, height, 0) }, Enum.EasingStyle.Back)
		task.delay(0.45, function()
			for _, p in { arm, cuff, hand } do
				fadeOut(p, 0.2)
			end
		end)
	end
end

local PETALS = Color3.fromRGB(255, 160, 220)

-- A patch of arms bursting up with petals.
function handlers.hands(ev)
	local ground = groundAt(ev.pos or ev.o)
	local scale = math.min(ev.r / 7, 1.6)
	shockwave(ground + Vector3.new(0, 0.15, 0), ev.r, ev.c, 0.5)
	sproutArms(ground, ev.r * 0.6, ev.r > 8 and 7 or 4, scale, ev.c)
	burst(ground + Vector3.new(0, 2, 0), PETALS, 16, { size = 1.2, speed = 8, life = 0.6, gravity = Vector3.new(0, -6, 0) })
	showHits(ev.hits, ev.c)
end

-- Arms grabbing one enemy after another.
function handlers.grab(ev)
	for i, point in ev.pts do
		task.delay((i - 1) * 0.06, function()
			local ground = groundAt(point)
			sproutArms(ground, 1, 2, 0.7, ev.c)
			burst(ground + Vector3.new(0, 2, 0), PETALS, 6, { size = 1, speed = 6, life = 0.5 })
		end)
	end
	showHits(ev.hits, ev.c)
end

-- Projectiles: fireballs or glowing orbs. The server says where each one bursts ("boom").
local shots = {}

function handlers.shot(ev)
	local size = ev.size or 2
	local ball = part({ Shape = Enum.PartType.Ball, Color = ev.c, Transparency = 0.1, Size = Vector3.one * size, Position = ev.o })
	if ev.fire then
		local flames = Instance.new("Fire")
		flames.Color, flames.SecondaryColor = ev.c, Color3.fromRGB(255, 220, 90)
		flames.Size, flames.Heat = size * 2, 0
		flames.Parent = ball
		ignite(ev.p, "RightHand", ev.c, 0.3)
	end
	addTrail(ball, ev.c, size, 0.25)
	shots[ev.id] = { part = ball, pos = ev.o, dir = ev.d, left = ev.len, speed = ev.speed }
	Debris:AddItem(ball, ev.len / ev.speed + 1)
end

function handlers.boom(ev)
	local shot = shots[ev.id]
	if shot then
		shot.part:Destroy()
		shots[ev.id] = nil
	end
	local sphere = part({ Shape = Enum.PartType.Ball, Color = ev.c, Transparency = 0.1, Size = Vector3.one * 2, Position = ev.pos })
	fadeOut(sphere, 0.35, { Size = Vector3.one * ev.r * 2 })
	if ev.fire then
		local explosion = Instance.new("Explosion")
		explosion.Position = ev.pos
		explosion.BlastRadius = ev.r
		explosion.BlastPressure = 0 -- visual only
		explosion.DestroyJointRadiusPercent = 0
		explosion.ExplosionType = Enum.ExplosionType.NoCraters
		explosion.Parent = workspace
		burst(ev.pos, ev.c, 25, { texture = TEX_FIRE, size = 3, speed = ev.r * 2.5, life = 0.5 })
		burst(ev.pos, Color3.fromRGB(90, 90, 90), 10, { texture = TEX_SMOKE, size = 4, speed = ev.r, life = 0.8, gravity = Vector3.new(0, 8, 0) })
	else
		shockwave(groundAt(ev.pos) + Vector3.new(0, 0.2, 0), ev.r, ev.c, 0.35)
		burst(ev.pos, ev.c, 20, { size = 1.5, speed = ev.r * 2, life = 0.45 })
	end
	flashLight(ev.pos, ev.c, ev.r * 2.5, 0.4)
	showHits(ev.hits, ev.c)
end

-- Spin kick around the player; Sanji's burning kicks add flames.
function handlers.kick(ev)
	local root = rootOf(ev.p)
	local center = root and root.Position or ev.o
	local ground = groundAt(center)
	local facing = root and Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z).Unit or Vector3.new(0, 0, -1)
	arc(center, facing, ev.r * 0.7, 360, ev.c, -1.5, 0.14)
	shockwave(ground + Vector3.new(0, 0.2, 0), ev.r, ev.c, 0.3)
	for i = 1, 8 do
		local a = i * math.pi / 4
		local pos = ground + Vector3.new(math.cos(a) * ev.r * 0.8, 1, math.sin(a) * ev.r * 0.8)
		if ev.fire then
			burst(pos, ev.c, 4, { texture = TEX_FIRE, size = 2.5, speed = 3, life = 0.45, gravity = Vector3.new(0, 15, 0) })
		else
			burst(pos, ev.c, 3, { size = 1, speed = 6, life = 0.3 })
		end
	end
	if ev.fire then
		ignite(ev.p, "RightFoot", ev.c, 0.35)
	end
	showHits(ev.hits, ev.c)
end

-- Energy bursting out around the player (balloon, cyclone, fire fence, rumble ball...).
function handlers.nova(ev)
	local root = rootOf(ev.p)
	local center = root and root.Position or ev.o
	local ground = groundAt(center)
	local sphere = part({ Shape = Enum.PartType.Ball, Material = Enum.Material.ForceField, Color = ev.c, Size = Vector3.one * 2, Position = center })
	fadeOut(sphere, 0.4, { Size = Vector3.one * ev.r * 2 })
	shockwave(ground + Vector3.new(0, 0.25, 0), ev.r, ev.c, 0.35)
	burst(center, ev.c, 16, { size = 1.4, speed = ev.r * 2, life = 0.35 })
	flashLight(center, ev.c, ev.r * 2, 0.25)
	showHits(ev.hits, ev.c)
end

-- A column crashing down from the sky (giant fist, heel drop, fire pillar, thunder lance...).
function handlers.strike(ev)
	local ground = groundAt(ev.pos)
	local width = ev.r * 1.1
	local column = part({
		Shape = Enum.PartType.Cylinder, Color = ev.c, Transparency = 0.15,
		Size = Vector3.new(60, width, width), CFrame = CFrame.new(ground + Vector3.new(0, 30, 0)) * UPRIGHT,
	})
	local core = part({
		Shape = Enum.PartType.Cylinder, Color = WHITE,
		Size = Vector3.new(60, width * 0.35, width * 0.35), CFrame = column.CFrame,
	})
	fadeOut(column, 0.35, { Size = Vector3.new(60, width * 0.2, width * 0.2) })
	fadeOut(core, 0.2)
	shockwave(ground + Vector3.new(0, 0.2, 0), ev.r * 1.3, ev.c, 0.4)
	burst(ground + Vector3.new(0, 1, 0), ev.c, 14, { size = 2, speed = ev.r * 2, life = 0.4 })
	flashLight(ground + Vector3.new(0, 3, 0), ev.c, ev.r * 3, 0.3)
	showHits(ev.hits, ev.c)
end

-- A crescent wave flying down a line (sword waves, wind, petals, fire bullets...).
function handlers.wave(ev)
	task.delay(((ev.i or 1) - 1) * 0.06, function()
		local root = rootOf(ev.p)
		local start = root and root.Position or ev.o
		local finish = start + ev.d * ev.len
		local width = (ev.w or 3) * 1.6
		local travel = ev.len / 90
		local pieces = {}
		for side = -1, 1 do
			-- a center blade and two swept-back wings make the crescent
			local offset = CFrame.new(side * width * 0.42, 0, math.abs(side) * width * 0.25) * CFrame.Angles(0, -side * math.rad(28), 0)
			local blade = part({
				Color = side == 0 and WHITE or ev.c, Transparency = side == 0 and 0 or 0.15,
				Size = Vector3.new(side == 0 and width * 0.5 or width * 0.45, 0.3, 0.8),
				CFrame = CFrame.lookAt(start, finish) * offset,
			})
			table.insert(pieces, { part = blade, offset = offset })
		end
		addTrail(pieces[2].part, ev.c, width, 0.2, "X")
		for _, piece in pieces do
			tween(piece.part, travel, { CFrame = CFrame.lookAt(finish, finish + ev.d) * piece.offset }, Enum.EasingStyle.Linear)
			Debris:AddItem(piece.part, travel + 0.05)
		end
		showHits(ev.hits, ev.c)
	end)
end

-- Things circling the player: fists, clouds, fireflies, petals (positions follow server time).
local orbits = {} -- [player] = { [weaponName] = { parts = {}, r = radius } }

local function clearOrbits(player)
	for _, o in orbits[player] or {} do
		for _, p in o.parts do
			p:Destroy()
		end
	end
	orbits[player] = nil
end

function handlers.orbit(ev)
	if ev.all then
		clearOrbits(ev.p)
		return
	end
	local mine = orbits[ev.p] or {}
	orbits[ev.p] = mine
	local o = mine[ev.key] or { parts = {} }
	mine[ev.key] = o
	o.r = ev.r
	while #o.parts < ev.n do
		local fist = part({ Shape = Enum.PartType.Ball, Material = SMOOTH, Color = ev.c, Size = Vector3.one * 1.8 })
		addTrail(fist, ev.c, 1.2, 0.2)
		table.insert(o.parts, fist)
	end
	while #o.parts > ev.n do
		table.remove(o.parts):Destroy()
	end
	if ev.n == 0 then
		mine[ev.key] = nil
	end
end

function handlers.hits(ev)
	showHits(ev.hits, ev.c)
end

-- A dash: a burst of wind and fading afterimages left behind the player.
function handlers.dash(ev)
	local root = rootOf(ev.p)
	if not root then
		return
	end
	burst(root.Position, Color3.fromRGB(200, 230, 255), 10, { size = 1.2, speed = 10, life = 0.3 })
	for i = 0, 3 do
		task.delay(i * 0.04, function()
			if root.Parent then
				local ghost = part({ Color = Color3.fromRGB(150, 200, 255), Transparency = 0.45, Size = Vector3.new(2, 5, 1), CFrame = root.CFrame })
				fadeOut(ghost, 0.3)
			end
		end)
	end
end

-- An enemy goes down in a puff of smoke.
function handlers.death(ev)
	burst(ev.pos, Color3.fromRGB(200, 200, 200), math.floor(6 * ev.s) + 2, { texture = TEX_SMOKE, size = 2.5 * ev.s, speed = 6, life = 0.5, gravity = Vector3.new(0, 6, 0) })
	burst(ev.pos, ev.c, 6, { size = 1, speed = 15, life = 0.3 })
end

function handlers.anim(_ev) end -- the animation itself is played in Effects.play

-- Enemy attacks -------------------------------------------------------------------

-- A red warning circle on the ground: the blast lands when it fills up. Get out!
function handlers.warn(ev)
	local ground = groundAt(ev.pos) + Vector3.new(0, 0.15, 0)
	local size = ev.r * 2
	local ring = part({
		Shape = Enum.PartType.Cylinder, Color = Color3.fromRGB(255, 40, 40), Transparency = 0.55,
		Size = Vector3.new(0.15, size, size), CFrame = CFrame.new(ground) * UPRIGHT,
	})
	local fill = part({
		Shape = Enum.PartType.Cylinder, Color = Color3.fromRGB(255, 130, 60), Transparency = 0.3,
		Size = Vector3.new(0.2, 0.5, 0.5), CFrame = ring.CFrame,
	})
	tween(fill, ev.t, { Size = Vector3.new(0.2, size, size) }, Enum.EasingStyle.Linear)
	Debris:AddItem(ring, ev.t)
	Debris:AddItem(fill, ev.t)
end

function handlers.slam(ev)
	local ground = groundAt(ev.pos)
	local center = ground + Vector3.new(0, 1, 0)
	shockwave(ground + Vector3.new(0, 0.3, 0), ev.r * 1.2, ev.c, 0.35)
	local sphere = part({ Shape = Enum.PartType.Ball, Color = ev.c, Transparency = 0.2, Size = Vector3.one * 2, Position = center })
	fadeOut(sphere, 0.3, { Size = Vector3.one * ev.r * 2 })
	burst(center, ev.c, 16, { texture = TEX_FIRE, size = 2.5, speed = ev.r * 2, life = 0.4 })
	burst(center, Color3.fromRGB(90, 90, 90), 8, { texture = TEX_SMOKE, size = 3, speed = ev.r, life = 0.6, gravity = Vector3.new(0, 6, 0) })
end

-- Marine rifle bullets. The server says when each one hits or runs out ("eshotEnd").
local enemyShots = {}

function handlers.eshot(ev)
	local bullet = part({ Shape = Enum.PartType.Ball, Color = Color3.fromRGB(255, 230, 120), Size = Vector3.one * 0.7, Position = ev.o })
	addTrail(bullet, Color3.fromRGB(255, 190, 80), 0.4, 0.15)
	enemyShots[ev.id] = { part = bullet, pos = ev.o, dir = ev.d, left = ev.len, speed = ev.speed }
	Debris:AddItem(bullet, ev.len / ev.speed + 0.5)
end

function handlers.eshotEnd(ev)
	local shot = enemyShots[ev.id]
	if shot then
		shot.part:Destroy()
		enemyShots[ev.id] = nil
	end
end

-- Skill emblems ------------------------------------------------------------------
-- Every skill a player owns floats around them as a little charm whose shape follows the skill:
-- blades for sword and wave skills, a fist for punches, rings for bursts, petals for Robin...

local loadouts = {} -- [player] = { emblems = { { part, color, fx, size } } }

local function makeEmblem(item)
	local fx, color = item.fx, item.c
	local p
	if fx == "slash" or fx == "wave" then
		p = part({ Color = color, Size = Vector3.new(0.25, 0.5, 1.8) })
	elseif fx == "nova" then
		p = part({ Shape = Enum.PartType.Cylinder, Color = color, Transparency = 0.15, Size = Vector3.new(0.15, 1.4, 1.4) })
	elseif fx == "strike" then
		p = part({ Color = color, Size = Vector3.one * 0.8 })
	elseif fx == "punch" then
		p = part({ Shape = Enum.PartType.Ball, Material = SMOOTH, Color = SKIN, Size = Vector3.one * 1.1 })
	elseif fx == "hands" or fx == "grab" then
		p = part({ Shape = Enum.PartType.Ball, Color = PETALS, Size = Vector3.one * 0.8 })
	else
		p = part({ Shape = Enum.PartType.Ball, Color = color, Size = Vector3.one * 0.9 })
	end
	if item.fire then
		local flames = Instance.new("Fire")
		flames.Color, flames.SecondaryColor = color, Color3.fromRGB(255, 220, 90)
		flames.Size, flames.Heat = 1.5, 0
		flames.Parent = p
	end
	if fx == "lightning" then
		local glow = Instance.new("PointLight")
		glow.Color, glow.Range, glow.Brightness = color, 6, 2
		glow.Parent = p
	end
	addTrail(p, color, 0.35, 0.25)
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(26, 26)
	gui.StudsOffset = Vector3.new(0, 1.1, 0)
	gui.MaxDistance = 70
	gui.Parent = p
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.TextScaled = true
	label.Text = item.icon or ""
	label.Parent = gui
	return { part = p, color = color, fx = fx, size = p.Size }
end

local function clearLoadout(player)
	local loadout = loadouts[player]
	if loadout then
		for _, emblem in loadout.emblems do
			emblem.part:Destroy()
		end
	end
	loadouts[player] = nil
end

function handlers.loadout(ev)
	clearLoadout(ev.p)
	if #ev.items > 0 then
		local emblems = {}
		for _, item in ev.items do
			table.insert(emblems, makeEmblem(item))
		end
		loadouts[ev.p] = { emblems = emblems }
	end
end

-- The emblem of the skill that just fired swells for a moment.
local function pulseEmblem(player, color)
	local loadout = loadouts[player]
	for _, emblem in loadout and loadout.emblems or {} do
		if emblem.color == color and not emblem.pulsing then
			emblem.pulsing = true
			tween(emblem.part, 0.08, { Size = emblem.size * 1.8 })
			task.delay(0.1, function()
				tween(emblem.part, 0.15, { Size = emblem.size })
				emblem.pulsing = false
			end)
		end
	end
end

local function moveEmblems(now)
	for player, loadout in loadouts do
		local root = rootOf(player)
		if not root or not player.Parent then
			clearLoadout(player)
			continue
		end
		local count = #loadout.emblems
		for i, emblem in loadout.emblems do
			local a = now * 1.4 + i * 2 * math.pi / count
			local pos = root.Position + Vector3.new(math.cos(a) * 3.4, 1.6 + math.sin(now * 3 + i) * 0.35, math.sin(a) * 3.4)
			local fx = emblem.fx
			if fx == "slash" or fx == "wave" then
				local ahead = pos + Vector3.new(-math.sin(a), 0, math.cos(a))
				emblem.part.CFrame = CFrame.lookAt(pos, ahead) * CFrame.Angles(0, 0, now * 6)
			elseif fx == "nova" or fx == "strike" then
				emblem.part.CFrame = CFrame.new(pos) * CFrame.Angles(now * 2, now * 3, now)
			else
				emblem.part.CFrame = CFrame.new(pos)
			end
		end
	end
end

-- Per-frame updates -------------------------------------------------------------

local function moveShots(list, dt)
	for id, shot in list do
		if not shot.part.Parent then
			list[id] = nil
		elseif shot.left > 0 then
			local move = math.min(shot.left, shot.speed * dt)
			shot.pos += shot.dir * move
			shot.left -= move
			shot.part.Position = shot.pos
		end
	end
end

RunService.RenderStepped:Connect(function(dt)
	moveShots(shots, dt)
	moveShots(enemyShots, dt)

	local now = workspace:GetServerTimeNow()
	for player, mine in orbits do
		local root = rootOf(player)
		if not root or not player.Parent then
			clearOrbits(player)
			continue
		end
		for _, o in mine do
			local n = #o.parts
			for i, p in o.parts do
				local a = now * 3 + i * 2 * math.pi / n
				p.CFrame = CFrame.new(root.Position + Vector3.new(math.cos(a) * o.r, 0, math.sin(a) * o.r))
			end
		end
	end

	moveEmblems(now)

	-- spin the swirl blades inside the island's portals
	for _, blade in CollectionService:GetTagged("PortalSwirl") do
		local center = blade:GetAttribute("Center")
		if center then
			blade.CFrame = center * CFrame.Angles(0, 0, now * 1.5 + (blade:GetAttribute("Phase") or 0))
		end
	end
end)

-- Public ------------------------------------------------------------------------

function Effects.play(ev)
	if ev.p and ev.anim then
		Animate.play(ev.p, ev.anim)
	end
	if ev.p and ev.c then
		pulseEmblem(ev.p, ev.c)
	end
	local handler = handlers[ev.k]
	if handler then
		local ok, err = pcall(handler, ev)
		if not ok then
			warn("Effect " .. tostring(ev.k) .. " failed: " .. tostring(err))
		end
	end
end

function Effects.clear()
	for player in loadouts do
		clearLoadout(player)
	end
	for player in orbits do
		clearOrbits(player)
	end
	for _, list in { shots, enemyShots } do
		for _, shot in list do
			shot.part:Destroy()
		end
		table.clear(list)
	end
end

return Effects
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX13491"><Properties><string name="Name">Hud</string><ProtectedString name="Source"><![CDATA[-- In-run HUD: status bar (level, XP, map, timer, kills), skill action bar, health,
-- level-up cards, boss announcements and the results screen.
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")

local Config = require(RS:WaitForChild("Shared"):WaitForChild("Config"))
local Theme = require(script.Parent.Theme)

local Hud = {}
local ui = {}
local cards = {}
local callbacks
local player = Players.LocalPlayer

local SKILL_TILE, PASSIVE_TILE, GAP = 52, 42, 6
local CARD_W, CARD_H, CARD_GAP = 240, 330, 22
local EVO_COLOR = Color3.fromRGB(255, 120, 255)
local FUSION_COLOR = Color3.fromRGB(110, 230, 255)

local function initials(name)
	local letters = ""
	for word in name:gmatch("[%a]+") do
		letters ..= word:sub(1, 1):upper()
		if #letters == 2 then
			break
		end
	end
	return letters
end

-- Status bar: level, XP, map, timer, kills ----------------------------------------------

local function buildStatus(root)
	local bar = Theme.panel({ Size = UDim2.fromOffset(460, 72), Position = UDim2.new(0.5, -230, 0, 10) }, root)
	local badge = Theme.new("Frame", { Size = UDim2.fromOffset(52, 52), Position = UDim2.fromOffset(10, 8), BackgroundColor3 = Theme.ACCENT, ZIndex = 2 }, bar)
	Theme.corner(badge, 26)
	Theme.gradient(badge, Color3.fromRGB(170, 190, 255), Color3.fromRGB(90, 70, 220), 135)
	Theme.text({ Size = UDim2.new(1, 0, 0.3, 0), Position = UDim2.fromScale(0, 0.12), Text = "LV", Font = Theme.BOLD, ZIndex = 3 }, badge)
	ui.level = Theme.title({ Size = UDim2.new(1, -8, 0.5, 0), Position = UDim2.new(0, 4, 0.4, 0), Text = "1", ZIndex = 3 }, badge)

	ui.adventure = Theme.text({ Size = UDim2.fromOffset(250, 16), Position = UDim2.fromOffset(74, 10), Font = Theme.BOLD, TextColor3 = Theme.MUTED, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 2 }, bar)
	ui.timer = Theme.title({ Size = UDim2.fromOffset(250, 30), Position = UDim2.fromOffset(74, 26), TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 2 }, bar)
	ui.kills = Theme.chip({ Size = UDim2.fromOffset(104, 32), Position = UDim2.new(1, -116, 0, 14), Text = "💀 0", ZIndex = 2 }, bar, Theme.BAD)

	local xp, fill = Theme.bar({ Size = UDim2.new(1, -84, 0, 6), Position = UDim2.new(0, 74, 1, -12), ZIndex = 2 }, bar,
		Color3.fromRGB(110, 230, 255), Color3.fromRGB(99, 132, 255))
	xp:FindFirstChildOfClass("TextLabel").Visible = false
	ui.xpFill = fill
end

-- Skill action bar and health ------------------------------------------------------------

local function makeTile(parent, size, x, y)
	local tile, label = Theme.icon({ Size = UDim2.fromOffset(size, size), Position = UDim2.fromOffset(x, y), ZIndex = 2 }, parent, "", Theme.CARD)
	local level = Theme.text({
		Size = UDim2.fromOffset(size * 0.62, 15), Position = UDim2.new(1, -size * 0.62 + 2, 1, -13), Font = Theme.BOLD,
		BackgroundTransparency = 0.15, BackgroundColor3 = Theme.BG, ZIndex = 4, MaxSize = 12,
	}, tile)
	Theme.corner(level, 6)
	local slot = { tile = tile, icon = label, level = level }
	tile.MouseEnter:Connect(function()
		if slot.tip then
			ui.tooltip.Text = slot.tip
			ui.tooltip.Visible = true
		end
	end)
	tile.MouseLeave:Connect(function()
		ui.tooltip.Visible = false
	end)
	return slot
end

local function buildActionBar(root)
	local width = Config.WEAPON_SLOTS_MAX * (SKILL_TILE + GAP) + Config.PASSIVE_SLOTS * (PASSIVE_TILE + GAP) + 34
	local bar = Theme.panel({ Size = UDim2.fromOffset(width, 74), Position = UDim2.new(0.5, -width / 2, 1, -132) }, root)
	ui.weaponSlots, ui.passiveSlots = {}, {}
	local x = 12
	for i = 1, Config.WEAPON_SLOTS_MAX do
		ui.weaponSlots[i] = makeTile(bar, SKILL_TILE, x, 11)
		x += SKILL_TILE + GAP
	end
	Theme.new("Frame", { Size = UDim2.fromOffset(2, 44), Position = UDim2.fromOffset(x + 2, 15), BackgroundColor3 = Theme.LINE, BackgroundTransparency = 0.85, BorderSizePixel = 0 }, bar)
	x += 12
	for i = 1, Config.PASSIVE_SLOTS do
		ui.passiveSlots[i] = makeTile(bar, PASSIVE_TILE, x, 16)
		x += PASSIVE_TILE + GAP
	end
	ui.tooltip = Theme.chip({
		Size = UDim2.fromOffset(320, 28), Position = UDim2.new(0.5, -160, 0, -36), Visible = false, ZIndex = 5,
		BackgroundTransparency = 0.1, TextColor3 = Theme.TEXT, MaxSize = 15,
	}, bar, Theme.PANEL)
end

local function buildHealth(root)
	local panel = Theme.panel({ Size = UDim2.fromOffset(480, 40), Position = UDim2.new(0.5, -240, 1, -52) }, root)
	Theme.icon({ Size = UDim2.fromOffset(28, 28), Position = UDim2.fromOffset(7, 6), ZIndex = 2 }, panel, "❤️", Theme.BAD, 8)
	local _, fill, text = Theme.bar({ Size = UDim2.new(1, -140, 0, 18), Position = UDim2.fromOffset(44, 11), ZIndex = 2 }, panel,
		Color3.fromRGB(255, 120, 130), Color3.fromRGB(220, 40, 70))
	ui.hpFill, ui.hpText = fill, text

	-- dash: Shift / L2 / the on-screen button; the dark overlay drains as it recharges
	local dash = Theme.new("TextButton", {
		Size = UDim2.fromOffset(84, 28), Position = UDim2.new(1, -90, 0, 6), Text = "💨 SHIFT", Font = Theme.BOLD,
		TextScaled = true, TextColor3 = Theme.TEXT, BackgroundColor3 = Theme.ACCENT, AutoButtonColor = false, ZIndex = 2,
	}, panel)
	Theme.corner(dash, 8)
	Theme.padding(dash, 5)
	ui.dashShade = Theme.new("Frame", {
		Size = UDim2.new(0, 0, 1, 10), Position = UDim2.fromOffset(-5, -5), BackgroundColor3 = Theme.BG,
		BackgroundTransparency = 0.25, BorderSizePixel = 0, ZIndex = 3,
	}, dash)
	Theme.corner(ui.dashShade, 8)
	dash.Activated:Connect(function()
		callbacks.dash()
	end)

	local function bind(character)
		local hum = character:WaitForChild("Humanoid")
		local function update()
			local ratio = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
			Theme.tween(ui.hpFill, 0.15, { Size = UDim2.fromScale(ratio, 1) })
			ui.hpText.Text = string.format("%d / %d", math.ceil(hum.Health), math.floor(hum.MaxHealth))
		end
		hum.HealthChanged:Connect(update)
		hum:GetPropertyChangedSignal("MaxHealth"):Connect(update)
		update()
	end
	player.CharacterAdded:Connect(bind)
	if player.Character then
		task.spawn(bind, player.Character)
	end
end

local function fillSlot(slot, info, max, locked)
	slot.tip = nil
	slot.level.Visible = false
	if locked then
		slot.tile.BackgroundColor3 = Theme.LOCKED
		slot.icon.Text = "🔒"
		slot.icon.TextTransparency = 0.4
		slot.tip = "Locked  -  buy more Skill Slots in the Shop"
		return
	end
	slot.icon.TextTransparency = 0
	if not info then
		slot.tile.BackgroundColor3 = Theme.CARD
		slot.icon.Text = ""
		return
	end
	slot.tile.BackgroundColor3 = info.color or Color3.fromRGB(120, 130, 170)
	slot.icon.Text = info.icon or initials(info.name)
	slot.level.Visible = true
	if info.fused then
		slot.level.Text, slot.level.TextColor3 = "FUSE", FUSION_COLOR
	elseif info.evo then
		slot.level.Text, slot.level.TextColor3 = "EVO", EVO_COLOR
	else
		local maxed = info.level >= max
		slot.level.Text = maxed and "MAX" or tostring(info.level)
		slot.level.TextColor3 = maxed and Theme.GOLD or Theme.TEXT
	end
	slot.tip = info.name .. (info.fused and "  (fused)" or info.evo and "  (evolved)" or "  -  level " .. info.level)
end

-- Leave button and the knocked-out panel ---------------------------------------------------

local function buildCrewControls(root)
	local confirmUntil = 0
	ui.leave = Theme.button({
		Size = UDim2.fromOffset(150, 38), Position = UDim2.fromOffset(16, 16), Text = "🏳️  LEAVE",
		BackgroundColor3 = Theme.CARD_LIGHT, ZIndex = 2,
	}, root, function()
		if os.clock() < confirmUntil then
			callbacks.leave()
		else
			-- ask twice so nobody leaves by accident
			confirmUntil = os.clock() + 3
			ui.leave.Text = "TAP AGAIN"
			ui.leave.BackgroundColor3 = Theme.BAD
			task.delay(3, function()
				ui.leave.Text = "🏳️  LEAVE"
				ui.leave.BackgroundColor3 = Theme.CARD_LIGHT
			end)
		end
	end)

	local down = Theme.panel({ Size = UDim2.fromOffset(440, 118), Position = UDim2.new(0.5, -220, 1, -262), Visible = false, ZIndex = 5 }, root)
	ui.down = down
	Theme.title({ Size = UDim2.new(1, -24, 0, 26), Position = UDim2.fromOffset(12, 10), Text = "KNOCKED OUT", TextColor3 = Theme.BAD, ZIndex = 6 }, down)
	Theme.button({ Size = UDim2.fromOffset(38, 32), Position = UDim2.fromOffset(12, 42), Text = "◀", BackgroundColor3 = Theme.CARD_LIGHT, ZIndex = 6 }, down, function()
		callbacks.spectate(-1)
	end)
	ui.watching = Theme.text({ Size = UDim2.new(1, -124, 0, 32), Position = UDim2.fromOffset(62, 42), Text = "", Font = Theme.BOLD, ZIndex = 6, MaxSize = 16 }, down)
	Theme.button({ Size = UDim2.fromOffset(38, 32), Position = UDim2.new(1, -50, 0, 42), Text = "▶", BackgroundColor3 = Theme.CARD_LIGHT, ZIndex = 6 }, down, function()
		callbacks.spectate(1)
	end)
	ui.revive = Theme.button({
		Size = UDim2.new(1, -24, 0, 30), Position = UDim2.fromOffset(12, 80), Text = "💖  REVIVE",
		BackgroundColor3 = Color3.fromRGB(230, 70, 130), ZIndex = 6,
	}, down, function()
		callbacks.revive(ui.revives or 0)
	end)
end

-- Level-up cards ----------------------------------------------------------------------

local function setPips(container, level, max, color)
	for _, child in container:GetChildren() do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
	if not level or not max then
		return
	end
	local width = math.floor((CARD_W - 60) / max) - 4
	for i = 1, max do
		local pip = Theme.new("Frame", {
			Size = UDim2.fromOffset(width, 6), ZIndex = 24,
			BackgroundColor3 = i <= level and color or Color3.fromRGB(255, 255, 255),
			BackgroundTransparency = i <= level and 0 or 0.88,
		}, container)
		Theme.corner(pip, 3)
	end
end

local function buildLevelUp(gui)
	local overlay = Theme.new("Frame", {
		Name = "LevelUp", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Theme.BG,
		BackgroundTransparency = 0.35, Visible = false, ZIndex = 20,
	}, gui)
	ui.levelOverlay = overlay
	ui.levelTitle = Theme.title({ Size = UDim2.fromOffset(600, 54), Position = UDim2.new(0.5, -300, 0.5, -262), Text = "LEVEL UP", ZIndex = 21 }, overlay)
	Theme.text({
		Size = UDim2.fromOffset(600, 22), Position = UDim2.new(0.5, -300, 0.5, -206), ZIndex = 21,
		Text = "Choose a power  -  press 1, 2 or 3", TextColor3 = Theme.MUTED, MaxSize = 18,
	}, overlay)

	local width = Config.CHOICES * CARD_W + (Config.CHOICES - 1) * CARD_GAP
	local row = Theme.new("Frame", {
		Size = UDim2.fromOffset(width, CARD_H), Position = UDim2.new(0.5, -width / 2, 0.5, -170),
		BackgroundTransparency = 1, ZIndex = 21,
	}, overlay)
	for i = 1, Config.CHOICES do
		local x = (i - 1) * (CARD_W + CARD_GAP)
		local button = Theme.new("TextButton", {
			Size = UDim2.fromOffset(CARD_W, CARD_H), Position = UDim2.fromOffset(x, 0), Text = "",
			AutoButtonColor = false, BackgroundColor3 = Theme.CARD, ZIndex = 22,
		}, row)
		Theme.corner(button, 18)
		local stroke = Theme.stroke(button, Theme.ACCENT, 2, 0.5)
		Theme.gradient(button, Color3.fromRGB(255, 255, 255), Color3.fromRGB(160, 165, 195))
		local accent = Theme.new("Frame", { Size = UDim2.new(1, -36, 0, 4), Position = UDim2.fromOffset(18, 0), BorderSizePixel = 0, ZIndex = 23 }, button)
		Theme.corner(accent, 2)
		local tag = Theme.chip({ Size = UDim2.fromOffset(130, 24), Position = UDim2.fromOffset(14, 16), ZIndex = 23, MaxSize = 13 }, button)
		Theme.chip({ Size = UDim2.fromOffset(26, 24), Position = UDim2.new(1, -40, 0, 16), Text = tostring(i), ZIndex = 23, MaxSize = 13 }, button, Theme.LINE)
		local icon, iconText = Theme.icon({ Size = UDim2.fromOffset(92, 92), Position = UDim2.new(0.5, -46, 0, 54), ZIndex = 23 }, button, "", Theme.ACCENT, 22)
		local title = Theme.title({ Size = UDim2.new(1, -28, 0, 44), Position = UDim2.fromOffset(14, 158), TextWrapped = true, ZIndex = 23, MaxSize = 22 }, button)
		local desc = Theme.text({ Size = UDim2.new(1, -32, 0, 72), Position = UDim2.fromOffset(16, 206), TextWrapped = true, TextColor3 = Theme.MUTED, ZIndex = 23, MaxSize = 16 }, button)
		local pips = Theme.new("Frame", { Size = UDim2.new(1, -40, 0, 6), Position = UDim2.new(0, 20, 1, -26), BackgroundTransparency = 1, ZIndex = 23 }, button)
		Theme.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 4) }, pips)

		button.MouseEnter:Connect(function()
			Theme.tween(button, 0.15, { Position = UDim2.fromOffset(x, -8) })
			Theme.tween(stroke, 0.15, { Transparency = 0, Thickness = 3 })
		end)
		button.MouseLeave:Connect(function()
			Theme.tween(button, 0.15, { Position = UDim2.fromOffset(x, 0) })
			Theme.tween(stroke, 0.15, { Transparency = 0.5, Thickness = 2 })
		end)
		button.Activated:Connect(function()
			Hud.choose(i)
		end)
		cards[i] = { button = button, stroke = stroke, accent = accent, tag = tag, icon = icon, iconText = iconText, title = title, desc = desc, pips = pips, x = x }
	end

	ui.reroll = Theme.button({
		Size = UDim2.fromOffset(220, 46), Position = UDim2.new(0.5, -110, 0.5, 180), Text = "🎲  REROLL  (R)",
		BackgroundColor3 = Theme.CARD_LIGHT, ZIndex = 22,
	}, overlay, function()
		Hud.reroll()
	end)
end

-- Announcements and results -------------------------------------------------------------

local function buildBanners(gui)
	local banner = Theme.panel({ Size = UDim2.fromOffset(600, 64), Position = UDim2.new(0.5, -300, 0.2, 0), Visible = false, ZIndex = 15 }, gui)
	ui.announce = banner
	ui.announceBar = Theme.new("Frame", { Size = UDim2.new(0, 6, 1, -20), Position = UDim2.fromOffset(12, 10), BorderSizePixel = 0, ZIndex = 16 }, banner)
	Theme.corner(ui.announceBar, 3)
	ui.announceText = Theme.title({ Size = UDim2.new(1, -50, 1, -18), Position = UDim2.fromOffset(30, 9), ZIndex = 16 }, banner)

	local overlay = Theme.new("Frame", {
		Name = "Results", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Theme.BG,
		BackgroundTransparency = 0.35, Visible = false, ZIndex = 30,
	}, gui)
	ui.results = overlay
	local card = Theme.panel({ Size = UDim2.fromOffset(500, 440), Position = UDim2.new(0.5, -250, 0.5, -220), ZIndex = 31 }, overlay)
	ui.resultScale = Theme.new("UIScale", {}, card)
	local tile, icon = Theme.icon({ Size = UDim2.fromOffset(72, 72), Position = UDim2.new(0.5, -36, 0, 22), ZIndex = 32 }, card, "🏆", Theme.GOLD, 20)
	ui.resultTile, ui.resultIcon = tile, icon
	ui.resultTitle = Theme.title({ Size = UDim2.new(1, -40, 0, 46), Position = UDim2.fromOffset(20, 102), ZIndex = 32 }, card)
	ui.resultAdventure = Theme.chip({ Size = UDim2.fromOffset(300, 26), Position = UDim2.new(0.5, -150, 0, 152), ZIndex = 32, MaxSize = 14 }, card)
	ui.resultRows = {}
	for i, name in { "Time", "Level", "Defeated" } do
		local stat = Theme.card({ Size = UDim2.fromOffset(142, 74), Position = UDim2.fromOffset(20 + (i - 1) * 154, 194), ZIndex = 32 }, card)
		ui.resultRows[i] = Theme.title({ Size = UDim2.new(1, -16, 0, 34), Position = UDim2.fromOffset(8, 10), ZIndex = 33 }, stat)
		Theme.text({ Size = UDim2.new(1, -16, 0, 18), Position = UDim2.fromOffset(8, 46), Text = name, TextColor3 = Theme.MUTED, ZIndex = 33, MaxSize = 14 }, stat)
	end
	ui.resultGold = Theme.title({ Size = UDim2.new(1, -40, 0, 46), Position = UDim2.fromOffset(20, 282), TextColor3 = Theme.GOLD, ZIndex = 32 }, card)
	ui.resultUnlocked = Theme.chip({ Size = UDim2.fromOffset(440, 28), Position = UDim2.new(0.5, -220, 0, 338), ZIndex = 32, MaxSize = 14 }, card, Theme.GOOD)
	Theme.text({
		Size = UDim2.new(1, -40, 0, 18), Position = UDim2.new(0, 20, 1, -36), ZIndex = 32,
		Text = "Sailing back to the island...", TextColor3 = Theme.MUTED, MaxSize = 15,
	}, card)
end

-- Count a label up from 0 to `value`.
local function countUp(label, value, format)
	local number = Instance.new("NumberValue")
	number.Changed:Connect(function(v)
		label.Text = format(v)
	end)
	label.Text = format(0)
	Theme.tween(number, 1.2, { Value = value })
	task.delay(1.3, function()
		number:Destroy()
	end)
end

-- Blurs the world behind full-screen menus.
local blur = Instance.new("BlurEffect")
blur.Size = 0
local function setBlur(on)
	blur.Parent = workspace.CurrentCamera
	Theme.tween(blur, 0.25, { Size = on and 14 or 0 })
end

-- Public -----------------------------------------------------------------------------------

function Hud.init(gui, cb)
	callbacks = cb
	local root = Theme.new("Frame", { Name = "RunHud", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false }, gui)
	ui.root = root
	buildStatus(root)
	buildActionBar(root)
	buildHealth(root)
	buildCrewControls(root)
	buildLevelUp(gui)
	buildBanners(gui)
	Hud.setStats({ level = 1, xp = 0, need = 1, kills = 0, weapons = {}, passives = {}, slots = Config.WEAPON_SLOTS_START })
end

function Hud.setVisible(visible)
	ui.root.Visible = visible
	if not visible then
		Hud.showLevelUp(nil)
	end
end

function Hud.setState(state)
	ui.adventure.Text = (state.adventure or ""):upper()
	ui.adventure.TextColor3 = state.color or Theme.MUTED
	ui.timer.Text = state.text or ""
	ui.timer.TextColor3 = state.boss and Theme.BAD or Theme.TEXT
	ui.down.Visible = state.down == true
end

-- Revives the player owns (from the store), shown on the knocked-out panel.
function Hud.setRevives(count)
	ui.revives = count
	ui.revive.Text = count > 0 and string.format("💖  REVIVE  (%d left)", count) or "💖  BUY A REVIVE"
end

function Hud.setWatching(name)
	ui.watching.Text = name and "Watching " .. name or "No crewmates standing"
end

-- Shows the dash recharging over `cooldown` seconds.
function Hud.dashUsed(cooldown)
	ui.dashShade.Size = UDim2.new(1, 10, 1, 10)
	Theme.tween(ui.dashShade, cooldown, { Size = UDim2.new(0, 0, 1, 10) }, Enum.EasingStyle.Linear)
end

function Hud.setStats(st)
	Theme.tween(ui.xpFill, 0.2, { Size = UDim2.fromScale(math.clamp(st.xp / st.need, 0, 1), 1) })
	ui.level.Text = tostring(st.level)
	ui.kills.Text = "💀 " .. Theme.comma(st.kills)
	local unlocked = st.slots or Config.WEAPON_SLOTS_START
	for i, slot in ui.weaponSlots do
		fillSlot(slot, st.weapons[i], Config.WEAPON_MAX, i > unlocked)
	end
	for i, slot in ui.passiveSlots do
		fillSlot(slot, st.passives[i], Config.PASSIVE_MAX, false)
	end
end

function Hud.showLevelUp(list, rerolls)
	if not list then
		if ui.levelOverlay.Visible then
			setBlur(false)
		end
		ui.levelOverlay.Visible = false
		return
	end
	for i, card in cards do
		local c = list[i]
		card.button.Visible = c ~= nil
		if c then
			local tint = c.tag == "EVOLUTION" and EVO_COLOR or c.tag == "FUSION" and FUSION_COLOR or c.color
			card.tag.Text = c.tag or ""
			card.tag.BackgroundColor3 = tint
			card.tag.TextColor3 = tint:Lerp(Color3.new(1, 1, 1), 0.5)
			card.accent.BackgroundColor3 = tint
			card.stroke.Color = tint
			card.icon.BackgroundColor3 = c.color
			card.iconText.Text = c.icon or initials(c.title)
			card.title.Text = c.title
			card.desc.Text = c.text
			setPips(card.pips, c.level, c.max, tint)
			-- cards rise into place one after another
			card.button.Position = UDim2.fromOffset(card.x, 70)
			Theme.tween(card.button, 0.35 + i * 0.06, { Position = UDim2.fromOffset(card.x, 0) }, Enum.EasingStyle.Back)
		end
	end
	ui.reroll.Text = string.format("🎲  REROLL (R)  x%d", rerolls or 0)
	ui.reroll.Visible = (rerolls or 0) > 0
	if not ui.levelOverlay.Visible then
		setBlur(true)
	end
	ui.levelOverlay.Visible = true
end

function Hud.choose(i)
	if ui.levelOverlay.Visible and cards[i] and cards[i].button.Visible then
		ui.levelOverlay.Visible = false -- the server sends the next offer, if any
		setBlur(false)
		callbacks.choose(i)
	end
end

function Hud.reroll()
	if ui.levelOverlay.Visible and ui.reroll.Visible then
		callbacks.reroll()
	end
end

function Hud.announce(text, color)
	color = color or Theme.GOLD
	ui.announceText.Text = text:upper()
	ui.announceText.TextColor3 = color:Lerp(Color3.new(1, 1, 1), 0.35)
	ui.announceBar.BackgroundColor3 = color
	ui.announce:FindFirstChildOfClass("UIStroke").Color = color
	ui.announce.Position = UDim2.new(0.5, -300, 0.2, -30)
	ui.announce.Visible = true
	Theme.tween(ui.announce, 0.35, { Position = UDim2.new(0.5, -300, 0.2, 0) }, Enum.EasingStyle.Back)
	task.delay(2.8, function()
		ui.announce.Visible = false
	end)
end

function Hud.showResults(r)
	local victory = r.result == "Victory"
	ui.resultTitle.Text = victory and "VICTORY" or "DEFEATED"
	ui.resultTitle.TextColor3 = victory and Theme.GOLD or Theme.BAD
	ui.resultIcon.Text = victory and "🏆" or "☠️"
	ui.resultTile.BackgroundColor3 = victory and Theme.GOLD or Theme.BAD
	ui.resultAdventure.Text = r.adventure or ""
	ui.resultAdventure.BackgroundColor3 = r.color or Theme.ACCENT
	local notes = {}
	if r.unlocked then
		table.insert(notes, "🔓 " .. r.unlocked)
	end
	if r.drop then
		table.insert(notes, string.format("🎁 %s %s%s", r.drop.icon, r.drop.name,
			r.drop.duplicate and " (owned: +" .. Theme.comma(r.drop.duplicate) .. " gold)" or " (" .. r.drop.rarity .. ")"))
	end
	ui.resultUnlocked.Text = table.concat(notes, "   ")
	ui.resultUnlocked.Visible = #notes > 0
	countUp(ui.resultRows[1], r.time, function(v)
		v = math.floor(v)
		return string.format("%d:%02d", v // 60, v % 60)
	end)
	countUp(ui.resultRows[2], r.level, function(v)
		return tostring(math.floor(v))
	end)
	countUp(ui.resultRows[3], r.kills, function(v)
		return Theme.comma(v)
	end)
	countUp(ui.resultGold, r.gold, function(v)
		return "+" .. Theme.comma(v) .. " 💰"
	end)
	ui.results.Visible = true
	setBlur(true)
	ui.resultScale.Scale = 0.7
	Theme.tween(ui.resultScale, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)
	task.delay(Config.RESULTS_TIME, function()
		ui.results.Visible = false
		setBlur(false)
	end)
end

return Hud
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX13492"><Properties><string name="Name">Lobby</string><ProtectedString name="Source"><![CDATA[-- Spawn island UI: character select, training, gear, upgrades shop, Robux store, the gate's
-- map select, gold counter, hints and the voyage gate boarding banner. NPC prompts open these
-- menus too (see SwarmClient). Maps are only chosen at a voyage gate.
local RS = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(RS:WaitForChild("Shared"):WaitForChild("Config"))
local Theme = require(script.Parent.Theme)

local Lobby = {}
local ui = {}
local callbacks
local classCards = {}
local shopRows = {}
local mapCards = {}
local diffButtons = {}
local panels = {}
local lastPortalMessage = 0
local portal -- latest boarding info from the server while standing on a gate
local pickerOpened = false -- opened the map select once for this boarding
local selectedMap, selectedDifficulty = Config.Maps[1].key, 1
local meta = { gold = 0, levels = {}, costs = {}, progress = {}, class = Config.DEFAULT_CLASS }

local THEME_COLORS = {
	grass = Color3.fromRGB(80, 160, 70), marine = Color3.fromRGB(70, 110, 180), town = Color3.fromRGB(180, 140, 90),
	beach = Color3.fromRGB(220, 190, 120), ship = Color3.fromRGB(140, 95, 55), deepsea = Color3.fromRGB(40, 120, 190),
	snow = Color3.fromRGB(170, 200, 235), desert = Color3.fromRGB(220, 180, 100), jungle = Color3.fromRGB(40, 120, 60),
	sky = Color3.fromRGB(150, 185, 255), spooky = Color3.fromRGB(110, 60, 140), mangrove = Color3.fromRGB(120, 180, 90),
	prison = Color3.fromRGB(90, 85, 100), volcano = Color3.fromRGB(200, 70, 40), wano = Color3.fromRGB(230, 120, 170),
}
local THEME_ICONS = {
	grass = "🌾", marine = "⚓", town = "🏘️", beach = "🏖️", ship = "🚢", deepsea = "🐠", snow = "❄️", desert = "🏜️",
	jungle = "🌴", sky = "☁️", spooky = "👻", mangrove = "🌳", prison = "⛓️", volcano = "🌋", wano = "🌸",
}

local function isCaptain()
	return portal ~= nil and portal.captain and os.clock() - lastPortalMessage < 0.6
end

-- Building blocks -----------------------------------------------------------------------

local function panel(name, width, height, title, subtitle)
	local frame = Theme.panel({
		Name = name, Size = UDim2.fromOffset(width, height), Position = UDim2.new(0.5, -width / 2, 0.5, -height / 2),
		Visible = false, ZIndex = 10,
	}, ui.root)
	panels[name:lower()] = { frame = frame, scale = Theme.new("UIScale", {}, frame), height = height, width = width }
	Theme.title({ Size = UDim2.new(1, -120, 0, 34), Position = UDim2.fromOffset(28, 22), Text = title, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 11 }, frame)
	local sub = Theme.text({ Size = UDim2.new(1, -120, 0, 18), Position = UDim2.fromOffset(28, 58), Text = subtitle or "", TextColor3 = Theme.MUTED, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 11, MaxSize = 15 }, frame)
	Theme.button({
		Size = UDim2.fromOffset(40, 40), Position = UDim2.new(1, -60, 0, 20), Text = "X",
		BackgroundColor3 = Theme.CARD_LIGHT, ZIndex = 12,
	}, frame, function()
		Lobby.toggle(name:lower(), false)
	end)
	return frame, sub
end

local function scroller(parent, props)
	props.BackgroundTransparency = 1
	props.BorderSizePixel = 0
	props.ScrollBarThickness = 6
	props.ScrollBarImageColor3 = Theme.MUTED
	props.ScrollingDirection = Enum.ScrollingDirection.Y
	props.CanvasSize = UDim2.new()
	props.AutomaticCanvasSize = Enum.AutomaticSize.Y
	props.ZIndex = 11
	local frame = Theme.new("ScrollingFrame", props, parent)
	Theme.padding(frame, 6)
	return frame
end

local function hover(button, scale)
	button.MouseEnter:Connect(function()
		Theme.tween(scale, 0.12, { Scale = 1.04 })
	end)
	button.MouseLeave:Connect(function()
		Theme.tween(scale, 0.12, { Scale = 1 })
	end)
end

-- Character select ------------------------------------------------------------------

local function buildCrew()
	local frame = panel("Crew", 860, 640, "CHOOSE YOUR PIRATE", #Config.CLASS_ORDER .. " pirates  -  each with 6 skills and their own gear")
	local grid = scroller(frame, { Size = UDim2.new(1, -40, 0, 452), Position = UDim2.fromOffset(20, 88) })
	Theme.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(190, 244), CellPadding = UDim2.fromOffset(12, 12),
		HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder,
	}, grid)

	local details = Theme.card({ Size = UDim2.new(1, -40, 0, 76), Position = UDim2.new(0, 20, 1, -92), ZIndex = 11 }, frame)
	ui.detailsIcon = select(2, Theme.icon({ Size = UDim2.fromOffset(52, 52), Position = UDim2.fromOffset(12, 12), ZIndex = 12 }, details, "", Theme.ACCENT, 14))
	ui.detailsTile = ui.detailsIcon.Parent
	ui.detailsTitle = Theme.title({ Size = UDim2.new(1, -90, 0, 22), Position = UDim2.fromOffset(78, 12), TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 12 }, details)
	ui.detailsSkills = Theme.text({
		Size = UDim2.new(1, -90, 0, 30), Position = UDim2.fromOffset(78, 36), TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true, TextColor3 = Theme.MUTED, ZIndex = 12, MaxSize = 14,
	}, details)

	for i, name in Config.CLASS_ORDER do
		local class = Config.Classes[name]
		local card = Theme.new("TextButton", { Text = "", AutoButtonColor = false, BackgroundColor3 = Theme.CARD, LayoutOrder = i, ZIndex = 12 }, grid)
		Theme.corner(card, 16)
		local stroke = Theme.stroke(card, class.color, 1.5, 0.55)
		Theme.gradient(card, Color3.new(1, 1, 1), Color3.fromRGB(165, 170, 200))
		local scale = Theme.new("UIScale", {}, card)
		hover(card, scale)

		Theme.icon({ Size = UDim2.fromOffset(84, 84), Position = UDim2.new(0.5, -42, 0, 16), ZIndex = 13 }, card, class.icon, class.color, 42)
		Theme.title({ Size = UDim2.new(1, -20, 0, 24), Position = UDim2.fromOffset(10, 108), Text = name:upper(), ZIndex = 13, MaxSize = 22 }, card)
		Theme.text({ Size = UDim2.new(1, -20, 0, 16), Position = UDim2.fromOffset(10, 134), Text = class.title, TextColor3 = Theme.MUTED, ZIndex = 13, MaxSize = 14 }, card)
		Theme.chip({ Size = UDim2.new(1, -36, 0, 24), Position = UDim2.fromOffset(18, 158), Text = class.perk, ZIndex = 13, MaxSize = 12 }, card, Theme.GOOD)

		-- the character's 6 skill icons
		local row = Theme.new("Frame", { Size = UDim2.new(1, -20, 0, 26), Position = UDim2.fromOffset(10, 198), BackgroundTransparency = 1, ZIndex = 13 }, card)
		Theme.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 4) }, row)
		for _, key in class.skills do
			local w = Config.Weapons[key]
			Theme.icon({ Size = UDim2.fromOffset(25, 25), ZIndex = 14 }, row, w.icon, w.color, 7)
		end

		local selected = Theme.chip({ Size = UDim2.fromOffset(92, 22), Position = UDim2.fromOffset(10, 10), Text = "✓ SELECTED", Visible = false, ZIndex = 15, MaxSize = 11 }, card, Theme.GOLD)
		card.MouseEnter:Connect(function()
			Lobby.showSkills(name)
		end)
		card.MouseLeave:Connect(function()
			Lobby.showSkills(meta.class)
		end)
		card.Activated:Connect(function()
			callbacks.selectClass(name)
		end)
		classCards[name] = { stroke = stroke, selected = selected, color = class.color }
	end
end

-- Upgrade shop --------------------------------------------------------------------------

local function buildShop()
	local frame = panel("Shop", 660, 620, "UPGRADES", "Spend gold from adventures. Upgrades last forever.")
	for i, name in Config.META_ORDER do
		local m = Config.Meta[name]
		local row = Theme.card({ Size = UDim2.new(1, -48, 0, 74), Position = UDim2.fromOffset(24, 92 + (i - 1) * 84), ZIndex = 11 }, frame)
		Theme.icon({ Size = UDim2.fromOffset(50, 50), Position = UDim2.fromOffset(12, 12), ZIndex = 12 }, row, m.icon, Theme.ACCENT, 14)
		Theme.title({ Size = UDim2.new(0, 220, 0, 22), Position = UDim2.fromOffset(76, 14), Text = m.name:upper(), TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 12, MaxSize = 20 }, row)
		Theme.text({ Size = UDim2.new(0, 220, 0, 16), Position = UDim2.fromOffset(76, 42), Text = m.desc .. " per level", TextColor3 = Theme.MUTED, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 12, MaxSize = 14 }, row)
		local pips = Theme.new("Frame", { Size = UDim2.fromOffset(140, 8), Position = UDim2.new(1, -310, 0.5, -4), BackgroundTransparency = 1, ZIndex = 12 }, row)
		Theme.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 3), VerticalAlignment = Enum.VerticalAlignment.Center }, pips)
		local pipFrames = {}
		for p = 1, m.max do
			local pip = Theme.new("Frame", { Size = UDim2.fromOffset(math.floor(140 / m.max) - 3, 8), BackgroundColor3 = Theme.LINE, BackgroundTransparency = 0.88, ZIndex = 13 }, pips)
			Theme.corner(pip, 4)
			pipFrames[p] = pip
		end
		local buy = Theme.button({
			Size = UDim2.fromOffset(140, 46), Position = UDim2.new(1, -154, 0.5, -23), Text = "",
			BackgroundColor3 = Theme.GOOD, ZIndex = 12,
		}, row, function()
			callbacks.buy(name)
		end)
		shopRows[name] = { pips = pipFrames, buy = buy }
	end
end

-- Map select (only from a voyage gate) ---------------------------------------------------

local function buildVoyage()
	local frame, sub = panel("Voyage", 900, 640, "CHOOSE AN ADVENTURE")
	ui.voyageHint = sub

	local grid = scroller(frame, { Size = UDim2.fromOffset(580, 520), Position = UDim2.fromOffset(16, 96) })
	Theme.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(134, 96), CellPadding = UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder,
	}, grid)
	for i, map in Config.Maps do
		local color = THEME_COLORS[map.theme]
		local card = Theme.new("TextButton", { Text = "", AutoButtonColor = false, BackgroundColor3 = Theme.CARD, LayoutOrder = i, ZIndex = 12 }, grid)
		Theme.corner(card, 12)
		local stroke = Theme.stroke(card, Theme.LINE, 1, 0.88)
		local band = Theme.new("Frame", { Size = UDim2.new(1, 0, 0, 40), BackgroundColor3 = color, ZIndex = 12 }, card)
		Theme.corner(band, 12)
		Theme.gradient(band, Color3.new(1, 1, 1), Color3.fromRGB(120, 120, 140))
		Theme.text({ Size = UDim2.fromOffset(32, 32), Position = UDim2.new(1, -38, 0, 4), Text = THEME_ICONS[map.theme], ZIndex = 13 }, band)
		Theme.chip({ Size = UDim2.fromOffset(28, 22), Position = UDim2.fromOffset(8, 9), Text = tostring(i), ZIndex = 13, MaxSize = 12, BackgroundTransparency = 0.3 }, band, Theme.BG)
		Theme.title({ Size = UDim2.new(1, -16, 0, 30), Position = UDim2.fromOffset(8, 44), Text = map.name, TextWrapped = true, ZIndex = 13, MaxSize = 15 }, card)
		local pips = Theme.new("Frame", { Size = UDim2.new(1, -16, 0, 6), Position = UDim2.new(0, 8, 1, -14), BackgroundTransparency = 1, ZIndex = 13 }, card)
		Theme.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 4) }, pips)
		local pipFrames = {}
		for d = 1, #Config.Difficulties do
			local pip = Theme.new("Frame", { Size = UDim2.fromOffset(20, 6), ZIndex = 14 }, pips)
			Theme.corner(pip, 3)
			pipFrames[d] = pip
		end
		local lock = Theme.text({ Size = UDim2.fromScale(1, 1), Text = "🔒", BackgroundTransparency = 0.3, BackgroundColor3 = Theme.BG, ZIndex = 16, Visible = false, MaxSize = 28 }, card)
		Theme.corner(lock, 12)
		local busy = Theme.chip({ Size = UDim2.fromOffset(70, 20), Position = UDim2.new(1, -78, 0, 46), Text = "IN USE", Visible = false, ZIndex = 15, MaxSize = 11 }, card, Theme.BAD)
		card.Activated:Connect(function()
			selectedMap = map.key
			Lobby.refreshVoyage()
		end)
		mapCards[map.key] = { stroke = stroke, pips = pipFrames, lock = lock, busy = busy }
	end

	local side = Theme.card({ Size = UDim2.fromOffset(284, 520), Position = UDim2.fromOffset(604, 96), ZIndex = 11 }, frame)
	ui.mapName = Theme.title({ Size = UDim2.new(1, -24, 0, 30), Position = UDim2.fromOffset(12, 14), TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 12, MaxSize = 22 }, side)
	ui.mapBoss = Theme.chip({ Size = UDim2.new(1, -24, 0, 26), Position = UDim2.fromOffset(12, 52), ZIndex = 12, MaxSize = 13 }, side, Theme.BAD)
	ui.mapInfo = Theme.text({ Size = UDim2.new(1, -24, 0, 16), Position = UDim2.fromOffset(12, 86), TextColor3 = Theme.MUTED, ZIndex = 12, MaxSize = 13 }, side)
	for d, diff in Config.Difficulties do
		diffButtons[d] = Theme.button({
			Size = UDim2.new(1, -24, 0, 48), Position = UDim2.fromOffset(12, 112 + (d - 1) * 56), Text = "",
			BackgroundColor3 = diff.color, ZIndex = 12,
		}, side, function()
			selectedDifficulty = d
			Lobby.refreshVoyage()
		end)
	end
	ui.sail = Theme.button({
		Size = UDim2.new(1, -24, 0, 54), Position = UDim2.new(0, 12, 1, -66), Text = "⛵  SET SAIL",
		BackgroundColor3 = Theme.GOOD, ZIndex = 12,
	}, side, function()
		local map = Config.MapByKey[selectedMap]
		local busy = portal and portal.busy and portal.busy[selectedMap]
		if isCaptain() and not busy and Config.unlocked(meta.progress, map, selectedDifficulty) then
			callbacks.voyage(selectedMap, selectedDifficulty)
			Lobby.toggle("voyage", false)
		end
	end)
end

-- Training (Rayleigh: skills, Dr. Kureha: passives) ------------------------------------------

local trainTab = "skills"

local function buildTrain()
	local frame, sub = panel("Train", 780, 640, "TRAINING")
	ui.trainHint = sub
	ui.trainTabs = {}
	for i, tab in { { "skills", "⚔️  SKILLS  -  Rayleigh" }, { "passives", "💊  PASSIVES  -  Dr. Kureha" } } do
		ui.trainTabs[tab[1]] = Theme.button({
			Size = UDim2.fromOffset(250, 38), Position = UDim2.fromOffset(28 + (i - 1) * 262, 88), Text = tab[2],
			BackgroundColor3 = Theme.CARD_LIGHT, ZIndex = 12,
		}, frame, function()
			trainTab = tab[1]
			Lobby.refreshTrain()
		end)
	end
	ui.trainList = scroller(frame, { Size = UDim2.new(1, -40, 1, -156), Position = UDim2.fromOffset(20, 138) })
	Theme.new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, ui.trainList)
end

local function trainRow(order, icon, color, name, effect, level, max, cost, onTrain)
	local row = Theme.card({ Size = UDim2.new(1, -12, 0, 72), LayoutOrder = order, ZIndex = 12 }, ui.trainList)
	Theme.icon({ Size = UDim2.fromOffset(50, 50), Position = UDim2.fromOffset(11, 11), ZIndex = 13 }, row, icon, color, 14)
	Theme.title({ Size = UDim2.new(0, 300, 0, 22), Position = UDim2.fromOffset(74, 12), Text = name, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 13, MaxSize = 18 }, row)
	Theme.text({ Size = UDim2.new(0, 330, 0, 16), Position = UDim2.fromOffset(74, 40), Text = effect, TextColor3 = Theme.MUTED, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 13, MaxSize = 13 }, row)
	local pips = Theme.new("Frame", { Size = UDim2.fromOffset(130, 8), Position = UDim2.new(1, -300, 0.5, -4), BackgroundTransparency = 1, ZIndex = 13 }, row)
	Theme.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 3) }, pips)
	for i = 1, max do
		local pip = Theme.new("Frame", {
			Size = UDim2.fromOffset(math.floor(130 / max) - 3, 8), BackgroundColor3 = i <= level and Theme.GOLD or Theme.LINE,
			BackgroundTransparency = i <= level and 0 or 0.88, ZIndex = 14,
		}, pips)
		Theme.corner(pip, 4)
	end
	local maxed = level >= max
	Theme.button({
		Size = UDim2.fromOffset(140, 44), Position = UDim2.new(1, -152, 0.5, -22),
		Text = maxed and "MAXED" or "💰 " .. Theme.comma(cost),
		BackgroundColor3 = maxed and Theme.LOCKED or meta.gold >= cost and Theme.GOOD or Color3.fromRGB(150, 60, 70), ZIndex = 13,
	}, row, not maxed and onTrain or nil)
end

function Lobby.refreshTrain()
	for _, child in ui.trainList:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	for tab, button in ui.trainTabs do
		button.BackgroundColor3 = tab == trainTab and Theme.ACCENT or Theme.CARD_LIGHT
	end
	local mastery, training = meta.mastery or {}, meta.training or {}
	if trainTab == "skills" then
		local class = Config.Classes[meta.class] or Config.Classes[Config.DEFAULT_CLASS]
		ui.trainHint.Text = "Permanently power up " .. (meta.class or "your pirate") .. "'s skills. Switch pirates in CREW to train others."
		for i, key in class.skills do
			local w = Config.Weapons[key]
			local level = mastery[key] or 0
			local effect = string.format("+%d%% damage, -%d%% cooldown per level  (now +%d%% / -%d%%)",
				Config.MASTERY.damage * 100, Config.MASTERY.cooldown * 100, Config.MASTERY.damage * 100 * level, Config.MASTERY.cooldown * 100 * level)
			trainRow(i, w.icon, w.color, w.name, effect, level, Config.MASTERY.max, Config.trainCost("skill", level), function()
				callbacks.train("skill", key)
			end)
		end
	else
		ui.trainHint.Text = "Make every passive stronger, forever. Each level adds 15% to that passive's effect."
		local order = 0
		for key, p in Config.Passives do
			order += 1
			local level = training[key] or 0
			local effect = string.format("%s per level  -  boosted +%d%%", p.desc, Config.TRAINING.boost * 100 * level)
			trainRow(order, p.icon, Theme.ACCENT, p.name, effect, level, Config.TRAINING.max, Config.trainCost("passive", level), function()
				callbacks.train("passive", key)
			end)
		end
	end
end

-- Gear (Tom the Shipwright) ----------------------------------------------------------------

local gearTab = "weapon"

local function buildGear()
	local frame = panel("Gear", 840, 640, "GEAR", "Equip one weapon, one outfit and one charm. Mythic gear only drops from bosses.")
	ui.equippedCards = {}
	for i, slot in Config.GEAR_SLOTS do
		local card = Theme.card({ Size = UDim2.fromOffset(256, 80), Position = UDim2.fromOffset(28 + (i - 1) * 268, 88), ZIndex = 11 }, frame)
		local tile, icon = Theme.icon({ Size = UDim2.fromOffset(56, 56), Position = UDim2.fromOffset(12, 12), ZIndex = 12 }, card, "", Theme.CARD_LIGHT, 14)
		local name = Theme.title({ Size = UDim2.new(1, -86, 0, 20), Position = UDim2.fromOffset(78, 14), TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 12, MaxSize = 17 }, card)
		local stats = Theme.text({ Size = UDim2.new(1, -86, 0, 30), Position = UDim2.fromOffset(78, 38), TextWrapped = true, TextColor3 = Theme.MUTED, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 12, MaxSize = 12 }, card)
		ui.equippedCards[slot] = { tile = tile, icon = icon, name = name, stats = stats }
	end
	ui.gearTabs = {}
	for i, slot in Config.GEAR_SLOTS do
		ui.gearTabs[slot] = Theme.button({
			Size = UDim2.fromOffset(180, 36), Position = UDim2.fromOffset(28 + (i - 1) * 192, 182),
			Text = Config.GEAR_SLOT_ICONS[slot] .. "  " .. Config.GEAR_SLOT_NAMES[slot]:upper(), BackgroundColor3 = Theme.CARD_LIGHT, ZIndex = 12,
		}, frame, function()
			gearTab = slot
			Lobby.refreshGear()
		end)
	end
	ui.gearList = scroller(frame, { Size = UDim2.new(1, -40, 1, -250), Position = UDim2.fromOffset(20, 230) })
	Theme.new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, ui.gearList)
end

function Lobby.refreshGear()
	local items, equipped = meta.items or {}, meta.equipped or {}
	for slot, card in ui.equippedCards do
		local item = equipped[slot] and Config.GearById[equipped[slot]]
		card.icon.Text = item and item.icon or Config.GEAR_SLOT_ICONS[slot]
		card.tile.BackgroundColor3 = item and Config.RARITIES[item.rarity] or Theme.CARD_LIGHT
		card.name.Text = item and item.name or "No " .. Config.GEAR_SLOT_NAMES[slot]:lower()
		card.stats.Text = item and Config.describeBonus(item.bonus) or "Pick one below"
	end
	for slot, button in ui.gearTabs do
		button.BackgroundColor3 = slot == gearTab and Theme.ACCENT or Theme.CARD_LIGHT
	end
	for _, child in ui.gearList:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	local order = 0
	for _, item in Config.GEAR_ITEMS do
		if item.slot == gearTab then
			order += 1
			local color = Config.RARITIES[item.rarity]
			local row = Theme.card({ Size = UDim2.new(1, -12, 0, 72), LayoutOrder = order, ZIndex = 12 }, ui.gearList)
			Theme.icon({ Size = UDim2.fromOffset(50, 50), Position = UDim2.fromOffset(11, 11), ZIndex = 13 }, row, item.icon, color, 14)
			Theme.title({ Size = UDim2.new(0, 260, 0, 22), Position = UDim2.fromOffset(74, 12), Text = item.name, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 13, MaxSize = 18 }, row)
			Theme.chip({ Size = UDim2.fromOffset(96, 20), Position = UDim2.fromOffset(74, 40), Text = item.rarity:upper(), ZIndex = 13, MaxSize = 11 }, row, color)
			Theme.text({ Size = UDim2.new(0, 280, 0, 34), Position = UDim2.fromOffset(180, 34), Text = Config.describeBonus(item.bonus), TextWrapped = true, TextColor3 = Theme.MUTED, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 13, MaxSize = 13 }, row)
			local text, color2, action
			if equipped[item.slot] == item.id then
				text, color2, action = "✓ EQUIPPED", Theme.ACCENT, "equip"
			elseif items[item.id] then
				text, color2, action = "EQUIP", Theme.GOOD, "equip"
			elseif item.cost > 0 then
				text, color2, action = "💰 " .. Theme.comma(item.cost), meta.gold >= item.cost and Theme.GOOD or Color3.fromRGB(150, 60, 70), "buy"
			else
				text, color2 = "☠️ BOSS DROP", Theme.LOCKED
			end
			Theme.button({ Size = UDim2.fromOffset(150, 44), Position = UDim2.new(1, -162, 0.5, -22), Text = text, BackgroundColor3 = color2, ZIndex = 13 }, row,
				action and function()
					callbacks.gear(action, item.id)
				end or nil)
		end
	end
end

-- Robux store (Buggy) --------------------------------------------------------------------

local function buildStore()
	local frame = panel("Store", 840, 640, "STORE", "Support the game and get perks. Game passes are forever; products are used up.")
	Theme.title({ Size = UDim2.fromOffset(300, 22), Position = UDim2.fromOffset(28, 90), Text = "GAME PASSES", TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Theme.GOLD, ZIndex = 11, MaxSize = 18 }, frame)
	ui.passButtons = {}
	for i, key in Config.PASS_ORDER do
		local pass = Config.GAME_PASSES[key]
		local card = Theme.card({ Size = UDim2.fromOffset(188, 196), Position = UDim2.fromOffset(28 + (i - 1) * 198, 120), ZIndex = 11 }, frame)
		Theme.icon({ Size = UDim2.fromOffset(60, 60), Position = UDim2.new(0.5, -30, 0, 12), ZIndex = 12 }, card, pass.icon, Theme.GOLD, 16)
		Theme.title({ Size = UDim2.new(1, -16, 0, 22), Position = UDim2.fromOffset(8, 78), Text = pass.name, ZIndex = 12, MaxSize = 18 }, card)
		Theme.text({ Size = UDim2.new(1, -20, 0, 40), Position = UDim2.fromOffset(10, 102), Text = pass.desc, TextWrapped = true, TextColor3 = Theme.MUTED, ZIndex = 12, MaxSize = 13 }, card)
		ui.passButtons[key] = Theme.button({ Size = UDim2.new(1, -20, 0, 36), Position = UDim2.new(0, 10, 1, -46), Text = "", ZIndex = 12 }, card, function()
			callbacks.buyPass(key)
		end)
	end
	Theme.title({ Size = UDim2.fromOffset(300, 22), Position = UDim2.fromOffset(28, 330), Text = "PRODUCTS", TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Theme.GOLD, ZIndex = 11, MaxSize = 18 }, frame)
	ui.productButtons, ui.productNotes = {}, {}
	for i, key in Config.PRODUCT_ORDER do
		local product = Config.PRODUCTS[key]
		local col, row = (i - 1) % 3, math.floor((i - 1) / 3)
		local card = Theme.card({ Size = UDim2.fromOffset(254, 116), Position = UDim2.fromOffset(28 + col * 264, 360 + row * 126), ZIndex = 11 }, frame)
		Theme.icon({ Size = UDim2.fromOffset(48, 48), Position = UDim2.fromOffset(12, 12), ZIndex = 12 }, card, product.icon, Theme.ACCENT, 14)
		Theme.title({ Size = UDim2.new(1, -84, 0, 20), Position = UDim2.fromOffset(72, 12), Text = product.name, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 12, MaxSize = 16 }, card)
		ui.productNotes[key] = Theme.text({ Size = UDim2.new(1, -84, 0, 30), Position = UDim2.fromOffset(72, 34), Text = product.desc, TextWrapped = true, TextColor3 = Theme.MUTED, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 12, MaxSize = 12 }, card)
		ui.productButtons[key] = Theme.button({ Size = UDim2.new(1, -24, 0, 34), Position = UDim2.new(0, 12, 1, -44), Text = "", ZIndex = 12 }, card, function()
			callbacks.buyProduct(key)
		end)
	end
end

-- prices: [kind .. key] = Robux price, filled in by Lobby.setPrice
local prices = {}

function Lobby.setPrice(kind, key, robux)
	prices[kind .. key] = robux
	Lobby.refreshStore()
end

function Lobby.refreshStore()
	local owned = {}
	for _, key in meta.passes or {} do
		owned[key] = true
	end
	for key, button in ui.passButtons do
		local pass = Config.GAME_PASSES[key]
		if owned[key] then
			button.Text, button.BackgroundColor3 = "✓ OWNED", Theme.ACCENT
		elseif pass.id == 0 then
			button.Text, button.BackgroundColor3 = "NOT SET UP", Theme.LOCKED
		else
			button.Text, button.BackgroundColor3 = prices["pass" .. key] and "R$ " .. prices["pass" .. key] or "BUY", Theme.GOOD
		end
	end
	for key, button in ui.productButtons do
		local product = Config.PRODUCTS[key]
		if product.id == 0 then
			button.Text, button.BackgroundColor3 = "NOT SET UP", Theme.LOCKED
		else
			button.Text, button.BackgroundColor3 = prices["product" .. key] and "R$ " .. prices["product" .. key] or "BUY", Theme.GOOD
		end
		local note = product.desc
		if product.boost and (meta.boosts or {})[product.boost] and meta.boosts[product.boost] > 0 then
			note = string.format("Active: %d min left", math.ceil(meta.boosts[product.boost] / 60))
		elseif product.revive then
			note = product.desc .. string.format("  (you have %d)", meta.revives or 0)
		end
		ui.productNotes[key].Text = note
	end
end

-- Gold, side menu, hint and the gate banner ----------------------------------------------

local function navButton(parent, icon, label, color, order, onClick)
	local button = Theme.button({ Size = UDim2.fromOffset(78, 78), Text = "", BackgroundColor3 = color, LayoutOrder = order }, parent, onClick)
	Theme.text({ Size = UDim2.new(1, 0, 0, 34), Position = UDim2.fromOffset(0, 2), Text = icon, ZIndex = 3 }, button)
	Theme.title({ Size = UDim2.new(1, 0, 0, 15), Position = UDim2.new(0, 0, 1, -22), Text = label, ZIndex = 3, MaxSize = 13 }, button)
	return button
end

local function buildHud()
	local gold = Theme.panel({ Size = UDim2.fromOffset(200, 50), Position = UDim2.new(1, -216, 0, 14) }, ui.root)
	Theme.icon({ Size = UDim2.fromOffset(34, 34), Position = UDim2.fromOffset(8, 8), ZIndex = 2 }, gold, "💰", Theme.GOLD, 10)
	ui.gold = Theme.title({ Size = UDim2.new(1, -60, 1, -18), Position = UDim2.fromOffset(50, 9), Text = "0", TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 2 }, gold)

	local nav = Theme.panel({ Size = UDim2.fromOffset(100, 460), Position = UDim2.new(0, 16, 0.5, -250) }, ui.root)
	Theme.new("UIListLayout", { Padding = UDim.new(0, 10), HorizontalAlignment = Enum.HorizontalAlignment.Center, VerticalAlignment = Enum.VerticalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder }, nav)
	for i, item in {
		{ "👒", "CREW", Color3.fromRGB(220, 70, 90), "crew" },
		{ "⚔️", "TRAIN", Color3.fromRGB(99, 132, 255), "train" },
		{ "🛡️", "GEAR", Color3.fromRGB(70, 170, 140), "gear" },
		{ "🛒", "SHOP", Color3.fromRGB(230, 160, 40), "shop" },
		{ "💎", "STORE", Color3.fromRGB(200, 80, 220), "store" },
	} do
		navButton(nav, item[1], item[2], item[3], i, function()
			Lobby.toggle(item[4])
		end)
	end
	local playing = Theme.panel({ Size = UDim2.fromOffset(200, 44), Position = UDim2.new(0, 16, 0.5, 220) }, ui.root)
	local tile, icon = Theme.icon({ Size = UDim2.fromOffset(32, 32), Position = UDim2.fromOffset(6, 6), ZIndex = 2 }, playing, "", Theme.ACCENT, 16)
	ui.playingTile, ui.playingIcon = tile, icon
	ui.crewName = Theme.text({ Size = UDim2.new(1, -54, 1, -14), Position = UDim2.fromOffset(46, 7), Font = Theme.BOLD, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 2, MaxSize = 16 }, playing)

	ui.saveWarning = Theme.chip({
		Size = UDim2.fromOffset(560, 32), Position = UDim2.new(0.5, -280, 0, 76), Visible = false, MaxSize = 14,
		Text = "⚠️  Your save couldn't load, so progress won't save this visit. Rejoin to try again.",
	}, ui.root, Theme.BAD)
	ui.hint = Theme.panel({ Size = UDim2.fromOffset(560, 46), Position = UDim2.new(0.5, -280, 1, -66) }, ui.root)
	Theme.text({ Size = UDim2.new(1, -28, 1, -16), Position = UDim2.fromOffset(14, 8), Text = "⛵  Step onto a voyage gate to choose your adventure", Font = Theme.BOLD, MaxSize = 17 }, ui.hint)

	local banner = Theme.panel({ Size = UDim2.fromOffset(500, 132), Position = UDim2.new(0.5, -250, 0, 20), Visible = false }, ui.root)
	ui.banner = banner
	ui.bannerBar = Theme.new("Frame", { Size = UDim2.new(0, 6, 1, -24), Position = UDim2.fromOffset(12, 12), BorderSizePixel = 0, ZIndex = 2 }, banner)
	Theme.corner(ui.bannerBar, 3)
	ui.bannerScale = Theme.new("UIScale", {}, banner)
	ui.bannerName = Theme.title({ Size = UDim2.new(1, -48, 0, 28), Position = UDim2.fromOffset(30, 12), Text = "", TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 2 }, banner)
	ui.bannerCaptain = Theme.chip({ Size = UDim2.fromOffset(220, 24), Position = UDim2.fromOffset(30, 46), ZIndex = 2, MaxSize = 13 }, banner, Theme.GOLD)
	ui.bannerStatus = Theme.text({ Size = UDim2.new(1, -48, 0, 22), Position = UDim2.fromOffset(30, 76), Text = "", TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 2, MaxSize = 17 }, banner)
	ui.bannerPick = Theme.button({
		Size = UDim2.fromOffset(150, 34), Position = UDim2.new(1, -166, 0, 42), Text = "🗺️ CHOOSE MAP",
		BackgroundColor3 = Theme.ACCENT, Visible = false, ZIndex = 2,
	}, banner, function()
		Lobby.toggle("voyage", true)
	end)
end

-- Public ----------------------------------------------------------------------------------

function Lobby.init(gui, cb)
	callbacks = cb
	ui.root = Theme.new("Frame", { Name = "Lobby", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1 }, gui)
	buildHud()
	buildCrew()
	buildTrain()
	buildGear()
	buildShop()
	buildStore()
	buildVoyage()
	Lobby.setMeta(meta)

	RunService.Heartbeat:Connect(function()
		local boarding = os.clock() - lastPortalMessage < 0.6
		if ui.banner.Visible ~= boarding then
			ui.banner.Visible = boarding
			if boarding then
				ui.bannerScale.Scale = 0.8
				Theme.tween(ui.bannerScale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
			else
				-- stepped off the gate: the map select is only for gates
				pickerOpened = false
				portal = nil
				Lobby.toggle("voyage", false)
			end
		end
		ui.hint.Visible = not boarding
	end)
end

function Lobby.setVisible(visible)
	ui.root.Visible = visible
	if not visible then
		for name in panels do
			Lobby.toggle(name, false)
		end
	end
end

-- Opens or closes a panel (only one at a time). Big panels shrink to fit small screens.
function Lobby.toggle(name, open)
	local p = panels[name]
	if open == nil then
		open = not p.frame.Visible
	end
	if open and not p.frame.Visible then
		for other, q in panels do
			if other ~= name then
				q.frame.Visible = false
			end
		end
		p.scale.Scale = 0.9
		Theme.tween(p.scale, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
		if name == "voyage" then
			Lobby.refreshVoyage()
		elseif name == "train" then
			Lobby.refreshTrain()
		elseif name == "gear" then
			Lobby.refreshGear()
		elseif name == "store" then
			Lobby.refreshStore()
		end
	end
	p.frame.Visible = open
end

-- Opens a menu from an NPC (tab: which tab of the training menu).
function Lobby.open(name, tab)
	if not panels[name] or not ui.root.Visible then
		return
	end
	if name == "train" and tab then
		trainTab = tab
	end
	Lobby.toggle(name, true)
	if name == "train" then
		Lobby.refreshTrain()
	end
end

-- Lists a character's 6 skills under the character cards.
function Lobby.showSkills(name)
	local class = Config.Classes[name]
	if not class then
		return
	end
	local names = {}
	for _, key in class.skills do
		local w = Config.Weapons[key]
		table.insert(names, w.icon .. " " .. w.name)
	end
	ui.detailsIcon.Text = class.icon
	ui.detailsTile.BackgroundColor3 = class.color
	ui.detailsTitle.Text = name:upper() .. "  -  " .. class.title:upper()
	ui.detailsSkills.Text = table.concat(names, "    ")
end

-- Redraws the map select: unlocks, cleared difficulties, the selected map and difficulty.
function Lobby.refreshVoyage()
	local progress = meta.progress or {}
	for _, map in Config.Maps do
		local card = mapCards[map.key]
		card.lock.Visible = not Config.unlocked(progress, map, 1)
		card.busy.Visible = portal ~= nil and portal.busy ~= nil and portal.busy[map.key] == true
		for d, pip in card.pips do
			local cleared = (progress[map.key] or 0) >= d
			pip.BackgroundColor3 = cleared and Config.Difficulties[d].color or Theme.LINE
			pip.BackgroundTransparency = cleared and 0 or 0.85
		end
		local chosen = map.key == selectedMap
		card.stroke.Color = chosen and Theme.GOLD or Theme.LINE
		card.stroke.Thickness = chosen and 2.5 or 1
		card.stroke.Transparency = chosen and 0 or 0.88
	end

	local map = Config.MapByKey[selectedMap]
	ui.mapName.Text = map.index .. ".  " .. map.name:upper()
	ui.mapBoss.Text = "☠️  Boss: " .. map.boss
	ui.mapInfo.Text = string.format("Enemy power x%.1f   -   Gold x%.1f", map.hp, map.gold)
	if not Config.unlocked(progress, map, selectedDifficulty) then
		selectedDifficulty = 1
	end
	for d, button in diffButtons do
		local diff = Config.Difficulties[d]
		local open = Config.unlocked(progress, map, d)
		local cleared = (progress[map.key] or 0) >= d
		button.BackgroundColor3 = open and diff.color or Theme.LOCKED
		button.Text = (open and "" or "🔒  ") .. diff.name:upper()
			.. string.format("   +%d%% gold", math.floor((diff.gold - 1) * 100 + 0.5)) .. (cleared and "   ✓" or "")
		local stroke = button:FindFirstChildOfClass("UIStroke")
		stroke.Color = d == selectedDifficulty and Theme.GOLD or Theme.LINE
		stroke.Thickness = d == selectedDifficulty and 2.5 or 1
		stroke.Transparency = d == selectedDifficulty and 0 or 0.82
	end

	if not Config.unlocked(progress, map, selectedDifficulty) then
		ui.sail.Text = map.index > 1 and (progress[Config.Maps[map.index - 1].key] or 0) < 1
			and "🔒  CLEAR " .. Config.Maps[map.index - 1].name:upper() .. " FIRST" or "🔒  LOCKED"
		ui.sail.BackgroundColor3 = Theme.LOCKED
	elseif portal and portal.busy and portal.busy[map.key] then
		ui.sail.Text = "ANOTHER CREW IS HERE"
		ui.sail.BackgroundColor3 = Theme.LOCKED
	elseif isCaptain() then
		ui.sail.Text = "⛵  SET SAIL"
		ui.sail.BackgroundColor3 = Theme.GOOD
	else
		ui.sail.Text = "ONLY THE CAPTAIN CHOOSES"
		ui.sail.BackgroundColor3 = Theme.LOCKED
	end
	ui.voyageHint.Text = isCaptain() and "You are the captain! Pick a map and difficulty, then set sail."
		or "Clear a difficulty to unlock the next one. Clear a map on Easy to unlock the next map."
end

function Lobby.setMeta(data)
	meta = data
	meta.progress = meta.progress or {}
	local class = Config.Classes[data.class] or Config.Classes[Config.DEFAULT_CLASS]
	Lobby.showSkills(data.class)
	ui.gold.Text = Theme.comma(data.gold)
	ui.crewName.Text = "Playing as " .. (data.class or "")
	ui.playingIcon.Text = class.icon
	ui.playingTile.BackgroundColor3 = class.color
	for name, card in classCards do
		local chosen = name == data.class
		card.selected.Visible = chosen
		card.stroke.Color = chosen and Theme.GOLD or card.color
		card.stroke.Thickness = chosen and 3 or 1.5
		card.stroke.Transparency = chosen and 0 or 0.55
	end
	for name, row in shopRows do
		local level = data.levels[name] or 0
		for i, pip in row.pips do
			pip.BackgroundColor3 = i <= level and Theme.GOLD or Theme.LINE
			pip.BackgroundTransparency = i <= level and 0 or 0.88
		end
		local cost = data.costs[name]
		if not cost then
			row.buy.Text = "MAXED"
			row.buy.BackgroundColor3 = Theme.LOCKED
		else
			row.buy.Text = "💰 " .. Theme.comma(cost)
			row.buy.BackgroundColor3 = data.gold >= cost and Theme.GOOD or Color3.fromRGB(150, 60, 70)
		end
	end
	ui.saveWarning.Visible = data.loadFailed == true
	Lobby.refreshVoyage()
	if panels.train.frame.Visible then
		Lobby.refreshTrain()
	end
	if panels.gear.frame.Visible then
		Lobby.refreshGear()
	end
	Lobby.refreshStore()
end

-- Called while standing on a voyage gate.
function Lobby.portal(info)
	local wasCaptain = isCaptain()
	portal = info
	lastPortalMessage = os.clock()
	ui.bannerName.Text = "⛵  VOYAGE GATE " .. info.gate
	ui.bannerBar.BackgroundColor3 = info.color
	ui.banner:FindFirstChildOfClass("UIStroke").Color = info.color
	ui.bannerCaptain.Text = info.captain and "👑 You are the captain" or ("👑 Captain: " .. (info.captainName or "?"))
	ui.bannerStatus.Text = info.text
	ui.bannerPick.Visible = info.captain
	for name, p in panels do
		if name ~= "voyage" then
			p.frame.Visible = false
		end
	end
	-- the captain gets the map select once per boarding
	if info.captain and not info.map and not pickerOpened then
		pickerOpened = true
		Lobby.toggle("voyage", true)
	end
	if wasCaptain ~= isCaptain() or panels.voyage.frame.Visible then
		Lobby.refreshVoyage() -- keeps captain status and busy maps current
	end
end

return Lobby
]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX13493"><Properties><string name="Name">SwarmClient</string><ProtectedString name="Source"><![CDATA[-- Client entry point: builds the UI, connects it to the server's remotes, and handles dashing,
-- NPC prompts, Robux purchase prompts and watching teammates while knocked out.
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local UIS = game:GetService("UserInputService")
local StarterGui = game:GetService("StarterGui")
local ContextActionService = game:GetService("ContextActionService")
local ProximityPromptService = game:GetService("ProximityPromptService")
local MarketplaceService = game:GetService("MarketplaceService")
local Debris = game:GetService("Debris")

local Config = require(RS:WaitForChild("Shared"):WaitForChild("Config"))
local remotes = RS:WaitForChild("Remotes")
local player = Players.LocalPlayer
local Theme = require(script.Parent:WaitForChild("Theme"))
local Effects = require(script.Parent:WaitForChild("Effects"))
local Hud = require(script.Parent:WaitForChild("Hud"))
local Lobby = require(script.Parent:WaitForChild("Lobby"))

-- our own health bar replaces the default one
pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
end)

local gui = Instance.new("ScreenGui")
gui.Name = "SwarmUI"
gui.ResetOnSpawn = false
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = player:WaitForChild("PlayerGui")
-- everything lives in one root that scales to fit the screen (phones included)
local root = Theme.new("Frame", { Name = "Root", BackgroundTransparency = 1 }, gui)
Theme.autoScale(root)

-- Dash ------------------------------------------------------------------------------------

local dashCooldown = Config.DASH.cooldown
local dashReadyAt = 0

local function dash()
	local character = player.Character
	local body = character and character:FindFirstChild("HumanoidRootPart")
	local hum = character and character:FindFirstChildOfClass("Humanoid")
	if not body or not hum or hum.Health <= 0 or os.clock() < dashReadyAt then
		return
	end
	dashReadyAt = os.clock() + dashCooldown
	local dir = hum.MoveDirection.Magnitude > 0.1 and hum.MoveDirection or body.CFrame.LookVector
	dir = Vector3.new(dir.X, 0, dir.Z).Unit
	-- a short, strong push in the move direction (the client owns its character's physics)
	local attachment = Instance.new("Attachment")
	attachment.Parent = body
	local push = Instance.new("LinearVelocity")
	push.Attachment0 = attachment
	push.MaxForce = math.huge
	push.VectorVelocity = dir * Config.DASH.speed
	push.Parent = body
	Debris:AddItem(push, Config.DASH.duration)
	Debris:AddItem(attachment, Config.DASH.duration)
	remotes.Dash:FireServer()
	Hud.dashUsed(dashCooldown)
end

-- Shift / gamepad L2, plus an on-screen button on touch devices
ContextActionService:BindAction("Dash", function(_, state)
	if state == Enum.UserInputState.Begin then
		dash()
	end
	return Enum.ContextActionResult.Sink
end, true, Enum.KeyCode.LeftShift, Enum.KeyCode.RightShift, Enum.KeyCode.ButtonL2)
ContextActionService:SetTitle("Dash", "DASH")

-- Watching teammates while knocked out ------------------------------------------------------

local crew = {} -- UserIds of this run's crew, from the latest State
local watchIndex = 0
local wasDown = false

local function standingCrew()
	local list = {}
	for _, userId in crew do
		local mate = Players:GetPlayerByUserId(userId)
		local hum = mate and mate ~= player and mate.Character and mate.Character:FindFirstChildOfClass("Humanoid")
		if hum and hum.Health > 0 then
			table.insert(list, { player = mate, hum = hum })
		end
	end
	return list
end

local function spectate(step)
	local list = standingCrew()
	if #list == 0 then
		Hud.setWatching(nil)
		return
	end
	watchIndex = (watchIndex + step - 1) % #list + 1
	workspace.CurrentCamera.CameraSubject = list[watchIndex].hum
	Hud.setWatching(list[watchIndex].player.DisplayName)
end

local function stopSpectating()
	local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if hum then
		workspace.CurrentCamera.CameraSubject = hum
	end
end

-- Purchases -------------------------------------------------------------------------------

local function buyPass(key)
	local pass = Config.GAME_PASSES[key]
	if pass and pass.id > 0 then
		MarketplaceService:PromptGamePassPurchase(player, pass.id)
	end
end

local function buyProduct(key)
	local product = Config.PRODUCTS[key]
	if product and product.id > 0 then
		MarketplaceService:PromptProductPurchase(player, product.id)
	end
end

-- Robux prices shown in the store
for key, pass in Config.GAME_PASSES do
	if pass.id > 0 then
		task.spawn(function()
			local ok, info = pcall(MarketplaceService.GetProductInfo, MarketplaceService, pass.id, Enum.InfoType.GamePass)
			if ok and info and info.PriceInRobux then
				Lobby.setPrice("pass", key, info.PriceInRobux)
			end
		end)
	end
end
for key, product in Config.PRODUCTS do
	if product.id > 0 then
		task.spawn(function()
			local ok, info = pcall(MarketplaceService.GetProductInfo, MarketplaceService, product.id, Enum.InfoType.Product)
			if ok and info and info.PriceInRobux then
				Lobby.setPrice("product", key, info.PriceInRobux)
			end
		end)
	end
end

-- UI --------------------------------------------------------------------------------------

Hud.init(root, {
	choose = function(i)
		remotes.Choose:FireServer(i)
	end,
	reroll = function()
		remotes.Reroll:FireServer()
	end,
	dash = dash,
	leave = function()
		remotes.Leave:FireServer()
	end,
	spectate = spectate,
	revive = function(owned)
		if owned > 0 then
			remotes.Revive:FireServer()
		else
			buyProduct("Revive")
		end
	end,
})
Lobby.init(root, {
	selectClass = function(name)
		remotes.SelectClass:FireServer(name)
	end,
	buy = function(name)
		remotes.BuyMeta:FireServer(name)
	end,
	voyage = function(mapKey, difficulty)
		remotes.Voyage:FireServer(mapKey, difficulty)
	end,
	train = function(kind, name)
		remotes.Train:FireServer(kind, name)
	end,
	gear = function(action, id)
		remotes.Gear:FireServer(action, id)
	end,
	buyPass = buyPass,
	buyProduct = buyProduct,
})

-- island NPCs open their menus
ProximityPromptService.PromptTriggered:Connect(function(prompt)
	local panel = prompt:GetAttribute("Panel")
	if panel then
		Lobby.open(panel, prompt:GetAttribute("Tab"))
	end
end)

remotes.Fx.OnClientEvent:Connect(function(list)
	for _, ev in list do
		Effects.play(ev)
	end
end)
remotes.Stats.OnClientEvent:Connect(Hud.setStats)
remotes.LevelUp.OnClientEvent:Connect(Hud.showLevelUp)
remotes.Announce.OnClientEvent:Connect(Hud.announce)
remotes.Results.OnClientEvent:Connect(Hud.showResults)
remotes.Portal.OnClientEvent:Connect(Lobby.portal)
remotes.Meta.OnClientEvent:Connect(function(data)
	dashCooldown = data.dashCooldown or Config.DASH.cooldown
	Hud.setRevives(data.revives or 0)
	Lobby.setMeta(data)
end)

remotes.State.OnClientEvent:Connect(function(state)
	local running = state.phase == "Run"
	if not running then
		Effects.clear()
	end
	crew = state.crew or crew
	local down = running and state.down == true
	if down and not wasDown then
		watchIndex = 0
		spectate(1)
	elseif down then
		-- keep watching someone who is still standing
		local subject = workspace.CurrentCamera.CameraSubject
		if not subject or not subject:IsA("Humanoid") or subject.Health <= 0 or subject.Parent == player.Character then
			spectate(1)
		end
	elseif wasDown then
		stopSpectating()
	end
	wasDown = down
	Hud.setVisible(running)
	Hud.setState(state)
	Lobby.setVisible(state.phase == "Lobby")
end)

local KEYS = { [Enum.KeyCode.One] = 1, [Enum.KeyCode.Two] = 2, [Enum.KeyCode.Three] = 3 }
UIS.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	if KEYS[input.KeyCode] then
		Hud.choose(KEYS[input.KeyCode])
	elseif input.KeyCode == Enum.KeyCode.R then
		Hud.reroll()
	end
end)

remotes.Meta:FireServer()
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX13494"><Properties><string name="Name">Theme</string><ProtectedString name="Source"><![CDATA[-- Shared look for every menu: a modern dark glass style. Colors, fonts and small UI builders.
local TweenService = game:GetService("TweenService")

local Theme = {}

Theme.BG = Color3.fromRGB(11, 13, 22)
Theme.PANEL = Color3.fromRGB(20, 24, 40)
Theme.CARD = Color3.fromRGB(31, 36, 58)
Theme.CARD_LIGHT = Color3.fromRGB(44, 51, 80)
Theme.LINE = Color3.fromRGB(255, 255, 255)
Theme.ACCENT = Color3.fromRGB(99, 132, 255)
Theme.GOLD = Color3.fromRGB(255, 196, 64)
Theme.TEXT = Color3.fromRGB(236, 240, 255)
Theme.MUTED = Color3.fromRGB(138, 148, 184)
Theme.GOOD = Color3.fromRGB(70, 214, 140)
Theme.BAD = Color3.fromRGB(255, 84, 104)
Theme.DARK_TEXT = Color3.fromRGB(14, 16, 26)
Theme.LOCKED = Color3.fromRGB(52, 56, 76)
Theme.TITLE_FONT = Enum.Font.GothamBlack
Theme.BOLD = Enum.Font.GothamBold
Theme.FONT = Enum.Font.GothamMedium

function Theme.new(class, props, parent)
	local obj = Instance.new(class)
	for k, v in props do
		obj[k] = v
	end
	obj.Parent = parent
	return obj
end

function Theme.tween(obj, time, goal, style, direction)
	local info = TweenInfo.new(time, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out)
	local t = TweenService:Create(obj, info, goal)
	t:Play()
	return t
end

function Theme.corner(parent, radius)
	return Theme.new("UICorner", { CornerRadius = UDim.new(0, radius or 12) }, parent)
end

function Theme.stroke(parent, color, thickness, transparency)
	return Theme.new("UIStroke", {
		Color = color or Theme.LINE, Thickness = thickness or 1, Transparency = transparency or 0.85,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, parent)
end

-- Vertical gradient that tints whatever color the parent has.
function Theme.gradient(parent, top, bottom, rotation)
	return Theme.new("UIGradient", { Color = ColorSequence.new(top, bottom), Rotation = rotation or 90 }, parent)
end

function Theme.padding(parent, px)
	return Theme.new("UIPadding", {
		PaddingTop = UDim.new(0, px), PaddingBottom = UDim.new(0, px), PaddingLeft = UDim.new(0, px), PaddingRight = UDim.new(0, px),
	}, parent)
end

-- Frosted dark panel with a hairline border.
function Theme.panel(props, parent)
	props.BackgroundColor3 = props.BackgroundColor3 or Theme.PANEL
	props.BackgroundTransparency = props.BackgroundTransparency or 0.06
	local frame = Theme.new("Frame", props, parent)
	Theme.corner(frame, 18)
	Theme.stroke(frame, Theme.LINE, 1, 0.86)
	Theme.gradient(frame, Color3.new(1, 1, 1), Color3.fromRGB(180, 186, 210))
	return frame
end

-- Rounded card used inside panels.
function Theme.card(props, parent)
	props.BackgroundColor3 = props.BackgroundColor3 or Theme.CARD
	local frame = Theme.new("Frame", props, parent)
	Theme.corner(frame, 12)
	Theme.stroke(frame, Theme.LINE, 1, 0.9)
	return frame
end

-- Text label. Pass MaxSize to cap scaled text.
function Theme.text(props, parent)
	local maxSize = props.MaxSize
	props.MaxSize = nil
	props.BackgroundTransparency = props.BackgroundTransparency or 1
	props.TextColor3 = props.TextColor3 or Theme.TEXT
	props.Font = props.Font or Theme.FONT
	if props.TextScaled == nil then
		props.TextScaled = true
	end
	local label = Theme.new("TextLabel", props, parent)
	if maxSize then
		Theme.new("UITextSizeConstraint", { MaxTextSize = maxSize }, label)
	end
	return label
end

function Theme.title(props, parent)
	props.Font = props.Font or Theme.TITLE_FONT
	props.TextStrokeTransparency = props.TextStrokeTransparency or 1
	return Theme.text(props, parent)
end

-- Small rounded label ("chip"), e.g. tags and counters.
function Theme.chip(props, parent, color)
	color = color or Theme.ACCENT
	props.BackgroundTransparency = props.BackgroundTransparency or 0.8
	props.BackgroundColor3 = color
	props.TextColor3 = props.TextColor3 or color:Lerp(Color3.new(1, 1, 1), 0.45)
	props.Font = props.Font or Theme.BOLD
	local chip = Theme.text(props, parent)
	Theme.corner(chip, 8)
	Theme.padding(chip, 4)
	return chip
end

-- Rounded square with a colored gradient and an emoji icon in the middle.
function Theme.icon(props, parent, icon, color, radius)
	props.BackgroundColor3 = color or Theme.ACCENT
	local tile = Theme.new("Frame", props, parent)
	Theme.corner(tile, radius or 10)
	Theme.gradient(tile, Color3.new(1, 1, 1), Color3.fromRGB(120, 120, 140), 135)
	Theme.stroke(tile, Theme.LINE, 1, 0.75)
	local label = Theme.text({
		Size = UDim2.fromScale(0.72, 0.72), Position = UDim2.fromScale(0.14, 0.14), Text = icon or "",
		ZIndex = (props.ZIndex or 1) + 1, Font = Theme.TITLE_FONT,
	}, tile)
	return tile, label
end

-- Button with a hover glow and a press squish. The glow is an overlay, so callers can
-- recolor the button at any time.
function Theme.button(props, parent, onClick)
	props.AutoButtonColor = false
	props.BackgroundColor3 = props.BackgroundColor3 or Theme.ACCENT
	props.Font = props.Font or Theme.BOLD
	props.TextColor3 = props.TextColor3 or Theme.TEXT
	if props.TextScaled == nil then
		props.TextScaled = true
	end
	local button = Theme.new("TextButton", props, parent)
	Theme.corner(button, 12)
	Theme.stroke(button, Theme.LINE, 1, 0.82)
	Theme.gradient(button, Color3.new(1, 1, 1), Color3.fromRGB(200, 205, 225))
	Theme.new("UITextSizeConstraint", { MaxTextSize = 22 }, button)
	Theme.padding(button, 6)
	local glow = Theme.new("Frame", {
		Name = "Glow", Size = UDim2.new(1, 12, 1, 12), Position = UDim2.fromOffset(-6, -6),
		BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 1, ZIndex = (props.ZIndex or 1) + 1,
	}, button)
	Theme.corner(glow, 12)
	local scale = Theme.new("UIScale", {}, button)
	button.MouseEnter:Connect(function()
		Theme.tween(scale, 0.12, { Scale = 1.03 })
		Theme.tween(glow, 0.12, { BackgroundTransparency = 0.88 })
	end)
	button.MouseLeave:Connect(function()
		Theme.tween(scale, 0.12, { Scale = 1 })
		Theme.tween(glow, 0.12, { BackgroundTransparency = 1 })
	end)
	button.MouseButton1Down:Connect(function()
		Theme.tween(scale, 0.06, { Scale = 0.97 })
	end)
	button.MouseButton1Up:Connect(function()
		Theme.tween(scale, 0.1, { Scale = 1.03 })
	end)
	if onClick then
		button.Activated:Connect(onClick)
	end
	return button
end

-- Slim rounded progress bar. Returns the frame, its fill and a centered label.
function Theme.bar(props, parent, top, bottom)
	props.BackgroundColor3 = props.BackgroundColor3 or Color3.fromRGB(255, 255, 255)
	props.BackgroundTransparency = props.BackgroundTransparency or 0.9
	local frame = Theme.new("Frame", props, parent)
	Theme.corner(frame, 8)
	local fill = Theme.new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ZIndex = (props.ZIndex or 1) }, frame)
	Theme.corner(fill, 8)
	Theme.gradient(fill, top, bottom, 0)
	local label = Theme.text({
		Size = UDim2.fromScale(1, 1), ZIndex = (props.ZIndex or 1) + 1, Font = Theme.BOLD, MaxSize = 15,
		TextStrokeTransparency = 0.6,
	}, frame)
	return frame, fill, label
end

-- Scales a full-screen root frame so the whole UI fits any screen. Layouts are designed for
-- 1280x720; smaller screens (phones) shrink everything evenly.
function Theme.autoScale(root)
	local scale = Theme.new("UIScale", {}, root)
	local function update()
		local view = workspace.CurrentCamera.ViewportSize
		local s = math.clamp(math.min(view.X / 1280, view.Y / 720), 0.45, 1)
		scale.Scale = s
		root.Size = UDim2.fromScale(1 / s, 1 / s)
	end
	update()
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(update)
	return scale
end

function Theme.comma(n)
	local s = tostring(math.floor(n))
	repeat
		local count
		s, count = s:gsub("^(-?%d+)(%d%d%d)", "%1,%2")
	until count == 0
	return s
end

return Theme
]]></ProtectedString></Properties></Item></Item></Item><Item class="StarterCharacterScripts" referent="RBX13498"><Properties><string name="Name">StarterCharacterScripts</string></Properties><Item class="Script" referent="RBX13497"><Properties><string name="Name">Health</string><ProtectedString name="Source"><![CDATA[-- Empty on purpose: replaces Roblox's default health regen, so healing only comes
-- from Chopper and level-up rewards.
]]></ProtectedString></Properties></Item></Item></Item></roblox>
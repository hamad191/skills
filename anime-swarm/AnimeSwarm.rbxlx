	{ "RightArm", Vector3.new(0.75, 1.7, 0.75), Vector3.new(1.4, 0.75, 0), Vector3.new(0, 0.75, 0), "color", "RightShoulder" },
	{ "Head", Vector3.new(1.7, 1.7, 1.7), Vector3.new(0, 1, 0), Vector3.new(0, -0.85, 0), "skin", "Neck", BALL },

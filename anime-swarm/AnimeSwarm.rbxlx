	sparks.Parent = anvil
	add("Forge", Vector3.new(3, 2.4, 3), CFrame.new(-4.2, 1.2, 1.5), rgb(90, 85, 85), nil, SLATE)
	local coals = add("Coals", Vector3.new(2.4, 0.3, 2.4), CFrame.new(-4.2, 2.45, 1.5), rgb(255, 110, 30), nil, NEON)
	local fire = Instance.new("Fire")

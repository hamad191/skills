	Theme.corner(ui.bossLag, 8)
	fill.ZIndex = 4
	ui.bossFill = fill
	ui.bossShown, ui.bossLagRatio = 1, 1
end

-- Combo counter -----------------------------------------------------------------------------

local COMBO_TIME = 4
local COMBO_TIERS = {
	{ 200, "LEGENDARY!", Color3.fromRGB(255, 80, 200) },
	{ 100, "UNSTOPPABLE!", Color3.fromRGB(255, 70, 70) },
	{ 50, "RAMPAGE!", Color3.fromRGB(255, 150, 40) },
	{ 20, "ON FIRE!", Color3.fromRGB(255, 220, 70) },
	{ 0, "COMBO", Theme.TEXT },
}

local function buildCombo(root)
	local frame = Theme.new("Frame", { Size = UDim2.fromOffset(190, 110), Position = UDim2.new(1, -210, 0.36, 0), BackgroundTransparency = 1, Visible = false }, root)
	ui.combo = frame
	ui.comboScale = Theme.new("UIScale", {}, frame)
	ui.comboCount = Theme.title({ Size = UDim2.new(1, 0, 0, 58), Text = "x0", TextXAlignment = Enum.TextXAlignment.Right, TextStrokeTransparency = 0, ZIndex = 3 }, frame)
	ui.comboLabel = Theme.title({ Size = UDim2.new(1, 0, 0, 24), Position = UDim2.fromOffset(0, 58), Text = "COMBO", TextXAlignment = Enum.TextXAlignment.Right, TextStrokeTransparency = 0, ZIndex = 3, MaxSize = 22 }, frame)
	local bar, fill = Theme.bar({ Size = UDim2.new(0.7, 0, 0, 6), Position = UDim2.new(0.3, 0, 0, 90), ZIndex = 3 }, frame,
		Color3.fromRGB(255, 230, 120), Color3.fromRGB(255, 120, 40))
	bar:FindFirstChildOfClass("TextLabel").Visible = false
	ui.comboFill = fill
	ui.comboValue, ui.comboUntil, ui.lastKills = 0, 0, 0
end

-- Screen-space layer: arrows to off-screen chests and bosses, and the hurt flash --------------
-- Lives in its own unscaled ScreenGui so it lines up with the camera's pixels.

local MARKERS = 6

local function buildScreenLayer()
	local gui = Instance.new("ScreenGui")
	gui.Name = "SwarmMarkers"
	gui.IgnoreGuiInset = true
	gui.ResetOnSpawn = false
	gui.DisplayOrder = -1
	gui.Enabled = false
	gui.Parent = player:WaitForChild("PlayerGui")
	ui.screenLayer = gui

	-- red edges that flash when you're hurt and pulse when you're low
	ui.vignette = {}
	for _, edge in {
		{ UDim2.new(1, 0, 0, 140), UDim2.fromScale(0, 0), 90 },
		{ UDim2.new(1, 0, 0, 140), UDim2.new(0, 0, 1, -140), 270 },
		{ UDim2.new(0, 160, 1, 0), UDim2.fromScale(0, 0), 0 },
		{ UDim2.new(0, 160, 1, 0), UDim2.new(1, -160, 0, 0), 180 },
	} do
		local f = Theme.new("Frame", { Size = edge[1], Position = edge[2], BackgroundColor3 = Color3.fromRGB(220, 20, 30), BackgroundTransparency = 1, BorderSizePixel = 0 }, gui)
		Theme.new("UIGradient", { Transparency = NumberSequence.new(0, 1), Rotation = edge[3] }, f)
		table.insert(ui.vignette, f)
	end

	ui.markers = {}
	for i = 1, MARKERS do
		local m = Theme.new("Frame", { Size = UDim2.fromOffset(48, 48), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = Theme.PANEL, BackgroundTransparency = 0.15, Visible = false, ZIndex = 2 }, gui)
		Theme.corner(m, 24)
		local stroke = Theme.stroke(m, Theme.GOLD, 2, 0)
		local icon = Theme.text({ Size = UDim2.fromScale(0.62, 0.62), Position = UDim2.fromScale(0.19, 0.12), Text = "", ZIndex = 3 }, m)
		local dist = Theme.text({ Size = UDim2.new(1, 0, 0, 14), Position = UDim2.new(0, 0, 1, -4), Text = "", Font = Theme.BOLD, ZIndex = 3, MaxSize = 12, TextStrokeTransparency = 0.3 }, m)
		local arrow = Theme.text({ Size = UDim2.fromOffset(22, 22), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Text = "▲", TextColor3 = Theme.GOLD, Font = Theme.BOLD, ZIndex = 3, TextStrokeTransparency = 0.4 }, m)
		ui.markers[i] = { frame = m, icon = icon, dist = dist, arrow = arrow, stroke = stroke }
	end
end

local function flashHurt(amount)
	Effects.shake(math.clamp(amount * 6, 0.25, 1.2), 0.25)
	for _, f in ui.vignette do
		f.BackgroundTransparency = math.clamp(0.75 - amount * 2, 0.2, 0.7)
		Theme.tween(f, 0.5, { BackgroundTransparency = 1 })
	end
end

-- Skill action bar and health ------------------------------------------------------------

local function makeTile(parent, size, x, y)
	local tile, label = Theme.icon({ Size = UDim2.fromOffset(size, size), Position = UDim2.fromOffset(x, y), ZIndex = 2 }, parent, "", Theme.CARD)
	local level = Theme.text({
		Size = UDim2.fromOffset(size * 0.62, 15), Position = UDim2.new(1, -size * 0.62 + 2, 1, -13), Font = Theme.BOLD,
		BackgroundTransparency = 0.15, BackgroundColor3 = Theme.BG, ZIndex = 4, MaxSize = 12,
	}, tile)
	Theme.corner(level, 6)
	local slot = { tile = tile, icon = label, level = level }
	tile.MouseEnter:Connect(function()
		if slot.tip then
			ui.tooltip.Text = slot.tip
			ui.tooltip.Visible = true
		end
	end)
	tile.MouseLeave:Connect(function()
		ui.tooltip.Visible = false
	end)
	return slot
end

local function buildActionBar(root)
	local width = Config.WEAPON_SLOTS_MAX * (SKILL_TILE + GAP) + Config.PASSIVE_SLOTS * (PASSIVE_TILE + GAP) + 34
	local bar = Theme.panel({ Size = UDim2.fromOffset(width, 74), Position = UDim2.new(0.5, -width / 2, 1, -132) }, root)
	ui.weaponSlots, ui.passiveSlots = {}, {}
	local x = 12
	for i = 1, Config.WEAPON_SLOTS_MAX do
		ui.weaponSlots[i] = makeTile(bar, SKILL_TILE, x, 11)
		x += SKILL_TILE + GAP
	end
	Theme.new("Frame", { Size = UDim2.fromOffset(2, 44), Position = UDim2.fromOffset(x + 2, 15), BackgroundColor3 = Theme.LINE, BackgroundTransparency = 0.85, BorderSizePixel = 0 }, bar)
	x += 12
	for i = 1, Config.PASSIVE_SLOTS do
		ui.passiveSlots[i] = makeTile(bar, PASSIVE_TILE, x, 16)
		x += PASSIVE_TILE + GAP
	end
	ui.tooltip = Theme.chip({
		Size = UDim2.fromOffset(320, 28), Position = UDim2.new(0.5, -160, 0, -36), Visible = false, ZIndex = 5,
		BackgroundTransparency = 0.1, TextColor3 = Theme.TEXT, MaxSize = 15,
	}, bar, Theme.PANEL)
end

local function buildHealth(root)
	local panel = Theme.panel({ Size = UDim2.fromOffset(480, 40), Position = UDim2.new(0.5, -240, 1, -52) }, root)
	Theme.icon({ Size = UDim2.fromOffset(28, 28), Position = UDim2.fromOffset(7, 6), ZIndex = 2 }, panel, "❤️", Theme.BAD, 8)
	local _, fill, text = Theme.bar({ Size = UDim2.new(1, -140, 0, 18), Position = UDim2.fromOffset(44, 11), ZIndex = 2 }, panel,
		Color3.fromRGB(255, 120, 130), Color3.fromRGB(220, 40, 70))
	ui.hpFill, ui.hpText = fill, text

	-- dash: Shift / L2 / the on-screen button; the dark overlay drains as it recharges
	local dash = Theme.new("TextButton", {
		Size = UDim2.fromOffset(84, 28), Position = UDim2.new(1, -90, 0, 6), Text = UIS.TouchEnabled and not UIS.KeyboardEnabled and "💨 DASH" or "💨 SHIFT", Font = Theme.BOLD,
		TextScaled = true, TextColor3 = Theme.TEXT, BackgroundColor3 = Theme.ACCENT, AutoButtonColor = false, ZIndex = 2,
	}, panel)
	Theme.corner(dash, 8)
	Theme.padding(dash, 5)
	ui.dashShade = Theme.new("Frame", {
		Size = UDim2.new(0, 0, 1, 10), Position = UDim2.fromOffset(-5, -5), BackgroundColor3 = Theme.BG,
		BackgroundTransparency = 0.25, BorderSizePixel = 0, ZIndex = 3,
	}, dash)
	Theme.corner(ui.dashShade, 8)
	dash.Activated:Connect(function()
		callbacks.dash()
	end)

	local function bind(character)
		local hum = character:WaitForChild("Humanoid")
		local last = hum.Health
		local function update()
			local ratio = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
			Theme.tween(ui.hpFill, 0.15, { Size = UDim2.fromScale(ratio, 1) })
			ui.hpText.Text = string.format("%d / %d", math.ceil(hum.Health), math.floor(hum.MaxHealth))
			if hum.Health < last - 0.5 and ui.root.Visible then
				flashHurt((last - hum.Health) / math.max(hum.MaxHealth, 1))
			end
			last = hum.Health
			ui.lowHealth = ratio < 0.3 and hum.Health > 0
		end
		hum.HealthChanged:Connect(update)
		hum:GetPropertyChangedSignal("MaxHealth"):Connect(update)
		update()
	end
	player.CharacterAdded:Connect(bind)
	if player.Character then
		task.spawn(bind, player.Character)
	end
end

local function fillSlot(slot, info, max, locked)
	slot.tip = nil
	slot.level.Visible = false
	if locked then
		slot.tile.BackgroundColor3 = Theme.LOCKED
		slot.icon.Text = "🔒"
		slot.icon.TextTransparency = 0.4
		slot.tip = "Locked  -  buy more Skill Slots in the Shop"
		return
	end
	slot.icon.TextTransparency = 0
	if not info then
		slot.tile.BackgroundColor3 = Theme.CARD
		slot.icon.Text = ""
		return
	end
	slot.tile.BackgroundColor3 = info.color or Color3.fromRGB(120, 130, 170)
	slot.icon.Text = info.icon or initials(info.name)
	slot.level.Visible = true
	if info.fused then
		slot.level.Text, slot.level.TextColor3 = "FUSE", FUSION_COLOR
	elseif info.evo then
		slot.level.Text, slot.level.TextColor3 = "EVO", EVO_COLOR
	else
		local maxed = info.level >= max
		slot.level.Text = maxed and "MAX" or tostring(info.level)
		slot.level.TextColor3 = maxed and Theme.GOLD or Theme.TEXT
	end
	slot.tip = info.name .. (info.fused and "  (fused)" or info.evo and "  (evolved)" or "  -  level " .. info.level)
end

-- Leave button and the knocked-out panel ---------------------------------------------------

local function buildCrewControls(root)
	local confirmUntil = 0
	ui.leave = Theme.button({
		Size = UDim2.fromOffset(150, 38), Position = UDim2.fromOffset(16, 16), Text = "🏳️  LEAVE",
		BackgroundColor3 = Theme.CARD_LIGHT, ZIndex = 2,
	}, root, function()
		if os.clock() < confirmUntil then
			callbacks.leave()
		else
			-- ask twice so nobody leaves by accident
			confirmUntil = os.clock() + 3
			ui.leave.Text = "TAP AGAIN"
			ui.leave.BackgroundColor3 = Theme.BAD
			task.delay(3, function()
				ui.leave.Text = "🏳️  LEAVE"
				ui.leave.BackgroundColor3 = Theme.CARD_LIGHT
			end)
		end
	end)

	Theme.button({ Size = UDim2.fromOffset(44, 38), Position = UDim2.fromOffset(174, 16), Text = "⚙️", BackgroundColor3 = Theme.CARD_LIGHT, ZIndex = 2 }, root, function()
		callbacks.settings()
	end)

	-- crewmates' health, under the leave button
	ui.crewList = Theme.new("Frame", { Size = UDim2.fromOffset(210, 200), Position = UDim2.fromOffset(16, 64), BackgroundTransparency = 1 }, root)
	Theme.new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, ui.crewList)
	ui.crewRows = {}

	local down = Theme.panel({ Size = UDim2.fromOffset(440, 118), Position = UDim2.new(0.5, -220, 1, -262), Visible = false, ZIndex = 5 }, root)
	ui.down = down
	Theme.title({ Size = UDim2.new(1, -24, 0, 26), Position = UDim2.fromOffset(12, 10), Text = "KNOCKED OUT", TextColor3 = Theme.BAD, ZIndex = 6 }, down)
	Theme.button({ Size = UDim2.fromOffset(38, 32), Position = UDim2.fromOffset(12, 42), Text = "◀", BackgroundColor3 = Theme.CARD_LIGHT, ZIndex = 6 }, down, function()
		callbacks.spectate(-1)
	end)
	ui.watching = Theme.text({ Size = UDim2.new(1, -124, 0, 32), Position = UDim2.fromOffset(62, 42), Text = "", Font = Theme.BOLD, ZIndex = 6, MaxSize = 16 }, down)
	Theme.button({ Size = UDim2.fromOffset(38, 32), Position = UDim2.new(1, -50, 0, 42), Text = "▶", BackgroundColor3 = Theme.CARD_LIGHT, ZIndex = 6 }, down, function()
		callbacks.spectate(1)
	end)
	ui.revive = Theme.button({
		Size = UDim2.new(1, -24, 0, 30), Position = UDim2.fromOffset(12, 80), Text = "💖  REVIVE",
		BackgroundColor3 = Color3.fromRGB(230, 70, 130), ZIndex = 6,
	}, down, function()
		callbacks.revive(ui.revives or 0)
	end)
end

-- Level-up cards ----------------------------------------------------------------------

local function setPips(container, level, max, color)
	for _, child in container:GetChildren() do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
	if not level or not max then
		return
	end
	local width = math.floor((CARD_W - 60) / max) - 4
	for i = 1, max do
		local pip = Theme.new("Frame", {
			Size = UDim2.fromOffset(width, 6), ZIndex = 24,
			BackgroundColor3 = i <= level and color or Color3.fromRGB(255, 255, 255),
			BackgroundTransparency = i <= level and 0 or 0.88,
		}, container)
		Theme.corner(pip, 3)
	end
end

local function buildLevelUp(gui)
	local overlay = Theme.new("Frame", {
		Name = "LevelUp", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Theme.BG,
		BackgroundTransparency = 0.35, Visible = false, ZIndex = 20,
	}, gui)
	ui.levelOverlay = overlay
	ui.levelTitle = Theme.title({ Size = UDim2.fromOffset(600, 54), Position = UDim2.new(0.5, -300, 0.5, -262), Text = "LEVEL UP", ZIndex = 21 }, overlay)
	Theme.text({
		Size = UDim2.fromOffset(600, 22), Position = UDim2.new(0.5, -300, 0.5, -206), ZIndex = 21,
		Text = "Choose a power  -  press 1, 2 or 3", TextColor3 = Theme.MUTED, MaxSize = 18,
	}, overlay)

	local width = Config.CHOICES * CARD_W + (Config.CHOICES - 1) * CARD_GAP
	local row = Theme.new("Frame", {
		Size = UDim2.fromOffset(width, CARD_H), Position = UDim2.new(0.5, -width / 2, 0.5, -170),
		BackgroundTransparency = 1, ZIndex = 21,
	}, overlay)
	for i = 1, Config.CHOICES do
		local x = (i - 1) * (CARD_W + CARD_GAP)
		local button = Theme.new("TextButton", {
			Size = UDim2.fromOffset(CARD_W, CARD_H), Position = UDim2.fromOffset(x, 0), Text = "",
			AutoButtonColor = false, BackgroundColor3 = Theme.CARD, ZIndex = 22,
		}, row)
		Theme.corner(button, 18)
		local stroke = Theme.stroke(button, Theme.ACCENT, 2, 0.5)
		Theme.gradient(button, Color3.fromRGB(255, 255, 255), Color3.fromRGB(160, 165, 195))
		local accent = Theme.new("Frame", { Size = UDim2.new(1, -36, 0, 4), Position = UDim2.fromOffset(18, 0), BorderSizePixel = 0, ZIndex = 23 }, button)
		Theme.corner(accent, 2)
		local tag = Theme.chip({ Size = UDim2.fromOffset(130, 24), Position = UDim2.fromOffset(14, 16), ZIndex = 23, MaxSize = 13 }, button)
		Theme.chip({ Size = UDim2.fromOffset(26, 24), Position = UDim2.new(1, -40, 0, 16), Text = tostring(i), ZIndex = 23, MaxSize = 13 }, button, Theme.LINE)
		local icon, iconText = Theme.icon({ Size = UDim2.fromOffset(92, 92), Position = UDim2.new(0.5, -46, 0, 54), ZIndex = 23 }, button, "", Theme.ACCENT, 22)
		local title = Theme.title({ Size = UDim2.new(1, -28, 0, 44), Position = UDim2.fromOffset(14, 158), TextWrapped = true, ZIndex = 23, MaxSize = 22 }, button)
		local desc = Theme.text({ Size = UDim2.new(1, -32, 0, 72), Position = UDim2.fromOffset(16, 206), TextWrapped = true, TextColor3 = Theme.MUTED, ZIndex = 23, MaxSize = 16 }, button)
		local pips = Theme.new("Frame", { Size = UDim2.new(1, -40, 0, 6), Position = UDim2.new(0, 20, 1, -26), BackgroundTransparency = 1, ZIndex = 23 }, button)
		-- a shine sweeps across each card as it appears
		local shine = Theme.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.55, ZIndex = 25 }, button)
		Theme.corner(shine, 18)
		local shineGradient = Theme.new("UIGradient", {
			Rotation = 25, Offset = Vector2.new(-1, 0),
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.45, 1), NumberSequenceKeypoint.new(0.5, 0.2),
				NumberSequenceKeypoint.new(0.55, 1), NumberSequenceKeypoint.new(1, 1),
			}),
		}, shine)
		Theme.rivets(button, 8, 24)
		Theme.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 4) }, pips)

		button.MouseEnter:Connect(function()
			Theme.tween(button, 0.15, { Position = UDim2.fromOffset(x, -8) })
			Theme.tween(stroke, 0.15, { Transparency = 0, Thickness = 3 })
		end)
		button.MouseLeave:Connect(function()
			Theme.tween(button, 0.15, { Position = UDim2.fromOffset(x, 0) })
			Theme.tween(stroke, 0.15, { Transparency = 0.5, Thickness = 2 })
		end)
		button.Activated:Connect(function()
			Hud.choose(i)
		end)
		cards[i] = { button = button, stroke = stroke, accent = accent, tag = tag, icon = icon, iconText = iconText, title = title, desc = desc, pips = pips, x = x, shine = shineGradient }
	end

	ui.reroll = Theme.button({
		Size = UDim2.fromOffset(220, 46), Position = UDim2.new(0.5, -110, 0.5, 180), Text = "🎲  REROLL  (R)",
		BackgroundColor3 = Theme.CARD_LIGHT, ZIndex = 22,
	}, overlay, function()
		Hud.reroll()
	end)
end

-- Announcements and results -------------------------------------------------------------

local function buildBanners(gui)
	local banner = Theme.panel({ Size = UDim2.fromOffset(600, 64), Position = UDim2.new(0.5, -300, 0, 206), Visible = false, ZIndex = 15 }, gui)
	ui.announce = banner
	ui.announceBar = Theme.new("Frame", { Size = UDim2.new(0, 6, 1, -20), Position = UDim2.fromOffset(12, 10), BorderSizePixel = 0, ZIndex = 16 }, banner)
	Theme.corner(ui.announceBar, 3)
	ui.announceText = Theme.title({ Size = UDim2.new(1, -50, 1, -18), Position = UDim2.fromOffset(30, 9), ZIndex = 16 }, banner)

	local overlay = Theme.new("Frame", {
		Name = "Results", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Theme.BG,
		BackgroundTransparency = 0.35, Visible = false, ZIndex = 30,
	}, gui)
	ui.results = overlay
	local card = Theme.panel({ Size = UDim2.fromOffset(500, 620), Position = UDim2.new(0.5, -250, 0.5, -310), ZIndex = 31 }, overlay)
	ui.resultScale = Theme.new("UIScale", {}, card)
	local tile, icon = Theme.icon({ Size = UDim2.fromOffset(72, 72), Position = UDim2.new(0.5, -36, 0, 22), ZIndex = 32 }, card, "🏆", Theme.GOLD, 20)
	ui.resultTile, ui.resultIcon = tile, icon
	ui.resultTitle = Theme.title({ Size = UDim2.new(1, -40, 0, 46), Position = UDim2.fromOffset(20, 102), ZIndex = 32 }, card)
	ui.resultAdventure = Theme.chip({ Size = UDim2.fromOffset(300, 26), Position = UDim2.new(0.5, -150, 0, 152), ZIndex = 32, MaxSize = 14 }, card)
	ui.resultRows = {}
	for i, name in { "Time", "Level", "Defeated" } do
		local stat = Theme.card({ Size = UDim2.fromOffset(142, 74), Position = UDim2.fromOffset(20 + (i - 1) * 154, 194), ZIndex = 32 }, card)
		ui.resultRows[i] = Theme.title({ Size = UDim2.new(1, -16, 0, 34), Position = UDim2.fromOffset(8, 10), ZIndex = 33 }, stat)
		Theme.text({ Size = UDim2.new(1, -16, 0, 18), Position = UDim2.fromOffset(8, 46), Text = name, TextColor3 = Theme.MUTED, ZIndex = 33, MaxSize = 14 }, stat)
	end
	ui.resultGold = Theme.title({ Size = UDim2.new(1, -40, 0, 46), Position = UDim2.fromOffset(20, 282), TextColor3 = Theme.GOLD, ZIndex = 32 }, card)
	ui.resultUnlocked = Theme.chip({ Size = UDim2.fromOffset(460, 28), Position = UDim2.new(0.5, -230, 0, 334), ZIndex = 32, MaxSize = 14 }, card, Theme.GOOD)
	ui.resultUnlocked.TextWrapped = true
	Theme.divider({ Size = UDim2.new(1, -60, 0, 2), Position = UDim2.fromOffset(30, 374), ZIndex = 32 }, card)
	Theme.title({ Size = UDim2.new(1, -40, 0, 20), Position = UDim2.fromOffset(20, 382), Text = "DAMAGE BY SKILL", TextColor3 = Theme.GOLD, ZIndex = 32, MaxSize = 18 }, card)
	ui.damageRows = {}
	for i = 1, 6 do
		local row = Theme.new("Frame", { Size = UDim2.new(1, -60, 0, 26), Position = UDim2.fromOffset(30, 408 + (i - 1) * 30), BackgroundTransparency = 1, ZIndex = 32 }, card)
		local icon = Theme.text({ Size = UDim2.fromOffset(26, 26), Text = "", ZIndex = 33 }, row)
		local name = Theme.text({ Size = UDim2.new(0.45, -32, 1, 0), Position = UDim2.fromOffset(32, 0), Font = Theme.BOLD, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 33, MaxSize = 14 }, row)
		local bar = Theme.new("Frame", { Size = UDim2.new(0.55, -70, 0, 12), Position = UDim2.new(0.45, 0, 0.5, -6), BackgroundColor3 = Theme.BG, BackgroundTransparency = 0.3, ZIndex = 33 }, row)
		Theme.corner(bar, 6)
		local fill = Theme.new("Frame", { Size = UDim2.fromScale(0, 1), BorderSizePixel = 0, ZIndex = 34 }, bar)
		Theme.corner(fill, 6)
		local amount = Theme.text({ Size = UDim2.fromOffset(64, 26), Position = UDim2.new(1, -64, 0, 0), Font = Theme.BOLD, TextColor3 = Theme.GOLD, TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 33, MaxSize = 14 }, row)
		ui.damageRows[i] = { row = row, icon = icon, name = name, fill = fill, amount = amount }
	end
	Theme.text({
		Size = UDim2.new(1, -40, 0, 18), Position = UDim2.new(0, 20, 1, -36), ZIndex = 32,
		Text = "Sailing back to the island...", TextColor3 = Theme.MUTED, MaxSize = 15,
	}, card)
end

-- Count a label up from 0 to `value`.
local function countUp(label, value, format)
	local number = Instance.new("NumberValue")
	number.Changed:Connect(function(v)
		label.Text = format(v)
	end)
	label.Text = format(0)
	Theme.tween(number, 1.2, { Value = value })
	task.delay(1.3, function()
		number:Destroy()
	end)
end

-- Blurs the world behind full-screen menus.
local blur = Instance.new("BlurEffect")
blur.Size = 0
local function setBlur(on)
	blur.Parent = workspace.CurrentCamera
	Theme.tween(blur, 0.25, { Size = on and 14 or 0 })
end

-- Public -----------------------------------------------------------------------------------

function Hud.init(gui, cb)
	callbacks = cb
	local root = Theme.new("Frame", { Name = "RunHud", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false }, gui)
	ui.root = root
	buildStatus(root)
	buildWaveTracker(root)
	buildBossBar(root)
	buildCombo(root)
	buildActionBar(root)
	buildScreenLayer()
	buildHealth(root)
	buildCrewControls(root)
	buildLevelUp(gui)
	buildBanners(gui)
	buildWaveBanner(gui)
	RunService.RenderStepped:Connect(Hud.update)
	Hud.setStats({ level = 1, xp = 0, need = 1, kills = 0, weapons = {}, passives = {}, slots = Config.WEAPON_SLOTS_START })
end

function Hud.setVisible(visible)
	ui.root.Visible = visible
	ui.screenLayer.Enabled = visible
	if not visible then
		Hud.showLevelUp(nil)
		ui.waveBanner.Visible = false
		ui.comboValue, ui.comboUntil = 0, 0
		ui.combo.Visible = false
	end
end

function Hud.setState(state)
	ui.adventure.Text = (state.adventure or ""):upper()
	ui.adventure.TextColor3 = state.color or Theme.MUTED
	ui.timer.Text = state.text or ""
	ui.timer.TextColor3 = state.boss and Theme.BAD or Theme.TEXT
	ui.down.Visible = state.down == true

	ui.waveTracker.Visible = (state.wave or 0) > 0
	if state.boss then
		ui.waveIcon.Text = "☠️"
		ui.waveText.Text = "FINAL WAVE"
		ui.waveText.TextColor3 = Theme.BAD
		ui.waveNext.Text = "BOSS"
		ui.waveFill.Size = UDim2.fromScale(1, 1)
	elseif state.wave then
		ui.waveIcon.Text = "🌊"
		ui.waveText.Text = state.endless and string.format("WAVE %d  ♾️", state.wave) or string.format("WAVE %d / %d", state.wave, state.waves or state.wave)
		ui.waveText.TextColor3 = Theme.TEXT
		local left = state.waveLeft or 0
		local label = (state.endless or state.wave < (state.waves or 0)) and "next" or "boss"
		ui.waveNext.Text = string.format("%s %d:%02d", label, left // 60, math.floor(left % 60))
		-- the State comes once a second: glide the bar to where it will be by the next one
		local length = Config.WAVE_LENGTH
		ui.waveFill.Size = UDim2.fromScale(math.clamp(1 - left / length, 0, 1), 1)
		Theme.tween(ui.waveFill, 1, { Size = UDim2.fromScale(math.clamp(1 - (left - 1) / length, 0, 1), 1) }, Enum.EasingStyle.Linear)
	end
end

-- The big banner at the start of each wave (and when the boss arrives).
function Hud.showWave(info)
	Sounds.play(info.boss and "Boss" or "Wave")
	local color = info.color or Theme.ACCENT
	ui.waveNumber.Text = info.n == "RAID" and "RAID BOSS" or info.boss and "FINAL WAVE" or "WAVE " .. tostring(info.n)
	ui.waveTitle.Text = info.title or ""
	ui.waveSub.Text = info.sub or ""
	ui.waveSub.TextColor3 = color:Lerp(Color3.new(1, 1, 1), 0.6)
	local dark = color:Lerp(Color3.new(0, 0, 0), 0.35)
	ui.waveRibbon.BackgroundColor3 = dark
	for _, tail in ui.waveTails do
		tail.BackgroundColor3 = dark
	end
	ui.waveBanner.Visible = true
	ui.waveBanner.GroupTransparency = 1
	ui.waveBanner.Position = UDim2.new(0.5, -340, 0.36, 0)
	ui.waveBannerScale.Scale = 1.6
	Theme.tween(ui.waveBanner, 0.25, { GroupTransparency = 0 })
	Theme.tween(ui.waveBannerScale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	local token = {}
	ui.waveToken = token
	task.delay(2.6, function()
		if ui.waveToken ~= token then
			return
		end
		Theme.tween(ui.waveBanner, 0.4, { GroupTransparency = 1, Position = UDim2.new(0.5, -340, 0.36, -40) })
		task.delay(0.45, function()
			if ui.waveToken == token then
				ui.waveBanner.Visible = false
			end
		end)
	end)
end

-- Bosses near me: the highest tier first (the map's boss over a Vice Admiral), then the closest.
local function findBoss(me)
	local folder = workspace:FindFirstChild("Enemies")
	local best, bestTier, bestDist
	for _, model in folder and folder:GetChildren() or {} do
		local torso = model:GetAttribute("Boss") and model:FindFirstChild("Torso")
		if torso then
			local d = (torso.Position - me).Magnitude
			local tier = model:GetAttribute("BossTier") or 1
			if d < 700 and (not best or tier > bestTier or tier == bestTier and d < bestDist) then
				best, bestTier, bestDist = model, tier, d
			end
		end
	end
	return best
end

-- Things worth an arrow at the screen edge: treasure chests and bosses, closest first.
local function markerTargets(me)
	local found = {}
	local folder = workspace:FindFirstChild("Enemies")
	for _, model in folder and folder:GetChildren() or {} do
		local icon
		if model.Name == "TreasureChest" then
			icon = "🎁"
		elseif model:GetAttribute("Boss") then
			icon = "☠️"
		end
		local pos = icon and model:GetPivot().Position
		if pos and (pos - me).Magnitude < 400 then
			table.insert(found, { pos = pos, icon = icon, d = (pos - me).Magnitude })
		end
	end
	table.sort(found, function(a, b)
		return a.d < b.d
	end)
	return found
end

local function updateMarkers(me)
	local camera = workspace.CurrentCamera
	local view = camera.ViewportSize
	local center = view / 2
	local margin = 54
	local targets = markerTargets(me)
	for i, m in ui.markers do
		local t = targets[i]
		local shown = false
		if t then
			local vp = camera:WorldToViewportPoint(t.pos)
			local onScreen = vp.Z > 0 and vp.X > margin and vp.X < view.X - margin and vp.Y > margin and vp.Y < view.Y - margin
			if not onScreen then
				-- push the marker to the screen edge in the target's direction
				local d = Vector2.new(vp.X, vp.Y) - center
				if vp.Z < 0 then
					d = -d
				end
				if d.Magnitude < 1 then
					d = Vector2.new(0, -1)
				end
				local hx, hy = center.X - margin, center.Y - margin
				local scale = math.min(hx / math.max(math.abs(d.X), 0.001), hy / math.max(math.abs(d.Y), 0.001))
				local pos = center + d * scale
				local angle = math.atan2(d.Y, d.X)
				m.frame.Position = UDim2.fromOffset(pos.X, pos.Y)
				m.arrow.Position = UDim2.new(0.5, math.cos(angle) * 34, 0.5, math.sin(angle) * 34)
				m.arrow.Rotation = math.deg(angle) + 90
				m.icon.Text = t.icon
				m.dist.Text = string.format("%dm", math.floor(t.d))
				m.stroke.Color = t.icon == "🎁" and Theme.GOLD or Theme.BAD
				m.arrow.TextColor3 = m.stroke.Color
				shown = true
			end
		end
		m.frame.Visible = shown
	end
end

local bossCheckAt = 0

-- Crewmates' health bars (everyone in the run but you).
local function updateCrew()
	for userId, row in ui.crewRows do
		local mate = Players:GetPlayerByUserId(userId)
		local hum = mate and mate.Character and mate.Character:FindFirstChildOfClass("Humanoid")
		local ratio = hum and math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1) or 0
		row.fill.Size = UDim2.fromScale(ratio, 1)
		row.state.Text = ratio <= 0 and "💀" or ""
		row.frame.BackgroundTransparency = ratio <= 0 and 0.5 or 0.15
	end
end

-- Builds the crew list from the run's crew (UserIds).
function Hud.setCrew(crew)
	local wanted = {}
	for _, userId in crew or {} do
		if userId ~= player.UserId then
			wanted[userId] = true
		end
	end
	for userId, row in ui.crewRows do
		if not wanted[userId] then
			row.frame:Destroy()
			ui.crewRows[userId] = nil
		end
	end
	for userId in wanted do
		if not ui.crewRows[userId] then
			local mate = Players:GetPlayerByUserId(userId)
			local frame = Theme.card({ Size = UDim2.fromOffset(210, 34), BackgroundColor3 = Theme.PANEL, BackgroundTransparency = 0.15 }, ui.crewList)
			Theme.text({ Size = UDim2.new(1, -40, 0, 14), Position = UDim2.fromOffset(8, 3), Text = mate and mate.DisplayName or "Crewmate", Font = Theme.BOLD, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 2, MaxSize = 13 }, frame)
			local bar, fill = Theme.bar({ Size = UDim2.new(1, -16, 0, 8), Position = UDim2.fromOffset(8, 21), ZIndex = 2 }, frame,
				Color3.fromRGB(120, 240, 140), Color3.fromRGB(40, 170, 80))
			bar:FindFirstChildOfClass("TextLabel").Visible = false
			local state = Theme.text({ Size = UDim2.fromOffset(24, 18), Position = UDim2.new(1, -30, 0, 1), Text = "", ZIndex = 3 }, frame)
			ui.crewRows[userId] = { frame = frame, fill = fill, state = state }
		end
	end
end

-- Every frame while the HUD is up: boss bar, combo timer, markers, low-health pulse.
function Hud.update(dt)
	if not ui.root.Visible then
		return
	end
	local now = os.clock()
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local me = root and root.Position or workspace.CurrentCamera.Focus.Position

	-- boss bar: smooth fill plus a pale bar that catches up slowly
	if now >= bossCheckAt then
		bossCheckAt = now + 0.25
		local boss = findBoss(me)
		if boss ~= ui.boss then
			ui.boss = boss
			local hp = boss and boss:GetAttribute("Hp") or 1
			ui.bossShown, ui.bossLagRatio = hp, hp
		end
	end
	local boss = ui.boss
	ui.bossBar.Visible = boss ~= nil and boss.Parent ~= nil
	if ui.bossBar.Visible then
		local ratio = math.clamp(boss:GetAttribute("Hp") or 1, 0, 1)
		ui.bossName.Text = string.upper(boss:GetAttribute("Boss") or "")
		ui.bossShown += (ratio - ui.bossShown) * math.min(1, dt * 12)
		ui.bossLagRatio += (ratio - ui.bossLagRatio) * math.min(1, dt * 2)
		ui.bossFill.Size = UDim2.fromScale(ui.bossShown, 1)
		ui.bossLag.Size = UDim2.fromScale(math.max(ui.bossLagRatio, ui.bossShown), 1)
		ui.bossPercent.Text = string.format("%d%%", math.ceil(ratio * 100))
	end

	-- combo: fades out when the kills stop
	if ui.comboValue > 0 then
		local left = ui.comboUntil - now
		if left <= 0 then
			ui.comboValue = 0
			ui.combo.Visible = false
		else
			ui.comboFill.Size = UDim2.fromScale(left / COMBO_TIME, 1)
		end
	end

	updateMarkers(me)
	updateCrew()

	-- low health: the edges pulse red
	if ui.lowHealth then
		local pulse = 0.55 + math.sin(now * 6) * 0.2
		for _, f in ui.vignette do
			if f.BackgroundTransparency > pulse then
				f.BackgroundTransparency = pulse
			end
		end
	end
end

-- Kill streaks: big numbers on the right, with a shout at 20, 50, 100 and 200.
local function addCombo(kills)
	local before = ui.comboValue
	ui.comboValue += kills
	ui.comboUntil = os.clock() + COMBO_TIME
	if ui.comboValue < 3 then
		return -- only show real streaks
	end
	for _, tier in COMBO_TIERS do
		if ui.comboValue >= tier[1] then
			ui.comboLabel.Text = tier[2]
			ui.comboLabel.TextColor3 = tier[3]
			ui.comboCount.TextColor3 = tier[3]:Lerp(Color3.new(1, 1, 1), 0.3)
			if before < tier[1] and tier[1] > 0 then
				Hud.announce(tier[2] .. "  " .. tier[1] .. " KILL COMBO", tier[3])
			end
			break
		end
	end
	ui.comboCount.Text = "x" .. ui.comboValue
	ui.combo.Visible = true
	ui.comboScale.Scale = 1.35
	Theme.tween(ui.comboScale, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
end


-- Revives the player owns (from the store), shown on the knocked-out panel.
local function refreshRevive()
	if not ui.revive then
		return -- not built yet: Hud.init shows it
	end
	local count = ui.revives or 0
	if count > 0 then
		ui.revive.Text = string.format("💖  REVIVE  (%d left)", count)
	else
		ui.revive.Text = ui.revivePrice and string.format("💖  REVIVE NOW  R$ %d", ui.revivePrice) or "💖  BUY A REVIVE"
	end
end

function Hud.setRevives(count)
	ui.revives = count
	refreshRevive()
end

-- The Robux price of a revive, shown when the player has none left.
function Hud.setRevivePrice(price)
	ui.revivePrice = price
	refreshRevive()
end

function Hud.setWatching(name)
	ui.watching.Text = name and "Watching " .. name or "No crewmates standing"
end

-- Shows the dash recharging over `cooldown` seconds.
function Hud.dashUsed(cooldown)
	ui.dashShade.Size = UDim2.new(1, 10, 1, 10)
	Theme.tween(ui.dashShade, cooldown, { Size = UDim2.new(0, 0, 1, 10) }, Enum.EasingStyle.Linear)
end

function Hud.setStats(st)
	Theme.tween(ui.xpFill, 0.2, { Size = UDim2.fromScale(math.clamp(st.xp / st.need, 0, 1), 1) })
	ui.level.Text = tostring(st.level)
	ui.kills.Text = "💀 " .. Theme.comma(st.kills)
	if st.kills > ui.lastKills and ui.root.Visible then
		addCombo(st.kills - ui.lastKills)
	end
	ui.lastKills = st.kills
	local unlocked = st.slots or Config.WEAPON_SLOTS_START
	for i, slot in ui.weaponSlots do
		fillSlot(slot, st.weapons[i], Config.WEAPON_MAX, i > unlocked)
	end
	for i, slot in ui.passiveSlots do
		fillSlot(slot, st.passives[i], Config.PASSIVE_MAX, false)
	end
end

function Hud.showLevelUp(list, rerolls)
	if not list then
		if ui.levelOverlay.Visible then
			setBlur(false)
		end
		ui.levelOverlay.Visible = false
		return
	end
	for i, card in cards do
		local c = list[i]
		card.button.Visible = c ~= nil
		if c then
			local tint = c.tag == "EVOLUTION" and EVO_COLOR or c.tag == "FUSION" and FUSION_COLOR or c.color
			card.tag.Text = c.tag or ""
			card.tag.BackgroundColor3 = tint
			card.tag.TextColor3 = tint:Lerp(Color3.new(1, 1, 1), 0.5)
			card.accent.BackgroundColor3 = tint
			card.stroke.Color = tint
			card.icon.BackgroundColor3 = c.color
			card.iconText.Text = c.icon or initials(c.title)
			card.title.Text = c.title
			card.desc.Text = c.text
			setPips(card.pips, c.level, c.max, tint)
			-- cards rise into place one after another
			card.button.Position = UDim2.fromOffset(card.x, 70)
			Theme.tween(card.button, 0.35 + i * 0.06, { Position = UDim2.fromOffset(card.x, 0) }, Enum.EasingStyle.Back)
			card.shine.Offset = Vector2.new(-1, 0)
			task.delay(0.25 + i * 0.12, function()
				Theme.tween(card.shine, 0.6, { Offset = Vector2.new(1, 0) }, Enum.EasingStyle.Sine)
			end)
		end
	end
	ui.reroll.Text = string.format("🎲  REROLL (R)  x%d", rerolls or 0)
	ui.reroll.Visible = (rerolls or 0) > 0
	if not ui.levelOverlay.Visible then
		setBlur(true)
		Sounds.play("LevelUp")
	end
	ui.levelOverlay.Visible = true
end

function Hud.choose(i)
	if ui.levelOverlay.Visible and cards[i] and cards[i].button.Visible then
		ui.levelOverlay.Visible = false -- the server sends the next offer, if any
		setBlur(false)
		callbacks.choose(i)
	end
end

function Hud.reroll()
	if ui.levelOverlay.Visible and ui.reroll.Visible then
		callbacks.reroll()
	end
end

function Hud.announce(text, color)
	color = color or Theme.GOLD
	ui.announceText.Text = text:upper()
	ui.announceText.TextColor3 = color:Lerp(Color3.new(1, 1, 1), 0.35)
	ui.announceBar.BackgroundColor3 = color
	ui.announce:FindFirstChildOfClass("UIStroke").Color = color
	ui.announce.Position = UDim2.new(0.5, -300, 0, 176)
	ui.announce.Visible = true
	Theme.tween(ui.announce, 0.35, { Position = UDim2.new(0.5, -300, 0, 206) }, Enum.EasingStyle.Back)
	task.delay(2.8, function()
		ui.announce.Visible = false
	end)
end

function Hud.showResults(r)
	local victory = r.result == "Victory"
	local endless = r.result == "Endless"
	ui.resultTitle.Text = endless and "WAVE " .. (r.wave or 0) .. " REACHED" or victory and "VICTORY" or "DEFEATED"
	ui.resultTitle.TextColor3 = (victory or endless) and Theme.GOLD or Theme.BAD
	ui.resultIcon.Text = endless and "🌊" or victory and "🏆" or "☠️"
	ui.resultTile.BackgroundColor3 = endless and Theme.SEA or victory and Theme.GOLD or Theme.BAD
	ui.resultAdventure.Text = r.adventure or ""
	ui.resultAdventure.BackgroundColor3 = r.color or Theme.ACCENT
	local notes = {}
	if r.firstClear then
		table.insert(notes, "⭐ First clear +" .. Theme.comma(r.firstClear))
	end
	if r.unlocked then
		table.insert(notes, "🔓 " .. r.unlocked)
	end
	if r.drop then
		table.insert(notes, r.drop)
	end
	ui.resultUnlocked.Text = table.concat(notes, "   ")
	ui.resultUnlocked.Visible = #notes > 0
	countUp(ui.resultRows[1], r.time, function(v)
		v = math.floor(v)
		return string.format("%d:%02d", v // 60, v % 60)
	end)
	countUp(ui.resultRows[2], r.level, function(v)
		return tostring(math.floor(v))
	end)
	countUp(ui.resultRows[3], r.kills, function(v)
		return Theme.comma(v)
	end)
	countUp(ui.resultGold, r.gold, function(v)
		return "+" .. Theme.comma(v) .. " 💰"
	end)
	local damage = r.damage or {}
	local top = damage[1] and damage[1].amount or 1
	for i, row in ui.damageRows do
		local d = damage[i]
		row.row.Visible = d ~= nil
		if d then
			row.icon.Text = d.icon or ""
			row.name.Text = d.name
			row.fill.BackgroundColor3 = d.color or Theme.ACCENT
			row.fill.Size = UDim2.fromScale(0, 1)
			Theme.tween(row.fill, 0.8 + i * 0.1, { Size = UDim2.fromScale(d.amount / top, 1) })
			row.amount.Text = d.amount >= 10000 and string.format("%.1fK", d.amount / 1000) or Theme.comma(d.amount)
		end
	end
	ui.results.Visible = true
	setBlur(true)
	ui.resultScale.Scale = 0.7
	Theme.tween(ui.resultScale, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)
	task.delay(Config.RESULTS_TIME, function()
		ui.results.Visible = false
		setBlur(false)
	end)
end

return Hud
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX14393"><Properties><string name="Name">Lobby</string><ProtectedString name="Source"><![CDATA[-- Spawn island UI: character select, training, gear, upgrades shop, Robux store, rewards (daily
-- login, quests, codes, achievements), the gate's map select, gold counter and title, hints and
-- the voyage gate boarding banner. NPC prompts open these
-- menus too (see SwarmClient). Maps are only chosen at a voyage gate.
local RS = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(RS:WaitForChild("Shared"):WaitForChild("Config"))
local Theme = require(script.Parent.Theme)

local Lobby = {}
local ui = {}
local callbacks
local classCards = {}
local shopRows = {}
local mapCards = {}
local diffButtons = {}
local panels = {}
local lastPortalMessage = 0
local portal -- latest boarding info from the server while standing on a gate
local pickerOpened = false -- opened the map select once for this boarding
local selectedMap, selectedDifficulty = Config.Maps[1].key, 1
local endlessOn = false
local meta = { gold = 0, levels = {}, costs = {}, progress = {}, class = Config.DEFAULT_CLASS }

local THEME_COLORS = {
	grass = Color3.fromRGB(80, 160, 70), marine = Color3.fromRGB(70, 110, 180), town = Color3.fromRGB(180, 140, 90),
	beach = Color3.fromRGB(220, 190, 120), ship = Color3.fromRGB(140, 95, 55), deepsea = Color3.fromRGB(40, 120, 190),
	snow = Color3.fromRGB(170, 200, 235), desert = Color3.fromRGB(220, 180, 100), jungle = Color3.fromRGB(40, 120, 60),
	sky = Color3.fromRGB(150, 185, 255), spooky = Color3.fromRGB(110, 60, 140), mangrove = Color3.fromRGB(120, 180, 90),
	prison = Color3.fromRGB(90, 85, 100), volcano = Color3.fromRGB(200, 70, 40), wano = Color3.fromRGB(230, 120, 170),
}
local THEME_ICONS = {
	grass = "🌾", marine = "⚓", town = "🏘️", beach = "🏖️", ship = "🚢", deepsea = "🐠", snow = "❄️", desert = "🏜️",
	jungle = "🌴", sky = "☁️", spooky = "👻", mangrove = "🌳", prison = "⛓️", volcano = "🌋", wano = "🌸",
}

local function isCaptain()
	return portal ~= nil and portal.captain and os.clock() - lastPortalMessage < 0.6
end

-- Building blocks -----------------------------------------------------------------------

local function panel(name, width, height, title, subtitle)
	local frame = Theme.panel({
		Name = name, Size = UDim2.fromOffset(width, height), Position = UDim2.new(0.5, -width / 2, 0.5, -height / 2),
		Visible = false, ZIndex = 10,
	}, ui.root)
	panels[name:lower()] = { frame = frame, scale = Theme.new("UIScale", {}, frame), height = height, width = width }
	Theme.title({ Size = UDim2.new(1, -120, 0, 34), Position = UDim2.fromOffset(28, 22), Text = title, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 11 }, frame)
	local sub = Theme.text({ Size = UDim2.new(1, -120, 0, 18), Position = UDim2.fromOffset(28, 58), Text = subtitle or "", TextColor3 = Theme.MUTED, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 11, MaxSize = 15 }, frame)
	Theme.divider({ Size = UDim2.new(1, -40, 0, 2), Position = UDim2.fromOffset(20, 82), ZIndex = 11 }, frame)
	Theme.button({
		Size = UDim2.fromOffset(40, 40), Position = UDim2.new(1, -60, 0, 20), Text = "X",
		BackgroundColor3 = Theme.CARD_LIGHT, ZIndex = 12,
	}, frame, function()
		Lobby.toggle(name:lower(), false)
	end)
	return frame, sub
end

local function scroller(parent, props)
	props.BackgroundTransparency = 1
	props.BorderSizePixel = 0
	props.ScrollBarThickness = 6
	props.ScrollBarImageColor3 = Theme.MUTED
	props.ScrollingDirection = Enum.ScrollingDirection.Y
	props.CanvasSize = UDim2.new()
	props.AutomaticCanvasSize = Enum.AutomaticSize.Y
	props.ZIndex = 11
	local frame = Theme.new("ScrollingFrame", props, parent)
	Theme.padding(frame, 6)
	return frame
end

local function hover(button, scale)
	button.MouseEnter:Connect(function()
		Theme.tween(scale, 0.12, { Scale = 1.04 })
	end)
	button.MouseLeave:Connect(function()
		Theme.tween(scale, 0.12, { Scale = 1 })
	end)
end

-- Character select ------------------------------------------------------------------

local function buildCrew()
	local frame = panel("Crew", 860, 640, "CHOOSE YOUR PIRATE", #Config.CLASS_ORDER .. " pirates  -  each with 6 skills and their own gear")
	local grid = scroller(frame, { Size = UDim2.new(1, -40, 0, 452), Position = UDim2.fromOffset(20, 88) })
	Theme.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(190, 254), CellPadding = UDim2.fromOffset(14, 14),
		HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder,
	}, grid)

	local details = Theme.card({ Size = UDim2.new(1, -40, 0, 76), Position = UDim2.new(0, 20, 1, -92), ZIndex = 11 }, frame)
	ui.detailsIcon = select(2, Theme.icon({ Size = UDim2.fromOffset(52, 52), Position = UDim2.fromOffset(12, 12), ZIndex = 12 }, details, "", Theme.ACCENT, 14))
	ui.detailsTile = ui.detailsIcon.Parent
	ui.detailsTitle = Theme.title({ Size = UDim2.new(1, -90, 0, 22), Position = UDim2.fromOffset(78, 12), TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 12 }, details)
	ui.detailsSkills = Theme.text({
		Size = UDim2.new(1, -90, 0, 30), Position = UDim2.fromOffset(78, 36), TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true, TextColor3 = Theme.MUTED, ZIndex = 12, MaxSize = 14,
	}, details)

	for i, name in Config.CLASS_ORDER do
		local class = Config.Classes[name]
		-- a WANTED poster for every pirate (the Marine gets a recruitment poster)
		local card = Theme.parchment({ Text = "", AutoButtonColor = false, LayoutOrder = i, ZIndex = 12 }, grid, "TextButton")
		local stroke = card:FindFirstChildOfClass("UIStroke")
		local scale = Theme.new("UIScale", {}, card)
		hover(card, scale)
		local marine = name == Config.DEFAULT_CLASS
		Theme.title({
			Size = UDim2.new(1, -20, 0, 28), Position = UDim2.fromOffset(10, 6), Text = marine and "RECRUIT" or "WANTED",
			TextColor3 = Theme.INK, TextStrokeTransparency = 1, ZIndex = 13,
		}, card)
		local portrait = Theme.new("Frame", { Size = UDim2.fromOffset(112, 86), Position = UDim2.new(0.5, -56, 0, 36), BackgroundColor3 = class.color, ZIndex = 13 }, card)
		Theme.stroke(portrait, Theme.INK, 3, 0)
		Theme.gradient(portrait, Color3.fromRGB(255, 255, 255), Color3.fromRGB(140, 140, 140), 135)
		Theme.text({ Size = UDim2.fromScale(0.8, 0.8), Position = UDim2.fromScale(0.1, 0.1), Text = class.icon, ZIndex = 14 }, portrait)
		Theme.title({
			Size = UDim2.new(1, -16, 0, 24), Position = UDim2.fromOffset(8, 126), Text = class.name:upper(),
			TextColor3 = Theme.INK, TextStrokeTransparency = 1, ZIndex = 13, MaxSize = 22,
		}, card)
		Theme.text({ Size = UDim2.new(1, -20, 0, 14), Position = UDim2.fromOffset(10, 150), Text = class.title, TextColor3 = Color3.fromRGB(120, 85, 50), Font = Theme.BOLD, ZIndex = 13, MaxSize = 13 }, card)
		local perk = Theme.text({
			Size = UDim2.new(1, -30, 0, 20), Position = UDim2.fromOffset(15, 168), Text = class.perk, TextColor3 = Color3.fromRGB(40, 110, 60),
			Font = Theme.BOLD, BackgroundTransparency = 0.75, BackgroundColor3 = Color3.fromRGB(80, 170, 100), ZIndex = 13, MaxSize = 12,
		}, card)
		Theme.corner(perk, 6)

		-- the character's 6 skill icons
		local row = Theme.new("Frame", { Size = UDim2.new(1, -20, 0, 25), Position = UDim2.fromOffset(10, 194), BackgroundTransparency = 1, ZIndex = 13 }, card)
		Theme.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 4) }, row)
		for _, key in class.skills do
			local w = Config.Weapons[key]
			Theme.icon({ Size = UDim2.fromOffset(24, 24), ZIndex = 14 }, row, w.icon, w.color, 7)
		end
		-- bounty line: the unlock price, or that they're in your crew
		local bounty = Theme.title({
			Size = UDim2.new(1, -16, 0, 22), Position = UDim2.new(0, 8, 1, -28), Text = "", TextColor3 = Theme.INK,
			TextStrokeTransparency = 1, ZIndex = 13, MaxSize = 17,
		}, card)

		local selected = Theme.chip({ Size = UDim2.fromOffset(96, 22), Position = UDim2.new(1, -104, 0, 40), Text = "✓ SAILING", Visible = false, ZIndex = 15, MaxSize = 11, BackgroundTransparency = 0.05, TextColor3 = Theme.DARK_TEXT }, card, Theme.GOLD)
		local lock = Theme.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(40, 25, 10), BackgroundTransparency = 0.45, ZIndex = 16, Visible = false }, card)
		Theme.corner(lock, 6)
		Theme.text({ Size = UDim2.new(1, 0, 0, 44), Position = UDim2.fromOffset(0, 56), Text = "🔒", ZIndex = 17 }, lock)
		local price = Theme.chip({ Size = UDim2.new(1, -30, 0, 30), Position = UDim2.new(0, 15, 0, 112), Text = "", ZIndex = 17, MaxSize = 14, BackgroundTransparency = 0.1 }, lock, Theme.PANEL)
		card.MouseEnter:Connect(function()
			Lobby.showSkills(name)
		end)
		card.MouseLeave:Connect(function()
			Lobby.showSkills(meta.class)
		end)
		card.Activated:Connect(function()
			if (meta.classes or {})[name] then
				callbacks.selectClass(name)
			elseif meta.gold >= class.cost then
				callbacks.unlockClass(name)
			end
		end)
		classCards[name] = { stroke = stroke, selected = selected, color = class.color, lock = lock, price = price, cost = class.cost, bounty = bounty }
	end
end

-- Upgrade shop --------------------------------------------------------------------------

local function buildShop()
	local frame = panel("Shop", 660, 620, "UPGRADES", "Spend gold from adventures. Upgrades last forever.")
	for i, name in Config.META_ORDER do
		local m = Config.Meta[name]
		local row = Theme.card({ Size = UDim2.new(1, -48, 0, 74), Position = UDim2.fromOffset(24, 92 + (i - 1) * 84), ZIndex = 11 }, frame)
		Theme.icon({ Size = UDim2.fromOffset(50, 50), Position = UDim2.fromOffset(12, 12), ZIndex = 12 }, row, m.icon, Theme.ACCENT, 14)
		Theme.title({ Size = UDim2.new(0, 220, 0, 22), Position = UDim2.fromOffset(76, 14), Text = m.name:upper(), TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 12, MaxSize = 20 }, row)
		Theme.text({ Size = UDim2.new(0, 220, 0, 16), Position = UDim2.fromOffset(76, 42), Text = m.desc .. " per level", TextColor3 = Theme.MUTED, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 12, MaxSize = 14 }, row)
		local pips = Theme.new("Frame", { Size = UDim2.fromOffset(140, 8), Position = UDim2.new(1, -310, 0.5, -4), BackgroundTransparency = 1, ZIndex = 12 }, row)
		Theme.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 3), VerticalAlignment = Enum.VerticalAlignment.Center }, pips)
		local pipFrames = {}
		for p = 1, m.max do
			local pip = Theme.new("Frame", { Size = UDim2.fromOffset(math.floor(140 / m.max) - 3, 8), BackgroundColor3 = Theme.LINE, BackgroundTransparency = 0.88, ZIndex = 13 }, pips)
			Theme.corner(pip, 4)
			pipFrames[p] = pip
		end
		local buy = Theme.button({
			Size = UDim2.fromOffset(140, 46), Position = UDim2.new(1, -154, 0.5, -23), Text = "",
			BackgroundColor3 = Theme.GOOD, ZIndex = 12,
		}, row, function()
			callbacks.buy(name)
		end)
		shopRows[name] = { pips = pipFrames, buy = buy }
	end
end

-- Map select (only from a voyage gate) ---------------------------------------------------

local function buildVoyage()
	local frame, sub = panel("Voyage", 900, 640, "CHOOSE AN ADVENTURE")
	ui.voyageHint = sub

	local grid = scroller(frame, { Size = UDim2.fromOffset(580, 520), Position = UDim2.fromOffset(16, 96) })
	Theme.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(134, 96), CellPadding = UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder,
	}, grid)
	for i, map in Config.Maps do
		local color = THEME_COLORS[map.theme]
		local card = Theme.new("TextButton", { Text = "", AutoButtonColor = false, BackgroundColor3 = Theme.CARD, LayoutOrder = i, ZIndex = 12 }, grid)
		Theme.corner(card, 12)
		local stroke = Theme.stroke(card, Theme.LINE, 1, 0.88)
		local band = Theme.new("Frame", { Size = UDim2.new(1, 0, 0, 40), BackgroundColor3 = color, ZIndex = 12 }, card)
		Theme.corner(band, 12)
		Theme.gradient(band, Color3.new(1, 1, 1), Color3.fromRGB(120, 120, 140))
		Theme.text({ Size = UDim2.fromOffset(32, 32), Position = UDim2.new(1, -38, 0, 4), Text = THEME_ICONS[map.theme], ZIndex = 13 }, band)
		Theme.chip({ Size = UDim2.fromOffset(28, 22), Position = UDim2.fromOffset(8, 9), Text = tostring(i), ZIndex = 13, MaxSize = 12, BackgroundTransparency = 0.3 }, band, Theme.BG)
		Theme.title({ Size = UDim2.new(1, -16, 0, 30), Position = UDim2.fromOffset(8, 44), Text = map.name, TextWrapped = true, ZIndex = 13, MaxSize = 15 }, card)
		local pips = Theme.new("Frame", { Size = UDim2.new(1, -16, 0, 6), Position = UDim2.new(0, 8, 1, -14), BackgroundTransparency = 1, ZIndex = 13 }, card)
		Theme.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 4) }, pips)
		local pipFrames = {}
		for d = 1, #Config.Difficulties do
			local pip = Theme.new("Frame", { Size = UDim2.fromOffset(20, 6), ZIndex = 14 }, pips)
			Theme.corner(pip, 3)
			pipFrames[d] = pip
		end
		local lock = Theme.text({ Size = UDim2.fromScale(1, 1), Text = "🔒", BackgroundTransparency = 0.3, BackgroundColor3 = Theme.BG, ZIndex = 16, Visible = false, MaxSize = 28 }, card)
		Theme.corner(lock, 12)
		local busy = Theme.chip({ Size = UDim2.fromOffset(70, 20), Position = UDim2.new(1, -78, 0, 46), Text = "IN USE", Visible = false, ZIndex = 15, MaxSize = 11 }, card, Theme.BAD)
		card.Activated:Connect(function()
			selectedMap = map.key
			Lobby.refreshVoyage()
		end)
		mapCards[map.key] = { stroke = stroke, pips = pipFrames, lock = lock, busy = busy }
	end

	local side = Theme.card({ Size = UDim2.fromOffset(284, 520), Position = UDim2.fromOffset(604, 96), ZIndex = 11 }, frame)
	ui.mapName = Theme.title({ Size = UDim2.new(1, -24, 0, 30), Position = UDim2.fromOffset(12, 14), TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 12, MaxSize = 22 }, side)
	ui.mapBoss = Theme.chip({ Size = UDim2.new(1, -24, 0, 26), Position = UDim2.fromOffset(12, 52), ZIndex = 12, MaxSize = 13 }, side, Theme.BAD)
	ui.mapInfo = Theme.text({ Size = UDim2.new(1, -24, 0, 16), Position = UDim2.fromOffset(12, 86), TextColor3 = Theme.MUTED, ZIndex = 12, MaxSize = 13 }, side)
	for d, diff in Config.Difficulties do
		diffButtons[d] = Theme.button({
			Size = UDim2.new(1, -24, 0, 44), Position = UDim2.fromOffset(12, 110 + (d - 1) * 50), Text = "",
			BackgroundColor3 = diff.color, ZIndex = 12,
		}, side, function()
			selectedDifficulty = d
			Lobby.refreshVoyage()
		end)
	end
	ui.endless = Theme.button({
		Size = UDim2.new(1, -24, 0, 40), Position = UDim2.new(0, 12, 1, -112), Text = "", BackgroundColor3 = Theme.CARD_LIGHT, ZIndex = 12,
	}, side, function()
		endlessOn = not endlessOn
		Lobby.refreshVoyage()
	end)
	ui.sail = Theme.button({
		Size = UDim2.new(1, -24, 0, 54), Position = UDim2.new(0, 12, 1, -66), Text = "⛵  SET SAIL",
		BackgroundColor3 = Theme.GOOD, ZIndex = 12,
	}, side, function()
		local map = Config.MapByKey[selectedMap]
		local busy = portal and portal.busy and portal.busy[selectedMap]
		if isCaptain() and not busy and Config.unlocked(meta.progress, map, selectedDifficulty) then
			local endless = endlessOn and (meta.progress[selectedMap] or 0) >= selectedDifficulty
			callbacks.voyage(selectedMap, selectedDifficulty, endless)
			Lobby.toggle("voyage", false)
		end
	end)
end

-- Training (Captain Grey: skills, Granny Doc: passives) ------------------------------------------

local trainTab = "skills"

local function buildTrain()
	local frame, sub = panel("Train", 780, 640, "TRAINING")
	ui.trainHint = sub
	ui.trainTabs = {}
	for i, tab in { { "skills", "⚔️  SKILLS  -  Captain Grey" }, { "passives", "💊  PASSIVES  -  Granny Doc" } } do
		ui.trainTabs[tab[1]] = Theme.button({
			Size = UDim2.fromOffset(250, 38), Position = UDim2.fromOffset(28 + (i - 1) * 262, 88), Text = tab[2],
			BackgroundColor3 = Theme.CARD_LIGHT, ZIndex = 12,
		}, frame, function()
			trainTab = tab[1]
			Lobby.refreshTrain()
		end)
	end
	ui.trainList = scroller(frame, { Size = UDim2.new(1, -40, 1, -156), Position = UDim2.fromOffset(20, 138) })
	Theme.new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, ui.trainList)
end

local function trainRow(order, icon, color, name, effect, level, max, cost, onTrain)
	local row = Theme.card({ Size = UDim2.new(1, -12, 0, 72), LayoutOrder = order, ZIndex = 12 }, ui.trainList)
	Theme.icon({ Size = UDim2.fromOffset(50, 50), Position = UDim2.fromOffset(11, 11), ZIndex = 13 }, row, icon, color, 14)
	Theme.title({ Size = UDim2.new(0, 300, 0, 22), Position = UDim2.fromOffset(74, 12), Text = name, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 13, MaxSize = 18 }, row)
	Theme.text({ Size = UDim2.new(0, 330, 0, 16), Position = UDim2.fromOffset(74, 40), Text = effect, TextColor3 = Theme.MUTED, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 13, MaxSize = 13 }, row)
	local pips = Theme.new("Frame", { Size = UDim2.fromOffset(130, 8), Position = UDim2.new(1, -300, 0.5, -4), BackgroundTransparency = 1, ZIndex = 13 }, row)
	Theme.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 3) }, pips)
	for i = 1, max do
		local pip = Theme.new("Frame", {
			Size = UDim2.fromOffset(math.floor(130 / max) - 3, 8), BackgroundColor3 = i <= level and Theme.GOLD or Theme.LINE,
			BackgroundTransparency = i <= level and 0 or 0.88, ZIndex = 14,
		}, pips)
		Theme.corner(pip, 4)
	end
	local maxed = level >= max
	Theme.button({
		Size = UDim2.fromOffset(140, 44), Position = UDim2.new(1, -152, 0.5, -22),
		Text = maxed and "MAXED" or "💰 " .. Theme.comma(cost),
		BackgroundColor3 = maxed and Theme.LOCKED or meta.gold >= cost and Theme.GOOD or Color3.fromRGB(150, 60, 70), ZIndex = 13,
	}, row, not maxed and onTrain or nil)
end

function Lobby.refreshTrain()
	for _, child in ui.trainList:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	for tab, button in ui.trainTabs do
		button.BackgroundColor3 = tab == trainTab and Theme.ACCENT or Theme.CARD_LIGHT
	end
	local mastery, training = meta.mastery or {}, meta.training or {}
	if trainTab == "skills" then
		local class = Config.Classes[meta.class] or Config.Classes[Config.DEFAULT_CLASS]
		ui.trainHint.Text = "Permanently power up " .. class.name .. "'s skills. Switch pirates in CREW to train others."
		for i, key in class.skills do
			local w = Config.Weapons[key]
			local level = mastery[key] or 0
			local effect = string.format("+%d%% damage, -%d%% cooldown per level  (now +%d%% / -%d%%)",
				Config.MASTERY.damage * 100, Config.MASTERY.cooldown * 100, Config.MASTERY.damage * 100 * level, Config.MASTERY.cooldown * 100 * level)
			trainRow(i, w.icon, w.color, w.name, effect, level, Config.MASTERY.max, Config.trainCost("skill", level), function()
				callbacks.train("skill", key)
			end)
		end
	else
		ui.trainHint.Text = "Make every passive stronger, forever. Each level adds 15% to that passive's effect."
		local order = 0
		for key, p in Config.Passives do
			order += 1
			local level = training[key] or 0
			local effect = string.format("%s per level  -  boosted +%d%%", p.desc, Config.TRAINING.boost * 100 * level)
			trainRow(order, p.icon, Theme.ACCENT, p.name, effect, level, Config.TRAINING.max, Config.trainCost("passive", level), function()
				callbacks.train("passive", key)
			end)
		end
	end
end

-- Gear (Hammond the Shipwright) ----------------------------------------------------------------

local gearTab = "weapon"

local function buildGear()
	local frame = panel("Gear", 840, 640, "GEAR", "One weapon, outfit and charm. Drops give spare copies: upgrade with a copy + gold.")
	ui.equippedCards = {}
	for i, slot in Config.GEAR_SLOTS do
		local card = Theme.card({ Size = UDim2.fromOffset(256, 80), Position = UDim2.fromOffset(28 + (i - 1) * 268, 88), ZIndex = 11 }, frame)
		local tile, icon = Theme.icon({ Size = UDim2.fromOffset(56, 56), Position = UDim2.fromOffset(12, 12), ZIndex = 12 }, card, "", Theme.CARD_LIGHT, 14)
		local name = Theme.title({ Size = UDim2.new(1, -86, 0, 20), Position = UDim2.fromOffset(78, 14), TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 12, MaxSize = 17 }, card)
		local stats = Theme.text({ Size = UDim2.new(1, -86, 0, 30), Position = UDim2.fromOffset(78, 38), TextWrapped = true, TextColor3 = Theme.MUTED, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 12, MaxSize = 12 }, card)
		ui.equippedCards[slot] = { tile = tile, icon = icon, name = name, stats = stats }
	end
	ui.gearTabs = {}
	for i, slot in Config.GEAR_SLOTS do
		ui.gearTabs[slot] = Theme.button({
			Size = UDim2.fromOffset(180, 36), Position = UDim2.fromOffset(28 + (i - 1) * 192, 182),
			Text = Config.GEAR_SLOT_ICONS[slot] .. "  " .. Config.GEAR_SLOT_NAMES[slot]:upper(), BackgroundColor3 = Theme.CARD_LIGHT, ZIndex = 12,
		}, frame, function()
			gearTab = slot
			Lobby.refreshGear()
		end)
	end
	ui.gearList = scroller(frame, { Size = UDim2.new(1, -40, 1, -250), Position = UDim2.fromOffset(20, 230) })
	Theme.new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, ui.gearList)
end

function Lobby.refreshGear()
	local items, equipped = meta.items or {}, meta.equipped or {}
	for slot, card in ui.equippedCards do
		local item = equipped[slot] and Config.GearById[equipped[slot]]
		card.icon.Text = item and item.icon or Config.GEAR_SLOT_ICONS[slot]
		card.tile.BackgroundColor3 = item and Config.RARITIES[item.rarity] or Theme.CARD_LIGHT
		card.name.Text = item and item.name or "No " .. Config.GEAR_SLOT_NAMES[slot]:lower()
		local level = item and (meta.gearLevels or {})[item.id] or 0
		card.name.Text = item and item.name .. (level > 0 and "  +" .. level or "") or card.name.Text
		card.stats.Text = item and Config.describeBonus(Config.gearStats(item, level)) or "Pick one below"
	end
	for slot, button in ui.gearTabs do
		button.BackgroundColor3 = slot == gearTab and Theme.ACCENT or Theme.CARD_LIGHT
	end
	for _, child in ui.gearList:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	local order = 0
	for _, item in Config.GEAR_ITEMS do
		if item.slot == gearTab then
			order += 1
			local color = Config.RARITIES[item.rarity]
			local row = Theme.card({ Size = UDim2.new(1, -12, 0, 72), LayoutOrder = order, ZIndex = 12 }, ui.gearList)
			Theme.icon({ Size = UDim2.fromOffset(50, 50), Position = UDim2.fromOffset(11, 11), ZIndex = 13 }, row, item.icon, color, 14)
			local owned = items[item.id] == true
			local level = (meta.gearLevels or {})[item.id] or 0
			local copies = (meta.gearCopies or {})[item.id] or 0
			Theme.title({ Size = UDim2.new(0, 260, 0, 22), Position = UDim2.fromOffset(74, 12), Text = item.name .. (level > 0 and "  +" .. level or ""), TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 13, MaxSize = 18 }, row)
			Theme.chip({ Size = UDim2.fromOffset(96, 20), Position = UDim2.fromOffset(74, 40), Text = item.rarity:upper(), ZIndex = 13, MaxSize = 11 }, row, color)
			Theme.text({
				Size = UDim2.new(0, 230, 0, 34), Position = UDim2.fromOffset(178, 34), TextWrapped = true, TextColor3 = Theme.MUTED,
				Text = Config.describeBonus(Config.gearStats(item, level)) .. (owned and string.format("\nSpare copies: %d", copies) or ""),
				TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 13, MaxSize = 12,
			}, row)
			local text, color2, action
			if equipped[item.slot] == item.id then
				text, color2, action = "✓ EQUIPPED", Theme.ACCENT, "equip"
			elseif owned then
				text, color2, action = "EQUIP", Theme.GOOD, "equip"
			elseif item.cost > 0 then
				text, color2, action = "💰 " .. Theme.comma(item.cost), meta.gold >= item.cost and Theme.GOOD or Color3.fromRGB(150, 60, 70), "buy"
			else
				text, color2 = "☠️ BOSS DROP", Theme.LOCKED
			end
			Theme.button({ Size = UDim2.fromOffset(118, 44), Position = UDim2.new(1, -130, 0.5, -22), Text = text, BackgroundColor3 = color2, ZIndex = 13 }, row,
				action and function()
					callbacks.gear(action, item.id)
				end or nil)
			if owned then
				-- upgrading costs one spare copy (from drops) plus gold
				local cost = Config.gearUpgradeCost(item, level)
				local maxed = level >= Config.GEAR_UPGRADE.max
				local ready = not maxed and copies >= 1 and meta.gold >= cost
				Theme.button({
					Size = UDim2.fromOffset(136, 44), Position = UDim2.new(1, -274, 0.5, -22),
					Text = maxed and "MAX +10" or copies < 1 and "⬆ NEED A COPY" or "⬆ 💰 " .. Theme.comma(cost),
					BackgroundColor3 = ready and Color3.fromRGB(230, 150, 40) or Theme.LOCKED, ZIndex = 13,
				}, row, ready and function()
					callbacks.gear("upgrade", item.id)
				end or nil)
			end
		end
	end
end

-- Robux store (Bingo) --------------------------------------------------------------------

local function buildStore()
	local frame = panel("Store", 840, 640, "STORE", "Support the game and get perks. Game passes are forever; products are used up.")
	Theme.title({ Size = UDim2.fromOffset(300, 22), Position = UDim2.fromOffset(28, 90), Text = "GAME PASSES", TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Theme.GOLD, ZIndex = 11, MaxSize = 18 }, frame)
	ui.passButtons = {}
	for i, key in Config.PASS_ORDER do
		local pass = Config.GAME_PASSES[key]
		local card = Theme.card({ Size = UDim2.fromOffset(188, 196), Position = UDim2.fromOffset(28 + (i - 1) * 198, 120), ZIndex = 11 }, frame)
		Theme.icon({ Size = UDim2.fromOffset(60, 60), Position = UDim2.new(0.5, -30, 0, 12), ZIndex = 12 }, card, pass.icon, Theme.GOLD, 16)
		Theme.title({ Size = UDim2.new(1, -16, 0, 22), Position = UDim2.fromOffset(8, 78), Text = pass.name, ZIndex = 12, MaxSize = 18 }, card)
		Theme.text({ Size = UDim2.new(1, -20, 0, 40), Position = UDim2.fromOffset(10, 102), Text = pass.desc, TextWrapped = true, TextColor3 = Theme.MUTED, ZIndex = 12, MaxSize = 13 }, card)
		ui.passButtons[key] = Theme.button({ Size = UDim2.new(1, -20, 0, 36), Position = UDim2.new(0, 10, 1, -46), Text = "", ZIndex = 12 }, card, function()
			callbacks.buyPass(key)
		end)
	end
	Theme.title({ Size = UDim2.fromOffset(300, 22), Position = UDim2.fromOffset(28, 330), Text = "PRODUCTS", TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Theme.GOLD, ZIndex = 11, MaxSize = 18 }, frame)
	ui.productButtons, ui.productNotes = {}, {}
	for i, key in Config.PRODUCT_ORDER do
		local product = Config.PRODUCTS[key]
		local col, row = (i - 1) % 3, math.floor((i - 1) / 3)
		local card = Theme.card({ Size = UDim2.fromOffset(254, 116), Position = UDim2.fromOffset(28 + col * 264, 360 + row * 126), ZIndex = 11 }, frame)
		Theme.icon({ Size = UDim2.fromOffset(48, 48), Position = UDim2.fromOffset(12, 12), ZIndex = 12 }, card, product.icon, Theme.ACCENT, 14)
		Theme.title({ Size = UDim2.new(1, -84, 0, 20), Position = UDim2.fromOffset(72, 12), Text = product.name, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 12, MaxSize = 16 }, card)
		ui.productNotes[key] = Theme.text({ Size = UDim2.new(1, -84, 0, 30), Position = UDim2.fromOffset(72, 34), Text = product.desc, TextWrapped = true, TextColor3 = Theme.MUTED, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 12, MaxSize = 12 }, card)
		ui.productButtons[key] = Theme.button({ Size = UDim2.new(1, -24, 0, 34), Position = UDim2.new(0, 12, 1, -44), Text = "", ZIndex = 12 }, card, function()
			callbacks.buyProduct(key)
		end)
	end
end

-- prices: [kind .. key] = Robux price, filled in by Lobby.setPrice
local prices = {}

function Lobby.setPrice(kind, key, robux)
	prices[kind .. key] = robux
	Lobby.refreshStore()
end

function Lobby.refreshStore()
	local owned = {}
	for _, key in meta.passes or {} do
		owned[key] = true
	end
	for key, button in ui.passButtons do
		local pass = Config.GAME_PASSES[key]
		if owned[key] then
			button.Text, button.BackgroundColor3 = "✓ OWNED", Theme.ACCENT
		elseif pass.id == 0 then
			button.Text, button.BackgroundColor3 = "NOT SET UP", Theme.LOCKED
		else
			button.Text, button.BackgroundColor3 = prices["pass" .. key] and "R$ " .. prices["pass" .. key] or "BUY", Theme.GOOD
		end
	end
	for key, button in ui.productButtons do
		local product = Config.PRODUCTS[key]
		if product.id == 0 then
			button.Text, button.BackgroundColor3 = "NOT SET UP", Theme.LOCKED
		else
			button.Text, button.BackgroundColor3 = prices["product" .. key] and "R$ " .. prices["product" .. key] or "BUY", Theme.GOOD
		end
		local note = product.desc
		if product.boost and (meta.boosts or {})[product.boost] and meta.boosts[product.boost] > 0 then
			note = string.format("Active: %d min left", math.ceil(meta.boosts[product.boost] / 60))
		elseif product.revive then
			note = product.desc .. string.format("  (you have %d)", meta.revives or 0)
		end
		ui.productNotes[key].Text = note
	end
end

-- Rebirth (the Sea Sage) ------------------------------------------------------------------

local rebirthConfirmUntil = 0

local function buildRebirth()
	local frame = panel("Rebirth", 660, 560, "⭐ REBIRTH", "Start over stronger. Rebirth bonuses stack and last forever.")
	ui.rebirthCount = Theme.title({ Size = UDim2.new(1, -40, 0, 50), Position = UDim2.fromOffset(20, 94), Text = "", TextColor3 = Theme.GOLD, ZIndex = 11 }, frame)
	ui.rebirthNow = Theme.text({ Size = UDim2.new(1, -40, 0, 22), Position = UDim2.fromOffset(20, 148), Font = Theme.BOLD, TextColor3 = Theme.MUTED, ZIndex = 11, MaxSize = 18 }, frame)
	ui.rebirthNext = Theme.text({ Size = UDim2.new(1, -40, 0, 24), Position = UDim2.fromOffset(20, 174), Font = Theme.BOLD, TextColor3 = Theme.GOOD, ZIndex = 11, MaxSize = 20 }, frame)
	for i, list in {
		{ "❌ YOU LOSE", Theme.BAD, { "💰 All your gold", "🛒 Shop upgrades", "⚔️ Skill training", "💊 Passive training" } },
		{ "✅ YOU KEEP", Theme.GOOD, { "👒 Every pirate you unlocked", "🛡️ All your gear and upgrades", "🗺️ Map progress", "🏅 Achievements and stats" } },
	} do
		local card = Theme.card({ Size = UDim2.fromOffset(290, 176), Position = UDim2.fromOffset(24 + (i - 1) * 306, 212), ZIndex = 11 }, frame)
		Theme.title({ Size = UDim2.new(1, -20, 0, 26), Position = UDim2.fromOffset(10, 10), Text = list[1], TextColor3 = list[2], ZIndex = 12, MaxSize = 20 }, card)
		for j, line in list[3] do
			Theme.text({ Size = UDim2.new(1, -24, 0, 24), Position = UDim2.fromOffset(14, 42 + (j - 1) * 31), Text = line, Font = Theme.BOLD, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 12, MaxSize = 16 }, card)
		end
	end
	ui.rebirthCost = Theme.title({ Size = UDim2.new(1, -40, 0, 34), Position = UDim2.fromOffset(20, 400), Text = "", TextColor3 = Theme.GOLD, ZIndex = 11 }, frame)
	ui.rebirthButton = Theme.button({ Size = UDim2.fromOffset(320, 56), Position = UDim2.new(0.5, -160, 0, 446), Text = "", ZIndex = 12 }, frame, function()
		local cost = meta.rebirthCost or math.huge
		if (meta.gold or 0) < cost then
			return
		end
		if os.clock() < rebirthConfirmUntil then
			rebirthConfirmUntil = 0
			callbacks.rebirth()
		else
			-- ask twice: this resets a lot
			rebirthConfirmUntil = os.clock() + 3
			ui.rebirthButton.Text = "TAP AGAIN TO BE REBORN"
			ui.rebirthButton.BackgroundColor3 = Theme.BAD
			task.delay(3, Lobby.refreshRebirth)
		end
	end)
end

function Lobby.refreshRebirth()
	if not ui.rebirthCount then
		return
	end
	local n, r = meta.rebirths or 0, Config.REBIRTH
	ui.rebirthCount.Text = string.format("⭐ %d REBIRTH%s", n, n == 1 and "" or "S")
	ui.rebirthNow.Text = string.format("Your bonus now: +%d%% gold, +%d%% damage", n * r.gold * 100, n * r.damage * 100)
	ui.rebirthNext.Text = string.format("After rebirth: +%d%% gold, +%d%% damage", (n + 1) * r.gold * 100, (n + 1) * r.damage * 100)
	local cost = meta.rebirthCost or 0
	local maxed = n >= r.max
	ui.rebirthCost.Text = maxed and "MAX REBIRTHS" or "Cost: 💰 " .. Theme.comma(cost)
	if os.clock() >= rebirthConfirmUntil then
		ui.rebirthButton.Text = maxed and "MAXED" or (meta.gold or 0) >= cost and "⭐ BE REBORN" or "NEED MORE GOLD"
		ui.rebirthButton.BackgroundColor3 = not maxed and (meta.gold or 0) >= cost and Color3.fromRGB(240, 170, 40) or Theme.LOCKED
	end
end

-- Rewards: daily login calendar, daily quests, codes and achievements ---------------------

local function buildRewards()
	local frame = panel("Rewards", 860, 660, "🎁 REWARDS", "Log in every day, finish quests, redeem codes and collect achievements.")
	frame.Position = UDim2.new(0.5, -430, 0.5, -330)
	-- playing together: invite friends, group bonus
	Theme.button({ Size = UDim2.fromOffset(150, 36), Position = UDim2.new(1, -220, 0, 22), Text = "📨 INVITE FRIENDS", BackgroundColor3 = Theme.SEA, ZIndex = 12 }, frame, function()
		callbacks.invite()
	end)
	ui.groupChip = Theme.chip({ Size = UDim2.fromOffset(300, 22), Position = UDim2.new(1, -370, 0, 62), Text = "", ZIndex = 12, MaxSize = 12 }, frame, Theme.SEA)

	-- daily calendar
	ui.dailyTitle = Theme.title({ Size = UDim2.fromOffset(500, 24), Position = UDim2.fromOffset(28, 94), Text = "📅 DAILY REWARD", TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Theme.GOLD, ZIndex = 11, MaxSize = 20 }, frame)
	ui.dailyCards = {}
	for day, reward in Config.DAILY_REWARDS do
		local card = Theme.card({ Size = UDim2.fromOffset(108, 118), Position = UDim2.fromOffset(28 + (day - 1) * 116, 124), ZIndex = 11 }, frame)
		Theme.title({ Size = UDim2.new(1, 0, 0, 20), Position = UDim2.fromOffset(0, 8), Text = "DAY " .. day, ZIndex = 12, MaxSize = 16 }, card)
		Theme.text({ Size = UDim2.new(1, 0, 0, 40), Position = UDim2.fromOffset(0, 30), Text = reward.revives and "💎" or "💰", ZIndex = 12 }, card)
		Theme.text({
			Size = UDim2.new(1, -8, 0, 32), Position = UDim2.fromOffset(4, 76), TextWrapped = true, Font = Theme.BOLD, ZIndex = 12, MaxSize = 14,
			Text = Theme.comma(reward.gold) .. (reward.revives and "\n+ revive" or ""), TextColor3 = Theme.GOLD,
		}, card)
		local check = Theme.text({ Size = UDim2.fromScale(1, 1), Text = "✓", Font = Theme.TITLE_FONT, TextColor3 = Theme.GOOD, BackgroundTransparency = 0.35, BackgroundColor3 = Theme.BG, Visible = false, ZIndex = 14 }, card)
		Theme.corner(check, 12)
		ui.dailyCards[day] = { card = card, stroke = card:FindFirstChildOfClass("UIStroke"), check = check }
	end
	ui.dailyClaim = Theme.button({ Size = UDim2.fromOffset(300, 44), Position = UDim2.new(0.5, -150, 0, 252), Text = "", ZIndex = 12 }, frame, function()
		callbacks.rewards("daily")
	end)

	-- quests
	Theme.title({ Size = UDim2.fromOffset(500, 24), Position = UDim2.fromOffset(28, 308), Text = "📜 DAILY QUESTS", TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Theme.GOLD, ZIndex = 11, MaxSize = 20 }, frame)
	ui.questRows = {}
	for i = 1, Config.QUESTS_PER_DAY do
		local row = Theme.card({ Size = UDim2.new(1, -56, 0, 54), Position = UDim2.fromOffset(28, 336 + (i - 1) * 60), ZIndex = 11 }, frame)
		local text = Theme.text({ Size = UDim2.new(1, -330, 0, 22), Position = UDim2.fromOffset(14, 6), Font = Theme.BOLD, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 12, MaxSize = 16 }, row)
		local bar, fill, label = Theme.bar({ Size = UDim2.new(1, -330, 0, 14), Position = UDim2.fromOffset(14, 32), ZIndex = 12 }, row,
			Color3.fromRGB(255, 220, 110), Color3.fromRGB(240, 150, 40))
		local gold = Theme.title({ Size = UDim2.fromOffset(120, 24), Position = UDim2.new(1, -306, 0, 15), TextColor3 = Theme.GOLD, ZIndex = 12, MaxSize = 18 }, row)
		local claim = Theme.button({ Size = UDim2.fromOffset(160, 40), Position = UDim2.new(1, -172, 0, 7), Text = "", ZIndex = 12 }, row, function()
			callbacks.rewards("quest", i)
		end)
		ui.questRows[i] = { row = row, text = text, bar = bar, fill = fill, label = label, gold = gold, claim = claim }
	end

	-- codes
	Theme.title({ Size = UDim2.fromOffset(300, 24), Position = UDim2.fromOffset(28, 524), Text = "🎟️ CODES", TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Theme.GOLD, ZIndex = 11, MaxSize = 20 }, frame)
	local box = Theme.new("TextBox", {
		Size = UDim2.fromOffset(250, 42), Position = UDim2.fromOffset(28, 552), PlaceholderText = "Enter a code", Text = "",
		Font = Theme.BOLD, TextScaled = true, TextColor3 = Theme.TEXT, PlaceholderColor3 = Theme.MUTED,
		BackgroundColor3 = Theme.BG, ClearTextOnFocus = false, ZIndex = 12,
	}, frame)
	Theme.corner(box, 10)
	Theme.stroke(box, Theme.TRIM, 1.5, 0.3)
	Theme.padding(box, 8)
	Theme.button({ Size = UDim2.fromOffset(120, 42), Position = UDim2.fromOffset(288, 552), Text = "REDEEM", BackgroundColor3 = Theme.GOOD, ZIndex = 12 }, frame, function()
		if box.Text ~= "" then
			callbacks.rewards("code", box.Text)
			box.Text = ""
		end
	end)

	-- achievements
	ui.achieveTitle = Theme.title({ Size = UDim2.fromOffset(400, 24), Position = UDim2.fromOffset(440, 524), Text = "🏅 ACHIEVEMENTS", TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Theme.GOLD, ZIndex = 11, MaxSize = 20 }, frame)
	local grid = Theme.new("Frame", { Size = UDim2.fromOffset(392, 100), Position = UDim2.fromOffset(440, 552), BackgroundTransparency = 1, ZIndex = 11 }, frame)
	Theme.new("UIGridLayout", { CellSize = UDim2.fromOffset(60, 30), CellPadding = UDim2.fromOffset(4, 4), SortOrder = Enum.SortOrder.Name }, grid)
	ui.achieveChips = {}
	for key, badge in Config.BADGES do
		local chip = Theme.chip({ Name = key, Text = "🏅", MaxSize = 22, ZIndex = 12 }, grid, Theme.LOCKED)
		ui.achieveChips[key] = { chip = chip, name = badge.name }
		chip.MouseEnter:Connect(function()
			ui.achieveTitle.Text = "🏅 " .. badge.name:upper()
		end)
		chip.MouseLeave:Connect(function()
			Lobby.refreshRewards()
		end)
	end
end

-- Redraws the rewards menu from meta.rewards, and the red dot on its button.
function Lobby.refreshRewards()
	local r = meta.rewards
	if not r or not ui.dailyCards then
		return
	end
	local daily = r.daily
	ui.dailyTitle.Text = string.format("📅 DAILY REWARD  -  %d day streak", daily.canClaim and math.max(daily.streak - 1, 0) or daily.streak)
	for day, card in ui.dailyCards do
		local isNext = day == daily.index
		card.check.Visible = day < daily.index or (day == daily.index and not daily.canClaim)
		card.stroke.Color = isNext and daily.canClaim and Theme.GOLD or Theme.TRIM
		card.stroke.Thickness = isNext and daily.canClaim and 3 or 1
		card.stroke.Transparency = isNext and daily.canClaim and 0 or 0.75
	end
	ui.dailyClaim.Text = daily.canClaim and "🎁 CLAIM DAY " .. daily.index or "COME BACK TOMORROW"
	ui.dailyClaim.BackgroundColor3 = daily.canClaim and Theme.GOOD or Theme.LOCKED
	local ready = daily.canClaim
	for i, row in ui.questRows do
		local q = r.quests[i]
		row.row.Visible = q ~= nil
		if q then
			local done = q.progress >= q.goal
			row.text.Text = q.text
			row.fill.Size = UDim2.fromScale(math.clamp(q.progress / q.goal, 0, 1), 1)
			row.label.Text = Theme.comma(q.progress) .. " / " .. Theme.comma(q.goal)
			row.gold.Text = "💰 " .. Theme.comma(q.gold)
			row.claim.Text = q.claimed and "✓ CLAIMED" or done and "CLAIM" or "IN PROGRESS"
			row.claim.BackgroundColor3 = q.claimed and Theme.LOCKED or done and Theme.GOOD or Theme.CARD_LIGHT
			ready = ready or (done and not q.claimed)
		end
	end
	local earned, total = 0, 0
	for key, entry in ui.achieveChips do
		total += 1
		local got = r.badges and r.badges[key]
		earned += got and 1 or 0
		entry.chip.BackgroundColor3 = got and Theme.GOLD or Theme.LOCKED
		entry.chip.BackgroundTransparency = got and 0.2 or 0.6
		entry.chip.TextTransparency = got and 0 or 0.6
	end
	ui.achieveTitle.Text = string.format("🏅 ACHIEVEMENTS  %d / %d", earned, total)
	ui.rewardsDot.Visible = ready
	local social = meta.social or {}
	ui.groupChip.Text = string.format("👥 +%d%% gold per friend in your crew", Config.SOCIAL.friendGold * 100)
		.. (social.groupSet and (social.inGroup and "  -  group bonus ✓" or "  -  join our group: +10%") or "")
end

-- Gold, side menu, hint and the gate banner ----------------------------------------------

local function navButton(parent, icon, label, color, order, onClick)
	local button = Theme.button({ Size = UDim2.fromOffset(66, 66), Text = "", BackgroundColor3 = color, LayoutOrder = order }, parent, onClick)
	Theme.text({ Size = UDim2.new(1, 0, 0, 28), Position = UDim2.fromOffset(0, 1), Text = icon, ZIndex = 3 }, button)
	Theme.title({ Size = UDim2.new(1, 0, 0, 14), Position = UDim2.new(0, 0, 1, -20), Text = label, ZIndex = 3, MaxSize = 12 }, button)
	return button
end

local function buildHud()
	local gold = Theme.panel({ Size = UDim2.fromOffset(230, 56), Position = UDim2.new(1, -246, 0, 14) }, ui.root)
	Theme.icon({ Size = UDim2.fromOffset(40, 40), Position = UDim2.fromOffset(9, 8), ZIndex = 2 }, gold, "💰", Theme.GOLD, 20)
	ui.gold = Theme.title({ Size = UDim2.new(1, -70, 1, -20), Position = UDim2.fromOffset(58, 10), Text = "0", TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Theme.GOLD, ZIndex = 2 }, gold)
	ui.titleChip = Theme.chip({ Size = UDim2.fromOffset(230, 26), Position = UDim2.new(1, -246, 0, 76), Text = "", MaxSize = 14, BackgroundTransparency = 0.25 }, ui.root, Theme.PANEL)

	local navPanel = Theme.panel({ Size = UDim2.fromOffset(90, 560), Position = UDim2.new(0, 16, 0.5, -300) }, ui.root)
	local nav = Theme.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 2 }, navPanel)
	Theme.new("UIListLayout", { Padding = UDim.new(0, 8), HorizontalAlignment = Enum.HorizontalAlignment.Center, VerticalAlignment = Enum.VerticalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder }, nav)
	for i, item in {
		{ "👒", "CREW", Color3.fromRGB(220, 70, 90), "crew" },
		{ "⚔️", "TRAIN", Color3.fromRGB(99, 132, 255), "train" },
		{ "🛡️", "GEAR", Color3.fromRGB(70, 170, 140), "gear" },
		{ "🛒", "SHOP", Color3.fromRGB(230, 160, 40), "shop" },
		{ "🎁", "REWARDS", Color3.fromRGB(255, 120, 60), "rewards" },
		{ "💎", "STORE", Color3.fromRGB(200, 80, 220), "store" },
		{ "⚙️", "SETTINGS", Color3.fromRGB(90, 105, 130), "settings" },
	} do
		local button = navButton(nav, item[1], item[2], item[3], i, function()
			if item[4] == "settings" then
				callbacks.settings()
			else
				Lobby.toggle(item[4])
			end
		end)
		if item[4] == "rewards" then
			-- a red dot when something is ready to claim
			ui.rewardsDot = Theme.text({
				Size = UDim2.fromOffset(22, 22), Position = UDim2.new(1, -16, 0, -6), Text = "!", Font = Theme.TITLE_FONT,
				BackgroundColor3 = Theme.BAD, BackgroundTransparency = 0, Visible = false, ZIndex = 5,
			}, button)
			Theme.corner(ui.rewardsDot, 11)
		end
	end
	local playing = Theme.panel({ Size = UDim2.fromOffset(220, 48), Position = UDim2.new(0, 16, 0.5, 268) }, ui.root)
	local tile, icon = Theme.icon({ Size = UDim2.fromOffset(34, 34), Position = UDim2.fromOffset(8, 7), ZIndex = 2 }, playing, "", Theme.ACCENT, 17)
	ui.playingTile, ui.playingIcon = tile, icon
	ui.crewName = Theme.text({ Size = UDim2.new(1, -60, 1, -16), Position = UDim2.fromOffset(50, 8), Font = Theme.BOLD, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 2, MaxSize = 16 }, playing)

	ui.saveWarning = Theme.chip({
		Size = UDim2.fromOffset(560, 32), Position = UDim2.new(0.5, -280, 0, 76), Visible = false, MaxSize = 14,
		Text = "⚠️  Your save couldn't load, so progress won't save this visit. Rejoin to try again.",
	}, ui.root, Theme.BAD)
	ui.hint = Theme.panel({ Size = UDim2.fromOffset(560, 46), Position = UDim2.new(0.5, -280, 1, -66) }, ui.root)
	Theme.text({ Size = UDim2.new(1, -28, 1, -16), Position = UDim2.fromOffset(14, 8), Text = "⛵  Step onto a voyage gate to choose your adventure", Font = Theme.BOLD, MaxSize = 17 }, ui.hint)

	local banner = Theme.panel({ Size = UDim2.fromOffset(500, 132), Position = UDim2.new(0.5, -250, 0, 20), Visible = false }, ui.root)
	ui.banner = banner
	ui.bannerBar = Theme.new("Frame", { Size = UDim2.new(0, 6, 1, -24), Position = UDim2.fromOffset(12, 12), BorderSizePixel = 0, ZIndex = 2 }, banner)
	Theme.corner(ui.bannerBar, 3)
	ui.bannerScale = Theme.new("UIScale", {}, banner)
	ui.bannerName = Theme.title({ Size = UDim2.new(1, -48, 0, 28), Position = UDim2.fromOffset(30, 12), Text = "", TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 2 }, banner)
	ui.bannerCaptain = Theme.chip({ Size = UDim2.fromOffset(220, 24), Position = UDim2.fromOffset(30, 46), ZIndex = 2, MaxSize = 13 }, banner, Theme.GOLD)
	ui.bannerStatus = Theme.text({ Size = UDim2.new(1, -48, 0, 22), Position = UDim2.fromOffset(30, 76), Text = "", TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 2, MaxSize = 17 }, banner)
	ui.bannerPick = Theme.button({
		Size = UDim2.fromOffset(150, 34), Position = UDim2.new(1, -166, 0, 42), Text = "🗺️ CHOOSE MAP",
		BackgroundColor3 = Theme.ACCENT, Visible = false, ZIndex = 2,
	}, banner, function()
		Lobby.toggle("voyage", true)
	end)
end

-- Public ----------------------------------------------------------------------------------

function Lobby.init(gui, cb)
	callbacks = cb
	ui.root = Theme.new("Frame", { Name = "Lobby", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1 }, gui)
	buildHud()
	buildCrew()
	buildTrain()
	buildGear()
	buildShop()
	buildStore()
	buildRewards()
	buildRebirth()
	buildVoyage()
	Lobby.setMeta(meta)

	RunService.Heartbeat:Connect(function()
		local boarding = os.clock() - lastPortalMessage < 0.6
		if ui.banner.Visible ~= boarding then
			ui.banner.Visible = boarding
			if boarding then
				ui.bannerScale.Scale = 0.8
				Theme.tween(ui.bannerScale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
			else
				-- stepped off the gate: the map select is only for gates
				pickerOpened = false
				portal = nil
				Lobby.toggle("voyage", false)
			end
		end
		ui.hint.Visible = not boarding
	end)
end

function Lobby.setVisible(visible)
	ui.root.Visible = visible
	if not visible then
		for name in panels do
			Lobby.toggle(name, false)
		end
	end
end

-- Opens or closes a panel (only one at a time). Big panels shrink to fit small screens.
function Lobby.toggle(name, open)
	local p = panels[name]
	if open == nil then
		open = not p.frame.Visible
	end
	if open and not p.frame.Visible then
		for other, q in panels do
			if other ~= name then
				q.frame.Visible = false
			end
		end
		p.scale.Scale = 0.9
		Theme.tween(p.scale, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
		if name == "voyage" then
			Lobby.refreshVoyage()
		elseif name == "train" then
			Lobby.refreshTrain()
		elseif name == "gear" then
			Lobby.refreshGear()
		elseif name == "store" then
			Lobby.refreshStore()
		elseif name == "rewards" then
			Lobby.refreshRewards()
		elseif name == "rebirth" then
			Lobby.refreshRebirth()
		end
	end
	p.frame.Visible = open
end

-- Opens a menu from an NPC (tab: which tab of the training menu).
function Lobby.open(name, tab)
	if not panels[name] or not ui.root.Visible then
		return
	end
	if name == "train" and tab then
		trainTab = tab
	end
	Lobby.toggle(name, true)
	if name == "train" then
		Lobby.refreshTrain()
	end
end

-- Lists a character's 6 skills under the character cards.
function Lobby.showSkills(name)
	local class = Config.Classes[name]
	if not class then
		return
	end
	local names = {}
	for _, key in class.skills do
		local w = Config.Weapons[key]
		table.insert(names, w.icon .. " " .. w.name)
	end
	ui.detailsIcon.Text = class.icon
	ui.detailsTile.BackgroundColor3 = class.color
	ui.detailsTitle.Text = class.name:upper() .. "  -  " .. class.title:upper()
	ui.detailsSkills.Text = table.concat(names, "    ")
end

-- Redraws the map select: unlocks, cleared difficulties, the selected map and difficulty.
function Lobby.refreshVoyage()
	local progress = meta.progress or {}
	for _, map in Config.Maps do
		local card = mapCards[map.key]
		card.lock.Visible = not Config.unlocked(progress, map, 1)
		card.busy.Visible = portal ~= nil and portal.busy ~= nil and portal.busy[map.key] == true
		for d, pip in card.pips do
			local cleared = (progress[map.key] or 0) >= d
			pip.BackgroundColor3 = cleared and Config.Difficulties[d].color or Theme.LINE
			pip.BackgroundTransparency = cleared and 0 or 0.85
		end
		local chosen = map.key == selectedMap
		card.stroke.Color = chosen and Theme.GOLD or Theme.LINE
		card.stroke.Thickness = chosen and 2.5 or 1
		card.stroke.Transparency = chosen and 0 or 0.88
	end

	local map = Config.MapByKey[selectedMap]
	ui.mapName.Text = map.index .. ".  " .. map.name:upper()
	ui.mapBoss.Text = "☠️  Boss: " .. map.boss
	ui.mapInfo.Text = string.format("Enemy power x%.1f   -   Gold x%.1f", map.hp, map.gold)
	if not Config.unlocked(progress, map, selectedDifficulty) then
		selectedDifficulty = 1
	end
	for d, button in diffButtons do
		local diff = Config.Difficulties[d]
		local open = Config.unlocked(progress, map, d)
		local cleared = (progress[map.key] or 0) >= d
		button.BackgroundColor3 = open and diff.color or Theme.LOCKED
		button.Text = (open and "" or "🔒  ") .. diff.name:upper()
			.. string.format("   +%d%% gold", math.floor((diff.gold - 1) * 100 + 0.5)) .. (cleared and "   ✓" or "")
		local stroke = button:FindFirstChildOfClass("UIStroke")
		stroke.Color = d == selectedDifficulty and Theme.GOLD or Theme.LINE
		stroke.Thickness = d == selectedDifficulty and 2.5 or 1
		stroke.Transparency = d == selectedDifficulty and 0 or 0.82
	end

	-- endless: only on a difficulty already cleared on this map
	local endlessOk = (progress[map.key] or 0) >= selectedDifficulty
	ui.endless.Text = not endlessOk and "♾️  ENDLESS  🔒 clear this difficulty first"
		or endlessOn and "♾️  ENDLESS MODE: ON" or "♾️  ENDLESS MODE: OFF"
	ui.endless.BackgroundColor3 = endlessOk and endlessOn and Color3.fromRGB(150, 80, 220) or Theme.CARD_LIGHT
	if not Config.unlocked(progress, map, selectedDifficulty) then
		ui.sail.Text = map.index > 1 and (progress[Config.Maps[map.index - 1].key] or 0) < 1
			and "🔒  CLEAR " .. Config.Maps[map.index - 1].name:upper() .. " FIRST" or "🔒  LOCKED"
		ui.sail.BackgroundColor3 = Theme.LOCKED
	elseif portal and portal.busy and portal.busy[map.key] then
		ui.sail.Text = "ANOTHER CREW IS HERE"
		ui.sail.BackgroundColor3 = Theme.LOCKED
	elseif isCaptain() then
		ui.sail.Text = endlessOn and endlessOk and "♾️  SET SAIL (ENDLESS)" or "⛵  SET SAIL"
		ui.sail.BackgroundColor3 = Theme.GOOD
	else
		ui.sail.Text = "ONLY THE CAPTAIN CHOOSES"
		ui.sail.BackgroundColor3 = Theme.LOCKED
	end
	ui.voyageHint.Text = isCaptain() and "You are the captain! Pick a map and difficulty, then set sail."
		or "Clear a difficulty to unlock the next one. Clear a map on Easy to unlock the next map."
end

function Lobby.setMeta(data)
	meta = data
	meta.progress = meta.progress or {}
	local class = Config.Classes[data.class] or Config.Classes[Config.DEFAULT_CLASS]
	Lobby.showSkills(data.class)
	ui.gold.Text = Theme.comma(data.gold)
	ui.crewName.Text = "Playing as " .. class.name
	ui.playingIcon.Text = class.icon
	ui.playingTile.BackgroundColor3 = class.color
	for name, card in classCards do
		local chosen = name == data.class
		local unlocked = (data.classes or {})[name] == true
		card.lock.Visible = not unlocked
		card.price.Text = "💰 " .. Theme.comma(card.cost) .. (data.gold >= card.cost and "  -  RECRUIT" or "")
		card.price.TextColor3 = data.gold >= card.cost and Theme.GOOD or Theme.GOLD
		card.bounty.Text = unlocked and "IN YOUR CREW" or "BOUNTY  💰 " .. Theme.comma(card.cost)
		card.selected.Visible = chosen
		card.stroke.Color = chosen and Theme.GOLD or Theme.INK
		card.stroke.Thickness = chosen and 4 or 2
		card.stroke.Transparency = chosen and 0 or 0.35
	end
	for name, row in shopRows do
		local level = data.levels[name] or 0
		for i, pip in row.pips do
			pip.BackgroundColor3 = i <= level and Theme.GOLD or Theme.LINE
			pip.BackgroundTransparency = i <= level and 0 or 0.88
		end
		local cost = data.costs[name]
		if not cost then
			row.buy.Text = "MAXED"
			row.buy.BackgroundColor3 = Theme.LOCKED
		else
			row.buy.Text = "💰 " .. Theme.comma(cost)
			row.buy.BackgroundColor3 = data.gold >= cost and Theme.GOOD or Color3.fromRGB(150, 60, 70)
		end
	end
	ui.saveWarning.Visible = data.loadFailed == true
	ui.titleChip.Text = "⭐ " .. (data.title or "Rookie") .. "   💰 " .. Theme.comma((data.rewards and data.rewards.stats.gold) or 0) .. " bounty"
	Lobby.refreshRewards()
	Lobby.refreshRebirth()
	Lobby.refreshVoyage()
	if panels.train.frame.Visible then
		Lobby.refreshTrain()
	end
	if panels.gear.frame.Visible then
		Lobby.refreshGear()
	end
	Lobby.refreshStore()
end

-- Called while standing on a voyage gate.
function Lobby.portal(info)
	local wasCaptain = isCaptain()
	portal = info
	lastPortalMessage = os.clock()
	ui.bannerName.Text = "⛵  VOYAGE GATE " .. info.gate
	ui.bannerBar.BackgroundColor3 = info.color
	ui.banner:FindFirstChildOfClass("UIStroke").Color = info.color
	ui.bannerCaptain.Text = info.captain and "👑 You are the captain" or ("👑 Captain: " .. (info.captainName or "?"))
	ui.bannerStatus.Text = info.text
	ui.bannerPick.Visible = info.captain
	for name, p in panels do
		if name ~= "voyage" then
			p.frame.Visible = false
		end
	end
	-- the captain gets the map select once per boarding
	if info.captain and not info.map and not pickerOpened then
		pickerOpened = true
		Lobby.toggle("voyage", true)
	end
	if wasCaptain ~= isCaptain() or panels.voyage.frame.Visible then
		Lobby.refreshVoyage() -- keeps captain status and busy maps current
	end
end

return Lobby
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX14394"><Properties><string name="Name">Rigs</string><ProtectedString name="Source"><![CDATA[-- Procedural animation for everything that isn't a player, no animation assets needed:
--   * enemies walk (legs and arms swing with their speed), aim their guns, carry bombs, and
--     swing, cast or shoot when the server says they attack (attributes Pose / PoseAt)
--   * island NPCs breathe, turn their head toward you, wave when you walk up, and play their
--     own idle (Captain Grey stands calm, Granny Doc sips sake, Hammond hammers, Roxie smokes, Bingo laughs)
-- Also shows NPC speech bubbles.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local Rigs = {}
local player = Players.LocalPlayer
local rad, sin, clamp = math.rad, math.sin, math.clamp
local Angles = CFrame.Angles

local POSE_TIME = { swing = 0.35, cast = 0.5, shoot = 0.25 }

local function envelope(t, peak)
	if t < peak then
		return t / peak
	end
	return 1 - (t - peak) / (1 - peak)
end

-- Enemies -------------------------------------------------------------------------------------

local mobs = {} -- [model] = state

local function mobState(model)
	local torso = model:FindFirstChild("Torso")
	if not torso then
		return nil
	end
	local motors = {}
	for _, name in { "LeftHip", "RightHip", "LeftShoulder", "RightShoulder", "Neck" } do
		local m = torso:FindFirstChild(name)
		if not m then
			return nil -- not a jointed enemy (e.g. a treasure chest)
		end
		motors[name] = m
	end
	return {
		torso = torso, motors = motors, last = torso.Position, speed = 0, t = math.random() * 6,
		scale = model:GetAttribute("Scale") or 1, style = model:GetAttribute("Style") or "march",
	}
end

local function animateMob(model, st, dt, now)
	local pos = st.torso.Position
	local moved = Vector3.new(pos.X - st.last.X, 0, pos.Z - st.last.Z).Magnitude
	st.last = pos
	local v = dt > 0 and math.min(moved / dt, 80) or 0
	st.speed += (v - st.speed) * math.min(1, dt * 8)
	local s = st.scale
	st.t += dt * clamp(st.speed / s, 0, 30) * 0.55
	local amp = clamp(st.speed / (6 * s), 0, 1) * 0.75
	local swing = sin(st.t) * amp
	local m = st.motors

	m.LeftHip.Transform = Angles(swing, 0, 0)
	m.RightHip.Transform = Angles(-swing, 0, 0)
	m.Neck.Transform = Angles(sin(st.t * 2) * 0.05, 0, 0)

	local left, right
	if st.style == "aim" then
		right = Angles(rad(90), 0, 0)
		left = Angles(rad(75), 0, rad(25))
	elseif st.style == "carry" then
		right = Angles(rad(60), 0, 0)
		left = Angles(rad(60), 0, rad(20))
	else
		right = Angles(swing * 0.8, 0, 0)
		left = Angles(-swing * 0.8, 0, 0)
	end

	-- attack poses on top
	local poseAt = model:GetAttribute("PoseAt")
	local poseName = model:GetAttribute("Pose")
	local duration = POSE_TIME[poseName]
	if poseAt and duration then
		-- the server's clock differs from ours: time the pose from when we first saw it
		if st.poseAt ~= poseAt then
			st.poseAt, st.poseStart = poseAt, now
		end
		local t = (now - st.poseStart) / duration
		if t < 1 then
			local k = envelope(t, 0.3)
			if poseName == "swing" then
				right = Angles(rad(160 - 150 * t) * k, 0, 0)
			elseif poseName == "cast" then
				right = Angles(rad(150) * k, 0, rad(20) * k)
				left = Angles(rad(150) * k, 0, rad(-20) * k)
			elseif poseName == "shoot" then
				right = right * Angles(rad(25) * k, 0, 0)
			end
		end
	end
	m.LeftShoulder.Transform = left
	m.RightShoulder.Transform = right
end

-- Island NPCs ---------------------------------------------------------------------------------

local npcs = {} -- [model] = state

local function motor(model, partName, motorName)
	local p = model:FindFirstChild(partName)
	return p and p:FindFirstChild(motorName)
end

local function npcState(model)
	local root = model:FindFirstChild("HumanoidRootPart")
	if not root then
		return nil
	end
	return {
		root = root, style = model:GetAttribute("Style"), yaw = 0, near = false, waveStart = -10,
		phase = math.random() * 5, lastStrike = 0,
		waist = motor(model, "UpperTorso", "Waist"), neck = motor(model, "Head", "Neck"),
		rs = motor(model, "RightUpperArm", "RightShoulder"), ls = motor(model, "LeftUpperArm", "LeftShoulder"),
		re = motor(model, "RightLowerArm", "RightElbow"), le = motor(model, "LeftLowerArm", "LeftElbow"),
		sparks = model.Parent and model.Parent:FindFirstChild("Anvil") and model.Parent.Anvil:FindFirstChild("Sparks"),
	}
end

local function set(m, cf)
	if m then
		m.Transform = cf
	end
end

-- A gesture every `every` seconds lasting `length`: returns 0..1..0 while it plays, else 0.
local function every(now, phase, period, length)
	local t = (now + phase) % period
	if t > length then
		return 0
	end
	return envelope(t / length, 0.25)
end

local function animateNpc(model, st, dt, now)
	local character = player.Character
	local me = character and character:FindFirstChild("HumanoidRootPart")
	local rel = me and st.root.CFrame:PointToObjectSpace(me.Position)
	local dist = rel and Vector3.new(rel.X, 0, rel.Z).Magnitude or math.huge

	-- wave once each time you walk up
	local near = dist < 14
	if near and not st.near then
		st.waveStart = now
	end
	st.near = near

	-- turn the head toward you
	local targetYaw = dist < 30 and clamp(math.atan2(-rel.X, -rel.Z), -1, 1) or 0
	st.yaw += (targetYaw - st.yaw) * math.min(1, dt * 5)

	local breathe = sin(now * 1.6 + st.phase) * 0.03
	local waist, neckPitch = Angles(breathe, 0, 0), 0
	local rs, ls, re, le = CFrame.identity, CFrame.identity, CFrame.identity, CFrame.identity

	if st.style == "swordsman" then
		-- calm, hands behind the back, a slow nod now and then
		rs, ls = Angles(rad(-20), 0, rad(8)), Angles(rad(-20), 0, rad(-8))
		re, le = Angles(rad(35), 0, 0), Angles(rad(35), 0, 0)
		neckPitch = every(now, st.phase, 7, 1.2) * 0.25
	elseif st.style == "sip" then
		local k = every(now, st.phase, 5, 1.6)
		rs = Angles(rad(100) * k, 0, rad(-25) * k)
		re = Angles(rad(70) * k, 0, 0)
		ls, le = Angles(0, 0, rad(-25)), Angles(rad(60), 0, 0)
		neckPitch = -0.25 * k
	elseif st.style == "hammer" then
		-- raise slowly, strike fast, sparks fly from the anvil
		local p = (now + st.phase) % 0.9 / 0.9
		local raise = p < 0.7 and p / 0.7 or 1 - (p - 0.7) / 0.3
		rs = Angles(rad(40 + 110 * raise), 0, 0)
		re = Angles(rad(20 * raise), 0, 0)
		waist = waist * Angles(rad(-6) * raise, 0, 0)
		if p > 0.97 and now - st.lastStrike > 0.5 then
			st.lastStrike = now
			if st.sparks then
				st.sparks:Emit(10)
			end
		end
		neckPitch = 0.2
	elseif st.style == "smoke" then
		local k = every(now, st.phase, 6, 1.8)
		ls = Angles(rad(105) * k, 0, rad(25) * k)
		le = Angles(rad(80) * k, 0, 0)
		rs, re = Angles(0, 0, rad(25)), Angles(rad(60), 0, 0)
		waist = waist * Angles(0, sin(now * 0.8) * 0.06, 0)
	elseif st.style == "pray" then
		-- palms together, a slow bow now and then
		local k = every(now, st.phase, 6, 2.4)
		rs, ls = Angles(rad(55), 0, rad(-28)), Angles(rad(55), 0, rad(28))
		re, le = Angles(rad(70), 0, 0), Angles(rad(70), 0, 0)
		waist = waist * Angles(rad(22) * k, 0, 0)
		neckPitch = 0.25 * k
	elseif st.style == "laugh" then
		-- hands on hips, then a big "Gya-ha-ha!" every few seconds
		local k = every(now, st.phase, 4, 1.6)
		rs = Angles(0, 0, rad(30 + 90 * k))
		ls = Angles(0, 0, rad(-30 - 90 * k))
		re, le = Angles(rad(70 * (1 - k)), 0, 0), Angles(rad(70 * (1 - k)), 0, 0)
		waist = waist * Angles(rad(-12) * k + sin(now * 25) * 0.06 * k, 0, 0)
		neckPitch = -0.35 * k
	end

	-- the greeting wave wins over the idle for the right arm
	local w = now - st.waveStart
	if w < 1.6 then
		local k = envelope(w / 1.6, 0.2)
		rs = rs:Lerp(Angles(0, 0, rad(150)), k)
		re = re:Lerp(Angles(0, 0, sin(w * 12) * 0.5), k)
	end

	set(st.waist, waist)
	set(st.neck, Angles(neckPitch, st.yaw, 0))
	set(st.rs, rs)
	set(st.ls, ls)
	set(st.re, re)
	set(st.le, le)
end

-- Speech bubbles ------------------------------------------------------------------------------

-- Shows `text` in a bubble above an NPC for a few seconds (only this player sees it).
function Rigs.speak(anchor, text)
	if not anchor or not text then
		return
	end
	local model = anchor:FindFirstAncestorOfClass("Model")
	local head = model and model:FindFirstChild("Head") or anchor
	local old = head:FindFirstChild("SpeechBubble")
	if old then
		old:Destroy()
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "SpeechBubble"
	gui.Size = UDim2.fromOffset(260, 70)
	gui.StudsOffset = Vector3.new(0, 7, 0)
	gui.MaxDistance = 60
	gui.LightInfluence = 0
	gui.Parent = head
	local bubble = Instance.new("TextLabel")
	bubble.Size = UDim2.new(1, 0, 1, -12)
	bubble.BackgroundColor3 = Color3.fromRGB(255, 250, 235)
	bubble.TextColor3 = Color3.fromRGB(40, 30, 20)
	bubble.Font = Enum.Font.FredokaOne
	bubble.TextScaled = true
	bubble.TextWrapped = true
	bubble.Text = text
	bubble.Parent = gui
	Instance.new("UICorner", bubble).CornerRadius = UDim.new(0, 14)
	local pad = Instance.new("UIPadding", bubble)
	pad.PaddingLeft, pad.PaddingRight, pad.PaddingTop, pad.PaddingBottom = UDim.new(0, 10), UDim.new(0, 10), UDim.new(0, 6), UDim.new(0, 6)
	local stroke = Instance.new("UIStroke", bubble)
	stroke.Color, stroke.Thickness = Color3.fromRGB(60, 40, 20), 2
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	local tail = Instance.new("Frame")
	tail.Size = UDim2.fromOffset(14, 14)
	tail.Position = UDim2.new(0.5, -7, 1, -19)
	tail.Rotation = 45
	tail.BackgroundColor3 = bubble.BackgroundColor3
	tail.BorderSizePixel = 0
	tail.Parent = gui
	local scale = Instance.new("UIScale", bubble)
	scale.Scale = 0.6
	TweenService:Create(scale, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	Debris:AddItem(gui, 3.5)
	-- they wave while talking
	local st = model and npcs[model]
	if st then
		st.waveStart = os.clock()
	end
end

-- Main loop -----------------------------------------------------------------------------------

local MOB_RANGE = 240 -- only animate what this player can actually see
local NPC_RANGE = 160

-- Stepped runs after Roblox's Animator, so these poses aren't overwritten.
RunService.Stepped:Connect(function(_, dt)
	local now = os.clock()
	local focus = workspace.CurrentCamera.Focus.Position
	local folder = workspace:FindFirstChild("Enemies")
	if folder then
		for _, model in folder:GetChildren() do
			local st = mobs[model]
			if st == nil then
				st = mobState(model) or false
				mobs[model] = st
			end
			if st then
				local pos = st.torso.Position
				if (pos - focus).Magnitude <= MOB_RANGE * st.scale then
					animateMob(model, st, dt, now)
				else
					st.last = pos -- keep the speed estimate fresh for when it comes into view
				end
			end
		end
	end
	for model in mobs do
		if not model.Parent then
			mobs[model] = nil
		end
	end

	for _, model in CollectionService:GetTagged("IslandNPC") do
		local st = npcs[model]
		if not st then
			st = npcState(model)
			npcs[model] = st
		end
		if st and (st.root.Position - focus).Magnitude <= NPC_RANGE then
			animateNpc(model, st, dt, now)
		end
	end
	for model in npcs do
		if not model.Parent then
			npcs[model] = nil
		end
	end
end)

return Rigs
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX14395"><Properties><string name="Name">Settings</string><ProtectedString name="Source"><![CDATA[-- The settings menu (⚙️): music and effects volume, damage numbers, camera shake and a low
-- graphics mode for phones. Saved with the player's data; works on the island and in adventures.
local Theme = require(script.Parent.Theme)
local Sounds = require(script.Parent.Sounds)
local Effects = require(script.Parent.Effects)

local Settings = {}
local values = { music = 0.5, sfx = 0.8, numbers = true, shake = true, low = false }
local ui = {}
local onChange
local sendAt -- debounce: the server hears about changes once things settle

local function apply()
	Sounds.setVolume(values.music, values.sfx)
	Effects.settings.numbers = values.numbers
	Effects.settings.shake = values.shake
	Effects.settings.low = values.low
end

local function refresh()
	for key, row in ui.rows or {} do
		local v = values[key]
		if type(v) == "number" then
			row.value.Text = string.format("%d%%", math.floor(v * 100 + 0.5))
		else
			row.toggle.Text = v and "ON" or "OFF"
			row.toggle.BackgroundColor3 = v and Theme.GOOD or Theme.LOCKED
		end
	end
end

local function changed()
	apply()
	refresh()
	local token = {}
	sendAt = token
	task.delay(1, function()
		if sendAt == token and onChange then
			onChange(table.clone(values))
		end
	end)
end

function Settings.init(root, change)
	onChange = change
	local frame = Theme.panel({
		Name = "Settings", Size = UDim2.fromOffset(460, 420), Position = UDim2.new(0.5, -230, 0.5, -210), Visible = false, ZIndex = 40,
	}, root)
	ui.frame = frame
	ui.scale = Theme.new("UIScale", {}, frame)
	Theme.title({ Size = UDim2.new(1, -100, 0, 34), Position = UDim2.fromOffset(26, 20), Text = "⚙️ SETTINGS", TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 41 }, frame)
	Theme.divider({ Size = UDim2.new(1, -40, 0, 2), Position = UDim2.fromOffset(20, 66), ZIndex = 41 }, frame)
	Theme.button({ Size = UDim2.fromOffset(40, 40), Position = UDim2.new(1, -60, 0, 18), Text = "X", BackgroundColor3 = Theme.CARD_LIGHT, ZIndex = 42 }, frame, function()
		Settings.toggle(false)
	end)
	ui.rows = {}
	local rows = {
		{ "music", "🎵 Music" }, { "sfx", "🔊 Sound effects" }, { "numbers", "🔢 Damage numbers" },
		{ "shake", "📳 Camera shake" }, { "low", "🥔 Low graphics (fewer particles)" },
	}
	for i, row in rows do
		local key = row[1]
		local card = Theme.card({ Size = UDim2.new(1, -40, 0, 56), Position = UDim2.fromOffset(20, 80 + (i - 1) * 64), ZIndex = 41 }, frame)
		Theme.text({ Size = UDim2.new(1, -200, 1, -16), Position = UDim2.fromOffset(14, 8), Text = row[2], Font = Theme.BOLD, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 42, MaxSize = 18 }, card)
		local entry = {}
		if type(values[key]) == "number" then
			Theme.button({ Size = UDim2.fromOffset(40, 40), Position = UDim2.new(1, -170, 0, 8), Text = "-", BackgroundColor3 = Theme.CARD_LIGHT, ZIndex = 42 }, card, function()
				values[key] = math.max(0, values[key] - 0.1)
				changed()
			end)
			entry.value = Theme.title({ Size = UDim2.fromOffset(70, 30), Position = UDim2.new(1, -125, 0, 13), Text = "", ZIndex = 42, MaxSize = 20 }, card)
			Theme.button({ Size = UDim2.fromOffset(40, 40), Position = UDim2.new(1, -50, 0, 8), Text = "+", BackgroundColor3 = Theme.CARD_LIGHT, ZIndex = 42 }, card, function()
				values[key] = math.min(1, values[key] + 0.1)
				changed()
			end)
		else
			entry.toggle = Theme.button({ Size = UDim2.fromOffset(96, 40), Position = UDim2.new(1, -108, 0, 8), Text = "", ZIndex = 42 }, card, function()
				values[key] = not values[key]
				changed()
			end)
		end
		ui.rows[key] = entry
	end
	apply()
	refresh()
end

-- Applies settings loaded from the save.
function Settings.load(saved)
	if type(saved) ~= "table" then
		return
	end
	for key, v in saved do
		if values[key] ~= nil and type(v) == type(values[key]) then
			values[key] = v
		end
	end
	apply()
	refresh()
end

function Settings.toggle(open)
	if open == nil then
		open = not ui.frame.Visible
	end
	if open and not ui.frame.Visible then
		ui.scale.Scale = 0.9
		Theme.tween(ui.scale, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
	end
	ui.frame.Visible = open
end

return Settings
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX14396"><Properties><string name="Name">Sounds</string><ProtectedString name="Source"><![CDATA[-- Sound effects and music. Sounds are listed in Config.SOUNDS and Config.MUSIC; volumes come
-- from the player's settings. Each sound has a minimum gap so a swarm of hits doesn't turn into
-- noise, and positioned sounds play in 3D at the spot they happen.
local RS = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local Config = require(RS:WaitForChild("Shared"):WaitForChild("Config"))

local Sounds = {}
local volume = { music = 0.5, sfx = 0.8 }
local lastPlayed = {}

local sfxGroup = Instance.new("SoundGroup")
sfxGroup.Name = "Effects"
sfxGroup.Parent = SoundService
local musicGroup = Instance.new("SoundGroup")
musicGroup.Name = "Music"
musicGroup.Parent = SoundService

-- Plays a sound by name. opts: pos (Vector3 for 3D sound), volume (multiplier), pitch (exact).
function Sounds.play(name, opts)
	local def = Config.SOUNDS[name]
	if not def or def.id == "" or volume.sfx <= 0 then
		return
	end
	local now = os.clock()
	if now - (lastPlayed[name] or 0) < (def.gap or 0) then
		return
	end
	lastPlayed[name] = now
	opts = opts or {}
	local sound = Instance.new("Sound")
	sound.SoundId = def.id
	sound.Volume = def.volume * (opts.volume or 1)
	local pitch = def.pitch
	sound.PlaybackSpeed = opts.pitch or (pitch and pitch[1] + math.random() * (pitch[2] - pitch[1])) or 1
	sound.SoundGroup = sfxGroup
	if opts.pos then
		-- a 3D sound at the spot: louder close by, fading out with distance
		local spot = Instance.new("Attachment")
		spot.WorldPosition = opts.pos
		spot.Parent = workspace.Terrain
		sound.RollOffMode = Enum.RollOffMode.InverseTapered
		sound.RollOffMinDistance = 20
		sound.RollOffMaxDistance = 220
		sound.Parent = spot
		Debris:AddItem(spot, 4)
	else
		sound.Parent = SoundService
		Debris:AddItem(sound, 4)
	end
	sound:Play()
end

-- Music ---------------------------------------------------------------------------------------

local tracks = {} -- [name] = Sound
local current

-- Crossfades to a music track ("Lobby", "Battle", "Boss"); tracks without an id are silent.
function Sounds.music(name)
	if current == name then
		return
	end
	current = name
	for trackName, sound in tracks do
		if trackName ~= name then
			TweenService:Create(sound, TweenInfo.new(1.5), { Volume = 0 }):Play()
		end
	end
	local id = Config.MUSIC[name]
	if not id or id == "" then
		return
	end
	local sound = tracks[name]
	if not sound then
		sound = Instance.new("Sound")
		sound.Name = name
		sound.SoundId = id
		sound.Looped = true
		sound.Volume = 0
		sound.SoundGroup = musicGroup
		sound.Parent = SoundService
		tracks[name] = sound
	end
	if not sound.IsPlaying then
		sound:Play()
	end
	TweenService:Create(sound, TweenInfo.new(1.5), { Volume = 0.6 }):Play()
end

-- Applies the volume settings (0 to 1 each).
function Sounds.setVolume(music, sfx)
	volume.music, volume.sfx = music, sfx
	musicGroup.Volume = music
	sfxGroup.Volume = sfx
end

return Sounds
]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX14397"><Properties><string name="Name">SwarmClient</string><ProtectedString name="Source"><![CDATA[-- Client entry point: builds the UI, connects it to the server's remotes, and handles dashing,
-- NPC prompts, Robux purchase prompts, watching teammates while knocked out, music, map moods,
-- settings and the first-time guide.
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local UIS = game:GetService("UserInputService")
local StarterGui = game:GetService("StarterGui")
local ContextActionService = game:GetService("ContextActionService")
local ProximityPromptService = game:GetService("ProximityPromptService")
local MarketplaceService = game:GetService("MarketplaceService")
local SocialService = game:GetService("SocialService")
local Debris = game:GetService("Debris")

local Config = require(RS:WaitForChild("Shared"):WaitForChild("Config"))
local remotes = RS:WaitForChild("Remotes")
local player = Players.LocalPlayer
local Theme = require(script.Parent:WaitForChild("Theme"))
local Effects = require(script.Parent:WaitForChild("Effects"))
local Hud = require(script.Parent:WaitForChild("Hud"))
local Lobby = require(script.Parent:WaitForChild("Lobby"))
local Rigs = require(script.Parent:WaitForChild("Rigs")) -- animates enemies and island NPCs
local Sounds = require(script.Parent:WaitForChild("Sounds"))
local Settings = require(script.Parent:WaitForChild("Settings"))
local Tutorial = require(script.Parent:WaitForChild("Tutorial"))
local Ambience = require(script.Parent:WaitForChild("Ambience"))

-- our own health bar replaces the default one
pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
end)

local gui = Instance.new("ScreenGui")
gui.Name = "SwarmUI"
gui.ResetOnSpawn = false
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = player:WaitForChild("PlayerGui")
-- everything lives in one root that scales to fit the screen (phones included)
local root = Theme.new("Frame", { Name = "Root", BackgroundTransparency = 1 }, gui)
Theme.autoScale(root)

-- Dash ------------------------------------------------------------------------------------

local dashCooldown = Config.DASH.cooldown
local dashReadyAt = 0

local function dash()
	local character = player.Character
	local body = character and character:FindFirstChild("HumanoidRootPart")
	local hum = character and character:FindFirstChildOfClass("Humanoid")
	if not body or not hum or hum.Health <= 0 or os.clock() < dashReadyAt then
		return
	end
	dashReadyAt = os.clock() + dashCooldown
	local dir = hum.MoveDirection.Magnitude > 0.1 and hum.MoveDirection or body.CFrame.LookVector
	dir = Vector3.new(dir.X, 0, dir.Z).Unit
	-- a short, strong push in the move direction (the client owns its character's physics)
	local attachment = Instance.new("Attachment")
	attachment.Parent = body
	local push = Instance.new("LinearVelocity")
	push.Attachment0 = attachment
	push.MaxForce = math.huge
	push.VectorVelocity = dir * Config.DASH.speed
	push.Parent = body
	Debris:AddItem(push, Config.DASH.duration)
	Debris:AddItem(attachment, Config.DASH.duration)
	remotes.Dash:FireServer()
	Hud.dashUsed(dashCooldown)
end

-- Shift / gamepad L2, plus an on-screen button on touch devices
ContextActionService:BindAction("Dash", function(_, state)
	if state == Enum.UserInputState.Begin then
		dash()
	end
	return Enum.ContextActionResult.Sink
end, true, Enum.KeyCode.LeftShift, Enum.KeyCode.RightShift, Enum.KeyCode.ButtonL2)
ContextActionService:SetTitle("Dash", "DASH")

-- Watching teammates while knocked out ------------------------------------------------------

local crew = {} -- UserIds of this run's crew, from the latest State
local watchIndex = 0
local wasDown = false

local function standingCrew()
	local list = {}
	for _, userId in crew do
		local mate = Players:GetPlayerByUserId(userId)
		local hum = mate and mate ~= player and mate.Character and mate.Character:FindFirstChildOfClass("Humanoid")
		if hum and hum.Health > 0 then
			table.insert(list, { player = mate, hum = hum })
		end
	end
	return list
end

local function spectate(step)
	local list = standingCrew()
	if #list == 0 then
		Hud.setWatching(nil)
		return
	end
	watchIndex = (watchIndex + step - 1) % #list + 1
	workspace.CurrentCamera.CameraSubject = list[watchIndex].hum
	Hud.setWatching(list[watchIndex].player.DisplayName)
end

local function stopSpectating()
	local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if hum then
		workspace.CurrentCamera.CameraSubject = hum
	end
end

-- Purchases -------------------------------------------------------------------------------

local function buyPass(key)
	local pass = Config.GAME_PASSES[key]
	if pass and pass.id > 0 then
		MarketplaceService:PromptGamePassPurchase(player, pass.id)
	end
end

local function buyProduct(key)
	local product = Config.PRODUCTS[key]
	if product and product.id > 0 then
		MarketplaceService:PromptProductPurchase(player, product.id)
	end
end

-- Robux prices shown in the store
for key, pass in Config.GAME_PASSES do
	if pass.id > 0 then
		task.spawn(function()
			local ok, info = pcall(MarketplaceService.GetProductInfo, MarketplaceService, pass.id, Enum.InfoType.GamePass)
			if ok and info and info.PriceInRobux then
				Lobby.setPrice("pass", key, info.PriceInRobux)
			end
		end)
	end
end
for key, product in Config.PRODUCTS do
	if product.id > 0 then
		task.spawn(function()
			local ok, info = pcall(MarketplaceService.GetProductInfo, MarketplaceService, product.id, Enum.InfoType.Product)
			if ok and info and info.PriceInRobux then
				Lobby.setPrice("product", key, info.PriceInRobux)
				if key == "Revive" then
					Hud.setRevivePrice(info.PriceInRobux)
				end
			end
		end)
	end
end

-- UI --------------------------------------------------------------------------------------

Hud.init(root, {
	choose = function(i)
		remotes.Choose:FireServer(i)
	end,
	reroll = function()
		remotes.Reroll:FireServer()
	end,
	dash = dash,
	leave = function()
		remotes.Leave:FireServer()
	end,
	spectate = spectate,
	settings = function()
		Settings.toggle()
	end,
	revive = function(owned)
		if owned > 0 then
			remotes.Revive:FireServer()
		else
			buyProduct("Revive")
		end
	end,
})
Lobby.init(root, {
	selectClass = function(name)
		remotes.SelectClass:FireServer(name)
	end,
	unlockClass = function(name)
		remotes.UnlockClass:FireServer(name)
	end,
	buy = function(name)
		remotes.BuyMeta:FireServer(name)
	end,
	voyage = function(mapKey, difficulty, endless)
		remotes.Voyage:FireServer(mapKey, difficulty, endless)
	end,
	rebirth = function()
		remotes.Rebirth:FireServer()
	end,
	invite = function()
		-- Roblox's invite friends prompt (if this player is allowed to send invites)
		task.spawn(function()
			local ok, can = pcall(SocialService.CanSendGameInviteAsync, SocialService, player)
			if ok and can then
				pcall(SocialService.PromptGameInvite, SocialService, player)
			end
		end)
	end,
	train = function(kind, name)
		remotes.Train:FireServer(kind, name)
	end,
	gear = function(action, id)
		remotes.Gear:FireServer(action, id)
	end,
	buyPass = buyPass,
	buyProduct = buyProduct,
	settings = function()
		Settings.toggle()
	end,
	rewards = function(action, arg)
		remotes.Rewards:FireServer(action, arg)
	end,
})
Settings.init(root, function(values)
	remotes.Settings:FireServer(values)
end)
Tutorial.init(root, function()
	remotes.Rewards:FireServer("tutorial")
end)

-- island NPCs greet you and open their menus
ProximityPromptService.PromptTriggered:Connect(function(prompt)
	local panel = prompt:GetAttribute("Panel")
	if panel then
		Rigs.speak(prompt.Parent, prompt:GetAttribute("Line"))
		Lobby.open(panel, prompt:GetAttribute("Tab"))
		Tutorial.talked()
	end
end)

remotes.Fx.OnClientEvent:Connect(function(list)
	for _, ev in list do
		Effects.play(ev)
	end
end)
remotes.Stats.OnClientEvent:Connect(Hud.setStats)
remotes.LevelUp.OnClientEvent:Connect(Hud.showLevelUp)
remotes.Announce.OnClientEvent:Connect(Hud.announce)
remotes.Wave.OnClientEvent:Connect(Hud.showWave)
remotes.Sound.OnClientEvent:Connect(Sounds.play)
remotes.Results.OnClientEvent:Connect(Hud.showResults)
remotes.Portal.OnClientEvent:Connect(Lobby.portal)
local firstMeta = true
remotes.Meta.OnClientEvent:Connect(function(data)
	dashCooldown = data.dashCooldown or Config.DASH.cooldown
	Hud.setRevives(data.revives or 0)
	Lobby.setMeta(data)
	if firstMeta and data.rewards then
		firstMeta = false
		Settings.load(data.rewards.settings)
		Tutorial.start(data.rewards.tutorial)
	end
end)

remotes.State.OnClientEvent:Connect(function(state)
	local running = state.phase == "Run"
	if not running then
		Effects.clear()
	end
	crew = state.crew or crew
	local down = running and state.down == true
	if down and not wasDown then
		watchIndex = 0
		spectate(1)
	elseif down then
		-- keep watching someone who is still standing
		local subject = workspace.CurrentCamera.CameraSubject
		if not subject or not subject:IsA("Humanoid") or subject.Health <= 0 or subject.Parent == player.Character then
			spectate(1)
		end
	elseif wasDown then
		stopSpectating()
	end
	wasDown = down
	Hud.setVisible(running)
	Hud.setState(state)
	Lobby.setVisible(state.phase == "Lobby")
	if running then
		Hud.setCrew(state.crew)
		Ambience.set(state.theme or "island")
		Sounds.music(state.boss and "Boss" or "Battle")
	elseif state.phase == "Lobby" then
		Ambience.set("island")
		Sounds.music("Lobby")
	end
	Tutorial.phase(state.phase)
end)

local KEYS = { [Enum.KeyCode.One] = 1, [Enum.KeyCode.Two] = 2, [Enum.KeyCode.Three] = 3 }
UIS.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	if KEYS[input.KeyCode] then
		Hud.choose(KEYS[input.KeyCode])
	elseif input.KeyCode == Enum.KeyCode.R then
		Hud.reroll()
	end
end)

remotes.Meta:FireServer()
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX14398"><Properties><string name="Name">Theme</string><ProtectedString name="Source"><![CDATA[-- Shared look for every menu: "High Seas" pirate style. Deep-sea navy panels with gold rope
-- trim and corner rivets, glossy chunky buttons, parchment for wanted posters, and cartoon
-- fonts (Luckiest Guy titles, Fredoka One labels). Colors, fonts and small UI builders.
local TweenService = game:GetService("TweenService")

local Sounds = require(script.Parent.Sounds)

local Theme = {}

Theme.BG = Color3.fromRGB(7, 17, 30)
Theme.PANEL = Color3.fromRGB(15, 33, 54)
Theme.CARD = Color3.fromRGB(23, 47, 74)
Theme.CARD_LIGHT = Color3.fromRGB(36, 66, 100)
Theme.LINE = Color3.fromRGB(255, 255, 255)
Theme.ACCENT = Color3.fromRGB(226, 72, 64) -- straw-hat red
Theme.GOLD = Color3.fromRGB(255, 200, 70)
Theme.TRIM = Color3.fromRGB(214, 168, 88) -- rope gold
Theme.TEXT = Color3.fromRGB(252, 246, 230)
Theme.MUTED = Color3.fromRGB(165, 184, 206)
Theme.GOOD = Color3.fromRGB(64, 200, 120)
Theme.BAD = Color3.fromRGB(255, 84, 96)
Theme.DARK_TEXT = Color3.fromRGB(14, 16, 26)
Theme.LOCKED = Color3.fromRGB(60, 70, 88)
Theme.PARCHMENT = Color3.fromRGB(240, 222, 180)
Theme.INK = Color3.fromRGB(70, 42, 20)
Theme.SEA = Color3.fromRGB(40, 140, 210)
Theme.TITLE_FONT = Enum.Font.LuckiestGuy
Theme.BOLD = Enum.Font.FredokaOne
Theme.FONT = Enum.Font.GothamMedium

function Theme.new(class, props, parent)
	local obj = Instance.new(class)
	for k, v in props do
		obj[k] = v
	end
	obj.Parent = parent
	return obj
end

function Theme.tween(obj, time, goal, style, direction)
	local info = TweenInfo.new(time, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out)
	local t = TweenService:Create(obj, info, goal)
	t:Play()
	return t
end

function Theme.corner(parent, radius)
	return Theme.new("UICorner", { CornerRadius = UDim.new(0, radius or 12) }, parent)
end

function Theme.stroke(parent, color, thickness, transparency)
	return Theme.new("UIStroke", {
		Color = color or Theme.LINE, Thickness = thickness or 1, Transparency = transparency or 0.85,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, parent)
end

-- Vertical gradient that tints whatever color the parent has.
function Theme.gradient(parent, top, bottom, rotation)
	return Theme.new("UIGradient", { Color = ColorSequence.new(top, bottom), Rotation = rotation or 90 }, parent)
end

function Theme.padding(parent, px)
	return Theme.new("UIPadding", {
		PaddingTop = UDim.new(0, px), PaddingBottom = UDim.new(0, px), PaddingLeft = UDim.new(0, px), PaddingRight = UDim.new(0, px),
	}, parent)
end

-- Little gold rivets in the corners of a panel, like a ship's chest.
function Theme.rivets(frame, inset, zIndex)
	inset = inset or 7
	for _, pos in {
		UDim2.fromOffset(inset, inset), UDim2.new(1, -inset - 6, 0, inset),
		UDim2.new(0, inset, 1, -inset - 6), UDim2.new(1, -inset - 6, 1, -inset - 6),
	} do
		local rivet = Theme.new("Frame", {
			Name = "Rivet", Size = UDim2.fromOffset(6, 6), Position = pos, BackgroundColor3 = Theme.TRIM,
			ZIndex = zIndex or 2, BorderSizePixel = 0,
		}, frame)
		Theme.corner(rivet, 3)
	end
end

-- Deep-sea panel with a gold rope border, an inner hairline and corner rivets.
function Theme.panel(props, parent)
	props.BackgroundColor3 = props.BackgroundColor3 or Theme.PANEL
	props.BackgroundTransparency = props.BackgroundTransparency or 0.04
	local frame = Theme.new("Frame", props, parent)
	Theme.corner(frame, 16)
	Theme.stroke(frame, Theme.TRIM, 2, 0.15)
	Theme.gradient(frame, Color3.fromRGB(255, 255, 255), Color3.fromRGB(150, 165, 190))
	local inner = Theme.new("Frame", {
		Name = "Inlay", Size = UDim2.new(1, -10, 1, -10), Position = UDim2.fromOffset(5, 5),
		BackgroundTransparency = 1, ZIndex = props.ZIndex or 1,
	}, frame)
	Theme.corner(inner, 12)
	Theme.stroke(inner, Theme.TRIM, 1, 0.7)
	Theme.rivets(frame, 4, (props.ZIndex or 1) + 1)
	return frame
end

-- Rounded card used inside panels.
function Theme.card(props, parent)
	props.BackgroundColor3 = props.BackgroundColor3 or Theme.CARD
	local frame = Theme.new("Frame", props, parent)
	Theme.corner(frame, 12)
	Theme.stroke(frame, Theme.TRIM, 1, 0.75)
	Theme.gradient(frame, Color3.fromRGB(255, 255, 255), Color3.fromRGB(190, 200, 215))
	return frame
end

-- A parchment card (wanted posters, the results scroll).
function Theme.parchment(props, parent, class)
	props.BackgroundColor3 = Theme.PARCHMENT
	local frame = Theme.new(class or "Frame", props, parent)
	Theme.corner(frame, 6)
	Theme.stroke(frame, Theme.INK, 2, 0.35)
	Theme.new("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 250, 235)),
			ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 255, 255)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(215, 190, 150)),
		}),
		Rotation = 90,
	}, frame)
	return frame
end

-- A gold divider that fades out at both ends.
function Theme.divider(props, parent)
	props.BackgroundColor3 = Theme.TRIM
	props.BorderSizePixel = 0
	local line = Theme.new("Frame", props, parent)
	Theme.new("UIGradient", {
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.2, 0.2),
			NumberSequenceKeypoint.new(0.8, 0.2), NumberSequenceKeypoint.new(1, 1),
		}),
	}, line)
	return line
end

-- Text label. Pass MaxSize to cap scaled text.
function Theme.text(props, parent)
	local maxSize = props.MaxSize
	props.MaxSize = nil
	props.BackgroundTransparency = props.BackgroundTransparency or 1
	props.TextColor3 = props.TextColor3 or Theme.TEXT
	props.Font = props.Font or Theme.FONT
	if props.TextScaled == nil then
		props.TextScaled = true
	end
	local label = Theme.new("TextLabel", props, parent)
	if maxSize then
		Theme.new("UITextSizeConstraint", { MaxTextSize = maxSize }, label)
	end
	return label
end

-- Cartoon title text with a dark outline.
function Theme.title(props, parent)
	props.Font = props.Font or Theme.TITLE_FONT
	props.TextStrokeTransparency = props.TextStrokeTransparency or 0.35
	props.TextStrokeColor3 = props.TextStrokeColor3 or Color3.fromRGB(5, 10, 20)
	return Theme.text(props, parent)
end

-- Small rounded label ("chip"), e.g. tags and counters.
function Theme.chip(props, parent, color)
	color = color or Theme.ACCENT
	props.BackgroundTransparency = props.BackgroundTransparency or 0.8
	props.BackgroundColor3 = color
	props.TextColor3 = props.TextColor3 or color:Lerp(Color3.new(1, 1, 1), 0.45)
	props.Font = props.Font or Theme.BOLD
	local chip = Theme.text(props, parent)
	Theme.corner(chip, 8)
	Theme.padding(chip, 4)
	return chip
end

-- Rounded square with a colored gradient and an emoji icon in the middle.
function Theme.icon(props, parent, icon, color, radius)
	props.BackgroundColor3 = color or Theme.ACCENT
	local tile = Theme.new("Frame", props, parent)
	Theme.corner(tile, radius or 10)
	Theme.gradient(tile, Color3.new(1, 1, 1), Color3.fromRGB(120, 120, 140), 135)
	Theme.stroke(tile, Theme.TRIM, 1.5, 0.45)
	local label = Theme.text({
		Size = UDim2.fromScale(0.72, 0.72), Position = UDim2.fromScale(0.14, 0.14), Text = icon or "",
		ZIndex = (props.ZIndex or 1) + 1, Font = Theme.TITLE_FONT,
	}, tile)
	return tile, label
end

-- Button with a hover glow and a press squish. The glow is an overlay, so callers can
-- recolor the button at any time.
function Theme.button(props, parent, onClick)
	props.AutoButtonColor = false
	props.BackgroundColor3 = props.BackgroundColor3 or Theme.ACCENT
	props.Font = props.Font or Theme.BOLD
	props.TextColor3 = props.TextColor3 or Theme.TEXT
	if props.TextScaled == nil then
		props.TextScaled = true
	end
	local button = Theme.new("TextButton", props, parent)
	if button.TextStrokeTransparency == 1 then
		button.TextStrokeTransparency = 0.55
	end
	Theme.corner(button, 12)
	Theme.stroke(button, Color3.fromRGB(10, 20, 35), 2, 0.35)
	-- glossy: a bright top half and a darker bottom half
	Theme.new("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
			ColorSequenceKeypoint.new(0.48, Color3.fromRGB(235, 235, 235)),
			ColorSequenceKeypoint.new(0.52, Color3.fromRGB(205, 205, 205)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(165, 165, 165)),
		}),
		Rotation = 90,
	}, button)
	Theme.new("UITextSizeConstraint", { MaxTextSize = 22 }, button)
	Theme.padding(button, 6)
	local glow = Theme.new("Frame", {
		Name = "Glow", Size = UDim2.new(1, 12, 1, 12), Position = UDim2.fromOffset(-6, -6),
		BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 1, ZIndex = (props.ZIndex or 1) + 1,
	}, button)
	Theme.corner(glow, 12)
	local scale = Theme.new("UIScale", {}, button)
	button.MouseEnter:Connect(function()
		Theme.tween(scale, 0.12, { Scale = 1.03 })
		Theme.tween(glow, 0.12, { BackgroundTransparency = 0.88 })
	end)
	button.MouseLeave:Connect(function()
		Theme.tween(scale, 0.12, { Scale = 1 })
		Theme.tween(glow, 0.12, { BackgroundTransparency = 1 })
	end)
	button.MouseButton1Down:Connect(function()
		Theme.tween(scale, 0.06, { Scale = 0.97 })
	end)
	button.MouseButton1Up:Connect(function()
		Theme.tween(scale, 0.1, { Scale = 1.03 })
	end)
	button.Activated:Connect(function()
		Sounds.play("Click")
	end)
	if onClick then
		button.Activated:Connect(onClick)
	end
	return button
end

-- Slim rounded progress bar. Returns the frame, its fill and a centered label.
function Theme.bar(props, parent, top, bottom)
	props.BackgroundColor3 = props.BackgroundColor3 or Color3.fromRGB(4, 10, 20)
	props.BackgroundTransparency = props.BackgroundTransparency or 0.35
	local frame = Theme.new("Frame", props, parent)
	Theme.corner(frame, 8)
	Theme.stroke(frame, Theme.TRIM, 1, 0.6)
	local fill = Theme.new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ZIndex = (props.ZIndex or 1) }, frame)
	Theme.corner(fill, 8)
	Theme.gradient(fill, top, bottom, 0)
	local label = Theme.text({
		Size = UDim2.fromScale(1, 1), ZIndex = (props.ZIndex or 1) + 1, Font = Theme.BOLD, MaxSize = 15,
		TextStrokeTransparency = 0.6,
	}, frame)
	return frame, fill, label
end

-- Scales a full-screen root frame so the whole UI fits any screen. Layouts are designed for
-- 1280x720; smaller screens (phones) shrink everything evenly.
function Theme.autoScale(root)
	local scale = Theme.new("UIScale", {}, root)
	local function update()
		local view = workspace.CurrentCamera.ViewportSize
		local s = math.clamp(math.min(view.X / 1280, view.Y / 720), 0.45, 1)
		scale.Scale = s
		root.Size = UDim2.fromScale(1 / s, 1 / s)
	end
	update()
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(update)
	return scale
end

function Theme.comma(n)
	local s = tostring(math.floor(n))
	repeat
		local count
		s, count = s:gsub("^(-?%d+)(%d%d%d)", "%1,%2")
	until count == 0
	return s
end

return Theme
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX14399"><Properties><string name="Name">Tutorial</string><ProtectedString name="Source"><![CDATA[-- The first-time guide: a glowing trail and tips that walk a new player through talking to an
-- NPC, boarding a voyage gate and their first adventure. Finishing it pays a welcome gift.
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(RS:WaitForChild("Shared"):WaitForChild("Config"))
local Theme = require(script.Parent.Theme)
local Sounds = require(script.Parent.Sounds)

local Tutorial = {}
local player = Players.LocalPlayer
local ui = {}
local step -- nil = not running
local onFinish
local tipToken

local RUN_TIPS = {
	{ "⚔️ Your skills fire on their own - just keep moving!", 6 },
	{ "💨 Press SHIFT (or DASH) to dash: you're untouchable for a moment.", 6 },
	{ "🔵 Walk over blue XP orbs to level up, then pick a card.", 8 },
	{ "🔴 Red circles and strips are attacks coming. Step out of them!", 7 },
	{ "🌊 Survive the waves, then take down the boss!", 6 },
}

-- Guide trail -----------------------------------------------------------------------------------

local marker = Instance.new("Part")
marker.Name = "GuideMarker"
marker.Anchored, marker.CanCollide, marker.CanQuery, marker.CanTouch = true, false, false, false
marker.Transparency = 1
marker.Size = Vector3.one
local targetAttachment = Instance.new("Attachment")
targetAttachment.Parent = marker
local beam = Instance.new("Beam")
beam.Attachment1 = targetAttachment
beam.Color = ColorSequence.new(Color3.fromRGB(255, 220, 90))
beam.Transparency = NumberSequence.new(0.2, 0.7)
beam.Width0, beam.Width1 = 0.6, 0.6
beam.FaceCamera = true
beam.LightEmission = 1
beam.Segments = 20
beam.Parent = marker
local arrow = Instance.new("BillboardGui")
arrow.Size = UDim2.fromOffset(60, 60)
arrow.AlwaysOnTop = true
arrow.StudsOffset = Vector3.new(0, 7, 0)
arrow.Parent = marker
local arrowText = Instance.new("TextLabel")
arrowText.Size = UDim2.fromScale(1, 1)
arrowText.BackgroundTransparency = 1
arrowText.Text = "⬇️"
arrowText.TextScaled = true
arrowText.Parent = arrow
local fromAttachment

local function pointTo(pos)
	if not pos then
		marker.Parent = nil
		return
	end
	marker.Position = pos
	marker.Parent = workspace
end

local function npcSpot(index)
	local npc = Config.NPCS[index]
	local folder = workspace:FindFirstChild("IslandNPCs")
	local stall = folder and folder:FindFirstChild(npc.name .. " Stall")
	local body = stall and stall:FindFirstChild(npc.name)
	local root = body and body:FindFirstChild("HumanoidRootPart")
	return root and root.Position or npc.position + Vector3.new(0, 3, 0)
end

-- Tip panel -------------------------------------------------------------------------------------

local function showTip(text)
	ui.text.Text = text
	ui.panel.Visible = true
	ui.scale.Scale = 0.85
	Theme.tween(ui.scale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
	Sounds.play("Pickup")
end

local function setStep(n)
	step = n
	if n == 1 then
		showTip("👋 Welcome aboard, recruit! Talk to " .. Config.NPCS[1].name .. " (follow the golden trail, press E).")
		pointTo(npcSpot(1))
	elseif n == 2 then
		showTip("⛵ Now step onto a voyage gate to start your first adventure!")
		pointTo(Config.GATES[2] + Vector3.new(0, 4, 0))
	elseif n == 3 then
		pointTo(nil)
		local token = {}
		tipToken = token
		task.spawn(function()
			for _, tip in RUN_TIPS do
				if tipToken ~= token then
					return
				end
				showTip(tip[1])
				task.wait(tip[2])
			end
			if tipToken == token then
				ui.panel.Visible = false
			end
		end)
	end
end

function Tutorial.init(root, finish)
	onFinish = finish
	local panel = Theme.panel({ Size = UDim2.fromOffset(620, 58), Position = UDim2.new(0.5, -310, 1, -214), Visible = false, ZIndex = 25 }, root)
	ui.panel = panel
	ui.scale = Theme.new("UIScale", {}, panel)
	Theme.text({ Size = UDim2.fromOffset(40, 40), Position = UDim2.fromOffset(12, 9), Text = "🎓", ZIndex = 26 }, panel)
	ui.text = Theme.text({ Size = UDim2.new(1, -120, 1, -16), Position = UDim2.fromOffset(58, 8), Font = Theme.BOLD, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 26, MaxSize = 17 }, panel)
	Theme.button({ Size = UDim2.fromOffset(48, 30), Position = UDim2.new(1, -58, 0.5, -15), Text = "SKIP", BackgroundColor3 = Theme.CARD_LIGHT, ZIndex = 26 }, panel, function()
		Tutorial.finish()
	end)

	RunService.Heartbeat:Connect(function()
		if not marker.Parent then
			return
		end
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if root and (not fromAttachment or fromAttachment.Parent ~= root) then
			fromAttachment = Instance.new("Attachment")
			fromAttachment.Name = "GuideFrom"
			fromAttachment.Parent = root
			beam.Attachment0 = fromAttachment
		end
		arrow.StudsOffset = Vector3.new(0, 7 + math.sin(os.clock() * 4) * 0.8, 0)
	end)
end

-- Starts the guide if this player hasn't finished it.
function Tutorial.start(done)
	if done or step then
		return
	end
	setStep(1)
end

-- Progress events from the rest of the client.
function Tutorial.talked()
	if step == 1 then
		setStep(2)
	end
end

function Tutorial.phase(phase)
	if not step then
		return
	end
	if phase == "Run" and step < 3 then
		setStep(3)
	elseif (phase == "Results" or phase == "Lobby") and step == 3 then
		Tutorial.finish()
	end
end

function Tutorial.finish()
	if not step then
		return
	end
	step = nil
	tipToken = nil
	ui.panel.Visible = false
	pointTo(nil)
	onFinish()
end

return Tutorial
]]></ProtectedString></Properties></Item></Item></Item><Item class="StarterCharacterScripts" referent="RBX14403"><Properties><string name="Name">StarterCharacterScripts</string></Properties><Item class="Script" referent="RBX14402"><Properties><string name="Name">Health</string><ProtectedString name="Source"><![CDATA[-- Empty on purpose: replaces Roblox's default health regen, so healing only comes
-- from Tuck and level-up rewards.
]]></ProtectedString></Properties></Item></Item></Item></roblox>